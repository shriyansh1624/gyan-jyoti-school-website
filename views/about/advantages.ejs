  margin:0 auto 58px;
  text-align:center;
}

.mis-heading h2{
  margin:17px 0 14px;
  color:#001f3f;
  font-size:clamp(38px,5vw,56px);
  line-height:1.05;
  letter-spacing:-1.8px;
  font-weight:950;
}

.mis-heading p{
  max-width:800px;
  margin:auto;
  color:#667585;
  font-size:16px;
  line-height:1.85;
}

.mis-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.mis-card{
  position:relative;
  overflow:hidden;
  min-height:285px;
  padding:34px;
  border:1px solid #e3eaf0;
  border-radius:28px;
  background:#fff;
  box-shadow:0 18px 50px rgba(0,31,63,.075);
  transition:transform .4s,box-shadow .4s,border-color .4s;
}

.mis-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:4px;
  background:linear-gradient(90deg,#ffc300,#ffdf68);
}

.mis-card::after{
  content:"";
  position:absolute;
  width:210px;
  height:210px;
  right:-115px;
  top:-115px;
  border-radius:50%;
  background:rgba(255,195,0,.10);
  transition:.5s;
}

.mis-card:hover{
