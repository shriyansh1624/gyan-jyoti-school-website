        <div class="stat-box">
          <h3>50+</h3>
          <p>Years of educational service</p>
        </div>

        <div class="stat-box">
          <h3>100%</h3>
          <p>Focus on holistic development</p>
        </div>
      </div>

    </div>
  </div>
</section>

<section class="mis-process-section">
  <div class="mis-container">

    <div class="mis-heading">
      <span class="section-tag">Student Support System</span>
      <h2>How We Help Students Grow</h2>
    </div>

    <div class="process-grid">
      <div class="process-step">
        <span>01</span>
        <h3>Concept Learning</h3>
        <p>Teachers explain topics with examples and classroom interaction.</p>
      </div>

      <div class="process-step">
        <span>02</span>
        <h3>Practice & Tests</h3>
        <p>Regular practice, homework and tests improve performance.</p>
      </div>

      <div class="process-step">
        <span>03</span>
        <h3>Feedback</h3>
        <p>Students receive guidance for improvement and confidence building.</p>
      </div>

      <div class="process-step">
        <span>04</span>
        <h3>Achievement</h3>
        <p>Continuous efforts help students achieve academic success.</p>
      </div>
    </div>

  </div>
</section>

<style>
/* =========================================================
   ADVANTAGES — PREMIUM GYAN JYOTI THEME
   Existing EJS data/content/routes preserved.
========================================================= */

.mis-container{
  width:min(1180px,90%);
  margin:0 auto;
}

.mis-hero{
  min-height:590px;
  position:relative;
  display:flex;
  align-items:center;
  overflow:hidden;
  background:
    radial-gradient(circle at 82% 22%,rgba(255,195,0,.18),transparent 27%),
    linear-gradient(125deg,#000b17 0%,#001f3f 58%,#075d98 100%);
}

.mis-hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(0,8,18,.88),rgba(0,31,63,.50)),
    url('/images/school-bg.jpg') center/cover no-repeat;
