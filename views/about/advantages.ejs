  border-color:rgba(255,195,0,.45);
  box-shadow:0 30px 70px rgba(0,31,63,.14);
}

.mis-card:hover::after{
  transform:scale(1.45);
}

.mis-icon{
  position:relative;
  z-index:2;
  width:68px;
  height:68px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:24px;
  border-radius:20px;
  background:linear-gradient(145deg,#001f3f,#075d98);
  color:#ffc300;
