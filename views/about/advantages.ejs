  margin-bottom:25px;
}

.mis-badge,
.section-tag{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:#ffc300;
  color:#001f3f;
  padding:10px 19px;
  border-radius:40px;
  font-size:10px;
  font-weight:950;
  letter-spacing:1.3px;
  text-transform:uppercase;
  box-shadow:0 10px 25px rgba(255,195,0,.18);
}

.mis-hero h1{
  margin:18px 0 12px;
  color:#fff;
  font-size:clamp(50px,7vw,82px);
  line-height:.98;
  letter-spacing:-3px;
  font-weight:950;
  text-shadow:0 18px 45px rgba(0,0,0,.35);
}

.mis-hero p,
.mis-hero a{
