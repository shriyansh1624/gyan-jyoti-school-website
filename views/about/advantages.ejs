  z-index:2;
  margin:0 0 5px;
  color:#001f3f;
  font-size:58px;
  line-height:1;
  font-weight:950;
}

.stat-box p{
  position:relative;
  z-index:2;
  margin:0;
  color:#687787;
  font-size:14px;
  line-height:1.5;
}

/* =========================================================
   PROCESS
========================================================= */

.process-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
}

.process-step{
  position:relative;
  overflow:hidden;
  min-height:235px;
  padding:30px 25px;
  border:1px solid #e3eaf0;
  border-radius:25px;
  background:#fff;
  box-shadow:0 15px 40px rgba(0,31,63,.07);
  transition:.4s;
}

.process-step::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  width:100%;
  height:3px;
  background:#ffc300;
}

.process-step:hover{
  transform:translateY(-9px);
  background:#001f3f;
  box-shadow:0 25px 55px rgba(0,31,63,.20);
}

.process-step span{
  display:flex;
  width:55px;
  height:55px;
  align-items:center;
  justify-content:center;
  margin-bottom:20px;
  border-radius:16px;
  background:#ffc300;
  color:#001f3f;
  font-size:17px;
  font-weight:950;
}

.process-step h3{
  margin:0 0 9px;
  color:#001f3f;
  font-size:20px;
  font-weight:950;
}

.process-step p{
  margin:0;
  color:#687787;
  font-size:13px;
  line-height:1.7;
}

.process-step:hover h3{
  color:#fff;
}

.process-step:hover p{
  color:rgba(255,255,255,.60);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px){
  .mis-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .process-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .highlight-wrapper{
    grid-template-columns:1fr;
  }

  .highlight-right{
    grid-template-columns:1fr 1fr;
    grid-template-rows:none;
  }
}

@media(max-width:700px){
  .mis-container{
    width:92%;
  }

  .mis-hero{
    min-height:520px;
  }

  .mis-overlay{
    padding:70px 0;
  }

  .mis-logo{
    width:90px;
    height:90px;
    border-radius:22px;
  }

  .mis-hero h1{
    font-size:47px;
    letter-spacing:-2px;
  }

  .mis-grid,
  .process-grid,
  .highlight-right{
    grid-template-columns:1fr;
  }

  .mis-intro-section,
  .mis-process-section,
  .mis-highlight-section{
    padding:75px 0;
  }

  .mis-heading{
    margin-bottom:40px;
  }

  .mis-heading h2{
    font-size:37px;
  }

  .highlight-left{
    padding:32px 25px;
  }

  .highlight-left h2{
    font-size:35px;
  }

  .stat-box{
    min-height:190px;
  }
}

@media(prefers-reduced-motion:reduce){
  .mis-hero::after{
    animation:none;
  }
}
</style>

<script>
(function(){
  const cards = document.querySelectorAll(
    '.mis-card,.stat-box,.process-step,.highlight-left'
  );

  if(!('IntersectionObserver' in window)){
    return;
  }

  const observer = new IntersectionObserver(
    function(entries, obs){
      entries.forEach(function(entry){
        if(!entry.isIntersecting){
          return;
        }

        entry.target.classList.add('mis-visible');
        obs.unobserve(entry.target);
      });
    },
    { threshold:.10 }
  );

  cards.forEach(function(card,index){
    card.style.opacity='0';
    card.style.transform='translateY(24px)';
    card.style.transition =
      'opacity .65s ease ' +
      ((index % 5) * .07) +
      's, transform .65s ease ' +
      ((index % 5) * .07) +
      's';

    observer.observe(card);
  });

  const style=document.createElement('style');
  style.textContent=`
    .mis-visible{
      opacity:1 !important;
      transform:translateY(0) !important;
    }
  `;
  document.head.appendChild(style);
})();
</script>

