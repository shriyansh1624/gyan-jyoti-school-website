/* =========================================================
   REDUCED MOTION
========================================================= */

@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{
        scroll-behavior:auto !important;
        animation-duration:.01ms !important;
        animation-iteration-count:1 !important;
        transition-duration:.01ms !important;
    }

}

</style>


<script>

document.addEventListener("DOMContentLoaded",function(){

    /* =====================================================
       SCROLL REVEAL
    ===================================================== */

    const revealItems = document.querySelectorAll(".reveal");

    const revealObserver = new IntersectionObserver(
        function(entries,observer){

            entries.forEach(function(entry){

                if(entry.isIntersecting){

                    entry.target.classList.add("revealed");
                    observer.unobserve(entry.target);

                }

            });

        },
        {
            threshold:.12,
            rootMargin:"0px 0px -40px 0px"
        }
    );

    revealItems.forEach(function(item){
        revealObserver.observe(item);
    });


    /* =====================================================
       LIGHTBOX GALLERY
    ===================================================== */

    const lightbox = document.getElementById("aboutLightbox");
    const lightboxImage = document.getElementById("lightboxImage");
    const lightboxClose = document.getElementById("lightboxClose");
    const lightboxPrev = document.getElementById("lightboxPrev");
    const lightboxNext = document.getElementById("lightboxNext");
    const lightboxTitle = document.getElementById("lightboxTitle");
    const lightboxCategory = document.getElementById("lightboxCategory");

    const galleryImages = Array.from(
        document.querySelectorAll(
            ".memory-card img, .event-card img, .member-photo img"
        )
    );

    let currentImage = 0;


    function getGalleryTitle(img){

        const card = img.closest(".memory-card, .event-card, .member-card");

        if(!card){
            return "Gallery Preview";
        }

        const heading = card.querySelector("h3");

        if(heading){
            return heading.textContent.trim();
        }

        return img.alt || "Gallery Preview";
    }


    function getGalleryCategory(img){

        const card = img.closest(".memory-card, .event-card, .member-card");

        if(!card){
            return "Gyan Jyoti School";
        }

        const role = card.querySelector(".member-role");

        if(role){
            return role.textContent.trim();
        }

        const label = card.querySelector(
            ".memory-overlay span, .event-caption span"
        );

        if(label){
            return label.textContent.trim();
        }

        return "Gyan Jyoti School";
    }


    function openLightbox(index){

        if(!galleryImages.length){
            return;
        }

        currentImage =
            (index + galleryImages.length) %
            galleryImages.length;

        const img = galleryImages[currentImage];

        lightboxImage.src = img.currentSrc || img.src;
        lightboxImage.alt = img.alt || "Gallery Preview";

        lightboxTitle.textContent = getGalleryTitle(img);
        lightboxCategory.textContent = getGalleryCategory(img);

        lightbox.classList.add("show");
        document.body.style.overflow = "hidden";

    }


    function closeLightbox(){

        lightbox.classList.remove("show");
        document.body.style.overflow = "";

    }


    function nextImage(){

        openLightbox(currentImage + 1);

    }


    function previousImage(){

        openLightbox(currentImage - 1);

    }


    galleryImages.forEach(function(img,index){

        const clickableCard =
            img.closest(".memory-card, .event-card, .member-card");

        if(clickableCard){

            clickableCard.addEventListener("click",function(e){

                if(e.target.closest("a")){
                    return;
                }

                openLightbox(index);

            });

        }

    });


    lightboxClose.addEventListener("click",closeLightbox);
    lightboxNext.addEventListener("click",nextImage);
    lightboxPrev.addEventListener("click",previousImage);


    lightbox.addEventListener("click",function(e){

        if(
            e.target === lightbox ||
            e.target.classList.contains("lightbox-backdrop")
        ){

            closeLightbox();

        }

    });


    document.addEventListener("keydown",function(e){

        if(!lightbox.classList.contains("show")){
            return;
        }

        if(e.key === "Escape"){
            closeLightbox();
        }

        if(e.key === "ArrowRight"){
            nextImage();
        }

        if(e.key === "ArrowLeft"){
            previousImage();
        }

    });


    /* =====================================================
       IMAGE ERROR HANDLING
    ===================================================== */

    document.querySelectorAll(
        ".memory-card img, .event-card img, .member-photo img"
    ).forEach(function(img){

        img.addEventListener("error",function(){

            this.style.opacity = "0";

            const parent = this.closest(
                ".memory-card, .event-card, .member-photo"
            );

            if(parent){
                parent.classList.add("image-missing");
            }

        });

    });


    /* =====================================================
       SUBTLE PARALLAX ON HERO
    ===================================================== */

    const hero = document.querySelector(".about-hero");
    const heroBg = document.querySelector(".hero-bg");

    if(hero && heroBg && !window.matchMedia("(prefers-reduced-motion: reduce)").matches){

        hero.addEventListener("mousemove",function(e){

            const rect = hero.getBoundingClientRect();

            const x =
                ((e.clientX - rect.left) / rect.width - .5) * 8;

            const y =
                ((e.clientY - rect.top) / rect.height - .5) * 5;

            heroBg.style.transform =
                `scale(1.12) translate(${x}px,${y}px)`;

        });

        hero.addEventListener("mouseleave",function(){

            heroBg.style.transform = "scale(1.12)";

        });

    }


    /* =====================================================
       PREVENT BROKEN LIGHTBOX IMAGE
    ===================================================== */

    lightboxImage.addEventListener("error",function(){

        lightboxTitle.textContent = "Image unavailable";

    });

});
/* =====================================================
   PREMIUM COUNTING ANIMATION
===================================================== */

const counterItems = document.querySelectorAll(
    '.legacy-card strong[data-count]'
);

const counterObserver = new IntersectionObserver(
    function(entries, observer) {

        entries.forEach(function(entry) {

            if (!entry.isIntersecting) return;

            const element = entry.target;

            const target = parseInt(
                element.getAttribute('data-count'),
                10
            );

            const duration = 1800;
            const startTime = performance.now();

            function updateCounter(currentTime) {

                const progress = Math.min(
                    (currentTime - startTime) / duration,
                    1
                );

                // Smooth ease-out
                const eased =
                    1 - Math.pow(1 - progress, 4);

                const currentValue =
                    Math.floor(target * eased);

                element.innerHTML = currentValue;

                if (progress < 1) {

                    requestAnimationFrame(updateCounter);

                } else {

                    element.innerHTML = target;

                }

            }

            requestAnimationFrame(updateCounter);

            observer.unobserve(element);

        });

    },
    {
        threshold: 0.6
    }
);


counterItems.forEach(function(counter) {

    counterObserver.observe(counter);

});

</script>


