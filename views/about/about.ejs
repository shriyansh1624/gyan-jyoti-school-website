    top:14px;
    left:14px;
    width:37px;
    height:37px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(255,255,255,.22);
    border-radius:50%;
    color:var(--gold);
    background:rgba(0,33,71,.85);
    backdrop-filter:blur(12px);
    font-size:10px;
    font-weight:900;
}

.member-photo{
    position:relative;
    height:285px;
    overflow:hidden;
    background:#e9eef4;
}

.member-photo img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    transition:1s cubic-bezier(.2,.8,.2,1);
}

.member-photo-shade{
    position:absolute;
    inset:0;
    background:linear-gradient(
        to top,
        rgba(0,33,71,.58),
        transparent 50%
    );
    opacity:.4;
    transition:.4s;
}

.member-card:hover .member-photo img{
    transform:scale(1.07);
}

.member-card:hover .member-photo-shade{
    opacity:.75;
}

.member-expand{
    position:absolute;
    right:15px;
    top:15px;
    z-index:7;
    width:40px;
    height:40px;
    display:flex;
    align-items:center;
    justify-content:center;
    border:1px solid rgba(255,255,255,.28);
    border-radius:50%;
    color:#fff;
    background:rgba(0,33,71,.60);
    backdrop-filter:blur(10px);
    cursor:pointer;
    opacity:0;
    transform:scale(.8);
    transition:.35s;
}

.member-card:hover .member-expand{
    opacity:1;
    transform:scale(1);
}

.member-info{
    padding:23px 20px 25px;
    text-align:center;
}

.member-role{
    display:inline-flex;
    align-items:center;
    gap:7px;
    color:var(--gold-dark);
    font-size:10px;
    font-weight:900;
    letter-spacing:1.3px;
    text-transform:uppercase;
}

.member-role i{
    font-size:11px;
}

.member-info h3{
    min-height:48px;
    margin:11px 0 9px;
    color:var(--navy);
    font-size:16px;
    line-height:1.45;
}

.member-line{
    width:35px;
    height:3px;
    margin:12px auto;
    border-radius:20px;
    background:linear-gradient(90deg,var(--gold),var(--gold-dark));
}

.member-info p{
    margin:0;
    color:#98a3b1;
    font-size:10px;
}


/* =========================================================
   LIGHTBOX
========================================================= */

.about-lightbox{
    position:fixed;
    inset:0;
    z-index:999999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:35px;
    opacity:0;
    visibility:hidden;
    background:rgba(0,10,25,.92);
    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);
    transition:.35s ease;
}

.about-lightbox.show{
    opacity:1;
    visibility:visible;
}

.lightbox-backdrop{
    position:absolute;
    inset:0;
}

.lightbox-content{
    position:relative;
    z-index:3;
    max-width:min(1100px,90vw);
    max-height:88vh;
    text-align:center;
    transform:scale(.94) translateY(15px);
    transition:.4s cubic-bezier(.2,.8,.2,1);
}

.about-lightbox.show .lightbox-content{
    transform:scale(1) translateY(0);
}

.lightbox-content img{
    max-width:100%;
    max-height:78vh;
    display:block;
    margin:auto;
    border:1px solid rgba(255,255,255,.12);
    border-radius:20px;
    box-shadow:0 35px 100px rgba(0,0,0,.55);
}

.lightbox-caption{
    display:flex;
    flex-direction:column;
    gap:5px;
    margin-top:15px;
    color:#fff;
}

.lightbox-caption span{
    color:var(--gold);
    font-size:10px;
    letter-spacing:2px;
    font-weight:900;
}

.lightbox-caption strong{
    font-size:15px;
}

.lightbox-close,
.lightbox-nav{
    position:absolute;
    z-index:10;
    border:1px solid rgba(255,255,255,.16);
    color:#fff;
    background:rgba(255,255,255,.10);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    cursor:pointer;
    transition:.3s;
}

.lightbox-close{
    top:25px;
    right:25px;
    width:52px;
    height:52px;
    border-radius:50%;
    font-size:19px;
}

.lightbox-close:hover{
    background:var(--gold);
    color:var(--navy);
    transform:rotate(90deg);
}

.lightbox-nav{
    top:50%;
    width:54px;
    height:54px;
    border-radius:50%;
    transform:translateY(-50%);
}

.lightbox-prev{
    left:28px;
}

.lightbox-next{
    right:28px;
}

.lightbox-nav:hover{
    background:var(--gold);
    color:var(--navy);
    transform:translateY(-50%) scale(1.08);
}


/* =========================================================
   REVEAL ANIMATION
========================================================= */

.reveal{
    opacity:0;
    transform:translateY(35px);
    transition:
        opacity .8s ease,
        transform .8s cubic-bezier(.2,.8,.2,1);
}

.reveal.revealed{
    opacity:1;
    transform:translateY(0);
}

.member-card.reveal.revealed{
    transition-delay:var(--delay);
}


