<%- include('../partials/header') %>

<!-- =========================================================
     ABOUT PAGE
========================================================= -->

<main class="about-page">

    <!-- ========================= HERO ========================= -->
    <section class="about-hero">

        <div class="hero-bg"></div>
        <div class="hero-shade"></div>

        <div class="about-container hero-inner">

            <div class="hero-copy">

                <span class="hero-kicker">
                    <i class="fas fa-school"></i>
                    ESTABLISHED 1973
                </span>

                <h1>
                    A Legacy of
                    <span>Education &amp; Values</span>
                </h1>

                <p>
                    Discover the journey, people and memories behind
                    Gyan Jyoti School.
                </p>

                <div class="hero-breadcrumb">
                    <a href="/">Home</a>
                    <i class="fas fa-chevron-right"></i>
                    <span>About Us</span>
                </div>

            </div>

            <div class="hero-scroll">
                <span>Scroll to explore</span>
                <i class="fas fa-arrow-down"></i>
            </div>

            <div class="hero-orb orb-one"></div>
            <div class="hero-orb orb-two"></div>

        </div>

    </section>


    <!-- ========================= INTRO ========================= -->
    <section class="about-intro">

        <div class="about-container">

            <div class="intro-grid">

                <div class="intro-visual reveal">

                    <div class="image-frame">

                        <div class="image-glow"></div>

                        <img
                            src="<%= about && about.image ? about.image : '/images/school-bg.jpg' %>"
                            alt="Gyan Jyoti School">

                        <div class="image-badge">
                            <i class="fas fa-award"></i>
                            <span>50+ Years</span>
                        </div>

                    </div>

                    <div class="experience-card">
                        <span class="mini-label">OUR LEGACY</span>
                        <strong>50<span>+</span></strong>
                        <p>Years of Educational Legacy</p>
                    </div>

                </div>


                <div class="intro-content reveal">

                    <span class="section-label">
                        <i class="fas fa-book-open"></i>
                        OUR STORY
                    </span>

                    <h2>
                        Building Futures
                        <span>Since 1973</span>
                    </h2>

                    <div class="gold-line"></div>

                    <p class="intro-lead">
                        <%= about && about.content
                            ? about.content
                            : 'Gyan Jyoti School was established in 1973 by Nainpur Vikas Samiti with a vision to provide quality education and create responsible citizens.' %>
                    </p>

                    <p>
                        The institution continues to provide an environment
                        where students develop academically, socially and
                        personally while growing with confidence,
                        discipline and strong values.
                    </p>

                    <div class="intro-highlights">

                        <div class="highlight-item">
                            <span class="highlight-icon">
                                <i class="fas fa-award"></i>
                            </span>
                            <span>Academic<br>Excellence</span>
                        </div>

                        <div class="highlight-item">
                            <span class="highlight-icon">
                                <i class="fas fa-heart"></i>
                            </span>
                            <span>Values &amp;<br>Discipline</span>
                        </div>

                        <div class="highlight-item">
                            <span class="highlight-icon">
                                <i class="fas fa-users"></i>
                            </span>
                            <span>Student<br>Development</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ========================= LEGACY ========================= -->
    <section class="legacy-section">

        <div class="about-container">

            <div class="legacy-grid">

                <div class="legacy-card reveal">
                    <div class="legacy-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <strong data-count="1973">1973</strong>
                    <span>Established</span>
                </div>

                <div class="legacy-card reveal">
                    <div class="legacy-icon">
                        <i class="fas fa-history"></i>
                    </div>
                   <strong data-count="50">
                     0<span>+</span>
                    </strong>
                    <span>Years of Legacy</span>
                </div>

                <div class="legacy-card reveal">
                    <div class="legacy-icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <strong>Generations</strong>
                    <span>Of Learners</span>
                </div>

                <div class="legacy-card reveal">
                    <div class="legacy-icon">
                        <i class="fas fa-school"></i>
                    </div>
                    <strong>Gyan Jyoti</strong>
                    <span>School Community</span>
                </div>

            </div>

        </div>

    </section>


    <!-- ========================= VALUES ========================= -->
    <section class="values-section">

        <div class="about-container">

            <div class="section-heading reveal">

                <span class="section-label">
                    OUR FOUNDATION
                </span>

                <h2>
                    Education Beyond
                    <span>Classrooms</span>
                </h2>

                <p>
                    We believe education is not only about academics.
                    It is about developing confident, responsible and
                    compassionate individuals.
                </p>

            </div>


            <div class="values-grid">

                <article class="value-card reveal">

                    <span class="value-number">01</span>

                    <div class="value-icon">
                      <i class="fas fa-graduation-cap"></i>
                    </div>

                    <div class="value-content">
                        <h3>Quality Education</h3>
                        <p>
                            Creating a strong academic foundation
                            and encouraging students to learn,
                            question and grow.
                        </p>
                    </div>

                    <span class="card-arrow">
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </span>

                </article>


                <article class="value-card reveal">

                    <span class="value-number">02</span>

                    <div class="value-icon">
                       <i class="fas fa-heart"></i>
                    </div>

                    <div class="value-content">
                        <h3>Strong Values</h3>
                        <p>
                            Discipline, respect, responsibility
                            and integrity remain an important
                            part of student life.
                        </p>
                    </div>

                    <span class="card-arrow">
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </span>

                </article>


                <article class="value-card reveal">

                    <span class="value-number">03</span>

                    <div class="value-icon">
                     <i class="fas fa-lightbulb"></i>
                    </div>

                    <div class="value-content">
                        <h3>Creativity</h3>
                        <p>
                            Students are encouraged to explore
                            ideas, participate in activities and
                            express themselves.
                        </p>
                    </div>

                    <span class="card-arrow">
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </span>

                </article>


                <article class="value-card reveal">

                    <span class="value-number">04</span>

                    <div class="value-icon">
                       <i class="fas fa-users"></i>
                    </div>

                    <div class="value-content">
                        <h3>Community</h3>
                        <p>
                            A school community where teachers,
                            students, parents and management
                            grow together.
                        </p>
                    </div>

                    <span class="card-arrow">
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </span>

                </article>

            </div>

        </div>

    </section>


    <!-- ========================= OLD MEMORIES ========================= -->
    <section class="memories-section">

        <div class="about-container">

            <div class="split-heading reveal">

                <div>
                    <span class="section-label">
                        <i class="fas fa-camera-retro"></i>
                        FROM THE ARCHIVES
                    </span>

                    <h2>
                        Old School
                        <span>Memories</span>
                    </h2>
                </div>

                <p>
                    A glimpse into the memories, moments and
                    milestones that have been part of the
                    school's journey.
                </p>

            </div>


            <div class="memory-gallery">

                <div class="memory-card memory-large reveal">
                    <img
                        src="/images/about/old/old1.jpg"
                        alt="Gyan Jyoti School old memory"
                        loading="lazy">
                    <div class="memory-overlay">
                        <div>
                            <span>School Archives</span>
                            <h3>Through The Years</h3>
                        </div>
                        <button type="button" class="gallery-open" aria-label="Open image">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>


                <div class="memory-card reveal">
                    <img
                        src="/images/about/old/old2.jpg"
                        alt="Old school memory"
                        loading="lazy">
                    <div class="memory-overlay">
                        <div>
                            <span>MEMORIES</span>
                            <h3>Our Journey</h3>
                        </div>
                        <button type="button" class="gallery-open" aria-label="Open image">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>


                <div class="memory-card reveal">
                    <img
                        src="/images/about/old/old3.jpg"
                        alt="Old school memory"
                        loading="lazy">
                    <div class="memory-overlay">
                        <div>
                            <span>MEMORIES</span>
                            <h3>School Life</h3>
                        </div>
                        <button type="button" class="gallery-open" aria-label="Open image">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>


                <div class="memory-card reveal">
                    <img
                        src="/images/about/old/old4.jpg"
                        alt="Old school memory"
                        loading="lazy">
                    <div class="memory-overlay">
                        <div>
                            <span>ARCHIVES</span>
                            <h3>Special Moments</h3>
                        </div>
                        <button type="button" class="gallery-open" aria-label="Open image">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>


                <div class="memory-card memory-large reveal">
                    <img
                        src="/images/about/old/old5.jpg"
                        alt="Old school memory"
                        loading="lazy">
                    <div class="memory-overlay">
                        <div>
                            <span>THROUGH THE YEARS</span>
                            <h3>Growing Together</h3>
                        </div>
                        <button type="button" class="gallery-open" aria-label="Open image">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </section>


    <!-- ========================= EVENTS ========================= -->
    <section class="events-section">

        <div class="events-background"></div>

        <div class="about-container events-inner">

            <div class="section-heading section-heading-light reveal">

                <span class="section-label">
                    <i class="fas fa-images"></i>
                    SCHOOL LIFE
                </span>

                <h2>
                    Moments That
                    <span>Bring Us Together</span>
                </h2>

                <p>
                    From celebrations and cultural programmes
                    to academic and co-curricular activities,
                    every event creates a memory.
                </p>

            </div>


            <div class="event-gallery">

                <article class="event-card event-wide reveal">
                    <img
                        src="/images/about/events/event1.jpg"
                        alt="School event"
                        loading="lazy">

                    <div class="event-caption">
                        <span>SCHOOL EVENTS</span>
                        <h3>Celebrations &amp; Activities</h3>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </article>


                <article class="event-card reveal">
                    <img
                        src="/images/about/events/event2.jpg"
                        alt="School activity"
                        loading="lazy">

                    <div class="event-caption">
                        <span>STUDENT LIFE</span>
                        <h3>Learning Together</h3>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </article>


                <article class="event-card reveal">
                    <img
                        src="/images/about/events/event3.jpg"
                        alt="School programme"
                        loading="lazy">

                    <div class="event-caption">
                        <span>PROGRAMMES</span>
                        <h3>Creating Memories</h3>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </article>


                <article class="event-card reveal">
                    <img
                        src="/images/about/events/event4.jpg"
                        alt="School celebration"
                        loading="lazy">

                    <div class="event-caption">
                        <span>CAMPUS LIFE</span>
                        <h3>Beyond The Classroom</h3>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </article>

            </div>

        </div>

    </section>


    <!-- ========================= MANAGEMENT ========================= -->
    <section class="management-section">

        <div class="about-container">

            <div class="management-heading reveal">

                <span class="section-label">
                    <i class="fas fa-building-columns"></i>
                    NAINPUR VIKAS SAMITI
                </span>

                <h2>
                    Management
                    <span>Committee</span>
                </h2>

                <div class="committee-year">
                    2024 — 2027
                </div>

                <p>
                    The Management Committee of Nainpur Vikas Samiti
                    provides guidance and leadership to the institution
                    with a commitment towards education and student
                    development.
                </p>

            </div>


            <div class="committee-line reveal">
                <span></span>
                <i class="fas fa-star"></i>
                <span></span>
            </div>


            <%
                const members = [

                    {
                        name:'Shri Benishyam Khandelwal',
                        designation:'President',
                        image:'/images/members/member1.jpg'
                    },

                    {
                        name:'Shri Satyanarayan Khandelwal',
                        designation:'Vice-President',
                        image:'/images/members/member2.jpg'
                    },

                    {
                        name:'Shri Rameshchandra Agrawal',
                        designation:'Treasurer',
                        image:'/images/members/member3.jpg'
                    },

                    {
                        name:'Shri Jeevanlal Sahu',
                        designation:'Secretary',
                        image:'/images/members/member4.jpg'
                    },

                    {
                        name:'Dr. Rajendra Pathak',
                        designation:'Joint Secretary',
                        image:'/images/members/member5.jpg'
                    },

                    {
                        name:'Shri Mansur Ali Hayjani',
                        designation:'Member',
                        image:'/images/members/member6.jpg'
                    },

                    {
                        name:'Dr. Pradeep Sihare',
                        designation:'Member',
                        image:'/images/members/member7.jpg'
                    },

                    {
                        name:'Shri Praveen Naidu',
                        designation:'Principal',
                        image:'/images/members/member8.jpg'
                    },

                    {
                        name:'Shri Pinchal Khandelwal',
                        designation:'Member',
                        image:'/images/members/member9.jpg'
                    },

                    {
                        name:'Shri Satyam Khandelwal',
                        designation:'Member',
                        image:'/images/members/member10.jpg'
                    },

                    {
                        name:'Shri Ayush Agrawal',
                        designation:'Member',
                        image:'/images/members/member11.jpg'
                    },

                    {
                        name:'Shri Jitendra Sahu',
                        designation:'Member',
                        image:'/images/members/member12.jpg'
                    },

                    {
                        name:'Dr. Ms. Hestu Pathak',
                        designation:'Member',
                        image:'/images/members/member13.jpg'
                    },

                    {
                        name:'Shri Vivek Sharma',
                        designation:'Member',
                        image:'/images/members/member14.jpg'
                    },

                    {
                        name:'Shri Mahendra Soni',
                        designation:'Member',
                        image:'/images/members/member15.jpg'
                    },

                    {
                        name:'Ms. Afreen Haziyani',
                        designation:'Member',
                        image:'/images/members/member16.jpg'
                    },

                    {
                        name:'Mrs. Devanshi Sihare Panchal',
                        designation:'Member',
                        image:'/images/members/member17.jpg'
                    }

                ];
            %>


            <div class="members-grid">

                <% members.forEach(function(member,index){ %>

                    <article
                        class="member-card reveal"
                        style="--delay:<%= index * .04 %>s;">

                        <span class="member-number">
                            <%= String(index + 1).padStart(2,'0') %>
                        </span>

                        <div class="member-photo">

                            <img
                                src="<%= member.image %>"
                                alt="<%= member.name %>"
                                loading="lazy">

                            <div class="member-photo-shade"></div>

                            <button
                                type="button"
                                class="member-expand"
                                aria-label="View <%= member.name %>">
                                <i class="fas fa-expand"></i>
                            </button>

                        </div>


                        <div class="member-info">

                            <span class="member-role">

                                <% if(member.designation === 'President'){ %>
                                    <i class="fas fa-crown"></i>
                                <% } else if(member.designation === 'Vice-President'){ %>
                                    <i class="fas fa-user-tie"></i>
                                <% } else if(member.designation === 'Secretary'){ %>
                                    <i class="fas fa-pen-nib"></i>
                                <% } else if(member.designation === 'Treasurer'){ %>
                                    <i class="fas fa-coins"></i>
                                <% } else if(member.designation === 'Principal'){ %>
                                    <i class="fas fa-school"></i>
                                <% } else { %>
                                    <i class="fas fa-user"></i>
                                <% } %>

                                <%= member.designation %>

                            </span>

                            <h3>
                                <%= member.name %>
                            </h3>

                            <div class="member-line"></div>

                            <p>
                                Nainpur Vikas Samiti
                            </p>

                        </div>

                    </article>

                <% }) %>

            </div>

        </div>

    </section>


    <!-- ========================= LIGHTBOX ========================= -->
    <div id="aboutLightbox" class="about-lightbox">

        <div class="lightbox-backdrop"></div>

        <button
            id="lightboxClose"
            class="lightbox-close"
            type="button"
            aria-label="Close image">

            <i class="fas fa-times"></i>

        </button>

        <button
            id="lightboxPrev"
            class="lightbox-nav lightbox-prev"
            type="button"
            aria-label="Previous image">

            <i class="fas fa-chevron-left"></i>

        </button>

        <div class="lightbox-content">

            <img
                id="lightboxImage"
                src=""
                alt="Gallery Preview">

            <div class="lightbox-caption">
                <span id="lightboxCategory">Gyan Jyoti School</span>
                <strong id="lightboxTitle">Gallery Preview</strong>
            </div>

        </div>

        <button
            id="lightboxNext"
            class="lightbox-nav lightbox-next"
            type="button"
            aria-label="Next image">

            <i class="fas fa-chevron-right"></i>

        </button>

    </div>

</main>


<style>

/* =========================================================
   ABOUT PAGE — PREMIUM DESIGN SYSTEM
========================================================= */

.about-page{
    --navy:#002147;
    --navy-2:#061d38;
    --navy-3:#0b3158;
    --gold:#ffc107;
    --gold-dark:#b78600;
    --cream:#fffaf0;
    --text:#17263a;
    --muted:#718096;
    --line:#e6ebf2;
    --white:#fff;
    overflow:hidden;
    background:#fff;
}

.about-page *,
.about-page *::before,
.about-page *::after{
    box-sizing:border-box;
}

.about-container{
    width:min(1180px,92%);
    margin:0 auto;
}

.about-page button{
    font:inherit;
}


/* =========================================================
   HERO
========================================================= */

/* =========================================================
   PREMIUM ABOUT HERO
========================================================= */

.about-hero {
    min-height: 680px;
    position: relative;
    display: flex;
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: #001a36;
}


/* =========================================================
   BACKGROUND IMAGE
========================================================= */

.hero-bg {
    position: absolute;
    inset: -25px;
    z-index: -3;

    background:
        url('/images/school-bg.jpg')
        center center / cover no-repeat;

    transform: scale(1.04);

    animation:
        heroZoom 16s cubic-bezier(.2,.7,.2,1) forwards;

    will-change: transform;
}


/* =========================================================
   PREMIUM IMAGE SHADING
========================================================= */

.hero-shade {
    position: absolute;
    inset: 0;
    z-index: -2;

    background:

        /* LEFT TEXT PROTECTION */
        linear-gradient(
            90deg,
            rgba(0, 15, 35, .78) 0%,
            rgba(0, 20, 45, .58) 32%,
            rgba(0, 20, 45, .24) 62%,
            rgba(0, 15, 35, .08) 100%
        ),

        /* BOTTOM CINEMATIC FADE */
        linear-gradient(
            to top,
            rgba(0, 7, 20, .72) 0%,
            rgba(0, 7, 20, .25) 35%,
            rgba(0, 7, 20, 0) 70%
        ),

        /* TOP PROTECTION */
        linear-gradient(
            to bottom,
            rgba(0, 12, 28, .42),
            transparent 35%
        );

    pointer-events: none;
}


/* =========================================================
   HERO INNER
========================================================= */

.hero-inner {
    position: relative;

    min-height: 680px;

    display: flex;
    align-items: center;

    width: 100%;
}


/* =========================================================
   HERO CONTENT
========================================================= */

.hero-copy {
    max-width: 820px;

    padding:
        90px
        0
        100px;

    position: relative;
    z-index: 10;

    animation:
        heroContentReveal 1.1s
        cubic-bezier(.16,1,.3,1)
        both;
}


/* =========================================================
   KICKER
========================================================= */

.hero-kicker {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    padding: 11px 20px;

    border: 1px solid
        rgba(255,193,7,.55);

    border-radius: 999px;

    color: #ffc107;

    background:
        rgba(255,193,7,.10);

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 2px;

    box-shadow:
        0 10px 35px rgba(0,0,0,.20),
        inset 0 0 20px
        rgba(255,193,7,.04);

    transition:
        transform .35s ease,
        background .35s ease,
        box-shadow .35s ease;
}

.hero-kicker:hover {
    transform: translateY(-3px);

    background:
        rgba(255,193,7,.16);

    box-shadow:
        0 15px 40px rgba(0,0,0,.25),
        0 0 25px rgba(255,193,7,.12);
}

.hero-kicker i {
    font-size: 15px;
}


/* =========================================================
   MAIN HEADING
========================================================= */

.about-hero h1 {

    margin:
        30px
        0
        24px;

    max-width: 850px;

    font-size:
        clamp(
            52px,
            6.7vw,
            88px
        );

    line-height: .98;

    letter-spacing:
        -3.8px;

    font-weight: 950;

    color: #ffffff;

    text-shadow:
        0 5px 20px rgba(0,0,0,.45),
        0 15px 45px rgba(0,0,0,.35);

    position: relative;
}


/* FIRST LINE */

.about-hero h1 {
    animation:
        headingReveal 1.1s
        .15s
        cubic-bezier(.16,1,.3,1)
        both;
}


/* GOLD SECOND LINE */

.about-hero h1 span {

    display: block;

    margin-top: 8px;

    color: #ffc107;

    text-shadow:
        0 4px 18px rgba(0,0,0,.35),
        0 10px 35px rgba(255,193,7,.10);

    position: relative;
}


/* SUBTLE GOLD LINE */

.about-hero h1 span::after {

    content: "";

    position: absolute;

    left: 3px;

    bottom: -12px;

    width: 105px;

    height: 4px;

    border-radius: 10px;

    background:
        linear-gradient(
            90deg,
            #ffc107,
            rgba(255,193,7,0)
        );

    opacity: .85;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.about-hero p {

    max-width: 650px;

    margin: 0;

    color:
        rgba(255,255,255,.90);

    font-size: 19px;

    line-height: 1.8;

    font-weight: 400;

    text-shadow:
        0 3px 14px rgba(0,0,0,.65);

    animation:
        paragraphReveal 1s
        .35s
        cubic-bezier(.16,1,.3,1)
        both;
}


/* =========================================================
   BREADCRUMB
========================================================= */

.hero-breadcrumb {

    display: flex;

    align-items: center;

    gap: 13px;

    margin-top: 32px;

    color:
        rgba(255,255,255,.68);

    font-size: 14px;

    animation:
        paragraphReveal 1s
        .5s
        cubic-bezier(.16,1,.3,1)
        both;
}

.hero-breadcrumb a {

    color: #ffc107;

    text-decoration: none;

    font-weight: 800;

    transition: .3s ease;
}

.hero-breadcrumb a:hover {

    color: #fff;

    text-shadow:
        0 0 15px
        rgba(255,193,7,.55);
}

.hero-breadcrumb i {

    font-size: 10px;

    color:
        rgba(255,255,255,.45);
}


/* =========================================================
   SCROLL INDICATOR
========================================================= */

.hero-scroll {

    position: absolute;

    right: 0;

    bottom: 38px;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 12px;

    color:
        rgba(255,255,255,.68);

    font-size: 10px;

    letter-spacing: 2.5px;

    text-transform: uppercase;

    z-index: 20;

    animation:
        scrollFade 1.2s
        .8s
        both;
}

.hero-scroll span {

    writing-mode:
        horizontal-tb;

    opacity: .85;
}

.hero-scroll i {

    color: #ffc107;

    font-size: 14px;

    animation:
        scrollDown
        1.6s
        ease-in-out
        infinite;

    filter:
        drop-shadow(
            0 0 8px
            rgba(255,193,7,.55)
        );
}


/* =========================================================
   FLOATING ORBS
========================================================= */

.hero-orb {

    position: absolute;

    border-radius: 50%;

    pointer-events: none;

    z-index: 1;

    filter: blur(2px);

    opacity: .35;

    mix-blend-mode: screen;
}


/* GOLD ORB */

.orb-one {

    width: 380px;

    height: 380px;

    right: -100px;

    top: 30px;

    background:
        radial-gradient(
            circle,
            rgba(255,193,7,.30) 0%,
            rgba(255,193,7,.10) 35%,
            transparent 70%
        );

    animation:
        orbFloat 7s
        ease-in-out
        infinite;
}


/* WHITE/BLUE ORB */

.orb-two {

    width: 300px;

    height: 300px;

    left: 46%;

    bottom: -170px;

    background:
        radial-gradient(
            circle,
            rgba(120,180,255,.18),
            transparent 70%
        );

    animation:
        orbFloatReverse 9s
        ease-in-out
        infinite;
}


/* =========================================================
   SUBTLE LIGHT BEAM
========================================================= */

.about-hero::after {

    content: "";

    position: absolute;

    width: 520px;

    height: 520px;

    right: 8%;

    top: 5%;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(255,193,7,.08),
            transparent 68%
        );

    filter: blur(30px);

    pointer-events: none;

    z-index: -1;

    animation:
        ambientGlow
        6s
        ease-in-out
        infinite;
}


/* =========================================================
   ANIMATIONS
========================================================= */

@keyframes heroZoom {

    from {
        transform:
            scale(1.04);
    }

    to {
        transform:
            scale(1.12);
    }
}


@keyframes heroContentReveal {

    from {
        opacity: 0;

        transform:
            translateY(45px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}


@keyframes headingReveal {

    from {
        opacity: 0;

        transform:
            translateY(35px)
            scale(.97);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}


@keyframes paragraphReveal {

    from {
        opacity: 0;

        transform:
            translateY(20px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}


@keyframes scrollFade {

    from {
        opacity: 0;

        transform:
            translateY(15px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}


@keyframes scrollDown {

    0%, 100% {
        transform:
            translateY(0);
    }

    50% {
        transform:
            translateY(8px);
    }
}


@keyframes orbFloat {

    0%, 100% {
        transform:
            translate(0,0)
            scale(1);
    }

    50% {
        transform:
            translate(-20px,25px)
            scale(1.08);
    }
}


@keyframes orbFloatReverse {

    0%, 100% {
        transform:
            translate(0,0)
            scale(1);
    }

    50% {
        transform:
            translate(25px,-20px)
            scale(1.08);
    }
}


@keyframes ambientGlow {

    0%, 100% {
        opacity: .45;

        transform:
            scale(1);
    }

    50% {
        opacity: .8;

        transform:
            scale(1.15);
    }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 992px) {

    .about-hero {
        min-height: 620px;
    }

    .hero-inner {
        min-height: 620px;
    }

    .hero-copy {
        padding:
            90px
            0
            90px;
    }

    .about-hero h1 {
        font-size:
            clamp(48px, 8vw, 72px);

        letter-spacing: -3px;
    }

    .hero-scroll {
        right: 20px;
    }
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

    .about-hero {

        min-height: 620px;

        align-items: flex-end;
    }

    .hero-inner {

        min-height: 620px;

        align-items: flex-end;
    }

    .hero-copy {

        width: 100%;

        padding:
            80px
            0
            95px;
    }

    .about-hero h1 {

        margin:
            24px
            0
            22px;

        font-size:
            clamp(42px, 11vw, 62px);

        letter-spacing:
            -2.5px;
    }

    .about-hero h1 span {
        margin-top: 6px;
    }

    .about-hero p {

        font-size: 17px;

        line-height: 1.7;

        max-width: 580px;
    }

    .hero-breadcrumb {

        margin-top: 24px;
    }

    .hero-scroll {

        right: 18px;

        bottom: 24px;

        font-size: 8px;
    }

    .hero-kicker {

        padding:
            9px
            16px;

        font-size: 10px;

        letter-spacing:
            1.5px;
    }

    .orb-one {

        width: 250px;

        height: 250px;

        right: -120px;

        top: 60px;
    }
}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 480px) {

    .about-hero {

        min-height: 590px;
    }

    .hero-inner {

        min-height: 590px;
    }

    .hero-copy {

        padding:
            70px
            0
            90px;
    }

    .about-hero h1 {

        font-size: 40px;

        line-height: 1.02;

        letter-spacing:
            -1.8px;
    }

    .about-hero p {

        font-size: 15px;

        line-height: 1.65;
    }

    .hero-breadcrumb {

        font-size: 12px;
    }

    .hero-scroll {

        display: none;
    }
}


/* =========================================================
   REDUCE MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    .hero-bg,
    .hero-copy,
    .about-hero h1,
    .about-hero p,
    .hero-breadcrumb,
    .hero-scroll,
    .orb-one,
    .orb-two,
    .about-hero::after {

        animation: none !important;
    }
}

