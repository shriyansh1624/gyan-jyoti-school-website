</style>


<script>

/* =========================================================
   PREMIUM REVEAL ANIMATION
========================================================= */

(function () {

    const items =
        document.querySelectorAll(
            '.dpx-team-card, .dpx-step, .dpx-value-card, .dpx-process-copy'
        );


    if (
        !('IntersectionObserver' in window) ||
        !items.length
    ) {

        return;

    }


    const observer =
        new IntersectionObserver(
            function (entries, obs) {

                entries.forEach(
                    function (entry) {

                        if (!entry.isIntersecting) {

                            return;

                        }


                        entry.target.classList.add(
                            'dpx-visible'
                        );


                        obs.unobserve(
                            entry.target
                        );

                    }
                );

            },
            {
                threshold: .10
            }
        );


    items.forEach(
        function (item, index) {

            item.style.opacity = '0';

            item.style.transform =
                'translateY(24px)';

            item.style.transition =
                'opacity .65s ease ' +
                (index % 4) * .08 +
                's, transform .65s ease ' +
                (index % 4) * .08 +
                's';

            observer.observe(item);

        }
    );


    const style =
        document.createElement('style');


    style.textContent = `

        .dpx-visible {
            opacity: 1 !important;
            transform: translateY(0) !important;
        }

    `;


    document.head.appendChild(style);

})();

</script>


