<style>

/* =========================================================
   DEVELOPER & MANAGEMENT — PREMIUM DESIGN
   Existing routes, images and social links preserved.
========================================================= */

.dpx-hero,
.dpx-team-section,
.dpx-process,
.dpx-values,
.dpx-closing {

    --dpx-navy: #001f3f;
    --dpx-deep: #000b17;
    --dpx-blue: #075d98;
    --dpx-gold: #ffc300;
    --dpx-gold-light: #ffe68c;
    --dpx-text: #172a3d;
    --dpx-muted: #6b7888;

}


.dpx-container {

    width: min(1180px, 90%);

    margin: 0 auto;

}


/* =========================================================
   HERO
========================================================= */

.dpx-hero {

    position: relative;

    min-height: 610px;

    display: flex;

    align-items: center;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 80% 20%,
            rgba(0,126,200,.25),
            transparent 30%
        ),
        linear-gradient(
            125deg,
            #000a14,
            #001f3f 55%,
            #004875
        );

}


.dpx-hero::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.35),
            transparent
        ),
        url('/images/school-bg.jpg');

    background-size: cover;

    background-position: center;

    opacity: .18;

    mix-blend-mode: screen;

}


.dpx-hero-grid {

    position: absolute;

    inset: 0;

    opacity: .075;

    background-image:
        linear-gradient(
            rgba(255,255,255,.25) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.25) 1px,
            transparent 1px
        );

    background-size: 72px 72px;

    animation: dpxGridMove 20s linear infinite;

}


@keyframes dpxGridMove {

    from {
        transform: translate(0,0);
    }

    to {
        transform: translate(-72px,-72px);
    }

}


.dpx-glow {

    position: absolute;

    border-radius: 50%;

    filter: blur(80px);

    pointer-events: none;

}


.dpx-glow-a {

    width: 400px;

    height: 400px;

    right: -120px;

    top: -150px;

    background: rgba(255,195,0,.13);

}


.dpx-glow-b {

    width: 400px;

    height: 400px;

    left: -250px;

    bottom: -250px;

    background: rgba(0,126,200,.15);

}


.dpx-hero-inner {

    position: relative;

    z-index: 3;

    display: grid;

    grid-template-columns: 1.15fr .85fr;

    align-items: center;

    gap: 60px;

    padding: 70px 0;

}


.dpx-hero-copy {

    max-width: 760px;

}


.dpx-eyebrow {

    display: flex;

    align-items: center;

    gap: 12px;

    color: var(--dpx-gold);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2.3px;

}


.dpx-eyebrow span {

    width: 45px;

    height: 2px;

    background: var(--dpx-gold);

}


.dpx-hero h1 {

    margin: 23px 0 20px;

    color: #fff;

    font-size: clamp(48px, 6.5vw, 78px);

    line-height: .98;

    letter-spacing: -3px;

    font-weight: 950;

    text-shadow:
        0 20px 45px rgba(0,0,0,.25);

}


.dpx-hero h1 span {

    display: block;

    color: var(--dpx-gold);

}


.dpx-hero-copy > p {

    max-width: 650px;

    margin: 0;

    color: rgba(255,255,255,.64);

    font-size: 17px;

    line-height: 1.8;

}


.dpx-hero-meta {

    display: flex;

    flex-wrap: wrap;

    gap: 10px;

    margin-top: 30px;

}


.dpx-hero-meta div {

    display: flex;

    align-items: center;

    gap: 8px;

    padding: 10px 13px;

    border: 1px solid rgba(255,255,255,.11);

    border-radius: 30px;

    background: rgba(255,255,255,.055);

    color: rgba(255,255,255,.65);

    font-size: 9px;

    font-weight: 850;

    backdrop-filter: blur(12px);

}


.dpx-hero-meta i {

    color: var(--dpx-gold);

}


/* =========================================================
   HERO FLOATING CARD
========================================================= */

.dpx-hero-card {

    position: relative;

    min-height: 390px;

    display: flex;

    align-items: center;

    justify-content: center;

}


.dpx-card-orbit {

    position: absolute;

    border: 1px solid rgba(255,195,0,.18);

    border-radius: 50%;

}


.dpx-card-orbit-one {

    width: 280px;

    height: 280px;

    animation: dpxOrbit 18s linear infinite;

}


.dpx-card-orbit-two {

    width: 420px;

    height: 420px;

    border-color: rgba(255,255,255,.07);

    animation: dpxOrbit 26s linear infinite reverse;

}


@keyframes dpxOrbit {

    to {
        transform: rotate(360deg);
    }

}


.dpx-mini-card {

    position: relative;

    z-index: 3;

    width: 265px;

    min-height: 305px;

    padding: 30px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    border: 1px solid rgba(255,255,255,.17);

    border-radius: 32px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.13),
            rgba(255,255,255,.035)
        );

    backdrop-filter: blur(20px);

    box-shadow:
        0 35px 80px rgba(0,0,0,.28);

    transform: rotate(3deg);

    transition: .5s;

}


.dpx-mini-card:hover {

    transform:
        rotate(0)
        translateY(-8px);

}


.dpx-mini-icon {

    width: 90px;

    height: 90px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 25px;

    background:
        linear-gradient(
            135deg,
            var(--dpx-gold),
            #fff0a0
        );

    color: var(--dpx-navy);

    font-size: 35px;

    box-shadow:
        0 20px 45px rgba(255,195,0,.15);

}


.dpx-mini-card > span {

    margin-top: 23px;

    color: rgba(255,255,255,.38);

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 2px;

}


.dpx-mini-card strong {

    margin-top: 7px;

    color: #fff;

    font-size: 21px;

    font-weight: 950;

}


.dpx-mini-card small {

    margin-top: 7px;

    color: rgba(255,255,255,.48);

    font-size: 10px;

}


.dpx-scroll {

    position: absolute;

    z-index: 5;

    left: 50%;

    bottom: 23px;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 7px;

    color: rgba(255,255,255,.32);

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 2px;

    transform: translateX(-50%);

}


.dpx-scroll i {

    color: var(--dpx-gold);

    animation: dpxBounce 1.5s infinite;

}


@keyframes dpxBounce {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(6px);
    }

}


/* =========================================================
   TEAM SECTION
========================================================= */

.dpx-team-section {

    padding: 110px 0;

    background:
        linear-gradient(
            180deg,
            #fff,
            #f4f7fa
        );

}


.dpx-heading {

    max-width: 820px;

    margin: 0 auto 58px;

    text-align: center;

}


.dpx-section-label {

    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: var(--dpx-navy);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2px;

}


.dpx-section-label::before {

    content: "";

    width: 28px;

    height: 2px;

    background: var(--dpx-gold);

}


.dpx-heading h2 {

    margin: 15px 0;

    color: var(--dpx-navy);

    font-size: clamp(38px, 5vw, 56px);

    line-height: 1.04;

    letter-spacing: -2px;

    font-weight: 950;

}


.dpx-heading h2 span {

    display: block;

    color: var(--dpx-blue);

}


.dpx-heading p {

    margin: 0 auto;

    color: var(--dpx-muted);

    font-size: 15px;

    line-height: 1.8;

}


.dpx-team-grid {

    display: grid;

    grid-template-columns: repeat(2,1fr);

    gap: 25px;

}


.dpx-team-card {

    overflow: hidden;

    border: 1px solid #e3e9ef;

    border-radius: 30px;

    background: #fff;

    box-shadow:
        0 22px 60px rgba(0,31,63,.09);

