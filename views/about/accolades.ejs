        transform .45s ease,
        box-shadow .45s ease;

}


.dpx-team-card:hover {

    transform: translateY(-11px);

    box-shadow:
        0 35px 80px rgba(0,31,63,.16);

}


.dpx-photo-wrap {

    position: relative;

    height: 500px;

    overflow: hidden;

    background: #edf2f7;

}


.dpx-photo {

    width: 100%;

    height: 100%;

}


.dpx-photo img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    object-position: center center;

    transition:
