<%- include('../partials/header') %>

<section class="fmx-hero">

    <div class="fmx-hero-grid"></div>
    <div class="fmx-glow fmx-glow-a"></div>
    <div class="fmx-glow fmx-glow-b"></div>

    <div class="fmx-container fmx-hero-inner">

        <div class="fmx-hero-copy">

            <div class="fmx-eyebrow">
                <span></span>
                FOUNDER'S VISION
            </div>

            <h1>
                Founder’s
                <span>Message</span>
            </h1>

            <p>
                A vision rooted in meaningful education, strong values
                and a brighter future for every child.
            </p>

            <div class="fmx-breadcrumb">
                <a href="/">
                    <i class="fas fa-house"></i>
                    Home
                </a>

                <i class="fas fa-chevron-right"></i>

                <strong>Founder’s Message</strong>
            </div>

        </div>


        <div class="fmx-founder-orbit">

            <div class="fmx-orbit fmx-orbit-one"></div>
            <div class="fmx-orbit fmx-orbit-two"></div>

            <div class="fmx-founder-glass">

                <div class="fmx-founder-avatar">

                    <img
                        src="<%= about && about.image ? about.image : '/images/founder.jpg' %>"
                        alt="<%= about && about.author ? about.author : 'Founder' %>"
                    >

                </div>

                <span>FOUNDER</span>

                <strong>
                    <%= about && about.author ? about.author : 'Founder' %>
                </strong>

                <small>
                    Gyan Jyoti School
                </small>

            </div>

        </div>

    </div>


    <div class="fmx-scroll">
        <span>EXPLORE</span>
        <i class="fas fa-arrow-down"></i>
    </div>

</section>


<section class="fmx-message-section">

    <div class="fmx-container">

        <div class="fmx-message-grid">

            <aside class="fmx-profile-column">

                <div class="fmx-photo-frame">

                    <div class="fmx-photo-accent"></div>

                    <img
                        src="<%= about && about.image ? about.image : '/images/founder.jpg' %>"
                        alt="<%= about && about.author ? about.author : 'Founder Image' %>"
                    >

                    <div class="fmx-photo-caption">

                        <span>01</span>

                        <div>
                            <strong>
                                <%= about && about.author ? about.author : 'Founder' %>
                            </strong>

                            <small>
                                Founder • Gyan Jyoti School
                            </small>
                        </div>

                    </div>

                </div>


                <div class="fmx-vision-card">

                    <div class="fmx-vision-icon">
                        <i class="fas fa-compass"></i>
                    </div>

                    <div>
                        <small>FOUNDER'S VISION</small>
                        <strong>Education with purpose and values.</strong>
                    </div>

                </div>

            </aside>


            <article class="fmx-message-content">

                <div class="fmx-section-label">
                    MESSAGE
                </div>

                <h2>
                    <%= about && about.title
                        ? about.title
                        : "A Vision for Quality Education" %>
                </h2>

                <div class="fmx-quote">
                    <i class="fas fa-quote-left"></i>
                </div>

                <p class="fmx-lead">
                    <%= about && about.content
                        ? about.content
                        : "Gyan Jyoti School was created by Nainpur Vikas Samiti with a vision to provide quality education and holistic development for every child. Our aim is to build confidence, discipline, values and academic excellence in students." %>
                </p>

                <p>
                    We believe that education is not only about books and
                    examinations, but also about character, creativity,
                    confidence and social responsibility.
                </p>

                <p>
                    Gyan Jyoti School continues to work with dedication
                    for the bright future of every student, creating an
                    environment where learning becomes purposeful and
                    every child gets the opportunity to grow.
                </p>


                <div class="fmx-signature">

                    <div class="fmx-signature-icon">
                        <i class="fas fa-pen-nib"></i>
                    </div>

                    <div>
                        <strong>
                            <%= about && about.author ? about.author : 'Founder' %>
                        </strong>

                        <span>
                            Founder, Gyan Jyoti School
                        </span>
                    </div>

                </div>


                <div class="fmx-points">

                    <div>
                        <i class="fas fa-check"></i>
                        Quality Education
                    </div>

                    <div>
                        <i class="fas fa-check"></i>
                        Character Building
                    </div>

                    <div>
                        <i class="fas fa-check"></i>
                        Holistic Development
                    </div>

                </div>

            </article>

        </div>

    </div>

</section>


<section class="fmx-principles">

    <div class="fmx-container">

        <div class="fmx-heading">

            <div class="fmx-section-label">
                THE FOUNDATION
            </div>

            <h2>
                A Vision Built
                <span>With Purpose</span>
            </h2>

            <p>
                The founding philosophy of Gyan Jyoti School is centred
                around meaningful education, student growth and values
                that remain relevant beyond the classroom.
            </p>

        </div>


        <div class="fmx-principle-grid">

            <article class="fmx-principle-card">

                <span class="fmx-number">01</span>

                <div class="fmx-principle-icon">
                    <i class="fas fa-school"></i>
                </div>

                <h3>Established With Purpose</h3>

                <p>
                    Built with a strong vision to provide meaningful
                    education and create a positive environment for
                    every learner.
                </p>

                <div class="fmx-card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

            </article>


            <article class="fmx-principle-card">

                <span class="fmx-number">02</span>

                <div class="fmx-principle-icon">
                    <i class="fas fa-user-graduate"></i>
                </div>

                <h3>Student First Approach</h3>

                <p>
                    Every child is guided towards confidence, curiosity,
                    responsibility and the ability to succeed with purpose.
                </p>

                <div class="fmx-card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

            </article>


            <article class="fmx-principle-card">

                <span class="fmx-number">03</span>

                <div class="fmx-principle-icon">
                    <i class="fas fa-award"></i>
                </div>

                <h3>Excellence & Values</h3>

                <p>
                    Academic growth is strengthened through discipline,
                    values, responsibility and a commitment to excellence.
                </p>

                <div class="fmx-card-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

            </article>

        </div>

    </div>

</section>


<section class="fmx-legacy-section">

    <div class="fmx-container">

        <div class="fmx-legacy-shell">

            <div class="fmx-legacy-copy">

                <div class="fmx-section-label fmx-light-label">
                    THE LEGACY
                </div>

                <h2>
                    Education that
                    <span>shapes tomorrow.</span>
                </h2>

                <p>
                    The founding vision continues to inspire a learning
                    environment where academic development goes hand in
                    hand with character, confidence and responsibility.
                </p>

                <div class="fmx-legacy-stats">

                    <div>
                        <strong>01</strong>
                        <span>Purpose</span>
                    </div>

                    <div>
                        <strong>02</strong>
                        <span>Values</span>
                    </div>

                    <div>
                        <strong>03</strong>
                        <span>Excellence</span>
                    </div>

                </div>

            </div>


            <div class="fmx-legacy-quote">

                <div class="fmx-big-quote">
                    <i class="fas fa-quote-left"></i>
                </div>

                <p>
                    “Every learner deserves an environment in which
                    knowledge becomes confidence and values become
                    a foundation for life.”
                </p>

                <span>
                    FOUNDER'S PHILOSOPHY
                </span>

            </div>

        </div>

    </div>

</section>


<section class="fmx-closing">

    <div class="fmx-closing-pattern"></div>

    <div class="fmx-container">

        <div class="fmx-closing-content">

            <div class="fmx-closing-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>

            <span>OUR COMMITMENT</span>

            <h2>
                Learn with purpose.
                <em>Grow with values.</em>
            </h2>

            <p>
                A strong foundation today creates confident possibilities tomorrow.
            </p>

        </div>

    </div>

</section>


<style>

/* =========================================================
   FOUNDER'S MESSAGE — PREMIUM SCHOOL DESIGN
   Existing EJS variables and routes preserved.
========================================================= */

.fmx-hero,
.fmx-message-section,
.fmx-principles,
.fmx-legacy-section,
.fmx-closing {

    --fmx-navy: #001f3f;
    --fmx-deep: #000d1b;
    --fmx-blue: #075d98;
    --fmx-gold: #ffc300;
    --fmx-gold-light: #ffe58a;
    --fmx-text: #172a3d;
    --fmx-muted: #697789;

}


/* =========================================================
   COMMON
========================================================= */

.fmx-container {

    width: min(1180px, 90%);

    margin: 0 auto;

}


/* =========================================================
   HERO
========================================================= */

.fmx-hero {

    position: relative;

    min-height: 610px;

    display: flex;

    align-items: center;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 78% 25%,
            rgba(0,126,200,.22),
            transparent 30%
        ),
        radial-gradient(
            circle at 10% 90%,
            rgba(255,195,0,.08),
            transparent 28%
        ),
        linear-gradient(
            125deg,
            #000a15,
            #001f3f 55%,
            #004575
        );

}


.fmx-hero::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.30),
            transparent 75%
        ),
        url('/images/school-bg.jpg');

    background-size: cover;

    background-position: center;

    opacity: .20;

    mix-blend-mode: screen;

}


.fmx-hero-grid {

    position: absolute;

    inset: 0;

    opacity: .08;

    background-image:
        linear-gradient(
            rgba(255,255,255,.28) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.28) 1px,
            transparent 1px
        );

    background-size: 72px 72px;

    mask-image:
        linear-gradient(
            90deg,
            black,
            transparent 85%
        );

    animation: fmxGrid 20s linear infinite;

}


@keyframes fmxGrid {

    from {
        transform: translate(0,0);
    }

    to {
        transform: translate(-72px,-72px);
    }

}


.fmx-glow {

    position: absolute;

    border-radius: 50%;

    filter: blur(80px);

    pointer-events: none;

}


.fmx-glow-a {

    width: 370px;

    height: 370px;

    right: -70px;

    top: -120px;

    background: rgba(255,195,0,.13);

}


.fmx-glow-b {

    width: 430px;

    height: 430px;

    left: -240px;

    bottom: -270px;

    background: rgba(0,128,205,.14);

}


.fmx-hero-inner {

    position: relative;

    z-index: 3;

    display: grid;

    grid-template-columns: 1.15fr .85fr;

    align-items: center;

    gap: 60px;

    padding: 65px 0;

}


.fmx-hero-copy {

    max-width: 700px;

}


.fmx-eyebrow {

    display: flex;

    align-items: center;

    gap: 12px;

    color: var(--fmx-gold);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2.5px;

}


.fmx-eyebrow span {

    width: 45px;

    height: 2px;

    background: var(--fmx-gold);

}


.fmx-hero h1 {

    margin: 22px 0 20px;

    color: #fff;

    font-size: clamp(54px, 7vw, 88px);

    line-height: .94;

    letter-spacing: -4px;

    font-weight: 950;

    text-shadow:
        0 20px 45px rgba(0,0,0,.25);

}


.fmx-hero h1 span {

    display: block;

    color: var(--fmx-gold);

}


.fmx-hero-copy > p {

    max-width: 620px;

    margin: 0;

    color: rgba(255,255,255,.64);

    font-size: 17px;

    line-height: 1.8;

}


.fmx-breadcrumb {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 30px;

    color: rgba(255,255,255,.40);

    font-size: 11px;

    font-weight: 750;

}


.fmx-breadcrumb a {

    color: #fff;

    text-decoration: none;

}


.fmx-breadcrumb a:hover {

    color: var(--fmx-gold);

}


.fmx-breadcrumb > i {

    color: var(--fmx-gold);

    font-size: 8px;

}


/* =========================================================
   HERO FOUNDER CARD
========================================================= */

.fmx-founder-orbit {

    position: relative;

    min-height: 390px;

    display: flex;

    align-items: center;

    justify-content: center;

}


.fmx-orbit {

    position: absolute;

    border: 1px solid rgba(255,195,0,.22);

    border-radius: 50%;

}


.fmx-orbit-one {

    width: 305px;

    height: 305px;

    animation:
        fmxOrbit 18s linear infinite;

}


.fmx-orbit-two {

    width: 420px;

    height: 420px;

    border-color: rgba(255,255,255,.08);

    animation:
        fmxOrbit 27s linear infinite reverse;

}


@keyframes fmxOrbit {

    to {
        transform: rotate(360deg);
    }

}


.fmx-founder-glass {

    position: relative;

    z-index: 3;

    width: 270px;

    min-height: 340px;

    padding: 28px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    border: 1px solid rgba(255,255,255,.17);

    border-radius: 32px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.13),
            rgba(255,255,255,.035)
        );

    backdrop-filter: blur(20px);

    box-shadow:
        0 35px 80px rgba(0,0,0,.30);

    transform: rotate(3deg);

    transition: .5s;

}


.fmx-founder-glass:hover {

    transform:
        rotate(0)
        translateY(-8px);

}


.fmx-founder-avatar {

    width: 130px;

    height: 130px;

    padding: 5px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--fmx-gold),
            #fff1a5
        );

    box-shadow:
        0 18px 40px rgba(255,195,0,.18);

}


.fmx-founder-avatar img {

    width: 100%;

    height: 100%;

    border-radius: 50%;

    object-fit: cover;

}


.fmx-founder-glass > span {

    margin-top: 19px;

    color: rgba(255,255,255,.42);

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 2px;

}


.fmx-founder-glass strong {

    margin-top: 7px;

    color: #fff;

    font-size: 21px;

    font-weight: 950;

}


.fmx-founder-glass small {

    margin-top: 6px;

    color: rgba(255,255,255,.54);

    font-size: 10px;

}


/* =========================================================
   SCROLL INDICATOR
========================================================= */

.fmx-scroll {

    position: absolute;

    z-index: 4;

    left: 50%;

    bottom: 24px;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 7px;

    color: rgba(255,255,255,.32);

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 2px;

    transform: translateX(-50%);

}


.fmx-scroll i {

    color: var(--fmx-gold);

    animation:
        fmxBounce 1.5s infinite;

}


@keyframes fmxBounce {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(6px);
    }

}


/* =========================================================
   MESSAGE
========================================================= */

.fmx-message-section {

    padding: 105px 0;

    background:
        linear-gradient(
            180deg,
            #fff,
            #f5f7fa
        );

}


.fmx-message-grid {

    display: grid;

    grid-template-columns: .82fr 1.18fr;

    gap: 65px;

    align-items: center;

}


.fmx-profile-column {

    position: relative;

}


.fmx-photo-frame {

    position: relative;

    height: 570px;

    padding: 8px;

    border-radius: 34px;

    background:
        linear-gradient(
            145deg,
            var(--fmx-gold),
            #fff1a0 48%,
            var(--fmx-navy)
        );

    box-shadow:
        0 30px 75px rgba(0,31,63,.20);

}


.fmx-photo-frame::before {

    content: "";

    position: absolute;

    inset: 17px;

    border: 1px solid rgba(255,255,255,.55);

    border-radius: 25px;

    z-index: 2;

    pointer-events: none;

}


.fmx-photo-frame img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    border-radius: 27px;

    transition: .7s ease;

}


.fmx-photo-frame:hover img {

    transform: scale(1.035);

}


.fmx-photo-caption {

    position: absolute;

    z-index: 4;

    left: 28px;

    right: 28px;

    bottom: 28px;

    display: flex;

    align-items: center;

    gap: 15px;

    padding: 14px;

    border: 1px solid rgba(255,255,255,.18);

    border-radius: 18px;

    background:
        rgba(0,31,63,.90);

    backdrop-filter: blur(15px);

    color: #fff;

}


.fmx-photo-caption > span {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: var(--fmx-gold);

    color: var(--fmx-navy);

    font-size: 10px;

    font-weight: 950;

}


.fmx-photo-caption strong {

    display: block;

    font-size: 14px;

}


.fmx-photo-caption small {

    display: block;

    margin-top: 3px;

    color: rgba(255,255,255,.52);

    font-size: 9px;

}


.fmx-vision-card {

    position: relative;

    z-index: 6;

    display: flex;

    align-items: center;

    gap: 14px;

    width: calc(100% - 50px);

    margin: -34px auto 0;

    padding: 17px;

    border-radius: 18px;

    background: #fff;

    box-shadow:
        0 18px 45px rgba(0,31,63,.13);

}


.fmx-vision-icon {

    width: 46px;

    height: 46px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 13px;

    background: var(--fmx-navy);

    color: var(--fmx-gold);

}


.fmx-vision-card small {

    display: block;

    color: #98a2ae;

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 1.4px;

}


.fmx-vision-card strong {

    display: block;

    margin-top: 4px;

    color: var(--fmx-navy);

    font-size: 12px;

}


.fmx-section-label {

    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: var(--fmx-navy);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2px;

}


.fmx-section-label::before {

    content: "";

    width: 28px;

    height: 2px;

    background: var(--fmx-gold);

}


.fmx-message-content h2 {

    margin: 16px 0 20px;

    color: var(--fmx-navy);

    font-size: clamp(40px, 4.5vw, 58px);

    line-height: 1.05;

    letter-spacing: -2px;

    font-weight: 950;

}


.fmx-quote {

    color: var(--fmx-gold);

    font-size: 46px;

    line-height: 1;

    margin-bottom: 8px;

}


.fmx-message-content p {

    margin: 0 0 16px;

    color: #526174;

    font-size: 15px;

    line-height: 1.9;

}


.fmx-message-content .fmx-lead {

    color: #283d52;

    font-size: 17px;

    font-weight: 600;

}


.fmx-signature {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 27px;

    padding-top: 22px;

    border-top: 1px solid #e3e8ee;

}


.fmx-signature-icon {

    width: 45px;

    height: 45px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 13px;

    background: #f3f6f9;

    color: var(--fmx-navy);

}


.fmx-signature strong {

    display: block;

    color: var(--fmx-navy);

    font-size: 13px;

}


.fmx-signature span {

    display: block;

    margin-top: 3px;

    color: #8793a0;

    font-size: 9px;

}


.fmx-points {

    display: flex;

    flex-wrap: wrap;

    gap: 9px;

    margin-top: 23px;

}


.fmx-points div {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 10px 13px;

    border-radius: 30px;

    background: var(--fmx-navy);

    color: #fff;

    font-size: 9px;

    font-weight: 850;

}


.fmx-points i {

    color: var(--fmx-gold);

}


/* =========================================================
   PRINCIPLES
========================================================= */

.fmx-principles {

    padding: 110px 0;

    background: #fff;

}


.fmx-heading {

    max-width: 820px;

    margin: 0 auto 55px;

    text-align: center;

}


.fmx-heading h2 {

    margin: 14px 0;

    color: var(--fmx-navy);

    font-size: clamp(38px, 5vw, 56px);

    line-height: 1.04;

    letter-spacing: -2px;

    font-weight: 950;

}


.fmx-heading h2 span {

    display: block;

    color: var(--fmx-blue);

}


.fmx-heading p {

    max-width: 750px;

    margin: auto;

    color: var(--fmx-muted);

    font-size: 15px;

    line-height: 1.8;

}


.fmx-principle-grid {

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;

}


.fmx-principle-card {

    position: relative;

    min-height: 330px;

    padding: 31px;

    overflow: hidden;

    border: 1px solid #e4eaf0;

    border-radius: 25px;

    background: #f8fafc;

    box-shadow:
        0 18px 45px rgba(0,31,63,.07);

    transition: .4s ease;

}


.fmx-principle-card::after {

    content: "";

    position: absolute;

    width: 190px;

    height: 190px;

    right: -85px;

    bottom: -95px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(255,195,0,.18),
            transparent 68%
        );

    transition: .5s;

}


.fmx-principle-card:hover {

    transform: translateY(-10px);

    background: var(--fmx-navy);

    border-color: var(--fmx-navy);

    box-shadow:
        0 28px 60px rgba(0,31,63,.18);

}


.fmx-principle-card:hover::after {

    transform: scale(1.4);

}


.fmx-number {

    position: absolute;

    right: 22px;

    top: 18px;

    color: #c8d0d9;

    font-size: 10px;

