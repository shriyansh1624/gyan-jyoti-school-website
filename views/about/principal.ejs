<section class="pmx-message-section">

    <div class="pmx-container">

        <div class="pmx-message-grid">

            <aside class="pmx-profile-column">

                <div class="pmx-photo-frame">

                    <div class="pmx-photo-glow"></div>

                    <img
                        src="/images/principal.jpg"
                        alt="Mr. P. K. Naidu, Principal"
                    >

                    <div class="pmx-photo-label">

                        <span>01</span>

                        <div>
                            <strong>Mr. P. K. Naidu</strong>
                            <small>Principal</small>
                        </div>

                    </div>

                </div>


                <div class="pmx-leadership-card">

                    <div class="pmx-leadership-icon">
                        <i class="fas fa-compass"></i>
                    </div>

                    <div>
                        <span>LEADERSHIP</span>
                        <strong>Guiding every learner forward.</strong>
                    </div>

                </div>

            </aside>


            <article class="pmx-message-content">

                <div class="pmx-section-label">
                    MESSAGE FROM PRINCIPAL
                </div>

                <h2>
                    Building Character,
                    <span>Confidence & Excellence</span>
                </h2>

                <div class="pmx-quote-mark">
                    <i class="fas fa-quote-left"></i>
                </div>


                <p class="pmx-lead-paragraph">
                    At Gyan Jyoti International School, we believe that
                    education is not only about academic excellence but
                    also about building strong character, discipline,
                    confidence and compassion in every child.
                </p>

                <p>
                    Our mission is to create a nurturing environment where
                    students are encouraged to think creatively, act
                    responsibly and grow into capable future leaders.
                </p>

                <p>
                    We focus on holistic development through quality
                    education, co-curricular activities, modern teaching
                    methods and moral values that prepare students for
                    real-world challenges.
                </p>


                <div class="pmx-signature-line">

                    <div class="pmx-signature-mark">
                        <i class="fas fa-pen-nib"></i>
                    </div>

                    <div>
                        <strong>Mr. P. K. Naidu</strong>
                        <span>Principal, Gyan Jyoti International School</span>
                    </div>

                </div>


                <div class="pmx-tags">

                    <span>
                        <i class="fas fa-check"></i>
                        Discipline
                    </span>

                    <span>
                        <i class="fas fa-check"></i>
                        Confidence
                    </span>

                    <span>
                        <i class="fas fa-check"></i>
                        Leadership
                    </span>

                    <span>
                        <i class="fas fa-check"></i>
                        Excellence
                    </span>

                </div>

            </article>

        </div>

    </div>

</section>


<section class="pmx-focus-section">

    <div class="pmx-container">

        <div class="pmx-section-heading">

            <div class="pmx-section-label">
                OUR FOCUS
            </div>

            <h2>
                Principal's
                <span>Educational Vision</span>
            </h2>

            <p>
                A balanced approach that supports academic learning,
                moral values and overall personality development.
            </p>

        </div>


        <div class="pmx-focus-grid">

            <article class="pmx-focus-card">

                <div class="pmx-focus-number">01</div>

                <div class="pmx-focus-icon">
                    <i class="fas fa-book-reader"></i>
                </div>

                <h3>Academic Excellence</h3>

                <p>
                    Strong foundation and result-oriented learning environment.
                </p>

                <div class="pmx-focus-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

            </article>


            <article class="pmx-focus-card">

                <div class="pmx-focus-number">02</div>

                <div class="pmx-focus-icon">
                    <i class="fas fa-users"></i>
                </div>

                <h3>Student Growth</h3>

                <p>
                    Confidence, communication, creativity and leadership development.
                </p>

                <div class="pmx-focus-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

            </article>


            <article class="pmx-focus-card">

                <div class="pmx-focus-number">03</div>

                <div class="pmx-focus-icon">
                    <i class="fas fa-heart"></i>
                </div>

                <h3>Values & Discipline</h3>

                <p>
                    Respect, responsibility, discipline and moral education.
                </p>

                <div class="pmx-focus-arrow">
                    <i class="fas fa-arrow-right"></i>
                </div>

            </article>

        </div>

    </div>

</section>


<section class="pmx-contact-section">

    <div class="pmx-container">

        <div class="pmx-contact-shell">

            <div class="pmx-contact-info">

                <div class="pmx-section-label pmx-light-label">
                    CONTACT PRINCIPAL
                </div>

                <h2>
                    Want to Share
                    <span>a Message?</span>
                </h2>

                <p>
                    Parents and students can send their message,
                    feedback or concern directly to the school
                    leadership. Our team will review it carefully.
                </p>


                <div class="pmx-contact-list">

                    <div class="pmx-contact-item">

                        <span>
                            <i class="fas fa-envelope"></i>
                        </span>

                        <div>
                            <small>EMAIL</small>
                            <strong>principal@gyanjyoti.com</strong>
                        </div>

                    </div>


                    <div class="pmx-contact-item">

                        <span>
                            <i class="fas fa-phone"></i>
                        </span>

                        <div>
                            <small>PHONE</small>
                            <strong>+91 98765-43210</strong>
                        </div>

                    </div>


                    <div class="pmx-contact-item">

                        <span>
                            <i class="fas fa-clock"></i>
                        </span>

                        <div>
                            <small>OFFICE HOURS</small>
                            <strong>Mon - Sat, 9:00 AM - 2:00 PM</strong>
                        </div>

                    </div>

                </div>

            </div>


            <div class="pmx-form-card">

                <div class="pmx-form-heading">

                    <span>WRITE TO US</span>

                    <h3>
                        Send a Message
                    </h3>

                    <p>
                        We value your feedback and communication.
                    </p>

                </div>


                <% if (typeof success !== 'undefined' && success) { %>

                    <div class="pmx-alert pmx-success">
                        <i class="fas fa-check-circle"></i>
                        <span>
                            Your message has been sent successfully.
                        </span>
                    </div>

                <% } %>


                <% if (typeof error !== 'undefined' && error) { %>

                    <div class="pmx-alert pmx-error">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>
                            Please fill all details correctly.
                        </span>
                    </div>

                <% } %>


                <form
                    action="/contact"
                    method="POST"
                    class="pmx-contact-form"
                    novalidate
                >

                    <div class="pmx-form-row">

                        <label>
                            <span>FULL NAME</span>

                            <div class="pmx-input-wrap">
                                <i class="fas fa-user"></i>

                                <input
                                    type="text"
                                    name="name"
                                    placeholder="Your Full Name"
                                    pattern="[A-Za-z\s.]{3,60}"
                                    maxlength="60"
                                    title="Only letters allowed, minimum 3 characters"
                                    autocomplete="name"
                                    required
                                >
                            </div>
                        </label>


                        <label>
                            <span>EMAIL ADDRESS</span>

                            <div class="pmx-input-wrap">
                                <i class="fas fa-envelope"></i>

                                <input
                                    type="email"
                                    name="email"
                                    placeholder="Your Email"
                                    maxlength="80"
                                    autocomplete="email"
                                    required
                                >
                            </div>
                        </label>

                    </div>


                    <div class="pmx-form-row">

                        <label>
                            <span>MOBILE NUMBER</span>

                            <div class="pmx-input-wrap">
                                <i class="fas fa-mobile-screen"></i>

                                <input
                                    type="text"
                                    name="phone"
                                    placeholder="10 digit mobile number"
                                    pattern="[0-9]{10}"
                                    maxlength="10"
                                    inputmode="numeric"
                                    title="Enter exactly 10 digits"
                                    autocomplete="tel"
                                    required
                                >
                            </div>
                        </label>


                        <label>
                            <span>SUBJECT</span>

                            <div class="pmx-input-wrap pmx-readonly">
                                <i class="fas fa-tag"></i>

                                <input
                                    type="text"
                                    name="subject"
                                    value="Message for Principal"
                                    readonly
                                    maxlength="120"
                                >
                            </div>
                        </label>

                    </div>


                    <label class="pmx-message-field">

                        <span>YOUR MESSAGE</span>

                        <div class="pmx-input-wrap pmx-textarea-wrap">
                            <i class="fas fa-message"></i>

                            <textarea
                                name="message"
                                placeholder="Write your message..."
                                minlength="5"
                                maxlength="1000"
                                required
                            ></textarea>
                        </div>

                    </label>


                    <small class="pmx-char-note">
                        <i class="fas fa-shield-halved"></i>
                        Max 1000 characters. Unsafe script text is not allowed.
                    </small>


                    <input
                        type="hidden"
                        name="category"
                        value="Principal Message"
                    >


                    <button
                        type="submit"
                        class="pmx-submit-btn"
                    >
                        <span>
                            <i class="fas fa-paper-plane"></i>
                            Send Message
                        </span>

                        <i class="fas fa-arrow-right pmx-submit-arrow"></i>
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>


<section class="pmx-closing">

    <div class="pmx-closing-pattern"></div>

    <div class="pmx-container">

        <div class="pmx-closing-content">

            <div class="pmx-closing-icon">
                <i class="fas fa-graduation-cap"></i>
            </div>

            <span>
                OUR COMMITMENT
            </span>

            <h2>
                Every child deserves
                <em>the opportunity to shine.</em>
            </h2>

            <p>
                Learn with purpose. Grow with values. Lead with confidence.
            </p>

        </div>

    </div>

</section>


<style>

/* =========================================================
   PRINCIPAL MESSAGE — PREMIUM INSTITUTIONAL DESIGN
   Existing route/form/backend fields preserved.
========================================================= */

.pmx-hero,
.pmx-message-section,
.pmx-focus-section,
.pmx-contact-section,
.pmx-closing {

    --pmx-navy: #001f3f;
    --pmx-deep: #000f20;
    --pmx-blue: #075d98;
    --pmx-gold: #ffc300;
    --pmx-gold-light: #ffe27b;
    --pmx-text: #15283d;
    --pmx-muted: #657386;

}


.pmx-container {

    width: min(1180px, 90%);

    margin: 0 auto;

}


/* =========================================================
   HERO
========================================================= */

.pmx-hero {

    position: relative;

    min-height: 610px;

    display: flex;

    align-items: center;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 78% 30%,
            rgba(0,130,205,.22),
            transparent 30%
        ),
        radial-gradient(
            circle at 10% 85%,
            rgba(255,195,0,.08),
            transparent 28%
        ),
        linear-gradient(
            125deg,
            #000b17,
            #001f3f 52%,
            #004575
        );

    color: #fff;

}


.pmx-hero::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.24),
            transparent 72%
        ),
        url('/images/school-bg.jpg');

    background-size: cover;

    background-position: center;

    opacity: .20;

    mix-blend-mode: screen;

}


.pmx-hero-grid {

    position: absolute;

    inset: 0;

    opacity: .09;

    background-image:
        linear-gradient(
            rgba(255,255,255,.24) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.24) 1px,
            transparent 1px
        );

    background-size: 75px 75px;

    mask-image:
        linear-gradient(
            90deg,
            black,
            transparent 85%
        );

    animation:
        pmxGridMove 20s linear infinite;

}


@keyframes pmxGridMove {

    from {
        transform: translate(0,0);
    }

    to {
        transform: translate(-75px,-75px);
    }

}


.pmx-hero-glow {

    position: absolute;

    border-radius: 50%;

    filter: blur(80px);

    pointer-events: none;

}


.pmx-glow-a {

    width: 360px;

    height: 360px;

    right: 2%;

    top: -100px;

    background: rgba(255,195,0,.12);

}


.pmx-glow-b {

    width: 420px;

    height: 420px;

    left: -230px;

    bottom: -260px;

    background: rgba(0,120,205,.13);

}


.pmx-hero-inner {

    position: relative;

    z-index: 3;

    display: grid;

    grid-template-columns: 1.15fr .85fr;

    align-items: center;

    gap: 60px;

    padding-top: 65px;

    padding-bottom: 65px;

}


.pmx-hero-copy {

    max-width: 700px;

}


.pmx-eyebrow {

    display: flex;

    align-items: center;

    gap: 12px;

    color: var(--pmx-gold);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2.5px;

}


.pmx-eyebrow span {

    width: 45px;

    height: 2px;

    background: var(--pmx-gold);

}


.pmx-hero h1 {

    margin: 22px 0 20px;

    color: #fff;

    font-size: clamp(54px, 7vw, 88px);

    line-height: .94;

    letter-spacing: -4px;

    font-weight: 950;

    text-shadow:
        0 20px 45px rgba(0,0,0,.25);

}


.pmx-hero h1 span {

    display: block;

    color: var(--pmx-gold);

}


.pmx-hero-copy > p {

    max-width: 620px;

    margin: 0;

    color: rgba(255,255,255,.64);

    font-size: 17px;

    line-height: 1.8;

}


.pmx-breadcrumb {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 30px;

    color: rgba(255,255,255,.40);

    font-size: 11px;

    font-weight: 750;

}


.pmx-breadcrumb a {

    color: #fff;

    text-decoration: none;

}


.pmx-breadcrumb a:hover {

    color: var(--pmx-gold);

}


.pmx-breadcrumb > i {

    color: var(--pmx-gold);

    font-size: 8px;

}


/* Hero profile */

.pmx-hero-profile {

    position: relative;

    min-height: 390px;

    display: flex;

    align-items: center;

    justify-content: center;

}


.pmx-profile-ring {

    position: absolute;

    border: 1px solid rgba(255,195,0,.23);

    border-radius: 50%;

}


.pmx-ring-one {

    width: 305px;

    height: 305px;

    animation:
        pmxOrbit 18s linear infinite;

}


.pmx-ring-two {

    width: 420px;

    height: 420px;

    border-color: rgba(255,255,255,.09);

    animation:
        pmxOrbit 26s linear infinite reverse;

}


@keyframes pmxOrbit {

    to {
        transform: rotate(360deg);
    }

}


.pmx-profile-glass {

    position: relative;

    z-index: 3;

    width: 265px;

    min-height: 335px;

    padding: 28px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    border: 1px solid rgba(255,255,255,.18);

    border-radius: 32px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.13),
            rgba(255,255,255,.035)
        );

    backdrop-filter: blur(20px);

    box-shadow:
        0 35px 80px rgba(0,0,0,.30);

    transform: rotate(3deg);

    transition: .5s;

}


.pmx-profile-glass:hover {

    transform:
        rotate(0)
        translateY(-8px);

}


.pmx-profile-avatar {

    width: 125px;

    height: 125px;

    padding: 5px;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--pmx-gold),
            #fff1a8
        );

    box-shadow:
        0 18px 40px rgba(255,195,0,.18);

}


.pmx-profile-avatar img {

    width: 100%;

    height: 100%;

    border-radius: 50%;

    object-fit: cover;

}


.pmx-profile-glass > span {

    margin-top: 20px;

    color: rgba(255,255,255,.42);

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 2px;

}


.pmx-profile-glass strong {

    margin-top: 7px;

    color: #fff;

    font-size: 22px;

    font-weight: 950;

}


.pmx-profile-glass small {

    margin-top: 6px;

    color: rgba(255,255,255,.54);

    font-size: 10px;

    line-height: 1.5;

}


.pmx-scroll-indicator {

    position: absolute;

    z-index: 4;

    left: 50%;

    bottom: 25px;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 7px;

    color: rgba(255,255,255,.35);

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 2px;

    transform: translateX(-50%);

}


.pmx-scroll-indicator i {

    color: var(--pmx-gold);

    animation:
        pmxBounce 1.5s infinite;

}


@keyframes pmxBounce {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(5px);
    }

}


/* =========================================================
   MESSAGE
========================================================= */

.pmx-message-section {

    padding: 105px 0;

    background:
        linear-gradient(
            180deg,
            #fff,
            #f5f7fa
        );

}


.pmx-message-grid {

    display: grid;

    grid-template-columns: .82fr 1.18fr;

    gap: 65px;

    align-items: center;

}


.pmx-profile-column {

    position: relative;

}


.pmx-photo-frame {

    position: relative;

    height: 570px;

    padding: 8px;

    border-radius: 34px;

    background:
        linear-gradient(
            145deg,
            var(--pmx-gold),
            #fff1a0 48%,
            var(--pmx-navy)
        );

    box-shadow:
        0 30px 75px rgba(0,31,63,.20);

}


.pmx-photo-frame::before {

    content: "";

    position: absolute;

    inset: 17px;

    border: 1px solid rgba(255,255,255,.55);

    border-radius: 25px;

    z-index: 2;

    pointer-events: none;

}


.pmx-photo-frame img {

    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;

    border-radius: 27px;

    transition: .7s ease;

}


.pmx-photo-frame:hover img {

    transform: scale(1.035);

}


.pmx-photo-label {

    position: absolute;

    z-index: 4;

    left: 28px;

    right: 28px;

    bottom: 28px;

    display: flex;

    align-items: center;

    gap: 15px;

    padding: 14px;

    border: 1px solid rgba(255,255,255,.18);

    border-radius: 18px;

    background:
        rgba(0,31,63,.90);

    backdrop-filter: blur(15px);

    color: #fff;

}


.pmx-photo-label > span {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: var(--pmx-gold);

    color: var(--pmx-navy);

    font-size: 10px;

    font-weight: 950;

}


.pmx-photo-label strong {

    display: block;

    color: #fff;

    font-size: 14px;

}


.pmx-photo-label small {

    display: block;

    margin-top: 3px;

    color: rgba(255,255,255,.52);

    font-size: 9px;

}


.pmx-leadership-card {

    position: relative;

    display: flex;

    align-items: center;

    gap: 14px;

    width: calc(100% - 50px);

    margin: -34px auto 0;

    padding: 17px;

    border-radius: 18px;

    background: #fff;

    box-shadow:
        0 18px 45px rgba(0,31,63,.13);

    z-index: 6;

}


.pmx-leadership-icon {

    width: 46px;

    height: 46px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 13px;

    background: var(--pmx-navy);

    color: var(--pmx-gold);

}


.pmx-leadership-card span {

    display: block;

    color: #98a2ae;

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 1.4px;

}


.pmx-leadership-card strong {

    display: block;

    margin-top: 4px;

    color: var(--pmx-navy);

    font-size: 12px;

}


.pmx-section-label {

    display: inline-flex;

    align-items: center;

    gap: 9px;

    color: var(--pmx-navy);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2px;

}


.pmx-section-label::before {

    content: "";

    width: 28px;

    height: 2px;

    background: var(--pmx-gold);

}


.pmx-message-content h2 {

    margin: 16px 0 20px;

    color: var(--pmx-navy);

    font-size: clamp(40px, 4.5vw, 57px);

    line-height: 1.04;

    letter-spacing: -2px;

    font-weight: 950;

}


.pmx-message-content h2 span {

    display: block;

    color: var(--pmx-blue);

}


.pmx-quote-mark {

    color: var(--pmx-gold);

    font-size: 45px;

    line-height: 1;

    margin-bottom: 8px;

}


.pmx-message-content p {

    margin: 0 0 15px;

    color: #526174;

    font-size: 15px;

    line-height: 1.9;

}


.pmx-message-content .pmx-lead-paragraph {

