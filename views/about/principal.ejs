</style>


<script>

/* =========================================================
   PRINCIPAL CONTACT FORM VALIDATION
   Existing backend action and field names preserved.
========================================================= */

(function () {

    const principalContactForm =
        document.querySelector(
            '.pmx-contact-form'
        );


    if (!principalContactForm) {
        return;
    }


    principalContactForm.addEventListener(
        'submit',
        function (e) {

            const name =
                this.name.value.trim();

            const email =
                this.email.value.trim();

            const phone =
                this.phone.value.trim();

            const message =
                this.message.value.trim();


            const nameRegex =
                /^[A-Za-z\s.]{3,60}$/;

            const emailRegex =
                /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            const unsafeRegex =
                /<script|<\/script|javascript:|onerror=|onload=|<iframe|<\/iframe/gi;


            if (!nameRegex.test(name)) {

                alert(
                    'Full name should contain only letters and minimum 3 characters.'
                );

                e.preventDefault();

                return;

            }


            if (!emailRegex.test(email)) {

                alert(
                    'Please enter a valid email address.'
                );

                e.preventDefault();

                return;

            }


            if (!/^[0-9]{10}$/.test(phone)) {

                alert(
                    'Mobile number must be exactly 10 digits.'
                );

                e.preventDefault();

                return;

            }


            if (
                message.length < 5 ||
                message.length > 1000 ||
                unsafeRegex.test(message)
            ) {

                alert(
                    'Please enter a valid message. Unsafe script text is not allowed.'
                );

                e.preventDefault();

                return;

            }


            const btn =
                this.querySelector(
                    '.pmx-submit-btn'
                );


            if (btn) {

                btn.innerHTML =
                    '<span><i class="fas fa-spinner fa-spin"></i> Sending...</span>' +
                    '<i class="fas fa-arrow-right"></i>';

                btn.disabled = true;

            }

        }
    );


    /* =====================================================
       SIMPLE SCROLL REVEAL
    ====================================================== */

    const revealItems =
        document.querySelectorAll(
            '.pmx-focus-card, .pmx-contact-item, .pmx-message-content, .pmx-profile-column'
        );


    if (
        'IntersectionObserver' in window &&
        revealItems.length
    ) {

        const observer =
            new IntersectionObserver(
                function (entries, obs) {

                    entries.forEach(
                        function (entry) {

                            if (
                                !entry.isIntersecting
                            ) {
                                return;
                            }


                            entry.target.classList.add(
                                'pmx-visible'
                            );


                            obs.unobserve(
                                entry.target
                            );

                        }
                    );

                },
                {
                    threshold: .10
                }
            );


        revealItems.forEach(
            function (item, index) {

                item.style.opacity = '0';

                item.style.transform =
                    'translateY(25px)';

                item.style.transition =
                    'opacity .65s ease ' +
                    (index % 4) * .08 +
                    's, transform .65s ease ' +
                    (index % 4) * .08 +
                    's';

                observer.observe(item);

            }
        );


        const revealStyle =
            document.createElement('style');


        revealStyle.textContent = `

            .pmx-visible {
                opacity: 1 !important;
                transform: translateY(0) !important;
            }

        `;


        document.head.appendChild(
            revealStyle
        );

    }

})();

</script>


