<section class="pmx-hero">

    <div class="pmx-hero-grid"></div>
    <div class="pmx-hero-glow pmx-glow-a"></div>
    <div class="pmx-hero-glow pmx-glow-b"></div>

    <div class="pmx-container pmx-hero-inner">

        <div class="pmx-hero-copy">

            <div class="pmx-eyebrow">
