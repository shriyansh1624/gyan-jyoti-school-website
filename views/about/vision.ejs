<style>

/* =========================================================
   VISION & MISSION — PREMIUM DESIGN SYSTEM
   Theme: Gyan Jyoti Navy + Gold
========================================================= */

.vmx-hero,
.vmx-intro,
.vmx-direction-section,
.vmx-values-section,
.vmx-goals-section,
.vmx-closing-section {

    --vmx-navy: #001f3f;
    --vmx-navy-2: #003d70;
    --vmx-blue: #075d98;
    --vmx-gold: #ffc300;
    --vmx-gold-light: #ffe17a;
    --vmx-ink: #102236;
    --vmx-muted: #647284;
    --vmx-light: #f5f7fb;

}


.vmx-container {

    width: min(1180px, 90%);

    margin: 0 auto;

}


/* =========================================================
   HERO
========================================================= */

.vmx-hero {

    position: relative;

    min-height: 610px;

    display: flex;

    align-items: center;

    overflow: hidden;

    color: #fff;

    background:
        radial-gradient(
            circle at 78% 35%,
            rgba(0,130,205,.25),
            transparent 28%
        ),
        radial-gradient(
            circle at 15% 85%,
            rgba(255,195,0,.09),
            transparent 24%
        ),
        linear-gradient(
            125deg,
            #000e1d 0%,
            #001f3f 48%,
            #003f6f 100%
        );

}


.vmx-hero::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.18),
            transparent 65%
        ),
        url('/images/school-bg.jpg');

    background-size: cover;

    background-position: center;

    opacity: .22;

    mix-blend-mode: screen;

}


.vmx-hero-grid {

    position: absolute;

    inset: 0;

    opacity: .10;

    background-image:
        linear-gradient(
            rgba(255,255,255,.25) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.25) 1px,
            transparent 1px
        );

    background-size: 75px 75px;

    mask-image:
        linear-gradient(
            90deg,
            black,
            transparent 82%
        );

    animation:
        vmxGridMove 20s linear infinite;

}


@keyframes vmxGridMove {

    from {
        transform: translate3d(0,0,0);
    }

    to {
        transform: translate3d(-75px,-75px,0);
    }

}


.vmx-hero-glow {

    position: absolute;

    border-radius: 50%;

    filter: blur(70px);

    pointer-events: none;

}


.vmx-glow-one {

    width: 320px;

    height: 320px;

    right: 8%;

    top: 8%;

    background: rgba(255,195,0,.13);

}


.vmx-glow-two {

    width: 380px;

    height: 380px;

    left: -200px;

    bottom: -220px;

    background: rgba(0,126,206,.16);

}


.vmx-hero-content {

    position: relative;

    z-index: 3;

    display: grid;

    grid-template-columns: 1.15fr .85fr;

    align-items: center;

    gap: 60px;

}


.vmx-hero-copy {

    max-width: 720px;

}


.vmx-eyebrow {

    display: flex;

    align-items: center;

    gap: 12px;

    color: var(--vmx-gold);

    font-size: 11px;

    font-weight: 950;

    letter-spacing: 2.5px;

}


.vmx-eyebrow-line {

    width: 45px;

    height: 2px;

    background: var(--vmx-gold);

}


.vmx-hero h1 {

    margin: 20px 0 18px;

    color: #fff;

    font-size: clamp(55px, 7vw, 92px);

    line-height: .92;

    letter-spacing: -4px;

    font-weight: 950;

    text-shadow:
        0 18px 40px rgba(0,0,0,.25);

}


.vmx-hero h1 span {

    color: var(--vmx-gold);

}


.vmx-hero-description {

    max-width: 620px;

    margin: 0;

    color: rgba(255,255,255,.68);

    font-size: 17px;

    line-height: 1.8;

}


.vmx-breadcrumb {

    display: flex;

    align-items: center;

    gap: 12px;

    margin-top: 30px;

    color: rgba(255,255,255,.43);

    font-size: 11px;

    font-weight: 700;

}


.vmx-breadcrumb a {

    color: #fff;

    text-decoration: none;

}


.vmx-breadcrumb a:hover {

    color: var(--vmx-gold);

}


.vmx-breadcrumb > i {

    color: var(--vmx-gold);

    font-size: 8px;

}


/* Hero emblem */

.vmx-hero-emblem {

    position: relative;

    min-height: 390px;

    display: flex;

    align-items: center;

    justify-content: center;

}


.vmx-orbit {

    position: absolute;

    border: 1px solid rgba(255,195,0,.24);

    border-radius: 50%;

}


.vmx-orbit-one {

    width: 300px;

    height: 300px;

    animation:
        vmxOrbitOne 18s linear infinite;

}


.vmx-orbit-two {

    width: 410px;

    height: 410px;

    border-color: rgba(255,255,255,.10);

    animation:
        vmxOrbitTwo 25s linear infinite reverse;

}


@keyframes vmxOrbitOne {

    to {
        transform: rotate(360deg);
    }

}


@keyframes vmxOrbitTwo {

    to {
        transform: rotate(360deg);
    }

}


.vmx-emblem-card {

    position: relative;

    z-index: 3;

    width: 250px;

    height: 290px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    padding: 30px;

    border: 1px solid rgba(255,255,255,.18);

    border-radius: 32px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.12),
            rgba(255,255,255,.035)
        );

    box-shadow:
        0 35px 80px rgba(0,0,0,.30);

    backdrop-filter: blur(20px);

    transform:
        rotate(3deg);

    transition: .5s ease;

}


.vmx-emblem-card:hover {

    transform:
        rotate(0deg)
        translateY(-8px);

}


.vmx-emblem-icon {

    width: 82px;

    height: 82px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 25px;

    background:
        linear-gradient(
            135deg,
            var(--vmx-gold),
            var(--vmx-gold-light)
        );

    color: var(--vmx-navy);

    font-size: 33px;

    box-shadow:
        0 20px 45px rgba(255,195,0,.22);

}


.vmx-emblem-card > span {

    margin-top: 24px;

    color: rgba(255,255,255,.45);

    font-size: 9px;

    font-weight: 950;

    letter-spacing: 2px;

}


.vmx-emblem-card strong {

    margin-top: 8px;

    color: #fff;

    text-align: center;

    font-size: 22px;

    line-height: 1.2;

}


.vmx-emblem-card em {

    color: var(--vmx-gold);

    font-style: normal;

}


.vmx-hero-scroll {

    position: absolute;

    z-index: 4;

    left: 50%;

    bottom: 27px;

    display: flex;

    flex-direction: column;

    align-items: center;

    gap: 7px;

    color: rgba(255,255,255,.38);

    font-size: 8px;

    font-weight: 900;

    letter-spacing: 2px;

    transform: translateX(-50%);

}


.vmx-hero-scroll i {

    color: var(--vmx-gold);

    animation:
        vmxScrollBounce 1.5s infinite;

}


@keyframes vmxScrollBounce {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(5px);
    }

}


/* =========================================================
   INTRO
========================================================= */

.vmx-intro {

    padding: 105px 0 65px;

    background: #fff;

}


.vmx-section-heading {

    max-width: 820px;

    margin: 0 auto 58px;

    text-align: center;

}


.vmx-section-label {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    color: var(--vmx-navy);

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 2px;

}


.vmx-section-label::before {

    content: "";

    width: 25px;

    height: 2px;

    background: var(--vmx-gold);

}


.vmx-section-heading h2 {

    margin: 14px 0 15px;

    color: var(--vmx-navy);

    font-size: clamp(37px, 5vw, 58px);

    line-height: 1.02;

    letter-spacing: -2px;

    font-weight: 950;

}


.vmx-section-heading h2 span {

    display: block;

    color: var(--vmx-blue);

}


.vmx-section-heading p {

    max-width: 720px;

    margin: 0 auto;

    color: var(--vmx-muted);

    font-size: 16px;

    line-height: 1.8;

}


.vmx-purpose-strip {

    display: grid;

    grid-template-columns: 70px 1fr 52px;

    align-items: center;

    gap: 20px;

    padding: 20px 25px;

    border: 1px solid #e7ecf2;

    border-radius: 18px;

    background:
        linear-gradient(
            100deg,
            #f8fafc,
            #fff
        );

    box-shadow:
        0 20px 55px rgba(0,31,63,.07);

}


.vmx-purpose-number {

    width: 55px;

    height: 55px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 15px;

    background: var(--vmx-navy);

    color: var(--vmx-gold);

    font-size: 12px;

    font-weight: 950;

}


.vmx-purpose-copy span {

    display: block;

    color: #8a96a5;

    font-size: 8px;

    font-weight: 950;

    letter-spacing: 1.7px;

}


.vmx-purpose-copy strong {

    display: block;

    margin-top: 5px;

    color: var(--vmx-navy);

    font-size: 16px;

}


.vmx-purpose-copy em {

    color: var(--vmx-blue);

    font-style: normal;

}


.vmx-purpose-mark {

    width: 44px;

    height: 44px;

    display: flex;

    align-items: center;

    justify-content: center;

    border: 1px solid #dfe6ee;

    border-radius: 50%;

    color: var(--vmx-navy);

    transition: .3s;

}


.vmx-purpose-strip:hover .vmx-purpose-mark {

    color: var(--vmx-navy);

    background: var(--vmx-gold);

    border-color: var(--vmx-gold);

    transform: translateX(5px);

}


/* =========================================================
   VISION + MISSION
========================================================= */

.vmx-direction-section {

    padding: 55px 0 110px;

    background:
        linear-gradient(
            180deg,
            #fff,
            #f4f7fa
        );

}


.vmx-direction-grid {

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 28px;

}


.vmx-main-card {

    position: relative;

    overflow: hidden;

    min-height: 550px;

    padding: 35px;

    border: 1px solid #e3e9f0;

    border-radius: 30px;

    background: #fff;

    box-shadow:
        0 25px 70px rgba(0,31,63,.10);

    transition: .45s ease;

}


.vmx-main-card::before {

    content: "";

    position: absolute;

    top: 0;

    left: 0;

    width: 100%;

    height: 5px;

    background:
        linear-gradient(
            90deg,
            var(--vmx-gold),
            #ffe57f
        );

}


.vmx-main-card::after {

    content: "";

    position: absolute;

    width: 330px;

    height: 330px;

    right: -170px;

    bottom: -180px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            rgba(255,195,0,.13),
            transparent 68%
        );

    transition: .6s;

}


.vmx-main-card:hover {

    transform: translateY(-9px);

    box-shadow:
        0 35px 85px rgba(0,31,63,.15);

}


.vmx-main-card:hover::after {

    transform: scale(1.35);

}


.vmx-card-top {

    display: grid;

    grid-template-columns: 50px 72px 1fr;

    align-items: center;

    gap: 16px;

}


.vmx-card-number {

    color: #aab4c0;

    font-size: 11px;

    font-weight: 950;

}


.vmx-card-icon {

    width: 72px;

    height: 72px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 21px;

    background: var(--vmx-navy);

    color: var(--vmx-gold);

    font-size: 28px;

    box-shadow:
        0 15px 30px rgba(0,31,63,.18);

}


.vmx-card-label {

    justify-self: end;

    padding: 7px 10px;

    border-radius: 30px;

    background: #f1f5f9;

    color: #728093;

    font-size: 8px;

    font-weight: 950;

