</style>

<script>
document.addEventListener("DOMContentLoaded",function(){
    const elements=document.querySelectorAll(".stat-card,.fees-card,.fees-note");
    if(!("IntersectionObserver" in window)) return;
    const observer=new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
            if(entry.isIntersecting){
                entry.target.classList.add("fee-visible");
                observer.unobserve(entry.target);
            }
        });
    },{threshold:.12});
    elements.forEach(function(el){
        el.classList.add("fee-reveal");
        observer.observe(el);
    });
});
</script>


<!-- =========================================================
     PDF / PRINT SCRIPT
========================================================= -->

<script>

function getFeeCard(id) {

    return document.getElementById(
        'fee-' + id
    );

}


/* =========================================================
   DOWNLOAD / PRINT FEE CARD
========================================================= */

function downloadFeeCard(id) {

    printFeeCard(id);

}


/* =========================================================
   PRINT FEE CARD
========================================================= */

function printFeeCard(id) {

    const original =
        getFeeCard(id);


    if (!original) {

        alert(
            'Fee structure not found.'
        );

        return;

    }


    const section =
        original.cloneNode(true);


    const actions =
        section.querySelector(
            '.card-actions'
        );


    if (actions) {

        actions.remove();

    }


    const notes =
        section.querySelector(
            '.fee-notes'
        );


    const session =
        '<%= currentSession %>';


    const schoolName =
        '<%= schoolName.replace(/'/g, "\\'") %>';


    const schoolLogo =
        '<%= schoolLogo.replace(/'/g, "\\'") %>';


    const printWindow =
        window.open(
            '',
            '_blank'
        );


    if (!printWindow) {

        alert(
            'Please allow pop-ups to print or download the fee structure.'
        );

        return;

    }


    printWindow.document.write(`

        <!DOCTYPE html>

        <html>

        <head>

            <meta charset="UTF-8">

            <title>
                ${schoolName} - Fees Structure
            </title>


            <style>

                * {
                    box-sizing: border-box;
                }


                @page {
                    size: A4;
                    margin: 15mm;
                }


                body {

                    margin: 0;

                    font-family:
                        Arial,
                        Helvetica,
                        sans-serif;

                    color: #172b3f;

                    background: #fff;

                }


                .print-header {

                    text-align: center;

                    padding-bottom: 22px;

                    margin-bottom: 25px;

                    border-bottom:
                        3px solid
                        #ffc300;

                }


                .print-header img {

                    width: 85px;

                    height: 85px;

                    object-fit: contain;

                    border-radius: 50%;

                }


                .print-header h1 {

                    margin:
                        8px 0 4px;

                    color: #8b0000;

                    font-size: 27px;

                }


                .print-header h2 {

                    margin:
                        0 0 5px;

                    color: #001f3f;

                    font-size: 21px;

                }


                .print-header p {

                    margin: 0;

                    color: #666;

                    font-size: 13px;

                }


                .fees-card {

                    border:
                        2px solid
                        #001f3f;

                    border-radius: 16px;

                    overflow: hidden;

                    box-shadow: none;

                }


                .fees-head {

                    background: #001f3f !important;

                    color: #fff !important;

                    text-align: center;

                    padding: 28px;

                }


                .fees-icon {

                    width: auto !important;

                    height: auto !important;

                    background: transparent !important;

                    border: none !important;

                }


                .fees-icon i {

                    color: #ffc300 !important;

                    font-size: 28px;

                }


                .card-number {

                    display: none;

                }


                .fees-section-label {

                    color: #ffc300 !important;

                    font-size: 10px;

                    font-weight: bold;

                }


                .fees-head h3 {

                    color: #fff !important;

                    font-size: 26px;

                    margin: 8px 0;

                }


                .fees-head p {

                    color: #fff !important;

                }


                .card-session {

                    color: #fff !important;

                }


                .fee-row {

                    display: flex;

                    justify-content: space-between;

                    align-items: center;

                    padding: 14px 18px;

                    border-bottom:
                        1px solid
                        #ddd;

                }


                .fee-row-number {

                    display: none;

                }


                .fee-name {

                    font-size: 14px;

                    font-weight: bold;

                }


                .fee-amount {

                    color: #001f3f;

                    font-weight: bold;

                }


                .annual-row {

                    display: flex;

                    justify-content: space-between;

                    padding: 17px 18px;

                    background: #ffc300 !important;

                    color: #001f3f !important;

                }


                .annual-row strong {

                    font-size: 18px;

                }


                .annual-row small {

                    display: none;

                }


                .fee-notes {

                    padding: 12px 18px;

                    background: #fffdf4;

                }


                .fee-notes p {

                    font-size: 11px;

                }


                .print-footer {

                    margin-top: 25px;

                    padding-top: 15px;

                    border-top:
                        1px solid
                        #ddd;

                    font-size: 11px;

                    color: #666;

                    line-height: 1.6;

                }

            </style>

        </head>


        <body>


            <div class="print-header">

                <img
                    src="${schoolLogo}"
                    alt="School Logo"
                >

                <h1>
                    ${schoolName}
                </h1>

                <h2>
                    Fees Structure
                </h2>

                <p>
                    Academic Session ${session}
                </p>

            </div>


            ${section.outerHTML}


            <div class="print-footer">

                <strong>
                    Important Note:
                </strong>

                Transport, uniform, books and other
                applicable charges may be separate.
                Please contact the school office for
                final confirmation of applicable fees.

                <br><br>

                This fee structure is intended for
                informational purposes.

            </div>


        </body>

        </html>

    `);


    printWindow.document.close();

    printWindow.focus();


    setTimeout(
        function () {

            printWindow.print();

        },
        600
    );

}

</script>


