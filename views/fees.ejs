.fees-card:nth-child(1){--fee-index:1}.fees-card:nth-child(2){--fee-index:2}
.fees-card:nth-child(3){--fee-index:3}.fees-card:nth-child(4){--fee-index:4}
.fees-card:nth-child(5){--fee-index:5}.fees-card:nth-child(6){--fee-index:6}
@keyframes feeCardIn{to{opacity:1;transform:translateY(0)}}

.fees-card::before{
