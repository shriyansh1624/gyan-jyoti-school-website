      linear-gradient(135deg,#00142c 0%,#002b52 48%,#004b78 100%)!important;
}
.fees-hero::after{
    content:"";position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.55;
    background:
      radial-gradient(circle at 20% 30%,rgba(255,255,255,.9) 0 1px,transparent 2px),
      radial-gradient(circle at 70% 20%,rgba(255,195,0,.9) 0 1px,transparent 2px),
      radial-gradient(circle at 82% 60%,rgba(255,255,255,.7) 0 1px,transparent 2px),
      radial-gradient(circle at 45% 78%,rgba(255,195,0,.7) 0 1px,transparent 2px);
    background-size:170px 170px,230px 230px,190px 190px,260px 260px;
    animation:feeStars 18s linear infinite;
}
@keyframes feeStars{from{transform:translate3d(0,0,0)}to{transform:translate3d(80px,-55px,0)}}

.fees-grid-pattern{
    opacity:.13!important;background-size:42px 42px!important;
    transform:perspective(500px) rotateX(55deg) scale(1.35);
    transform-origin:center bottom;
    mask-image:linear-gradient(to bottom,transparent,#000 25%,#000);
    animation:feeGrid 14s linear infinite;
}
@keyframes feeGrid{from{background-position:0 0}to{background-position:84px 84px}}

.fees-orb-one{
    width:620px!important;height:620px!important;left:-300px!important;top:-330px!important;
    border-color:rgba(255,195,0,.32)!important;
    box-shadow:0 0 0 70px rgba(255,195,0,.045),0 0 0 140px rgba(255,195,0,.025),0 0 80px rgba(255,195,0,.08);
    animation:feeOrb 9s ease-in-out infinite;
}
.fees-orb-two{
    width:520px!important;height:520px!important;right:-245px!important;bottom:-285px!important;
    animation:feeOrb 11s 1s ease-in-out infinite reverse;
}
