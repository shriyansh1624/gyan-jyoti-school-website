<%
    /*
     * =========================================================
     * SAFE DATA
     * =========================================================
     */

    const safeSchoolInfo =
        typeof schoolInfo !== 'undefined' && schoolInfo
            ? schoolInfo
            : {};

    const safeFeeStructures =
        typeof feeStructures !== 'undefined' && Array.isArray(feeStructures)
            ? feeStructures
            : [];

    const currentSession =
        safeFeeStructures.length && safeFeeStructures[0].session
            ? safeFeeStructures[0].session
            : '2026-27';

    const schoolName =
        safeSchoolInfo.schoolName ||
        'Gyan Jyoti School';

    const schoolLogo =
        safeSchoolInfo.logo ||
        '/images/logo.png';

    const schoolTagline =
        safeSchoolInfo.tagline ||
        'International School';

    const schoolAffiliation =
        safeSchoolInfo.affiliation ||
        'CBSE Affiliation No. 1030842';
%>


<%- include('partials/header') %>


<!-- =========================================================
     FEES HERO
========================================================= -->

<section class="fees-hero">

    <div class="fees-orb fees-orb-one"></div>
    <div class="fees-orb fees-orb-two"></div>
    <div class="fees-grid-pattern"></div>

    <div class="fees-container fees-hero-content">

        <div class="hero-logo-wrap">

            <img
                src="<%= schoolLogo %>"
                class="fees-logo"
                alt="<%= schoolName %> Logo"
            >

            <span class="hero-logo-ring"></span>

        </div>


        <div class="fees-badge">

            <i class="fas fa-calendar-days"></i>

            SESSION

            <strong>
                <%= currentSession %>
            </strong>

        </div>


        <h1>
            Fees Structure
        </h1>


        <p>
            Transparent and class-wise fee structure
            for <%= schoolName %>.
        </p>


        <div class="hero-meta">

            <span>
                <i class="fas fa-school"></i>
                <%= schoolTagline %>
            </span>

            <span>
                <i class="fas fa-certificate"></i>
                <%= schoolAffiliation %>
            </span>

        </div>

    </div>

</section>



<!-- =========================================================
     MAIN FEES SECTION
========================================================= -->

<section class="fees-section">

    <div class="fees-container">


        <!-- =====================================================
             SECTION HEADING
        ====================================================== -->

        <div class="fees-heading">

            <div class="heading-top">

                <span class="section-tag">

                    <i class="fas fa-wallet"></i>

                    CLASS WISE FEES

                </span>

                <span class="session-chip">

                    <i class="fas fa-calendar"></i>

                    <%= currentSession %>

                </span>

            </div>


            <h2>
                Transparent Fee Structure
            </h2>


            <p>
                Select your academic section to view
                complete fee details.
            </p>

        </div>



        <!-- =====================================================
             QUICK STATS
        ====================================================== -->

        <% if (safeFeeStructures.length > 0) { %>

            <div class="fees-stats">

                <div class="stat-card">

                    <div class="stat-icon blue">
                        <i class="fas fa-layer-group"></i>
                    </div>

                    <div>

                        <span>
                            Available Sections
                        </span>

                        <strong>
                            <%= safeFeeStructures.length %>
                        </strong>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon yellow">
                        <i class="fas fa-calendar-check"></i>
                    </div>

                    <div>

                        <span>
                            Academic Session
                        </span>

                        <strong>
                            <%= currentSession %>
                        </strong>

                    </div>

                </div>


                <div class="stat-card">

                    <div class="stat-icon green">
                        <i class="fas fa-shield-halved"></i>
                    </div>

                    <div>

                        <span>
                            Fee Information
                        </span>

                        <strong>
                            Official
                        </strong>

                    </div>

                </div>

            </div>

        <% } %>



        <!-- =====================================================
             NO DATA
        ====================================================== -->

        <% if (safeFeeStructures.length === 0) { %>

            <div class="fees-empty">

                <div class="empty-icon">

                    <i class="fas fa-file-invoice-dollar"></i>

                </div>


                <span class="empty-badge">
                    FEES INFORMATION
                </span>


                <h3>
                    Fee Structure Currently Unavailable
                </h3>


                <p>
                    Please contact the school office for
                    the latest fee information.
                </p>


                <% if (
                    safeSchoolInfo.phone
                ) { %>

                    <a
                        href="tel:<%= safeSchoolInfo.phone %>"
                        class="empty-contact-btn"
                    >

                        <i class="fas fa-phone"></i>

                        Contact School

                    </a>

                <% } %>

            </div>


        <% } else { %>



            <!-- =================================================
                 FEES GRID
            ================================================== -->

            <div class="fees-grid">


                <% safeFeeStructures.forEach(function(fee, index) { %>


                    <article
                        class="fees-card"
                        id="fee-<%= fee._id %>"
                    >


                        <!-- =====================================
                             CARD HEADER
                        ====================================== -->

                        <div class="fees-head">


                            <div class="card-number">
                                <%= String(index + 1).padStart(2, '0') %>
                            </div>


                            <div class="fees-icon">

                                <i class="<%= fee.icon || 'fas fa-graduation-cap' %>"></i>

                            </div>


                            <span class="fees-section-label">

                                <i class="fas fa-graduation-cap"></i>

                                <%= fee.section
                                    ? fee.section
                                        .replace(/-/g, ' ')
                                        .toUpperCase()
                                    : 'ACADEMIC SECTION'
                                %>

                            </span>


                            <h3>
                                <%= fee.title || 'Fee Structure' %>
                            </h3>


                            <p>
                                <i class="fas fa-users"></i>

                                <%= fee.classRange || 'Class details' %>
                            </p>


                            <div class="card-session">

                                <i class="fas fa-calendar-days"></i>

                                Session

                                <strong>
                                    <%= fee.session || currentSession %>
                                </strong>

                            </div>

                        </div>



                        <!-- =====================================
                             FEE BODY
                        ====================================== -->

                        <div class="fees-body">


                            <% if (
                                fee.fees &&
                                Array.isArray(fee.fees) &&
                                fee.fees.length
                            ) { %>


                                <div class="fee-list">


                                    <% fee.fees.forEach(function(item, feeIndex) { %>


                                        <div class="fee-row">


                                            <div class="fee-row-left">

                                                <span class="fee-row-number">
                                                    <%= String(feeIndex + 1).padStart(2, '0') %>
                                                </span>


                                                <span class="fee-name">

                                                    <%= item.name || 'Fee' %>

                                                </span>

                                            </div>


                                            <strong class="fee-amount">

                                                ₹ <%= Number(
                                                    item.amount || 0
                                                ).toLocaleString('en-IN') %>

                                            </strong>


                                        </div>


                                    <% }); %>


                                </div>


                            <% } else { %>


                                <div class="no-fees">

                                    <i class="fas fa-circle-info"></i>

                                    Fee details not available.

                                </div>


                            <% } %>



                            <!-- =================================
                                 ANNUAL APPROX
                            ================================== -->

                            <div class="annual-row">


                                <div>

                                    <span class="annual-label">

                                        <i class="fas fa-chart-line"></i>

                                        Annual Approx.

                                    </span>

                                    <small>
                                        Estimated yearly fee
                                    </small>

                                </div>


                                <strong>

                                    ₹ <%= Number(
                                        fee.annualApprox || 0
                                    ).toLocaleString('en-IN') %>

                                </strong>

                            </div>



                            <!-- =================================
                                 NOTES
                            ================================== -->

                            <% if (fee.notes) { %>

                                <div class="fee-notes">

                                    <i class="fas fa-circle-info"></i>

                                    <p>
                                        <%= fee.notes %>
                                    </p>

                                </div>

                            <% } %>



                            <!-- =================================
                                 DOWNLOAD
                            ================================== -->

                            <div class="card-actions">


                                <button
                                    type="button"
                                    class="download-btn"
                                    onclick="downloadFeeCard('<%= fee._id %>')"
                                >

                                    <i class="fas fa-file-pdf"></i>

                                    Download PDF

                                </button>


                                <button
                                    type="button"
                                    class="print-btn"
                                    onclick="printFeeCard('<%= fee._id %>')"
                                >

                                    <i class="fas fa-print"></i>

                                    Print

                                </button>


                            </div>


                        </div>


                    </article>


                <% }); %>


            </div>


        <% } %>



        <!-- =====================================================
             IMPORTANT NOTE
        ====================================================== -->

        <div class="fees-note">


            <div class="note-icon">

                <i class="fas fa-circle-info"></i>

            </div>


            <div class="note-content">

                <span class="note-label">
                    IMPORTANT INFORMATION
                </span>


                <h3>
                    Please Note
                </h3>


                <p>
                    Transport, uniform, books and other
                    applicable charges may be separate.
                    Please contact the school office for
                    final confirmation of applicable fees.
                </p>

            </div>


        </div>


    </div>

</section>



<!-- =========================================================
     PREMIUM FEES CSS
========================================================= -->

<style>

/* =========================================================
   BASE
========================================================= */

.fees-container {

    width: 88%;

    max-width: 1280px;

    margin: 0 auto;

}


.fees-section {

    background:
        linear-gradient(
            180deg,
            #f4f8fc 0%,
            #eef3f8 100%
        );

    padding: 85px 0 100px;

    position: relative;

}


/* =========================================================
   HERO
========================================================= */

.fees-hero {

    min-height: 470px;

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    color: #fff;

    overflow: hidden;

    background:

        radial-gradient(
            circle at 15% 20%,
            rgba(255,195,0,.16),
            transparent 28%
        ),

        radial-gradient(
            circle at 85% 80%,
            rgba(0,91,160,.55),
            transparent 30%
        ),

        linear-gradient(
            135deg,
            #001f3f 0%,
            #003b6f 55%,
            #004d89 100%
        );

}


.fees-hero::before {

    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.15),
            transparent,
            rgba(0,0,0,.15)
        );

}


.fees-orb {

    position: absolute;

    border-radius: 50%;

    pointer-events: none;

}


.fees-orb-one {

    width: 500px;

    height: 500px;

    left: -240px;

    top: -250px;

    border:
        1px solid
        rgba(255,195,0,.25);

    box-shadow:
        0 0 0 60px rgba(255,195,0,.04),
        0 0 0 120px rgba(255,195,0,.025);

}


.fees-orb-two {

    width: 420px;

    height: 420px;

    right: -190px;

    bottom: -220px;

    border:
        1px solid
        rgba(255,255,255,.12);

    box-shadow:
        0 0 0 70px rgba(255,255,255,.025);

}


.fees-grid-pattern {

    position: absolute;

    inset: 0;

    opacity: .08;

    background-image:

        linear-gradient(
            rgba(255,255,255,.4) 1px,
            transparent 1px
        ),

        linear-gradient(
            90deg,
            rgba(255,255,255,.4) 1px,
            transparent 1px
        );

    background-size: 55px 55px;

}


.fees-hero-content {

    position: relative;

    z-index: 5;

    padding: 65px 0;

}


.hero-logo-wrap {

    width: 125px;

    height: 125px;

    margin:
        0 auto 25px;

    position: relative;

}


.fees-logo {

    width: 125px;

    height: 125px;

    object-fit: contain;

    background: #fff;

    border-radius: 50%;

    padding: 7px;

    border:
        5px solid
        #ffc300;

    box-shadow:
        0 22px 55px
        rgba(0,0,0,.35);

    position: relative;

    z-index: 2;

}


.hero-logo-ring {

    position: absolute;

    inset: -12px;

    border:
        1px solid
        rgba(255,195,0,.45);

    border-radius: 50%;

    animation:
        heroRing 4s linear infinite;

}


@keyframes heroRing {

    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }

}


.fees-badge {

    display: inline-flex;

    align-items: center;

    gap: 9px;

    padding: 10px 20px;

    background:
        rgba(255,195,0,.14);

    border:
        1px solid
        rgba(255,195,0,.55);

    color: #ffc300;

    border-radius: 50px;

    font-size: 12px;

    font-weight: 900;

    letter-spacing: 1px;

    margin-bottom: 18px;

    backdrop-filter: blur(10px);

}


.fees-badge strong {

    color: #fff;

}


.fees-hero h1 {

    margin: 0;

    font-size: 64px;

    line-height: 1;

    font-weight: 950;

    letter-spacing: -2px;

    text-shadow:
        0 8px 30px
        rgba(0,0,0,.25);

}


.fees-hero p {

    margin: 18px auto 0;

    max-width: 680px;

    font-size: 18px;

    line-height: 1.7;

    opacity: .92;

}


.hero-meta {

    margin-top: 22px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-wrap: wrap;

    gap: 10px;

}


.hero-meta span {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 9px 14px;

    border-radius: 50px;

    background:
        rgba(255,255,255,.08);

    border:
        1px solid
        rgba(255,255,255,.12);

    font-size: 12px;

    color: rgba(255,255,255,.9);

}


.hero-meta i {

    color: #ffc300;

}


/* =========================================================
   HEADING
========================================================= */

.fees-heading {

    text-align: center;

    margin-bottom: 40px;

}


.heading-top {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    flex-wrap: wrap;

}


.section-tag {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    background: #ffc300;

    color: #001f3f;

    padding: 9px 18px;

    border-radius: 50px;

    font-size: 11px;

    font-weight: 950;

    letter-spacing: 1px;

}


.session-chip {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 8px 16px;

    border-radius: 50px;

    background: #fff;

    color: #001f3f;

    border:
        1px solid
        #dce5ef;

    font-size: 12px;

    font-weight: 800;

    box-shadow:
        0 8px 20px
        rgba(0,31,63,.06);

}


.session-chip i {

    color: #ffc300;

}


.fees-heading h2 {

    margin: 17px 0 9px;

    color: #001f3f;

    font-size: 44px;

    font-weight: 950;

    letter-spacing: -1px;

}


.fees-heading p {

    margin: 0;

    color: #708198;

    font-size: 16px;

}


/* =========================================================
   STATS
========================================================= */

.fees-stats {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;

    margin-bottom: 35px;

}


.stat-card {

    display: flex;

    align-items: center;

    gap: 16px;

    padding: 18px 20px;

    background: #fff;

    border:
        1px solid
        #e1e9f1;

    border-radius: 20px;

    box-shadow:
        0 12px 35px
        rgba(0,31,63,.06);

}


.stat-icon {

    width: 52px;

    height: 52px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 16px;

    font-size: 20px;

}


.stat-icon.blue {

    color: #0874c9;

    background: #eaf4ff;

}


.stat-icon.yellow {

    color: #d89900;

    background: #fff7dc;

}


.stat-icon.green {

    color: #009c5a;

    background: #e9fbf2;

}


.stat-card span {

    display: block;

    color: #8291a6;

    font-size: 11px;

    font-weight: 700;

    margin-bottom: 3px;

}


.stat-card strong {

    display: block;

    color: #001f3f;

    font-size: 18px;

    font-weight: 950;

}


/* =========================================================
   GRID
========================================================= */

.fees-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 30px;

}


/* =========================================================
   CARD
========================================================= */

.fees-card {

    background: #fff;

    border-radius: 28px;

    overflow: hidden;

    border-top:
        6px solid
        #ffc300;

    box-shadow:
        0 20px 65px
        rgba(0,31,63,.11);

    transition:
        transform .35s ease,
        box-shadow .35s ease;

    position: relative;

}


.fees-card::after {

    content: "";

    position: absolute;

    width: 160px;

    height: 160px;

    border-radius: 50%;

    border:
        1px solid
        rgba(255,195,0,.08);

    right: -80px;

    top: 90px;

    pointer-events: none;

}


.fees-card:hover {

    transform:
        translateY(-9px);

    box-shadow:
        0 32px 85px
        rgba(0,31,63,.18);

}


/* =========================================================
   CARD HEADER
========================================================= */

.fees-head {

    background:

        radial-gradient(
            circle at 50% 0%,
            rgba(255,195,0,.12),
            transparent 45%
        ),

        linear-gradient(
            135deg,
            #001f3f,
            #004481
        );

    color: #fff;

    text-align: center;

    padding: 35px 25px 32px;

    position: relative;

}


.card-number {

    position: absolute;

    right: 20px;

    top: 18px;

    color:
        rgba(255,255,255,.20);

    font-size: 14px;

    font-weight: 950;

    letter-spacing: 1px;

}


.fees-icon {

    width: 72px;

    height: 72px;

    margin:
        0 auto 17px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 22px;

    background:
        rgba(255,195,0,.13);

    border:
        1px solid
        rgba(255,195,0,.35);

}


.fees-icon i {

    font-size: 32px;

    color: #ffc300;

}


.fees-section-label {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 1.5px;

    color: #ffc300;

    margin-bottom: 8px;

}


.fees-head h3 {

    margin: 0;

    color: #fff;

    font-size: 31px;

    font-weight: 950;

}


.fees-head p {

    margin: 9px 0 0;

    color:
        rgba(255,255,255,.86);

    font-size: 15px;

}


.fees-head p i {

    color: #ffc300;

    margin-right: 5px;

}


.card-session {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    margin-top: 17px;

    padding: 7px 13px;

    border-radius: 50px;

    background:
        rgba(255,255,255,.08);

    border:
        1px solid
        rgba(255,255,255,.12);

    color:
        rgba(255,255,255,.7);

    font-size: 11px;

}


.card-session i {

    color: #ffc300;

}


.card-session strong {

    color: #fff;

}


/* =========================================================
   BODY
========================================================= */

.fees-body {

    background: #fff;

}


.fee-list {

    width: 100%;

}


.fee-row {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;

    min-height: 65px;

    padding: 13px 24px;

    border-bottom:
        1px solid
        #edf1f5;

    transition:
        background .2s ease;

}


.fee-row:hover {

    background:
        #f9fbfd;

}


.fee-row-left {

    display: flex;

    align-items: center;

    gap: 12px;

    min-width: 0;

}


.fee-row-number {

    width: 30px;

    height: 30px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 9px;

    background: #f0f5fa;

    color: #73869a;

    font-size: 10px;

    font-weight: 900;

}


.fee-name {

    color: #263d55;

    font-size: 15px;

    font-weight: 750;

}


.fee-amount {

    color: #001f3f;

    font-size: 16px;

    font-weight: 950;

    white-space: nowrap;

}


/* =========================================================
   ANNUAL
========================================================= */

.annual-row {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 20px;

    padding: 19px 24px;

    background:

        linear-gradient(
            90deg,
            #ffc300,
            #ffd33d
        );

    color: #001f3f;

}


.annual-label {

    display: flex;

    align-items: center;

    gap: 8px;

    font-size: 17px;

    font-weight: 950;

}


.annual-label i {

    font-size: 15px;

}


.annual-row small {

    display: block;

    margin-top: 3px;

    font-size: 10px;

    opacity: .65;

    font-weight: 700;

}


.annual-row strong {

    font-size: 22px;

    font-weight: 950;

    white-space: nowrap;

}


/* =========================================================
   NOTES
========================================================= */

.fee-notes {

    display: flex;

    align-items: flex-start;

    gap: 10px;

    padding: 15px 24px;

    background: #fffdf4;

    border-bottom:
        1px solid
        #f1ead0;

}


.fee-notes i {

    color: #d69c00;

    margin-top: 3px;

}


.fee-notes p {

    margin: 0;

    color: #7c6a38;

    font-size: 12px;

    line-height: 1.55;

}


/* =========================================================
   ACTIONS
========================================================= */

.card-actions {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 22px 24px;

}


.download-btn,
.print-btn {

    border: none;

    cursor: pointer;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    border-radius: 50px;

    font-family: inherit;

    font-weight: 900;

    transition: .3s;

}


.download-btn {

    padding: 14px 20px;

    color: #fff;

    background:
        linear-gradient(
            135deg,
            #001f3f,
            #004481
        );

    box-shadow:
        0 10px 25px
        rgba(0,31,63,.18);

}


.download-btn:hover {

    background: #ffc300;

    color: #001f3f;

    transform:
        translateY(-2px);

}


.print-btn {

    width: 46px;

    height: 46px;

    color: #001f3f;

    background: #eef4f9;

}


.print-btn:hover {

    background: #001f3f;

    color: #fff;

    transform:
        translateY(-2px);

}


/* =========================================================
   EMPTY
========================================================= */

.fees-empty {

    background: #fff;

    border-radius: 30px;

    text-align: center;

    padding: 90px 25px;

    box-shadow:
        0 20px 60px
        rgba(0,31,63,.09);

    border:
        1px solid
        #e5ecf3;

}


.empty-icon {

    width: 95px;

    height: 95px;

    margin:
        0 auto 23px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 28px;

    background:
        linear-gradient(
            135deg,
            #edf5fc,
            #f6f9fc
        );

    color: #62809d;

    font-size: 36px;

}


.empty-badge {

    display: inline-block;

    padding: 7px 14px;

    background: #fff7d7;

    color: #b58100;

    border-radius: 50px;

    font-size: 10px;

    font-weight: 900;

    letter-spacing: 1px;

}


.fees-empty h3 {

    color: #001f3f;

    font-size: 28px;

    margin:
        15px 0 9px;

}


.fees-empty p {

    color: #738399;

    margin: 0 0 22px;

}


.empty-contact-btn {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 13px 20px;

    border-radius: 50px;

    background: #001f3f;

    color: #fff;

    text-decoration: none;

    font-weight: 800;

}


/* =========================================================
   IMPORTANT NOTE
========================================================= */

.fees-note {

    margin-top: 42px;

    display: flex;

    gap: 18px;

    align-items: flex-start;

    padding: 26px;

    background: #fff;

    border-radius: 22px;

    border:
        1px solid
        #e2eaf2;

    border-left:
        6px solid
        #ffc300;

    box-shadow:
        0 15px 40px
        rgba(0,31,63,.07);

}


.note-icon {

    width: 50px;

    height: 50px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 15px;

    background: #fff7d8;

    color: #d69b00;

    font-size: 20px;

}


.note-label {

    color: #c18b00;

    font-size: 10px;

    font-weight: 950;

    letter-spacing: 1.3px;

}


.fees-note h3 {

    margin:
        4px 0 6px;

    color: #001f3f;

    font-size: 20px;

}


.fees-note p {

    margin: 0;

    color: #66768a;

    line-height: 1.7;

    font-size: 14px;

}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width: 900px) {

    .fees-container {

        width: 92%;

    }


    .fees-grid {

        grid-template-columns: 1fr;

    }


    .fees-stats {

        grid-template-columns: 1fr;

    }


    .fees-hero {

        min-height: 420px;

    }


    .fees-hero h1 {

        font-size: 46px;

    }


    .fees-heading h2 {

        font-size: 35px;

    }

}


@media(max-width: 600px) {

    .fees-section {

        padding:
            60px 0 75px;

    }


    .fees-hero {

        min-height: 390px;

    }


    .fees-hero-content {

        padding:
            50px 0;

    }


    .hero-logo-wrap,
    .fees-logo {

        width: 100px;

        height: 100px;

    }


    .fees-hero h1 {

        font-size: 38px;

        letter-spacing: -1px;

    }


    .fees-hero p {

        font-size: 15px;

    }


    .hero-meta {

        display: none;

    }


    .fees-heading h2 {

        font-size: 31px;

    }


    .fees-card {

        border-radius: 22px;

    }


    .fees-head {

        padding:
            30px 18px;

    }


    .fees-head h3 {

        font-size: 27px;

    }


    .fee-row {

        padding:
            13px 16px;

        gap: 10px;

    }


    .fee-name {

        font-size: 14px;

    }


    .fee-amount {

        font-size: 14px;

    }


    .annual-row {

        padding:
            17px;

    }


    .annual-label {

        font-size: 14px;

    }


    .annual-row strong {

        font-size: 17px;

    }


    .card-actions {

        padding:
            18px;

    }


    .download-btn {

        flex: 1;

        padding:
            13px 12px;

        font-size: 12px;

    }


    .fees-note {

        padding: 20px;

    }

}


@media(max-width: 400px) {

    .fees-hero h1 {

        font-size: 33px;

    }


    .fees-heading h2 {

        font-size: 27px;

    }


    .fee-row-number {

        display: none;

    }


    .fee-row {

        padding:
            13px 14px;

    }


    .annual-row {

        gap: 10px;

    }


    .annual-row small {

        display: none;

    }

}

</style>




<style>
/* ================= PREMIUM FEES UI — FRONTEND ONLY ================= */

