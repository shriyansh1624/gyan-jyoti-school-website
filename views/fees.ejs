    background:linear-gradient(115deg,transparent 25%,rgba(255,255,255,.25) 48%,transparent 67%);
    transform:translateX(-130%);transition:transform .8s ease;
}
.fees-card:hover::before{transform:translateX(130%)}
.fees-card::after{
