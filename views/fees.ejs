.fees-hero-content{z-index:6!important;animation:feeHeroIn .9s ease both}
@keyframes feeHeroIn{from{opacity:0;transform:translateY(25px)}to{opacity:1;transform:translateY(0)}}

.hero-logo-wrap{filter:drop-shadow(0 25px 35px rgba(0,0,0,.25))}
.fees-logo{transition:transform .6s cubic-bezier(.2,.8,.2,1)}
