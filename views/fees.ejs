.fees-head::after{
    content:"";position:absolute;width:180px;height:180px;right:-100px;bottom:-115px;
    border:1px solid rgba(255,255,255,.10);border-radius:50%;box-shadow:0 0 0 35px rgba(255,255,255,.025);
}
.fees-icon{box-shadow:0 15px 35px rgba(0,0,0,.20),inset 0 0 25px rgba(255,195,0,.08);transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s ease}
.fees-card:hover .fees-icon{transform:translateY(-7px) rotate(5deg) scale(1.08);box-shadow:0 22px 45px rgba(0,0,0,.27),0 0 25px rgba(255,195,0,.16)}
.fees-head h3{text-shadow:0 8px 25px rgba(0,0,0,.2)}

.fee-row{position:relative}
.fee-row::after{content:"";position:absolute;left:0;bottom:0;width:0;height:1px;background:#ffc300;transition:width .35s ease}
.fee-row:hover::after{width:100%}
.fee-row-number{transition:background .25s ease,color .25s ease,transform .25s ease}
.fee-row:hover .fee-row-number{background:#fff5c7;color:#a87700;transform:scale(1.08)}
.fee-amount{transition:transform .25s ease,color .25s ease}
.fee-row:hover .fee-amount{color:#b77f00;transform:translateX(-3px)}

.annual-row{position:relative;overflow:hidden}
.annual-row::before{
    content:"";position:absolute;top:0;left:-80%;width:45%;height:100%;transform:skewX(-20deg);
    background:rgba(255,255,255,.28);transition:left .7s ease;
}
.fees-card:hover .annual-row::before{left:140%}
.annual-row strong{text-shadow:0 3px 10px rgba(0,0,0,.10)}

.download-btn,.print-btn{position:relative;overflow:hidden}
.download-btn::after{
    content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent,rgba(255,255,255,.18),transparent);
    transform:translateX(-130%);transition:transform .6s ease;
}
.download-btn:hover::after{transform:translateX(130%)}
.download-btn:hover,.print-btn:hover{box-shadow:0 12px 28px rgba(0,31,63,.18)}

.fees-note{position:relative;overflow:hidden;transition:transform .35s ease,box-shadow .35s ease}
.fees-note::before{
    content:"";position:absolute;left:0;top:0;width:5px;height:100%;background:linear-gradient(#ffc300,#e3a900);
}
.fees-note:hover{transform:translateY(-4px);box-shadow:0 22px 50px rgba(0,31,63,.11)}
.note-icon{transition:transform .35s ease}
.fees-note:hover .note-icon{transform:rotate(-7deg) scale(1.06)}

.fees-empty{position:relative;overflow:hidden}
.fees-empty::before,.fees-empty::after{
    content:"";position:absolute;width:180px;height:180px;border:1px solid rgba(255,195,0,.12);border-radius:50%;
}
.fees-empty::before{left:-80px;top:-80px}.fees-empty::after{right:-80px;bottom:-80px}
.empty-icon{animation:emptyFloat 3.5s ease-in-out infinite}
