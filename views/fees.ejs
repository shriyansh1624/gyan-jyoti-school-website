    .fees-hero::after,.fees-grid-pattern,.fees-orb-one,.fees-orb-two,.fees-badge,.hero-logo-ring,.empty-icon,.fees-card{animation:none!important}
    .fees-card{opacity:1!important;transform:none!important}
