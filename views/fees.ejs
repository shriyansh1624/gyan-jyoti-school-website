.fees-head{
    min-height:245px;display:flex;flex-direction:column;align-items:center;justify-content:center;
    background:radial-gradient(circle at 50% 0%,rgba(255,195,0,.18),transparent 48%),linear-gradient(145deg,#00172f,#003d6d 62%,#00517d)!important;
