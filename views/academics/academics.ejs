<script>
/* =========================================================
   ACHIEVEMENT FILTER
   ORIGINAL FILTER BEHAVIOUR PRESERVED
========================================================= */

const filterButtons =
    document.querySelectorAll(".filter-btn");

const sections =
    document.querySelectorAll(".achievement-section");

const noResults =
    document.getElementById("noResults");

filterButtons.forEach(button => {

    button.addEventListener("click", () => {

        const filter =
            button.dataset.filter;

        filterButtons.forEach(btn =>
            btn.classList.remove("active")
        );

        button.classList.add("active");

        let visibleCards = 0;

        sections.forEach(section => {

            const cards =
                section.querySelectorAll(".achievement-card");

            let sectionVisible = 0;

            cards.forEach(card => {

                const cardClass =
                    card.dataset.class;

                const cardRank =
                    card.dataset.rank;

                let show = false;

                if(filter === "all"){
                    show = true;
                }
                else if(filter === "10th"){
                    show = cardClass === "10th";
                }
                else if(filter === "12th"){
                    show = cardClass === "12th";
                }
                else{
                    show = cardRank === filter;
                }

                if(show){

                    card.classList.remove("hidden");

                    sectionVisible++;
                    visibleCards++;

                }
                else{

                    card.classList.add("hidden");

                }

            });

            section.style.display =
                sectionVisible === 0
                    ? "none"
                    : "block";

        });

        if(visibleCards === 0){
            noResults.classList.add("show");
        }
        else{
            noResults.classList.remove("show");
        }

        const main =
            document.querySelector(".achievers-main");

        if(main){

            window.scrollTo({
                top:main.offsetTop - 30,
                behavior:"smooth"
            });

        }

    });

});

/* =========================================================
   PREMIUM MICRO INTERACTIONS
   UI ONLY — NO BACKEND / DATA CHANGES
========================================================= */

document.addEventListener("DOMContentLoaded",function(){

    const cards =
        document.querySelectorAll(".achievement-card");

    /* ---------------------------------------------------------
       1. Mouse spotlight + subtle 3D tilt
    --------------------------------------------------------- */

    cards.forEach(card => {

        card.addEventListener("mousemove",function(e){

            if(window.innerWidth < 901) return;

            const rect =
                card.getBoundingClientRect();

            const x =
                e.clientX - rect.left;

            const y =
                e.clientY - rect.top;

            const px =
                x / rect.width;

            const py =
                y / rect.height;

            const ry =
                ((px - .5) * 5).toFixed(2);

            const rx =
                ((.5 - py) * 4).toFixed(2);

            card.style.setProperty(
                "--mx",
                (px * 100) + "%"
            );

            card.style.setProperty(
                "--my",
                (py * 100) + "%"
            );

            card.style.transform =
                `translateY(-7px)
                 rotateX(${rx}deg)
                 rotateY(${ry}deg)`;

        });

        card.addEventListener("mouseleave",function(){

            card.style.removeProperty("transform");

        });

    });

    /* ---------------------------------------------------------
       2. Filter cards receive fresh reveal animation
    --------------------------------------------------------- */

    filterButtons.forEach(button => {

        button.addEventListener("click",function(){

            setTimeout(() => {

                document
                    .querySelectorAll(
                        ".achievement-card:not(.hidden)"
                    )
                    .forEach((card,index) => {

                        card.classList.remove(
                            "filter-reveal"
                        );

                        void card.offsetWidth;

                        card.style.animationDelay =
                            Math.min(index * 65,450) + "ms";

                        card.classList.add(
                            "filter-reveal"
                        );

                    });

            },25);

        });

    });

});
</script>

