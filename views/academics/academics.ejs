<%- include('../partials/header') %>

<style>
/* =========================================================
   TOP ACHIEVERS — COMPLETE PREMIUM UI
   BACKEND / EJS DATA CONTRACT UNCHANGED
========================================================= */

.achievers-page{
    --navy:#001d3d;
    --blue:#075c98;
    --blue2:#0b82c7;
    --yellow:#ffc300;
    --yellow2:#ffe27a;
    --text:#092c4d;
    --muted:#71869b;
    --bg:#edf3f9;
    --white:#fff;
    --border:#dce6ef;
    --green:#0fa968;
    --purple:#7457d8;
    --red:#e93645;

    min-height:100vh;
    color:var(--text);
    font-family:"Nunito","Segoe UI",Arial,sans-serif;
    background:
        radial-gradient(circle at 5% 20%,rgba(7,92,152,.07),transparent 25%),
        radial-gradient(circle at 95% 80%,rgba(255,195,0,.08),transparent 25%),
        linear-gradient(135deg,#edf3f9 0%,#f8fbff 50%,#e8f0f8 100%);
    overflow:hidden;
    position:relative;
}

.achievers-page::before,
.achievers-page::after{
    content:"";
    position:fixed;
    width:480px;
    height:480px;
    border-radius:50%;
    pointer-events:none;
    filter:blur(15px);
    z-index:0;
}

.achievers-page::before{
    left:-330px;
    top:30%;
    background:radial-gradient(circle,rgba(7,92,152,.10),transparent 68%);
    animation:ambientFloat 13s ease-in-out infinite;
}

.achievers-page::after{
    right:-320px;
    bottom:0;
    background:radial-gradient(circle,rgba(255,195,0,.11),transparent 68%);
    animation:ambientFloat 16s 2s ease-in-out infinite reverse;
}

@keyframes ambientFloat{
    0%,100%{transform:translate3d(0,0,0) scale(1)}
    50%{transform:translate3d(35px,-25px,0) scale(1.08)}
}

.achievers-hero,
.achievers-main{
    position:relative;
    z-index:1;
}

.achievers-container{
    width:min(1200px,calc(100% - 40px));
    margin:auto;
    position:relative;
    z-index:2;
}

/* =========================================================
   HERO
========================================================= */

.achievers-hero{
    min-height:430px;
    display:flex;
    align-items:center;
    position:relative;
    overflow:hidden;
    border-bottom:4px solid var(--yellow);
    background:
        radial-gradient(circle at 12% 80%,rgba(255,195,0,.17),transparent 25%),
        radial-gradient(circle at 87% 18%,rgba(61,186,255,.18),transparent 28%),
        linear-gradient(125deg,#00142d 0%,#002e59 48%,#075c98 100%);
}

.achievers-hero::before{
    content:"";
    position:absolute;
    width:650px;
    height:650px;
    right:-250px;
    top:-390px;
    border:1px solid rgba(255,255,255,.13);
    border-radius:50%;
    box-shadow:
        0 0 0 45px rgba(255,255,255,.018),
        0 0 0 95px rgba(255,195,0,.025);
    animation:heroRing 18s linear infinite;
}

.achievers-hero::after{
    content:"";
    position:absolute;
    width:430px;
    height:430px;
    right:75px;
    top:-225px;
    border:1px solid rgba(255,195,0,.15);
    border-radius:50%;
    animation:heroRing 12s linear infinite reverse;
}

@keyframes heroRing{
    from{transform:rotate(0)}
    to{transform:rotate(360deg)}
}

.hero-content{
    max-width:850px;
    animation:heroIn .9s cubic-bezier(.2,.75,.2,1) both;
}

@keyframes heroIn{
    from{opacity:0;transform:translateY(30px)}
    to{opacity:1;transform:translateY(0)}
}

.hero-label{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:9px 15px;
    color:var(--yellow);
    background:rgba(255,195,0,.08);
    border:1px solid rgba(255,195,0,.30);
    border-radius:999px;
    backdrop-filter:blur(12px);
    font-size:11px;
    font-weight:900;
    letter-spacing:2px;
    text-transform:uppercase;
    margin-bottom:16px;
}

.hero-label::before{
    content:"";
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--yellow);
    box-shadow:0 0 0 5px rgba(255,195,0,.10),0 0 18px rgba(255,195,0,.65);
    animation:liveDot 1.8s ease-in-out infinite;
}

@keyframes liveDot{
    0%,100%{transform:scale(1);opacity:1}
    50%{transform:scale(.72);opacity:.55}
}

.hero-content h1{
    margin:0;
    color:#fff;
    font-size:clamp(40px,5.5vw,68px);
    line-height:1;
    font-weight:900;
    letter-spacing:-2px;
    text-shadow:0 8px 30px rgba(0,0,0,.25);
}

.hero-content h1 span{
    background:linear-gradient(100deg,#ffc300,#ffe27a,#ffc300);
    background-size:220% auto;
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    animation:goldSweep 4s ease-in-out infinite;
}

@keyframes goldSweep{
    0%,100%{background-position:0 center}
    50%{background-position:100% center}
}

.hero-content h1::after{
    content:"";
    display:block;
    width:95px;
    height:5px;
    margin-top:20px;
    border-radius:99px;
    background:linear-gradient(90deg,transparent,var(--yellow),transparent);
    animation:underlinePulse 2.8s ease-in-out infinite;
}

@keyframes underlinePulse{
    0%,100%{transform:scaleX(.55);opacity:.55}
    50%{transform:scaleX(1.15);opacity:1}
}

.hero-content p{
    max-width:720px;
    margin:18px 0 0;
    color:rgba(255,255,255,.80);
    font-size:14px;
    line-height:1.75;
    font-weight:600;
}

.hero-breadcrumb{
    display:inline-flex;
    align-items:center;
    margin-top:22px;
    padding:8px 13px;
    border:1px solid rgba(255,255,255,.10);
    border-radius:999px;
    background:rgba(255,255,255,.055);
    backdrop-filter:blur(12px);
    color:rgba(255,255,255,.65);
    font-size:12px;
    font-weight:700;
}

.hero-breadcrumb a{
    color:var(--yellow);
    text-decoration:none;
}

/* =========================================================
   FLOATING TROPHY
========================================================= */

.hero-trophy{
    position:absolute;
    right:8%;
    top:50%;
    transform:translateY(-50%);
    width:170px;
    height:170px;
    border-radius:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--yellow);
    font-size:62px;
    background:
        radial-gradient(circle at 35% 25%,rgba(255,255,255,.16),transparent 30%),
        linear-gradient(145deg,rgba(255,255,255,.10),rgba(255,255,255,.035));
    border:1px solid rgba(255,255,255,.17);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.16),
        0 30px 80px rgba(0,0,0,.25),
        0 0 55px rgba(255,195,0,.10);
    animation:trophyFloat 4.5s ease-in-out infinite;
}

.hero-trophy::before,
.hero-trophy::after{
    content:"";
    position:absolute;
    border:1px solid rgba(255,195,0,.18);
    border-radius:50px;
}

.hero-trophy::before{inset:-17px}
.hero-trophy::after{
    inset:-32px;
    border-color:rgba(255,255,255,.07);
    animation:trophyRing 8s linear infinite;
}

@keyframes trophyFloat{
    0%,100%{transform:translateY(-50%) rotate(0)}
    50%{transform:translateY(calc(-50% - 15px)) rotate(2deg)}
}

@keyframes trophyRing{
    from{transform:rotate(0)}
    to{transform:rotate(360deg)}
}

.hero-trophy i{
    filter:drop-shadow(0 10px 18px rgba(255,195,0,.24));
    animation:trophyGlow 2.5s ease-in-out infinite;
}

@keyframes trophyGlow{
    0%,100%{transform:scale(1)}
    50%{transform:scale(1.08);filter:drop-shadow(0 15px 28px rgba(255,195,0,.42))}
}

/* =========================================================
   MAIN / INTRO
========================================================= */

.achievers-main{
    padding:65px 0 90px;
}

.intro{
    text-align:center;
    max-width:850px;
    margin:0 auto 38px;
}

.intro-label{
    display:inline-flex;
    padding:8px 13px;
    border-radius:999px;
    background:#fff7d8;
    border:1px solid #f0db87;
    color:#a27700;
    box-shadow:0 8px 22px rgba(150,110,0,.07);
    font-size:10px;
    font-weight:900;
    letter-spacing:2px;
    text-transform:uppercase;
}

.intro h2{
    margin:10px 0 0;
    color:var(--navy);
    font-size:clamp(29px,4vw,43px);
    font-weight:900;
    letter-spacing:-.8px;
}

.intro h2::after{
    content:"";
    display:block;
    width:60px;
    height:4px;
    margin:15px auto 0;
    border-radius:99px;
    background:linear-gradient(90deg,var(--navy),var(--yellow));
}

.intro p{
    margin:11px 0 0;
    color:var(--muted);
    font-size:13px;
    line-height:1.8;
    font-weight:600;
}

/* =========================================================
   FILTER
========================================================= */

.filter-card{
    position:relative;
    overflow:hidden;
    margin-bottom:42px;
    padding:14px;
    background:rgba(255,255,255,.72);
    border:1px solid rgba(255,255,255,.9);
    border-radius:20px;
    box-shadow:
        0 20px 55px rgba(0,43,87,.08),
        inset 0 1px 0 rgba(255,255,255,.9);
    backdrop-filter:blur(20px);
}

.filter-card::before{
    content:"";
    position:absolute;
    top:0;
    left:-35%;
    width:25%;
    height:100%;
    transform:skewX(-20deg);
    background:rgba(255,255,255,.55);
    transition:left .8s ease;
    pointer-events:none;
}

.filter-card:hover::before{left:125%}

.filters{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:9px;
}

.filter-btn{
    position:relative;
    overflow:hidden;
    min-height:43px;
    padding:0 18px;
    border:1px solid var(--border);
    border-radius:11px;
    background:#f7fafc;
    color:#536c82;
    cursor:pointer;
    font-family:inherit;
    font-size:11px;
    font-weight:900;
    transition:all .22s ease;
}

.filter-btn i{margin-right:6px}

.filter-btn::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(110deg,transparent,rgba(255,255,255,.25),transparent);
    transform:translateX(-130%);
    transition:transform .55s ease;
}

.filter-btn:hover::after{transform:translateX(130%)}

.filter-btn:hover{
    border-color:#b8cfdf;
    color:var(--navy);
    transform:translateY(-2px);
}

.filter-btn.active{
    background:linear-gradient(135deg,var(--navy),var(--blue));
    color:#fff;
    border-color:var(--navy);
    box-shadow:
        0 10px 25px rgba(0,43,87,.20),
        0 0 0 3px rgba(255,195,0,.08);
}

/* =========================================================
   SECTIONS
========================================================= */

.achievement-section{
    margin-bottom:55px;
}

.section-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    margin-bottom:22px;
}

.section-title-left{
    display:flex;
    align-items:center;
    gap:13px;
}

.section-icon{
    width:48px;
    height:48px;
    flex-shrink:0;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#fff5cf;
    color:var(--navy);
    font-size:17px;
    box-shadow:0 10px 25px rgba(0,43,87,.08);
    transition:transform .35s ease,box-shadow .35s ease;
}

.section-title:hover .section-icon{
    transform:translateY(-4px) rotate(-4deg);
    box-shadow:0 16px 32px rgba(0,43,87,.13);
}

.section-title h3{
    margin:0;
    color:var(--navy);
    font-size:21px;
    font-weight:900;
}

.section-title p{
    margin:3px 0 0;
    color:var(--muted);
    font-size:10px;
    font-weight:600;
}

.section-count{
    padding:7px 11px;
    border:1px solid #dbe7f0;
    border-radius:30px;
    background:#eaf2f8;
    color:var(--navy);
    font-size:10px;
    font-weight:900;
    box-shadow:0 7px 18px rgba(0,43,87,.05);
}

/* =========================================================
   GRID / CARD
========================================================= */

.records-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:22px;
    perspective:1600px;
}

.achievement-card{
    position:relative;
    isolation:isolate;
    overflow:hidden;
    background:#fff;
    border:1px solid rgba(123,157,182,.20);
    border-radius:21px;
    box-shadow:
        0 15px 42px rgba(0,43,87,.08),
        inset 0 1px 0 rgba(255,255,255,.9);
    transform:translateY(0) rotateX(0) rotateY(0);
    transition:
        transform .45s cubic-bezier(.2,.8,.2,1),
        box-shadow .45s ease,
        border-color .35s ease;
    animation:cardIn .75s cubic-bezier(.2,.75,.2,1) both;
}

.achievement-card:nth-child(1){animation-delay:.05s}
.achievement-card:nth-child(2){animation-delay:.13s}
.achievement-card:nth-child(3){animation-delay:.21s}
.achievement-card:nth-child(4){animation-delay:.29s}
.achievement-card:nth-child(5){animation-delay:.37s}
.achievement-card:nth-child(6){animation-delay:.45s}

@keyframes cardIn{
    from{opacity:0;transform:translateY(32px) scale(.985)}
    to{opacity:1;transform:translateY(0) scale(1)}
}

.achievement-card::before{
    content:"";
    position:absolute;
    inset:0;
    z-index:7;
    pointer-events:none;
    border-radius:inherit;
    background:radial-gradient(
        260px circle at var(--mx,50%) var(--my,0%),
        rgba(255,255,255,.24),
        transparent 60%
    );
    opacity:0;
    transition:opacity .3s ease;
}

.achievement-card::after{
    content:"";
    position:absolute;
    left:10%;
    right:10%;
    bottom:-18px;
    height:30px;
    z-index:-1;
    border-radius:50%;
    background:rgba(0,36,70,.14);
    filter:blur(16px);
    opacity:.35;
    transform:scale(.82);
    transition:transform .45s ease,opacity .45s ease;
}

.achievement-card:hover{
    transform:translateY(-13px) rotateX(1.2deg) rotateY(-1.2deg);
    border-color:rgba(0,91,152,.26);
    box-shadow:0 34px 85px rgba(0,31,63,.20);
}

.achievement-card:hover::before{opacity:1}
.achievement-card:hover::after{
    transform:scale(.65);
    opacity:.22;
}

/* =========================================================
   PHOTO
========================================================= */

.card-image{
    height:235px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 30% 20%,rgba(255,255,255,.7),transparent 30%),
        linear-gradient(145deg,#dbe8f2,#cbdbe8);
}

.card-image::before{
    content:"";
    position:absolute;
    inset:0;
    z-index:2;
    pointer-events:none;
    background:linear-gradient(
        115deg,
        transparent 15%,
        rgba(255,255,255,.22) 45%,
        transparent 68%
    );
    transform:translateX(-130%);
    transition:transform .9s ease;
}

.achievement-card:hover .card-image::before{
    transform:translateX(130%);
}

.card-image::after{
    content:"";
    position:absolute;
    inset:0;
    z-index:3;
    pointer-events:none;
    background:
        linear-gradient(to top,rgba(0,20,42,.55),transparent 48%),
        radial-gradient(circle at 50% 0%,rgba(255,195,0,.13),transparent 50%);
}

.card-image img{
    position:relative;
    z-index:1;
    width:100%;
    height:100%;
    object-fit:cover;
    transform:scale(1.025) translateY(0);
    transition:
        transform .65s cubic-bezier(.2,.8,.2,1),
        filter .45s ease;
    animation:photoFloat 5s ease-in-out infinite;
    will-change:transform;
}

@keyframes photoFloat{
    0%,100%{transform:scale(1.025) translate3d(0,0,0)}
    50%{transform:scale(1.035) translate3d(0,-6px,0)}
}

.achievement-card:hover .card-image img{
    transform:scale(1.10) translateY(-5px);
    filter:saturate(1.06) contrast(1.02);
    animation-play-state:paused;
}

.year-badge{
    position:absolute;
    top:15px;
    right:15px;
    z-index:5;
    padding:7px 11px;
    border-radius:30px;
    background:rgba(255,255,255,.92);
    border:1px solid rgba(255,255,255,.85);
    color:var(--navy);
    font-size:10px;
    font-weight:900;
    box-shadow:
        0 10px 25px rgba(0,0,0,.14),
        inset 0 1px 0 rgba(255,255,255,.9);
    backdrop-filter:blur(12px);
    transition:transform .35s ease;
}

.achievement-card:hover .year-badge{
    transform:translateY(-3px) scale(1.03);
}

/* =========================================================
   BODY / BADGES
========================================================= */

.card-body{
    padding:21px;
    position:relative;
}

.rank-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:7px 10px;
    border-radius:30px;
    font-size:9px;
    font-weight:900;
    margin-bottom:11px;
    box-shadow:0 7px 18px rgba(0,43,87,.05);
    transition:transform .3s ease,box-shadow .3s ease;
}

.achievement-card:hover .rank-badge{
    transform:translateY(-2px);
    box-shadow:0 10px 24px rgba(0,43,87,.09);
}

.badge-state{
    background:linear-gradient(135deg,#e8f2ff,#dcecff);
    color:#1769d2;
}

.badge-district{
    background:linear-gradient(135deg,#f1ecff,#e7dfff);
    color:var(--purple);
}

.badge-school{
    background:linear-gradient(135deg,#e6f9f0,#d8f3e6);
    color:#078a57;
}

.card-body h4{
    margin:0 0 15px;
    color:var(--navy);
    font-size:20px;
    line-height:1.2;
    font-weight:900;
    transition:color .3s ease,transform .3s ease;
}

.achievement-card:hover .card-body h4{
    color:var(--blue);
    transform:translateX(2px);
}

.meta-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
}

.meta{
    position:relative;
    overflow:hidden;
    padding:10px;
    background:#f7f9fb;
    border:1px solid #e5ecf2;
    border-radius:10px;
    transition:transform .3s ease,border-color .3s ease,background .3s ease;
}

.meta::before{
    content:"";
    position:absolute;
    left:0;
    top:0;
    width:3px;
    height:0;
    background:var(--yellow);
    transition:height .3s ease;
}

.achievement-card:hover .meta{
    border-color:#d3e2ed;
    background:#f9fbfd;
}

.achievement-card:hover .meta::before{height:100%}

.meta-label{
    display:block;
    margin-bottom:4px;
    color:#8497a9;
    font-size:7px;
    font-weight:900;
    letter-spacing:.8px;
    text-transform:uppercase;
}

.meta-value{
    color:var(--text);
    font-size:10px;
    font-weight:900;
    word-break:break-word;
}

/* =========================================================
   RESULT
========================================================= */

.result{
    position:relative;
    overflow:hidden;
    margin-top:9px;
    padding:12px 13px;
    border:1px solid #f3dd89;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:linear-gradient(135deg,#fff9df,#fff3bf);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.75),
        0 8px 22px rgba(185,142,0,.06);
}

.result::before{
    content:"";
    position:absolute;
    top:0;
    left:-90%;
    width:45%;
    height:100%;
    transform:skewX(-20deg);
    background:rgba(255,255,255,.40);
    transition:left .75s ease;
}

.achievement-card:hover .result::before{left:140%}

.result-label{
    position:relative;
    z-index:1;
    color:#886b00;
    font-size:9px;
    font-weight:900;
}

.result-value{
    position:relative;
    z-index:1;
    color:var(--navy);
    font-size:19px;
    font-weight:900;
    text-shadow:0 3px 10px rgba(0,43,87,.08);
}

/* =========================================================
   ACHIEVEMENT
========================================================= */

.achievement{
    margin-top:13px;
    padding-top:13px;
    border-top:1px solid #e7edf3;
}

.achievement strong{
    display:inline-flex;
    align-items:center;
    gap:6px;
    margin-bottom:5px;
    color:var(--navy);
    font-size:9px;
    font-weight:900;
    text-transform:uppercase;
}

.achievement strong::before{
    content:"";
    width:5px;
    height:5px;
    border-radius:50%;
    background:var(--yellow);
    box-shadow:0 0 0 4px rgba(255,195,0,.10);
}

.achievement p{
    margin:0;
    color:var(--muted);
    font-size:10px;
    line-height:1.6;
    font-weight:600;
}

/* =========================================================
   HIDDEN / EMPTY
========================================================= */

.achievement-card.hidden{
    display:none !important;
}

.section-empty{
    padding:40px 20px;
    text-align:center;
    border:1px dashed #cbd9e5;
    border-radius:18px;
    background:rgba(255,255,255,.55);
    color:var(--muted);
    font-size:12px;
    font-weight:700;
}

.no-results{
    display:none;
    position:relative;
    overflow:hidden;
    padding:55px 20px;
    text-align:center;
    background:#fff;
    border:1px solid var(--border);
    border-radius:22px;
    box-shadow:0 12px 35px rgba(0,43,87,.06);
}

.no-results.show{display:block}

.no-results::before,
.no-results::after{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    border:1px solid rgba(255,195,0,.12);
    border-radius:50%;
}

.no-results::before{left:-80px;top:-90px}
.no-results::after{right:-80px;bottom:-90px}

.no-results-icon{
    width:65px;
    height:65px;
    margin:0 auto 15px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#fff5cf;
    color:var(--navy);
    font-size:24px;
    animation:noResultFloat 3s ease-in-out infinite;
}

@keyframes noResultFloat{
    0%,100%{transform:translateY(0)}
    50%{transform:translateY(-8px)}
}

.no-results h3{
    margin:0;
    color:var(--navy);
    font-size:20px;
    font-weight:900;
}

.no-results p{
    margin:5px 0 0;
    color:var(--muted);
    font-size:11px;
}

/* =========================================================
   FILTER REVEAL
========================================================= */

.achievement-card.filter-reveal{
    animation:filterReveal .5s cubic-bezier(.2,.8,.2,1) both !important;
}

@keyframes filterReveal{
    from{opacity:0;transform:translateY(18px) scale(.97)}
    to{opacity:1;transform:translateY(0) scale(1)}
}

