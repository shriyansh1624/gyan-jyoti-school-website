<%- include('../partials/header') %>

<style>

/* =========================================================
   ACADEMIC RECORDS PAGE
========================================================= */

.records-page {
    --navy: #002b57;
    --navy-dark: #001d3d;
    --blue: #075c98;
    --yellow: #ffbd00;
    --yellow-light: #fff5cf;
    --green: #0fa968;
    --purple: #7355d8;
    --red: #e93645;
    --text: #092c4d;
    --muted: #71869b;
    --bg: #edf3f9;
    --white: #ffffff;
    --border: #dce6ef;

    background:
        linear-gradient(
            135deg,
            #edf3f9 0%,
            #f7faff 48%,
            #e8f0f8 100%
        );

    min-height: 100vh;
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
}


/* =========================================================
   HERO
========================================================= */

.records-hero {
    position: relative;
    min-height: 330px;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 88% 15%,
            rgba(255,255,255,.14),
            transparent 23%
        ),
        linear-gradient(
            125deg,
            #001d3d 0%,
            #003b6e 48%,
            #075c98 100%
        );
}


.records-hero::before {
    content: "";
    position: absolute;

    width: 470px;
    height: 470px;

    border: 1px solid rgba(255,255,255,.09);
    border-radius: 50%;

    right: -140px;
    top: -290px;
}


.records-hero::after {
    content: "";

    position: absolute;

    width: 310px;
    height: 310px;

    border: 1px solid rgba(255,255,255,.07);
    border-radius: 50%;

    right: 40px;
    top: -170px;
}


.records-overlay {
    min-height: 330px;

    display: flex;
    align-items: center;

    position: relative;
    z-index: 2;
}


.records-container {
    width: min(1180px, calc(100% - 40px));
    margin: auto;
}


.records-hero .records-container {
    padding-top: 20px;
}


.records-hero h1 {
    color: #ffffff;

    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.05;

    font-weight: 900;

    letter-spacing: -1.5px;

    max-width: 850px;

    position: relative;
}


.records-hero h1::after {
    content: "";

    display: block;

    width: 75px;
    height: 5px;

    margin-top: 19px;

    background: var(--yellow);

    border-radius: 10px;
}


.records-hero p {
    margin-top: 18px;

    color: rgba(255,255,255,.78);

    font-size: 14px;

    font-weight: 600;
}


.records-hero p a {
    color: var(--yellow);
    text-decoration: none;
}


.records-hero p a:hover {
    text-decoration: underline;
}


/* =========================================================
   MAIN SECTION
========================================================= */

.records-section {
    padding: 70px 0 90px;
}


.records-heading {
    text-align: center;

    max-width: 850px;

    margin: 0 auto 42px;
}


.records-heading h2 {
    color: var(--navy);

    font-size: clamp(28px, 4vw, 42px);

    font-weight: 900;

    letter-spacing: -.8px;

    margin-bottom: 12px;
}


.records-heading h2::before {
    content: "ACADEMIC EXCELLENCE";

    display: block;

    margin-bottom: 9px;

    color: #e3a900;

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 2px;
}


.records-heading p {
    color: var(--muted);

    font-size: 14px;

    line-height: 1.8;

    font-weight: 500;
}


/* =========================================================
   RECORDS GRID
========================================================= */

.records-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 25px;
}


/* =========================================================
   TOPPER CARD
========================================================= */

.topper-card {
    position: relative;

    background: rgba(255,255,255,.96);

    border: 1px solid var(--border);

    border-radius: 22px;

    overflow: hidden;

    box-shadow:
        0 12px 35px rgba(0,43,87,.08);

    transition:
        transform .28s ease,
        box-shadow .28s ease,
        border-color .28s ease;
}


.topper-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 4px;

    background:
        linear-gradient(
            90deg,
            var(--yellow),
            #ffd84d,
            var(--yellow)
        );

    z-index: 4;
}


.topper-card:hover {
    transform: translateY(-8px);

    border-color: #c5d9e8;

    box-shadow:
        0 22px 48px rgba(0,43,87,.14);
}


/* =========================================================
   IMAGE
========================================================= */

.topper-image {
    height: 235px;

    position: relative;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            #e6eef6,
            #d6e3ef
        );
}


.topper-image::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(0,29,61,.42),
            transparent 55%
        );

    pointer-events: none;
}


.topper-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform .45s ease;
}


.topper-card:hover .topper-image img {
    transform: scale(1.055);
}


/* =========================================================
   YEAR FLOATING BADGE
========================================================= */

.record-year {
    position: absolute;

    top: 17px;
    right: 17px;

    z-index: 5;

    padding: 7px 11px;

    border-radius: 30px;

    background:
        rgba(255,255,255,.94);

    color: var(--navy);

    font-size: 11px;

    font-weight: 900;

    box-shadow:
        0 6px 18px rgba(0,0,0,.12);

    backdrop-filter: blur(8px);
}


/* =========================================================
   CARD CONTENT
========================================================= */

.topper-content {
    padding: 22px 22px 24px;
}


.topper-badge {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 7px 11px;

    border-radius: 30px;

    font-size: 10px;

    font-weight: 900;

    margin-bottom: 13px;
}


/* STATE */

.badge-state {
    color: #1267d0;
    background: #e9f2ff;
}


/* DISTRICT */

.badge-district {
    color: var(--purple);
    background: #f0ebff;
}


/* SCHOOL */

.badge-school {
    color: #078a58;
    background: #e4f8ee;
}


/* SPORTS */

.badge-sports {
    color: var(--red);
    background: #fff0f2;
}


.topper-content h3 {
    color: var(--navy);

    font-size: 21px;

    font-weight: 900;

    line-height: 1.2;

    margin-bottom: 15px;
}


/* =========================================================
   INFO GRID
========================================================= */

.topper-info {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 9px;
}


.info-item {
    padding: 11px 12px;

    border-radius: 11px;

    background: #f6f9fc;

    border: 1px solid #e4ebf2;
}


.info-item.full {
    grid-column: 1 / -1;
}


.info-label {
    display: block;

    color: #8496a8;

    font-size: 8px;

    font-weight: 900;

    letter-spacing: .8px;

    text-transform: uppercase;

    margin-bottom: 4px;
}


.info-value {
    color: var(--text);

    font-size: 11px;

    font-weight: 800;

    line-height: 1.35;

    word-break: break-word;
}


/* =========================================================
   PERCENTAGE
========================================================= */

.result-box {
    grid-column: 1 / -1;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 13px 14px;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            #fff9df,
            #fff4c4
        );

    border:
        1px solid #f5df8a;
}


.result-label {
    display: flex;

    align-items: center;

    gap: 8px;

    color: #866700;

    font-size: 10px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: .5px;
}


.result-label i {
    color: #d59e00;
}


.result-value {
    color: var(--navy);

    font-size: 20px;

    font-weight: 900;
}


/* =========================================================
   ACHIEVEMENT DESCRIPTION
========================================================= */

.achievement-text {
    margin-top: 14px;

    padding-top: 14px;

    border-top: 1px solid #e8eef4;
}


.achievement-text strong {
    display: block;

    color: var(--navy);

    font-size: 10px;

    font-weight: 900;

    text-transform: uppercase;

    letter-spacing: .6px;

    margin-bottom: 5px;
}


.achievement-text p {
    color: var(--muted);

    font-size: 11px;

    line-height: 1.6;

    font-weight: 500;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-records {
    max-width: 650px;

    margin: 30px auto 0;

    padding: 65px 30px;

    text-align: center;

    background: white;

    border:
        1px solid var(--border);

    border-radius: 24px;

    box-shadow:
        0 15px 40px rgba(0,43,87,.07);
}


.empty-icon {
    width: 75px;
    height: 75px;

    margin: 0 auto 18px;

    border-radius: 22px;

    background: var(--yellow-light);

    color: var(--navy);

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 28px;
}


.empty-records h3 {
    color: var(--navy);

    font-size: 22px;

    font-weight: 900;

    margin-bottom: 8px;
}


.empty-records p {
    color: var(--muted);

    font-size: 13px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1100px) {

    .records-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 700px) {

    .records-container {
        width:
            calc(100% - 28px);
    }


    .records-hero,
    .records-overlay {
        min-height: 270px;
    }


    .records-section {
        padding:
            50px 0 65px;
    }


    .records-grid {
        grid-template-columns:
            1fr;

        gap: 20px;
    }


    .topper-image {
        height: 260px;
    }


    .records-heading {
        margin-bottom: 30px;
    }

}


@media (max-width: 430px) {

    .records-hero h1 {
        font-size: 34px;
    }


    .records-hero p {
        font-size: 12px;
    }


    .records-heading h2 {
        font-size: 29px;
    }


    .topper-content {
        padding:
            19px;
    }


    .topper-info {
        grid-template-columns:
            1fr;
    }


    .info-item.full,
    .result-box {
        grid-column:
            auto;
    }

}

</style>


<div class="records-page">


<!-- =========================================================
     HERO
========================================================= -->

<section class="records-hero">

    <div class="records-overlay">

        <div class="records-container">

            <h1>
                <%= heading %>
            </h1>

            <p>

                <a href="/">
                    Home
                </a>

                &nbsp; / &nbsp;

                <%= heading %>

            </p>

        </div>

    </div>

</section>



<!-- =========================================================
     RECORDS
========================================================= -->

<section class="records-section">

    <div class="records-container">


        <div class="records-heading">

            <h2>
                <%= heading %>
            </h2>

            <p>
                <%= intro %>
            </p>

        </div>



        <% if (records && records.length > 0) { %>


            <div class="records-grid">


                <% records.forEach(record => { %>


                    <article class="topper-card">


                        <!-- IMAGE -->

                        <div class="topper-image">


                            <div class="record-year">

                                <i class="fa-regular fa-calendar"></i>

                                <%= record.year %>

                            </div>


                            <img
                                src="<%= record.photo || '/images/academic/default-student.jpg' %>"
                                alt="<%= record.studentName %>"
                                loading="lazy"
                                onerror="
                                    this.onerror=null;
                                    this.src='/images/academic/default-student.jpg';
                                "
                            >


                        </div>



                        <!-- CONTENT -->

                        <div class="topper-content">


                            <!-- ACHIEVEMENT BADGE -->

                            <% if (record.rankType === 'State Topper') { %>


                                <span class="topper-badge badge-state">

                                    <i class="fa-solid fa-location-dot"></i>

                                    State Topper

                                </span>


                            <% } else if (record.rankType === 'District Topper') { %>


                                <span class="topper-badge badge-district">

                                    <i class="fa-solid fa-location-crosshairs"></i>

                                    District Topper

                                </span>


                            <% } else if (record.rankType === 'School Topper') { %>


                                <span class="topper-badge badge-school">

                                    <i class="fa-solid fa-school"></i>

                                    School Topper

                                </span>


                            <% } else { %>


                                <span class="topper-badge badge-sports">

                                    <i class="fa-solid fa-medal"></i>

                                    <%= record.rankType %>

                                </span>


                            <% } %>



                            <!-- NAME -->

                            <h3>
                                <%= record.studentName %>
                            </h3>



                            <!-- INFO -->

                            <div class="topper-info">


                                <div class="info-item">

                                    <span class="info-label">
                                        Class
                                    </span>

                                    <span class="info-value">

                                        <%= record.className === 'sports'
                                            ? 'Sports'
                                            : record.className %>

                                    </span>

                                </div>



                                <div class="info-item">

                                    <span class="info-label">
                                        Batch
                                    </span>

                                    <span class="info-value">
                                        <%= record.batch || '—' %>
                                    </span>

                                </div>



                                <% if (record.stream) { %>


                                    <div class="info-item">

                                        <span class="info-label">
                                            Stream / Category
                                        </span>

                                        <span class="info-value">
                                            <%= record.stream %>
                                        </span>

                                    </div>


                                <% } %>



                                <div class="info-item">

                                    <span class="info-label">
                                        Session
                                    </span>

                                    <span class="info-value">
                                        <%= record.year || '—' %>
                                    </span>

                                </div>



                                <% if (record.percentage) { %>


                                    <div class="result-box">


                                        <span class="result-label">

                                            <i class="fa-solid fa-chart-line"></i>

                                            Result / Percentage

                                        </span>


                                        <span class="result-value">
                                            <%= record.percentage %>
                                        </span>


                                    </div>


                                <% } %>


                            </div>



                            <!-- ACHIEVEMENT -->

                            <% if (record.achievement) { %>


                                <div class="achievement-text">


                                    <strong>

                                        <i class="fa-solid fa-award"></i>

                                        Achievement

                                    </strong>


                                    <p>
                                        <%= record.achievement %>
                                    </p>


                                </div>


                            <% } %>


                        </div>


                    </article>


                <% }) %>


            </div>


        <% } else { %>


            <div class="empty-records">


                <div class="empty-icon">

                    <i class="fa-solid fa-trophy"></i>

                </div>


                <h3>
                    No Records Added Yet
                </h3>


                <p>
                    Academic achievements will appear here
                    once records are added by the school administration.
                </p>


            </div>


        <% } %>


    </div>

</section>


</div>


<%- include('../partials/footer') %>