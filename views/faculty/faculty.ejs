<%- include('../partials/header') %>

<style>
/* =========================================================
   FACULTY PAGE — PREMIUM SCHOOL DESIGN
========================================================= */

.faculty-page{
    --navy:#001f3f;
    --navy-2:#003b73;
    --blue:#0066b3;
    --gold:#ffc107;
    --gold-soft:#fff4c2;
    --text:#172033;
    --muted:#667085;
    --line:#e6ebf2;
    --white:#fff;
    --bg:#f5f8fc;

    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(255,193,7,.10),
            transparent 25%
        ),
        linear-gradient(
            180deg,
            #f8fbff 0%,
            #f4f7fb 100%
        );

    color:var(--text);
    overflow:hidden;
}


/* =========================================================
   HERO
========================================================= */

.faculty-hero{
    position:relative;
    min-height:570px;
    display:flex;
    align-items:center;
    overflow:hidden;
    isolation:isolate;
    color:#fff;

    background:
        linear-gradient(
            110deg,
            rgba(0,18,42,.96),
            rgba(0,40,78,.84)
        ),
        url('/images/school-bg.jpg')
        center/cover no-repeat;
}


.faculty-hero::before{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    right:-170px;
    top:-170px;
    border-radius:50%;
    background:
        radial-gradient(
            circle,
            rgba(255,193,7,.25),
            transparent 68%
        );
    z-index:-1;
}


.faculty-hero::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.15),
            transparent 60%
        );
    z-index:-1;
}


.faculty-hero-inner{
    width:min(1180px,92%);
    margin:auto;
    position:relative;
    z-index:2;
}


.hero-kicker{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:10px 17px;
    border-radius:50px;
    border:1px solid rgba(255,193,7,.45);
    background:rgba(255,193,7,.10);
    color:var(--gold);
    font-size:11px;
    font-weight:900;
    letter-spacing:2px;
}


.faculty-hero h1{
    max-width:900px;
    margin:25px 0 20px;
    font-size:clamp(48px,7vw,88px);
    line-height:.98;
    letter-spacing:-4px;
    font-weight:950;
    text-shadow:
        0 15px 40px rgba(0,0,0,.3);
}


.faculty-hero h1 span{
    display:block;
    color:var(--gold);
}


.faculty-hero p{
    max-width:680px;
    color:rgba(255,255,255,.78);
    font-size:18px;
    line-height:1.8;
}


.hero-meta{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:30px;
}


.hero-meta-item{
    display:flex;
    align-items:center;
    gap:9px;
    padding:11px 15px;
    border-radius:13px;
    border:1px solid rgba(255,255,255,.12);
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(12px);
    color:rgba(255,255,255,.85);
    font-size:11px;
    font-weight:800;
}


.hero-meta-item i{
    color:var(--gold);
}


/* =========================================================
   FLOATING HERO STATS
========================================================= */

.hero-stat-panel{
    position:absolute;
    right:0;
    bottom:55px;

    display:grid;
    grid-template-columns:repeat(2,145px);
    gap:10px;
}


.hero-stat{
    padding:18px;
    border-radius:19px;
    border:1px solid rgba(255,255,255,.14);
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(15px);
    box-shadow:0 20px 40px rgba(0,0,0,.16);
}


.hero-stat strong{
    display:block;
    color:var(--gold);
    font-size:29px;
    font-weight:950;
}


.hero-stat span{
    color:rgba(255,255,255,.7);
    font-size:9px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1px;
}


/* =========================================================
   PAGE CONTAINER
========================================================= */

.faculty-container{
    width:min(1180px,92%);
    margin:auto;
}


/* =========================================================
   SECTION
========================================================= */

.faculty-section{
    padding:90px 0 0;
}


.section-heading{
    max-width:720px;
    margin-bottom:38px;
}


.section-label{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:var(--blue);
    font-size:11px;
    font-weight:950;
    letter-spacing:2px;
    text-transform:uppercase;
}


.section-label::before{
    content:"";
    width:28px;
    height:3px;
    border-radius:10px;
    background:var(--gold);
}


.section-heading h2{
    margin:13px 0 10px;
    color:var(--navy);
    font-size:clamp(32px,4vw,49px);
    line-height:1.05;
    letter-spacing:-2px;
    font-weight:950;
}


.section-heading p{
    color:var(--muted);
    font-size:15px;
    line-height:1.8;
}


/* =========================================================
   TOP FACULTY
========================================================= */

.top-faculty-grid{
    display:grid;
    grid-template-columns:
        repeat(5,minmax(0,1fr));
    gap:16px;
}


.top-card{
    position:relative;
    overflow:hidden;
    min-height:410px;
    border-radius:25px;
    background:#fff;
    border:1px solid var(--line);
    box-shadow:
        0 18px 50px rgba(0,31,63,.08);
    transition:.35s;
}


.top-card:hover{
    transform:translateY(-9px);
    box-shadow:
        0 28px 65px rgba(0,31,63,.14);
}


.top-card-image{
    height:260px;
    overflow:hidden;
    background:#e9eef5;
}


.top-card-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.6s;
}


.top-card:hover .top-card-image img{
    transform:scale(1.06);
}


.top-card-body{
    position:relative;
    padding:22px 19px 20px;
}


.top-number{
    position:absolute;
    right:18px;
    top:-23px;

    width:46px;
    height:46px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:50%;
    background:var(--gold);
    color:var(--navy);

    font-size:14px;
    font-weight:950;

    box-shadow:
        0 10px 25px rgba(255,193,7,.35);
}


.top-card h3{
    color:var(--navy);
    font-size:17px;
    font-weight:950;
}


.role{
    display:inline-flex;
    margin-top:7px;
    padding:6px 9px;
    border-radius:8px;
    color:#075985;
    background:#e0f2fe;
    font-size:9px;
    font-weight:900;
}


.specialization{
    margin-top:13px;
    color:var(--muted);
    font-size:10px;
    line-height:1.5;
}


.specialization strong{
    color:#334155;
}


/* =========================================================
   QUALITY STRIP
========================================================= */

.quality-banner{
    position:relative;
    overflow:hidden;
    display:grid;
    grid-template-columns:1.3fr 1fr;
    gap:30px;
    align-items:center;

    margin-top:80px;
    padding:45px;

    border-radius:30px;

    background:
        radial-gradient(
            circle at 100% 0,
            rgba(255,193,7,.25),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            var(--navy),
            var(--navy-2)
        );

    color:#fff;
    box-shadow:
        0 25px 65px rgba(0,31,63,.18);
}


.quality-banner h2{
    color:#fff;
    font-size:35px;
    font-weight:950;
    letter-spacing:-1px;
}


.quality-banner p{
    margin-top:12px;
    color:rgba(255,255,255,.72);
    line-height:1.8;
    font-size:13px;
}


.quality-list{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}


.quality-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding:13px;
    border-radius:13px;
    border:1px solid rgba(255,255,255,.12);
    background:rgba(255,255,255,.06);
    color:rgba(255,255,255,.85);
    font-size:10px;
    font-weight:800;
}


.quality-item i{
    color:var(--gold);
}


/* =========================================================
   INCHARGE SECTION
========================================================= */

.incharge-grid{
    display:grid;
    grid-template-columns:
        repeat(3,minmax(0,1fr));
    gap:18px;
}


.incharge-column{
    padding:22px;
    border-radius:24px;
    border:1px solid var(--line);
    background:#fff;
    box-shadow:
        0 16px 45px rgba(0,31,63,.07);
}


.incharge-title{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:18px;
}


.incharge-title h3{
    color:var(--navy);
    font-size:18px;
    font-weight:950;
}


.section-pill{
    padding:6px 9px;
    border-radius:50px;
    color:#92400e;
    background:#fef3c7;
    font-size:8px;
    font-weight:950;
    text-transform:uppercase;
}


.incharge-card{
    display:flex;
    align-items:center;
    gap:12px;
    padding:12px;
    margin-top:9px;
    border-radius:15px;
    background:#f8fafc;
    border:1px solid #edf1f5;
    transition:.25s;
}


.incharge-card:hover{
    transform:translateX(4px);
    border-color:#ffc10755;
}


.incharge-image{
    width:58px;
    height:65px;
    flex:none;
    overflow:hidden;
    border-radius:11px;
    background:#e2e8f0;
}


.incharge-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}


.incharge-info h4{
    color:var(--navy);
    font-size:12px;
    font-weight:950;
}


.incharge-info span{
    display:block;
    margin-top:4px;
    color:var(--muted);
    font-size:9px;
}


/* =========================================================
   FACULTY SECTION
========================================================= */

.academic-section{
    padding-top:95px;
}


.academic-block{
    margin-bottom:55px;
}


.academic-header{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    gap:20px;
    margin-bottom:22px;
}


.academic-header h3{
    color:var(--navy);
    font-size:28px;
    font-weight:950;
    letter-spacing:-1px;
}


.academic-header p{
    max-width:500px;
    color:var(--muted);
    font-size:11px;
    line-height:1.6;
}


.academic-grid{
    display:grid;
    grid-template-columns:
        repeat(4,minmax(0,1fr));
    gap:16px;
}


.faculty-card{
    overflow:hidden;
    border-radius:22px;
    background:#fff;
    border:1px solid var(--line);
    box-shadow:
        0 15px 40px rgba(0,31,63,.07);
    transition:.35s;
}


.faculty-card:hover{
    transform:translateY(-7px);
    box-shadow:
        0 25px 55px rgba(0,31,63,.12);
}


.faculty-card-image{
    height:230px;
    overflow:hidden;
    background:#e9eef5;
}


.faculty-card-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}


.faculty-card:hover
.faculty-card-image img{
    transform:scale(1.05);
}


.faculty-card-body{
    padding:19px;
}


.faculty-card-body h4{
    color:var(--navy);
    font-size:15px;
    font-weight:950;
}


.faculty-role{
    display:inline-flex;
    margin-top:6px;
    padding:5px 8px;
    border-radius:7px;
    color:#075985;
    background:#e0f2fe;
    font-size:8px;
    font-weight:900;
}


.faculty-info{
    margin-top:12px;
}


.faculty-info-row{
    display:flex;
    gap:7px;
    margin-top:7px;
    color:var(--muted);
    font-size:9px;
    line-height:1.4;
}


.faculty-info-row i{
    width:12px;
    color:var(--blue);
}


.qualities{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    margin-top:12px;
}


.quality-chip{
    padding:5px 7px;
    border-radius:7px;
    color:#166534;
    background:#dcfce7;
    font-size:8px;
    font-weight:850;
}


/* =========================================================
   EMPTY
========================================================= */

.empty-state{
    padding:45px 20px;
    text-align:center;
    border-radius:20px;
    border:1px dashed #cbd5e1;
    background:#fff;
    color:var(--muted);
}


.empty-state i{
    display:block;
    margin-bottom:10px;
    color:#cbd5e1;
    font-size:32px;
}


.empty-state strong{
    display:block;
    color:#475569;
    font-size:14px;
}


/* =========================================================
   LIBRARY
========================================================= */

.library-section{
    padding:70px 0 100px;
}


.library-box{
    position:relative;
    overflow:hidden;
    padding:40px;
    border-radius:28px;
    color:#fff;

    background:
        linear-gradient(
            135deg,
            #00264c,
            #004f91
        );

    box-shadow:
        0 22px 60px rgba(0,31,63,.16);
}


.library-box::after{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    right:-80px;
    top:-100px;
    border-radius:50%;
    background:
        radial-gradient(
            circle,
            rgba(255,193,7,.28),
            transparent 68%
        );
}


.library-box h2{
    position:relative;
    z-index:2;
    color:#fff;
    font-size:32px;
    font-weight:950;
}


.library-box p{
    position:relative;
    z-index:2;
    max-width:700px;
    margin-top:9px;
    color:#ffffffb8;
    font-size:13px;
    line-height:1.7;
}


.library-grid{
    position:relative;
    z-index:2;

    display:grid;
    grid-template-columns:
        repeat(3,minmax(0,1fr));

    gap:14px;
    margin-top:25px;
}


.library-card{
    padding:20px;
    border-radius:17px;
    border:1px solid rgba(255,255,255,.12);
    background:rgba(255,255,255,.07);
    backdrop-filter:blur(10px);
}


.library-card i{
    color:var(--gold);
    font-size:22px;
}


.library-card h4{
    margin-top:10px;
    color:#fff;
    font-size:12px;
}


.library-card span{
    display:block;
    margin-top:4px;
    color:#ffffff9e;
    font-size:9px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1100px){

    .top-faculty-grid{
        grid-template-columns:
            repeat(3,1fr);
    }

    .academic-grid{
        grid-template-columns:
            repeat(3,1fr);
    }

    .hero-stat-panel{
        position:relative;
        right:auto;
        bottom:auto;
        margin-top:35px;
    }

    .faculty-hero{
        padding:80px 0;
    }

}


@media(max-width:850px){

    .faculty-hero{
        min-height:650px;
    }

    .faculty-hero h1{
        letter-spacing:-2px;
    }

    .hero-stat-panel{
        grid-template-columns:
            repeat(2,130px);
    }

    .incharge-grid{
        grid-template-columns:1fr;
    }

    .quality-banner{
        grid-template-columns:1fr;
    }

    .academic-grid{
        grid-template-columns:
            repeat(2,1fr);
    }

    .library-grid{
        grid-template-columns:
            repeat(2,1fr);
    }

}


@media(max-width:600px){

    .faculty-container,
    .faculty-hero-inner{
        width:90%;
    }

    .faculty-hero{
        min-height:680px;
    }

    .faculty-hero h1{
        font-size:45px;
    }

    .faculty-hero p{
        font-size:15px;
    }

    .hero-stat-panel{
        grid-template-columns:
            repeat(2,1fr);
    }

    .hero-stat{
        padding:14px;
    }

    .top-faculty-grid{
        grid-template-columns:1fr 1fr;
    }

    .top-card{
        min-height:350px;
    }

    .top-card-image{
        height:200px;
    }

    .quality-banner{
        padding:28px;
    }

    .quality-list{
        grid-template-columns:1fr;
    }

    .academic-grid{
        grid-template-columns:1fr 1fr;
    }

    .academic-header{
        display:block;
    }

    .academic-header p{
        margin-top:8px;
    }

    .library-box{
        padding:28px;
    }

    .library-grid{
        grid-template-columns:1fr;
    }

}


@media(max-width:430px){

    .top-faculty-grid,
    .academic-grid{
        grid-template-columns:1fr;
    }

    .top-card-image{
        height:250px;
    }

    .hero-stat-panel{
        grid-template-columns:1fr 1fr;
    }

}

</style>


<div class="faculty-page">


<!-- =========================================================
     HERO
========================================================= -->

<section class="faculty-hero">

    <div class="faculty-hero-inner">

        <span class="hero-kicker">

            <i class="fas fa-chalkboard-user"></i>

            OUR EDUCATORS

        </span>


        <h1>

            The People Behind

            <span>Every Achievement.</span>

        </h1>


        <p>

            Meet the dedicated educators, academic leaders and
            mentors who shape the learning journey of our students
            through knowledge, discipline, care and values.

        </p>


        <div class="hero-meta">

            <div class="hero-meta-item">

                <i class="fas fa-users"></i>

                <%= facultyCount || 0 %> Faculty Members

            </div>


            <div class="hero-meta-item">

                <i class="fas fa-graduation-cap"></i>

                Academic Excellence

            </div>


            <div class="hero-meta-item">

                <i class="fas fa-heart"></i>

                Student First

            </div>

        </div>


        <div class="hero-stat-panel">

            <div class="hero-stat">

                <strong
                    data-count="<%= topFaculties ? topFaculties.length : 0 %>"
                >
                    0
                </strong>

                <span>
                    Top Faculty
                </span>

            </div>


            <div class="hero-stat">

                <strong
                    data-count="<%= (primaryIncharges ? primaryIncharges.length : 0) + (middleIncharges ? middleIncharges.length : 0) + (higherIncharges ? higherIncharges.length : 0) %>"
                >
                    0
                </strong>

                <span>
                    Section Leaders
                </span>

            </div>

        </div>

    </div>

</section>



<div class="faculty-container">


<!-- =========================================================
     TOP 5
========================================================= -->

<section class="faculty-section">

    <div class="section-heading">

        <span class="section-label">

            <i class="fas fa-star"></i>

            Distinguished Educators

        </span>


        <h2>
            Our Top Faculty
        </h2>


        <p>

            Experienced educators who bring strong subject
            knowledge, leadership and a student-focused approach
            to the classroom.

        </p>

    </div>


    <% if (topFaculties && topFaculties.length > 0) { %>

        <div class="top-faculty-grid">

            <% topFaculties.forEach((faculty,index) => { %>

                <article class="top-card">


                    <div class="top-card-image">

                        <img
                            src="<%= faculty.image || '/images/logo.png' %>"
                            alt="<%= faculty.name %>"
                            loading="lazy"
                            onerror="this.src='/images/logo.png'"
                        >

                    </div>


                    <div class="top-card-body">

                        <span class="top-number">

                            #<%= index + 1 %>

                        </span>


                        <h3>

                            <%= faculty.name %>

                        </h3>


                        <span class="role">

                            <%= faculty.role %>

                        </span>


                        <p class="specialization">

                            <strong>
                                Specialization:
                            </strong>

                            <%= faculty.specialization || 'Academic Excellence' %>

                        </p>


                        <% if (
                            faculty.qualities &&
                            faculty.qualities.length
                        ) { %>

                            <div class="qualities">

                                <% faculty.qualities
                                    .slice(0,3)
                                    .forEach(q => { %>

                                    <span class="quality-chip">

                                        <%= q %>

                                    </span>

                                <% }) %>

                            </div>

                        <% } %>

                    </div>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <div class="empty-state">

            <i class="fas fa-user-graduate"></i>

            <strong>
                Top faculty profiles will be updated soon.
            </strong>

        </div>

    <% } %>


</section>



<!-- =========================================================
     QUALITY BANNER
========================================================= -->

<section class="quality-banner">

    <div>

        <span class="section-label"
              style="color:#ffc107;">

            <i class="fas fa-award"></i>

            What Defines Our Educators

        </span>


        <h2>
            Teaching with Purpose.
        </h2>


        <p>

            Our faculty members combine academic expertise
            with mentorship, discipline and a genuine commitment
            to helping every student grow.

        </p>

    </div>


    <div class="quality-list">

        <div class="quality-item">

            <i class="fas fa-check-circle"></i>

            Strong Subject Knowledge

        </div>


        <div class="quality-item">

            <i class="fas fa-check-circle"></i>

            Student Centric Approach

        </div>


        <div class="quality-item">

            <i class="fas fa-check-circle"></i>

            Effective Communication

        </div>


        <div class="quality-item">

            <i class="fas fa-check-circle"></i>

            Continuous Learning

        </div>


        <div class="quality-item">

            <i class="fas fa-check-circle"></i>

            Mentorship &amp; Guidance

        </div>


        <div class="quality-item">

            <i class="fas fa-check-circle"></i>

            Values Based Education

        </div>

    </div>

</section>



<!-- =========================================================
     SECTION INCHARGES
========================================================= -->

<section class="faculty-section">

    <div class="section-heading">

        <span class="section-label">

            <i class="fas fa-user-tie"></i>

            Academic Leadership

        </span>


        <h2>
            Section Incharges
        </h2>


        <p>

            Academic leaders who coordinate planning,
            discipline and student development across
            different levels.

        </p>

    </div>


