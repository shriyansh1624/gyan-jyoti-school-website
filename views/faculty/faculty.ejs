<script>

/* =========================================================
   HERO COUNTER ANIMATION
========================================================= */

document
    .querySelectorAll('[data-count]')
    .forEach(counter => {

        const target =
            Number(counter.dataset.count) || 0;

        const duration = 900;

        const start =
            performance.now();


        function animate(now){

            const progress =
                Math.min(
                    (now - start) /
                    duration,
                    1
                );


            const eased =
                1 -
                Math.pow(
                    1 - progress,
                    3
                );


            counter.textContent =
                Math.floor(
                    target * eased
                );


            if(progress < 1){

                requestAnimationFrame(
                    animate
                );

            }else{

                counter.textContent =
                    target;

            }

        }


        requestAnimationFrame(
            animate
        );

    });

</script>


