  </div>
</section>

<section class="admission-process-section">
  <div class="admission-container">

    <div class="section-heading">
      <span class="section-tag">The Process</span>
      <h2>Six Steps. One Clear Journey.</h2>
      <p>
        Complete each stage at your own pace and move closer to joining
        the Gyan Jyoti family.
      </p>
    </div>

    <div class="process-timeline">

      <div class="process-card">
        <div class="step-head">
          <span class="step-number">01</span>
          <span class="step-icon"><i class="fas fa-comments"></i></span>
        </div>
        <span class="step-label">FIRST CONTACT</span>
        <h3>Enquiry</h3>
        <p>
          Parents submit an enquiry form or contact the school admission office.
        </p>
        <div class="step-footer">
          <span>Step 01</span>
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>

      <div class="process-card">
        <div class="step-head">
          <span class="step-number">02</span>
          <span class="step-icon"><i class="fas fa-school"></i></span>
        </div>
        <span class="step-label">DISCOVER CAMPUS</span>
        <h3>School Visit</h3>
        <p>
          Parents may visit the campus and understand academics,
          facilities and environment.
        </p>
        <div class="step-footer">
          <span>Step 02</span>
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>

      <div class="process-card featured-step">
        <div class="step-head">
          <span class="step-number">03</span>
          <span class="step-icon"><i class="fas fa-file-signature"></i></span>
        </div>
        <span class="step-label">TAKE THE NEXT STEP</span>
        <h3>Registration</h3>
        <p>
          Fill the registration form with student and parent details.
        </p>
        <a href="/admission/registration" class="card-action">
          Register Now <i class="fas fa-arrow-right"></i>
        </a>
      </div>

      <div class="process-card">
        <div class="step-head">
          <span class="step-number">04</span>
          <span class="step-icon"><i class="fas fa-folder-open"></i></span>
        </div>
        <span class="step-label">DOCUMENT CHECK</span>
        <h3>Document Verification</h3>
        <p>
          Submit required documents for verification by the admission team.
        </p>
        <div class="step-footer">
          <span>Step 04</span>
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>

      <div class="process-card">
        <div class="step-head">
          <span class="step-number">05</span>
          <span class="step-icon"><i class="fas fa-user-group"></i></span>
        </div>
        <span class="step-label">CONNECT WITH US</span>
        <h3>Interaction</h3>
        <p>
          Student and parent interaction is conducted as per class requirement.
        </p>
        <div class="step-footer">
          <span>Step 05</span>
          <i class="fas fa-arrow-right"></i>
        </div>
      </div>

      <div class="process-card final-step">
        <div class="step-head">
          <span class="step-number">06</span>
          <span class="step-icon"><i class="fas fa-award"></i></span>
        </div>
        <span class="step-label">WELCOME ABOARD</span>
        <h3>Admission Confirmation</h3>
        <p>
          Admission is confirmed after approval and fee submission.
        </p>
        <div class="step-footer">
          <span>Step 06</span>
          <i class="fas fa-check"></i>
        </div>
      </div>

    </div>
  </div>
</section>

