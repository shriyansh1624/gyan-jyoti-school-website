<style>
/* =========================================================
   GYAN JYOTI SCHOOL — ADMISSION EXPERIENCE
   Premium / Professional UI
   Backend routes & EJS markup intentionally preserved
========================================================= */

:root{
  --gj-navy:#001f3f;
  --gj-navy-2:#003c68;
  --gj-blue:#075d98;
  --gj-gold:#ffc300;
  --gj-gold-2:#ffe27a;
  --gj-ink:#0a2033;
  --gj-muted:#66798a;
  --gj-bg:#f4f7fa;
  --gj-line:#e3eaf0;
  --gj-white:#fff;
}

.admission-container{
  width:min(1220px,92%);
  margin:0 auto;
}

/* ================= HERO ================= */

.admission-hero{
  min-height:680px;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  background:
    radial-gradient(circle at 82% 22%,rgba(255,195,0,.18),transparent 23%),
    radial-gradient(circle at 12% 85%,rgba(0,119,190,.20),transparent 28%),
    linear-gradient(130deg,#000813 0%,#001f3f 56%,#064c7e 100%);
}

.admission-hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(0,7,16,.96),rgba(0,31,63,.64) 58%,rgba(0,31,63,.34)),
    url('/images/school-bg.jpg') center/cover no-repeat;
  opacity:.72;
  transform:scale(1.03);
}

.admission-hero::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    radial-gradient(circle at 20% 25%,rgba(255,195,0,.12) 0 1px,transparent 2px),
    radial-gradient(circle at 75% 70%,rgba(255,255,255,.09) 0 1px,transparent 2px);
  background-size:90px 90px,120px 120px;
  animation:starDrift 25s linear infinite;
  pointer-events:none;
}

@keyframes starDrift{
  from{background-position:0 0,0 0}
  to{background-position:90px -90px,-120px 120px}
}

.admission-grid{
  position:absolute;
  inset:0;
  z-index:1;
  opacity:.11;
  background-image:
    linear-gradient(rgba(255,255,255,.17) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.17) 1px,transparent 1px);
  background-size:80px 80px;
  mask-image:linear-gradient(90deg,#000,transparent 80%);
  animation:gridMove 30s linear infinite;
}

@keyframes gridMove{
  to{transform:translate(-80px,-80px)}
}

.admission-orb{
  position:absolute;
  z-index:2;
  border:1px solid rgba(255,195,0,.20);
  border-radius:50%;
  box-shadow:
    inset 0 0 70px rgba(255,195,0,.045),
    0 0 80px rgba(255,195,0,.035);
  pointer-events:none;
  animation:orbFloat 9s ease-in-out infinite;
}

.orb-one{
  width:540px;
  height:540px;
  right:-245px;
  top:-170px;
}

.orb-two{
  width:300px;
  height:300px;
  right:155px;
  bottom:-205px;
  animation-delay:-3s;
}

@keyframes orbFloat{
  0%,100%{transform:translate3d(0,0,0)}
  50%{transform:translate3d(-12px,18px,0)}
}

.admission-overlay{
  position:relative;
  z-index:4;
  width:100%;
  padding:110px 0 100px;
}

.admission-badge,
.section-tag,
.cta-badge{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:11px 19px;
  border-radius:50px;
  background:linear-gradient(135deg,var(--gj-gold),var(--gj-gold-2));
  color:var(--gj-navy);
  font-size:10px;
  font-weight:950;
  letter-spacing:1.25px;
  text-transform:uppercase;
  box-shadow:0 14px 34px rgba(255,195,0,.22);
}

.admission-hero h1{
  max-width:920px;
  margin:23px 0 17px;
  color:#fff;
  font-size:clamp(56px,7.4vw,96px);
  line-height:.91;
  letter-spacing:-4px;
  font-weight:950;
  text-shadow:0 22px 55px rgba(0,0,0,.48);
}

.admission-hero h1::after{
  content:"";
  display:block;
  width:92px;
  height:5px;
  margin-top:26px;
  border-radius:20px;
  background:var(--gj-gold);
  box-shadow:0 7px 22px rgba(255,195,0,.32);
}

.admission-hero p{
  max-width:760px;
  margin:0;
  color:rgba(255,255,255,.72);
  font-size:18px;
  line-height:1.8;
}

.admission-breadcrumb{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:10px;
  margin-top:22px;
  color:rgba(255,255,255,.42);
  font-size:12px;
}

.admission-breadcrumb a{
  color:var(--gj-gold);
  text-decoration:none;
  font-weight:850;
  transition:.25s;
}

.admission-breadcrumb a:hover{color:#fff}

.admission-breadcrumb strong{
  color:rgba(255,255,255,.72);
}

.hero-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:32px;
}

.hero-actions a{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  min-height:52px;
  padding:0 23px;
  border-radius:15px;
  text-decoration:none;
  font-size:12px;
  font-weight:950;
  transition:.35s;
}

.hero-primary{
  background:linear-gradient(135deg,var(--gj-gold),var(--gj-gold-2));
  color:var(--gj-navy);
  box-shadow:0 17px 35px rgba(255,195,0,.24);
}

.hero-secondary{
  color:#fff;
  background:rgba(255,255,255,.075);
  border:1px solid rgba(255,255,255,.19);
  backdrop-filter:blur(12px);
}

.hero-actions a:hover{
  transform:translateY(-5px);
  background:#fff;
  color:var(--gj-navy);
}


/* ================= HERO POLISH ================= */

.admission-hero{
  isolation:isolate;
}

.admission-hero .admission-container{
  animation:heroContentIn .9s cubic-bezier(.2,.8,.2,1) both;
}

@keyframes heroContentIn{
  from{opacity:0;transform:translateY(28px)}
  to{opacity:1;transform:translateY(0)}
}

.admission-badge{
  animation:badgeFloat 4s ease-in-out infinite;
}

@keyframes badgeFloat{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-4px)}
}

.admission-hero h1{
  text-wrap:balance;
}

.admission-hero h1::after{
  animation:heroLine 2.8s ease-in-out infinite;
}

@keyframes heroLine{
  0%,100%{width:92px;opacity:1}
  50%{width:145px;opacity:.72}
}

.admission-hero .hero-primary i,
.admission-hero .hero-secondary i{
  transition:.3s;
}

.admission-hero .hero-primary:hover i,
.admission-hero .hero-secondary:hover i{
  transform:translateX(5px);
}

/* ================= INTRO ================= */

.admission-intro{
  position:relative;
  padding:115px 0;
  background:#fff;
}

.admission-intro::before{
  content:"";
  position:absolute;
  top:0;
  right:0;
  width:38%;
  height:100%;
  background:linear-gradient(180deg,rgba(255,195,0,.045),transparent);
  pointer-events:none;
}

.intro-grid{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:1.06fr .94fr;
  gap:34px;
  align-items:center;
}

.intro-copy{padding:15px 0}

.intro-copy h2{
  margin:20px 0 18px;
  color:var(--gj-navy);
  font-size:clamp(44px,5vw,65px);
  line-height:.99;
  letter-spacing:-2.8px;
  font-weight:950;
}

.intro-copy h2 span{
  display:block;
  color:#8d6500;
}

.intro-copy > p{
  max-width:680px;
  margin:0;
  color:var(--gj-muted);
  font-size:16px;
  line-height:1.9;
}

.intro-points{
  display:grid;
  gap:13px;
  margin-top:30px;
}

.intro-points div{
  display:flex;
  align-items:center;
  gap:11px;
  color:#294055;
  font-size:13px;
  font-weight:850;
}

.intro-points i{
  color:var(--gj-gold);
  font-size:20px;
}

.journey-card{
  position:relative;
  overflow:hidden;
  min-height:415px;
  padding:43px;
  border-radius:34px;
  background:
    radial-gradient(circle at 100% 0,rgba(255,195,0,.20),transparent 30%),
    linear-gradient(145deg,#000d19,#001f3f 60%,#075d98);
  box-shadow:0 30px 80px rgba(0,31,63,.22);
}

.journey-card::before{
  content:"";
  position:absolute;
  width:390px;
  height:390px;
  right:-270px;
  bottom:-245px;
  border:1px solid rgba(255,195,0,.17);
  border-radius:50%;
  box-shadow:0 0 0 55px rgba(255,195,0,.025);
}

.journey-card::after{
  content:"";
  position:absolute;
  left:-100px;
  top:-100px;
  width:220px;
  height:220px;
  border-radius:50%;
  background:rgba(255,255,255,.025);
}

.journey-top{
  position:relative;
  z-index:2;
  display:flex;
  align-items:center;
  justify-content:space-between;
  color:var(--gj-gold);
  font-size:9px;
  font-weight:950;
  letter-spacing:1.5px;
}

.journey-top i{font-size:24px}

.journey-number{
  position:relative;
  z-index:2;
  margin-top:38px;
  color:var(--gj-gold);
  font-size:88px;
  line-height:.8;
  font-weight:950;
  letter-spacing:-5px;
}

.journey-card h3{
  position:relative;
  z-index:2;
  margin:20px 0 17px;
  color:#fff;
  font-size:32px;
  line-height:1.08;
  font-weight:950;
}

.journey-line{
  width:74px;
  height:4px;
  margin:22px 0;
  border-radius:20px;
  background:var(--gj-gold);
}

.journey-card p{
  position:relative;
  z-index:2;
  max-width:430px;
  margin:0;
  color:rgba(255,255,255,.60);
  font-size:13px;
  line-height:1.85;
}

/* ================= PROCESS ================= */

.admission-process-section{
  position:relative;
  overflow:hidden;
  padding:118px 0 125px;
  background:
    radial-gradient(circle at 8% 10%,rgba(255,195,0,.075),transparent 22%),
    radial-gradient(circle at 92% 85%,rgba(0,80,140,.06),transparent 25%),
    #f4f7fa;
}

.admission-process-section::before{
  content:"";
  position:absolute;
  width:520px;
  height:520px;
  left:-310px;
  top:140px;
  border:1px solid rgba(255,195,0,.13);
  border-radius:50%;
  box-shadow:0 0 0 55px rgba(255,195,0,.025),0 0 0 110px rgba(255,195,0,.018);
  animation:processRing 12s ease-in-out infinite;
  pointer-events:none;
}

.admission-process-section::after{
  content:"";
  position:absolute;
  width:420px;
  height:420px;
  right:-250px;
  bottom:-220px;
  border:1px solid rgba(0,57,104,.10);
  border-radius:50%;
  animation:processRing 14s ease-in-out infinite reverse;
  pointer-events:none;
}

@keyframes processRing{
  0%,100%{transform:translate3d(0,0,0) rotate(0deg)}
  50%{transform:translate3d(18px,-15px,0) rotate(8deg)}
}

.section-heading{
  position:relative;
  z-index:2;
  max-width:850px;
  margin:0 auto 66px;
  text-align:center;
}

.section-heading h2{
  margin:20px 0 14px;
  color:var(--gj-navy);
  font-size:clamp(40px,4.7vw,58px) !important;
  line-height:1.05 !important;
  letter-spacing:-2px;
  font-weight:950;
}

.section-heading p{
  max-width:760px;
  margin:auto;
  color:#687b8b;
  font-size:16px !important;
  line-height:1.85 !important;
}

.process-timeline{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:24px;
}

/* animated connector behind the cards */
.process-timeline::before{
  content:"";
  position:absolute;
  left:8%;
  right:8%;
  top:50%;
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(255,195,0,.35),rgba(255,195,0,.65),rgba(255,195,0,.35),transparent);
  opacity:.55;
  pointer-events:none;
}

.process-card{
  position:relative;
  overflow:hidden;
  isolation:isolate;
  min-width:0;
  min-height:350px;
  display:flex;
  flex-direction:column;
  padding:31px 31px 27px;
  border:1px solid #dfe7ed;
  border-radius:30px;
  background:rgba(255,255,255,.96);
  box-shadow:0 18px 48px rgba(0,31,63,.075);
  transition:
    transform .45s cubic-bezier(.2,.8,.2,1),
    box-shadow .45s ease,
    border-color .35s ease;
}

.process-card::before{
  content:"";
  position:absolute;
  z-index:-1;
  left:0;
  top:0;
  width:100%;
  height:4px;
  background:linear-gradient(90deg,#ffc300,#ffe47b,#ffc300);
  background-size:200% 100%;
  animation:goldShimmer 4s linear infinite;
}

@keyframes goldShimmer{
  to{background-position:200% 0}
}

.process-card::after{
  content:"";
  position:absolute;
  z-index:-1;
  width:220px;
  height:220px;
  right:-135px;
  bottom:-135px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(255,195,0,.14),rgba(255,195,0,0) 68%);
  transition:.55s;
}

.process-card:hover{
  transform:translateY(-12px);
  border-color:rgba(255,195,0,.52);
  box-shadow:0 32px 76px rgba(0,31,63,.15);
}

.process-card:hover::after{
  transform:scale(1.45);
}

.step-head{
  position:relative;
  z-index:2;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
}

.step-number{
  color:#d9e2e8 !important;
  font-size:45px !important;
  line-height:1 !important;
  letter-spacing:-2px;
  font-weight:950 !important;
  transition:.35s;
}

.process-card:hover .step-number{
  color:#ffc300 !important;
}

.step-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  flex:0 0 58px;
  width:58px;
  height:58px;
  border-radius:18px;
  background:#002747 !important;
  color:#ffc300 !important;
  font-size:21px !important;
  box-shadow:0 13px 28px rgba(0,31,63,.18);
  transition:.4s cubic-bezier(.2,.8,.2,1);
}

.process-card:hover .step-icon{
  transform:translateY(-4px) rotate(-5deg) scale(1.06);
  background:#ffc300 !important;
  color:#001f3f !important;
}

.step-label{
  position:relative;
  z-index:2;
  display:inline-flex !important;
  align-self:flex-start;
  width:auto !important;
