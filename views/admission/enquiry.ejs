</style>

<script>
document.addEventListener('DOMContentLoaded', function(){

  /* =======================================================
     FORM VALIDATION
  ======================================================= */

  const enquiryForm = document.querySelector('.enquiry-form');

  if (enquiryForm) {

    enquiryForm.addEventListener('submit', function(e) {

      const parentName = this.name.value.trim();
      const studentName = this.studentName.value.trim();
      const phone = this.phone.value.trim();
      const message = this.message.value.trim();

      const nameRegex = /^[A-Za-z\s.]{3,60}$/;

      if (!nameRegex.test(parentName)) {
        alert('Parent / Guardian name should contain only letters and minimum 3 characters.');
        e.preventDefault();
        return;
      }

      if (!nameRegex.test(studentName)) {
        alert('Student name should contain only letters and minimum 3 characters.');
        e.preventDefault();
        return;
      }

      if (!/^[0-9]{10}$/.test(phone)) {
        alert('Mobile number must be exactly 10 digits.');
        e.preventDefault();
        return;
      }

      if (message.length < 5) {
        alert('Message must be at least 5 characters.');
        e.preventDefault();
        return;
      }

      const btn = this.querySelector('.submit-btn');

      btn.innerHTML =
        '<span class="submit-content">' +
        '<i class="fas fa-spinner fa-spin"></i> Sending...' +
        '</span>';

      btn.disabled = true;

    });

  }

  /* =======================================================
     MESSAGE CHARACTER COUNTER
  ======================================================= */

  const message = document.getElementById('message');
  const counter = document.getElementById('messageCounter');

  if (message && counter) {

    function updateCounter(){
      counter.textContent = message.value.length + ' / 1000';
    }

    message.addEventListener('input', updateCounter);
    updateCounter();

  }

  /* =======================================================
     MOBILE NUMBER — ONLY DIGITS
  ======================================================= */

  const phoneInput = document.getElementById('phone');

  if (phoneInput) {

    phoneInput.addEventListener('input', function(){

      this.value = this.value.replace(/\D/g, '').slice(0, 10);

    });

  }

  /* =======================================================
     SCROLL REVEAL
  ======================================================= */

  if ('IntersectionObserver' in window) {

    const items = document.querySelectorAll(
      '.enquiry-info-card, .enquiry-form-card, .why-card'
    );

    const observer = new IntersectionObserver(function(entries, obs){

      entries.forEach(function(entry){

        if (!entry.isIntersecting) {
          return;
        }

        entry.target.classList.add('enquiry-visible');
        obs.unobserve(entry.target);

      });

    }, {
      threshold:0.08
    });

    items.forEach(function(item, index){

      item.style.opacity = '0';
      item.style.transform = 'translateY(24px)';
      item.style.transition =
        'opacity .65s ease ' +
        ((index % 3) * .08) +
        's, transform .65s ease ' +
        ((index % 3) * .08) +
        's';

      observer.observe(item);

    });

    const style = document.createElement('style');

    style.textContent = `
      .enquiry-visible{
        opacity:1 !important;
        transform:translateY(0) !important;
      }
    `;

    document.head.appendChild(style);

  }

});
</script>

