<%- include('../partials/header') %>

<section class="enquiry-hero">
  <div class="enquiry-hero-grid"></div>
  <div class="enquiry-orb enquiry-orb-one"></div>
  <div class="enquiry-orb enquiry-orb-two"></div>

  <div class="enquiry-container enquiry-hero-content">

    <div class="hero-kicker">
      <span class="kicker-dot"></span>
      Admissions Open • Enquiry Desk
    </div>

    <span class="hero-badge">
      <i class="fas fa-comments"></i>
      Admission Enquiry
    </span>

    <h1>Talk to Our <span>Admission Team</span></h1>

    <p>
      Have questions about admission, classes, fees or school facilities?
      Fill the enquiry form and our team will contact you soon.
    </p>

    <div class="hero-actions">
      <a href="/admission/registration" class="hero-primary">
        <i class="fas fa-user-plus"></i>
        Register Now
        <i class="fas fa-arrow-right action-arrow"></i>
      </a>

      <a href="tel:+919876543210" class="hero-secondary">
        <i class="fas fa-phone"></i>
        Call School
      </a>
    </div>

    <div class="hero-trust">
      <span><i class="fas fa-circle-check"></i> Admission Guidance</span>
      <span><i class="fas fa-circle-check"></i> Fee Information</span>
      <span><i class="fas fa-circle-check"></i> Campus Support</span>
    </div>

  </div>
</section>

<section class="enquiry-section">
  <div class="enquiry-container">

    <div class="enquiry-heading">
      <span class="section-tag">
        <i class="fas fa-paper-plane"></i>
        Get Admission Support
      </span>

      <h2>Submit Your Enquiry</h2>

      <p>
        Our admission counsellor will guide you about class availability,
        admission process, fees and school facilities.
      </p>
    </div>

    <div class="enquiry-layout">

      <!-- =====================================================
           SCHOOL INFORMATION
      ====================================================== -->

      <aside class="enquiry-info-card">

        <div class="info-glow"></div>

        <div class="school-brand">
          <div class="school-logo-box">
            <img src="/images/logo.png" alt="Gyan Jyoti Logo">
          </div>

          <div>
            <span class="brand-label">ADMISSION DESK</span>
            <h2>Gyan Jyoti School</h2>
          </div>
        </div>

        <p class="info-description">
          We provide quality education with discipline, confidence,
          values and academic excellence.
        </p>

        <div class="info-divider"></div>

        <div class="info-item">
          <div class="info-icon">
            <i class="fas fa-phone"></i>
          </div>

          <div>
            <span class="info-label">CALL US</span>
            <h4>School Phone</h4>
            <p>
              <%= typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.phone
                ? schoolInfo.phone
                : '+91 98765-43210' %>
            </p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">
            <i class="fas fa-envelope"></i>
          </div>

          <div>
            <span class="info-label">EMAIL</span>
            <h4>Email Address</h4>
            <p>
              <%= typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.email
                ? schoolInfo.email
                : 'info@gyanjyoti.com' %>
            </p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">
            <i class="fas fa-location-dot"></i>
          </div>

          <div>
            <span class="info-label">VISIT CAMPUS</span>
            <h4>School Address</h4>
            <p>
              <%= typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.address
                ? schoolInfo.address
                : 'C4M4+858, Ruchika Catering Rd, North Civil Lines, Nainpur, Madhya Pradesh 481776' %>
            </p>
          </div>
        </div>

        <a href="/admission/process" class="info-link">
          <span>
            <i class="fas fa-route"></i>
            View Admission Process
          </span>
          <i class="fas fa-arrow-right"></i>
        </a>

      </aside>

      <!-- =====================================================
           ENQUIRY FORM
      ====================================================== -->

      <div class="enquiry-form-card">

        <div class="form-card-header">
          <div>
            <span class="form-label">STEP 01</span>
            <h3>Tell Us About Your Requirement</h3>
          </div>

          <div class="secure-badge">
            <i class="fas fa-shield-halved"></i>
            Secure Form
          </div>
        </div>

        <% if (typeof query !== 'undefined' && query.success) { %>
          <div class="success-msg">
            <span class="message-icon">
              <i class="fas fa-check"></i>
            </span>
            <div>
              <strong>Enquiry Submitted Successfully</strong>
              <p>Our team will contact you soon.</p>
            </div>
          </div>
        <% } %>

        <% if (typeof query !== 'undefined' && query.error) { %>
          <div class="error-msg">
            <span class="message-icon">
              <i class="fas fa-exclamation"></i>
            </span>
            <div>
              <strong>Please check your details</strong>
              <p>Fill all required details correctly and try again.</p>
            </div>
          </div>
        <% } %>

        <form action="/admission/enquiry" method="POST" class="enquiry-form" novalidate>

          <div class="form-section-title">
            <span>01</span>
            <div>
              <strong>Student &amp; Parent Details</strong>
              <small>Required information</small>
            </div>
          </div>

          <div class="form-row">

            <div class="form-group">
              <label for="parentName">
                Parent / Guardian Name <span>*</span>
              </label>

              <div class="input-wrap">
                <i class="fas fa-user"></i>
                <input
                  type="text"
                  id="parentName"
                  name="name"
                  placeholder="Enter parent / guardian name"
                  pattern="[A-Za-z\s.]{3,60}"
                  maxlength="60"
                  autocomplete="name"
                  required>
              </div>
            </div>

            <div class="form-group">
              <label for="studentName">
                Student Name <span>*</span>
              </label>

              <div class="input-wrap">
                <i class="fas fa-user-graduate"></i>
                <input
                  type="text"
                  id="studentName"
                  name="studentName"
                  placeholder="Enter student name"
                  pattern="[A-Za-z\s.]{3,60}"
                  maxlength="60"
                  autocomplete="off"
                  required>
              </div>
            </div>

          </div>

          <div class="form-row">

            <div class="form-group">
              <label for="class">
                Class Applying For <span>*</span>
              </label>

              <div class="input-wrap">
                <i class="fas fa-school"></i>
                <input
                  type="text"
                  id="class"
                  name="class"
                  placeholder="Example: Class 6"
                  maxlength="30"
                  required>
              </div>
            </div>

            <div class="form-group">
              <label for="phone">
                Mobile Number <span>*</span>
              </label>

              <div class="input-wrap">
                <i class="fas fa-mobile-screen-button"></i>
                <input
                  type="text"
                  id="phone"
                  name="phone"
                  placeholder="10 digit mobile number"
                  pattern="[0-9]{10}"
                  maxlength="10"
                  inputmode="numeric"
                  autocomplete="tel"
                  required>
              </div>
            </div>

          </div>

          <div class="form-section-title form-section-second">
            <span>02</span>
            <div>
              <strong>Contact &amp; Enquiry</strong>
              <small>How can we help you?</small>
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>

            <div class="input-wrap">
              <i class="fas fa-envelope"></i>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Enter email address"
                maxlength="80"
                autocomplete="email">
            </div>
          </div>

          <div class="form-group">
            <label for="message">
              Your Enquiry <span>*</span>
            </label>

            <div class="input-wrap textarea-wrap">
              <i class="fas fa-message"></i>
              <textarea
                id="message"
                name="message"
                placeholder="Write your enquiry..."
                minlength="5"
                maxlength="1000"
                required></textarea>
            </div>

            <div class="character-hint">
              <span>Tell us what you would like to know.</span>
              <span id="messageCounter">0 / 1000</span>
            </div>
          </div>

          <button type="submit" class="submit-btn">
            <span class="submit-content">
              <i class="fas fa-paper-plane"></i>
              Send Enquiry
            </span>
            <span class="submit-arrow">
              <i class="fas fa-arrow-right"></i>
            </span>
          </button>

          <p class="form-note">
            <i class="fas fa-lock"></i>
            Your information is submitted securely to the school admission team.
          </p>

        </form>
      </div>

    </div>
  </div>
</section>

<section class="why-enquiry-section">
  <div class="enquiry-container">

    <div class="why-heading">
      <span class="section-tag">Why Contact Us?</span>
      <h2>Get the Right Guidance Before You Apply</h2>
      <p>
        Our admission support is designed to make your first interaction
        with the school simple and informative.
      </p>
    </div>

    <div class="why-grid">

      <div class="why-card">
        <div class="why-number">01</div>
        <div class="why-icon">
          <i class="fas fa-user-graduate"></i>
        </div>
        <span>ADMISSIONS</span>
        <h3>Admission Guidance</h3>
        <p>
          Get complete support about admission process and class availability.
        </p>
      </div>

      <div class="why-card">
        <div class="why-number">02</div>
        <div class="why-icon">
          <i class="fas fa-file-invoice-dollar"></i>
        </div>
        <span>FEES</span>
        <h3>Fees Information</h3>
        <p>
          Our team will guide you about class-wise fees and payment details.
        </p>
      </div>

      <div class="why-card">
        <div class="why-number">03</div>
        <div class="why-icon">
          <i class="fas fa-school"></i>
        </div>
        <span>CAMPUS</span>
        <h3>School Visit</h3>
        <p>
          Parents can visit the campus and meet the school office team.
        </p>
      </div>

    </div>

  </div>
</section>

<section class="enquiry-cta">
  <div class="cta-orb"></div>

  <div class="enquiry-container">
    <span class="cta-badge">
      <i class="fas fa-graduation-cap"></i>
      Begin Your Journey
    </span>

    <h2>Still Have Questions?</h2>

    <p>
      Our admission team is ready to help you understand the next step
      for your child's educational journey.
    </p>

    <div class="cta-actions">
      <a href="/admission/registration" class="cta-primary">
        <i class="fas fa-user-plus"></i>
        Register Now
      </a>

      <a href="/admission/process" class="cta-secondary">
        Admission Process
        <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

<style>
/* =========================================================
   PREMIUM ADMISSION ENQUIRY
   Gyan Jyoti School — Navy / Gold
========================================================= */

.enquiry-container{
  width:min(1200px,92%);
  margin:0 auto;
}

/* =========================================================
   HERO
========================================================= */

.enquiry-hero{
  min-height:620px;
  position:relative;
  display:flex;
  align-items:center;
  overflow:hidden;
  background:
    radial-gradient(circle at 80% 18%,rgba(255,195,0,.16),transparent 27%),
    linear-gradient(135deg,#000913,#001f3f 58%,#075d98);
}

.enquiry-hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(135deg,rgba(0,8,18,.84),rgba(0,31,63,.70)),
    url('/images/school-bg.jpg') center/cover no-repeat;
  opacity:.65;
}

.enquiry-hero-grid{
  position:absolute;
  inset:0;
  opacity:.12;
  background-image:
    linear-gradient(rgba(255,255,255,.15) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.15) 1px,transparent 1px);
  background-size:70px 70px;
  animation:enquiryGrid 28s linear infinite;
}

@keyframes enquiryGrid{
  from{transform:translate(0,0)}
  to{transform:translate(-70px,-70px)}
}

.enquiry-orb{
  position:absolute;
  border:1px solid rgba(255,195,0,.16);
  border-radius:50%;
  animation:enquiryFloat 8s ease-in-out infinite;
}

.enquiry-orb-one{
  width:460px;
  height:460px;
  right:-210px;
  top:-220px;
}

.enquiry-orb-two{
  width:260px;
  height:260px;
  left:-130px;
  bottom:-160px;
  animation-delay:-3s;
}

@keyframes enquiryFloat{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-18px)}
}

.enquiry-hero-content{
  position:relative;
  z-index:2;
  padding:90px 0;
}

.hero-kicker{
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin-bottom:20px;
  color:rgba(255,255,255,.60);
  font-size:10px;
  font-weight:900;
  letter-spacing:1.5px;
  text-transform:uppercase;
}

.kicker-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#ffc300;
  box-shadow:0 0 0 5px rgba(255,195,0,.10);
}

.hero-badge,
.section-tag,
.cta-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:10px 19px;
  border-radius:50px;
  background:#ffc300;
  color:#001f3f;
  font-size:10px;
  font-weight:950;
  letter-spacing:1.2px;
  text-transform:uppercase;
  box-shadow:0 12px 30px rgba(255,195,0,.18);
}

.enquiry-hero h1{
  max-width:950px;
  margin:22px 0 15px;
  color:#fff;
  font-size:clamp(52px,7vw,84px);
  line-height:.96;
  letter-spacing:-3px;
  font-weight:950;
  text-shadow:0 20px 50px rgba(0,0,0,.40);
}

.enquiry-hero h1 span{
  color:#ffc300;
}

.enquiry-hero > .enquiry-container > p{
  max-width:790px;
  margin:0;
  color:rgba(255,255,255,.69);
  font-size:18px;
  line-height:1.8;
}

.hero-actions{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:30px;
}

.hero-actions a{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:15px 22px;
  border-radius:50px;
  text-decoration:none;
  font-size:13px;
  font-weight:950;
  transition:.35s;
}

.hero-primary{
  background:#ffc300;
  color:#001f3f;
  box-shadow:0 15px 32px rgba(255,195,0,.24);
}

.hero-secondary{
  color:#fff;
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.19);
}

.action-arrow{
  margin-left:5px;
  font-size:10px;
}

.hero-actions a:hover{
  transform:translateY(-5px);
  background:#fff;
  color:#001f3f;
}

.hero-trust{
  display:flex;
  gap:20px;
  flex-wrap:wrap;
  margin-top:28px;
}

.hero-trust span{
  display:inline-flex;
  align-items:center;
  gap:7px;
  color:rgba(255,255,255,.50);
  font-size:10px;
  font-weight:800;
}

.hero-trust i{
  color:#ffc300;
}

/* =========================================================
   MAIN ENQUIRY
========================================================= */

.enquiry-section{
  padding:105px 0;
  background:
    radial-gradient(circle at 5% 5%,rgba(255,195,0,.07),transparent 25%),
    #f5f8fb;
}

.enquiry-heading{
  max-width:800px;
  margin:0 auto 55px;
  text-align:center;
}

.enquiry-heading h2{
  margin:18px 0 12px;
  color:#001f3f;
  font-size:clamp(40px,5vw,56px);
  line-height:1.03;
  letter-spacing:-2px;
  font-weight:950;
}

.enquiry-heading p{
  margin:0;
  color:#6d7b88;
  font-size:16px;
  line-height:1.8;
}

.enquiry-layout{
  display:grid;
  grid-template-columns:.82fr 1.18fr;
  gap:25px;
  align-items:stretch;
}

.enquiry-info-card,
.enquiry-form-card{
  position:relative;
  overflow:hidden;
  border-radius:30px;
  box-shadow:0 25px 65px rgba(0,31,63,.12);
}

.enquiry-info-card{
  padding:40px;
  color:#fff;
  background:
    radial-gradient(circle at 100% 0,rgba(255,195,0,.16),transparent 32%),
    linear-gradient(145deg,#000b18,#001f3f 62%,#004481);
}

.info-glow{
  position:absolute;
  width:280px;
  height:280px;
  right:-170px;
  bottom:-170px;
  border-radius:50%;
  border:1px solid rgba(255,195,0,.14);
}

.school-brand{
  position:relative;
  z-index:2;
  display:flex;
  align-items:center;
  gap:16px;
}

.school-logo-box{
  width:84px;
  height:84px;
  flex:0 0 84px;
  padding:6px;
  border-radius:50%;
  background:#fff;
  border:4px solid #ffc300;
  box-shadow:0 15px 35px rgba(0,0,0,.22);
}

.school-logo-box img{
  width:100%;
  height:100%;
  object-fit:contain;
}

.brand-label,
.info-label,
.form-label,
.card-label{
  display:block;
  font-size:8px;
  font-weight:950;
  letter-spacing:1.4px;
  text-transform:uppercase;
}

.brand-label{
  margin-bottom:5px;
  color:#ffc300;
}

.enquiry-info-card h2{
  margin:0;
  color:#fff;
  font-size:29px;
  font-weight:950;
}

.info-description{
  position:relative;
  z-index:2;
  margin:25px 0;
  color:rgba(255,255,255,.66);
  font-size:13px;
  line-height:1.8;
}

.info-divider{
  height:1px;
  margin-bottom:20px;
  background:rgba(255,255,255,.10);
}

.info-item{
  position:relative;
  z-index:2;
  display:flex;
