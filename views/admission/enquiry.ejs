}

.info-label{
  margin-bottom:4px;
  color:#ffc300;
}

.info-item h4{
  margin:0 0 4px;
  color:#fff;
  font-size:14px;
}

.info-item p{
  margin:0;
  color:rgba(255,255,255,.59);
  font-size:11px;
