  animation:mapGridMove 26s linear infinite;
}

@keyframes mapGridMove{
  from{transform:translate(0,0)}
  to{transform:translate(-70px,-70px)}
}

.map-orb{
  position:absolute;
  border-radius:50%;
  border:1px solid rgba(255,195,0,.18);
  animation:mapOrb 8s ease-in-out infinite;
}

.map-orb-one{
  width:450px;
  height:450px;
  right:-180px;
  top:-190px;
}

.map-orb-two{
  width:270px;
  height:270px;
  left:-130px;
  bottom:-170px;
  animation-delay:-3s;
}

