}

/* =========================================================
   HERO
========================================================= */

.school-map-hero{
  min-height:620px;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  text-align:center;
  background:
    radial-gradient(circle at 78% 18%,rgba(255,195,0,.18),transparent 26%),
    linear-gradient(135deg,#000914,#001f3f 58%,#075d98);
}

.school-map-hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg,rgba(0,8,18,.75),rgba(0,31,63,.72)),
    url('/images/school-bg.jpg') center/cover no-repeat;
  opacity:.52;
}

.map-grid{
  position:absolute;
  inset:0;
  opacity:.13;
  background-image:
