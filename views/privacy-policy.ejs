<%- include('partials/header') %>

<main class="legal-page legal-privacy">
    <div class="legal-ambient legal-ambient-one"></div>
    <div class="legal-ambient legal-ambient-two"></div>
    <div class="legal-grid"></div>

    <section class="legal-hero">
        <div class="legal-shell">
            <div class="legal-hero-copy legal-reveal">
                <div class="legal-kicker">
                    <span class="legal-kicker-line"></span>
                    GYAN JYOTI INTERNATIONAL SCHOOL
                    <span class="legal-kicker-line"></span>
                </div>

                <div class="legal-icon">
                    <i class="fas fa-shield-halved"></i>
                </div>

                <h1>
                    Privacy <em>Policy</em>
                </h1>

                <p class="legal-lead">
                    Your trust matters to us. This page explains how information
                    provided through the Gyan Jyoti website may be handled,
                    protected and used to support communication and school services.
                </p>

                <div class="legal-meta-row">
                    <span><i class="fas fa-calendar-check"></i> Last updated: 2026</span>
                    <span><i class="fas fa-lock"></i> Privacy first</span>
                    <span><i class="fas fa-school"></i> Gyan Jyoti</span>
                </div>
            </div>

            <div class="legal-hero-visual legal-reveal">
                <div class="legal-orbit orbit-a"></div>
                <div class="legal-orbit orbit-b"></div>

                <div class="legal-glass-card">
                    <div class="legal-card-top">
                        <span class="legal-live-dot"></span>
                        DATA & PRIVACY
                    </div>

                    <div class="legal-shield">
                        <i class="fas fa-shield-halved"></i>
                    </div>

                    <strong>Built around trust.</strong>
                    <p>
                        We aim to keep personal information handled responsibly
                        and only for legitimate school-related purposes.
                    </p>

                    <div class="legal-card-line"></div>

                    <div class="legal-mini-row">
                        <span><i class="fas fa-check"></i> Responsible use</span>
                        <span><i class="fas fa-check"></i> Secure handling</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="legal-body">
        <div class="legal-shell legal-body-grid">

            <aside class="legal-sidebar legal-reveal">
                <div class="legal-sidebar-inner">
                    <span class="legal-side-label">ON THIS PAGE</span>

                    <a href="#overview" class="legal-nav-link is-active">Overview</a>
                    <a href="#information" class="legal-nav-link">Information We Collect</a>
                    <a href="#use" class="legal-nav-link">How We Use Information</a>
                    <a href="#sharing" class="legal-nav-link">Information Sharing</a>
                    <a href="#security" class="legal-nav-link">Security</a>
                    <a href="#cookies" class="legal-nav-link">Cookies</a>
                    <a href="#choices" class="legal-nav-link">Your Choices</a>
                    <a href="#contact" class="legal-nav-link">Contact</a>
                </div>
            </aside>

            <article class="legal-content legal-reveal">

                <section id="overview" class="legal-section">
                    <span class="legal-section-number">01</span>
                    <div>
                        <span class="legal-section-kicker">THE BASICS</span>
                        <h2>Privacy with <em>purpose</em>.</h2>
                        <p>
                            Gyan Jyoti International School respects the privacy
                            of students, parents, guardians, staff, applicants and
                            visitors who interact with this website.
                        </p>
                        <p>
                            This Privacy Policy describes, at a general level,
                            how information submitted through the website may be
                            collected, used and protected. Specific practices may
                            depend on the service or form being used.
                        </p>
                    </div>
                </section>

                <section id="information" class="legal-section">
                    <span class="legal-section-number">02</span>
                    <div>
                        <span class="legal-section-kicker">INFORMATION</span>
                        <h2>What information may we <em>collect?</em></h2>

                        <div class="legal-info-grid">
                            <div class="legal-info-card">
                                <i class="fas fa-user"></i>
                                <h3>Contact details</h3>
                                <p>
                                    Information such as name, email address,
                                    phone number or other details you choose to
                                    provide through a website form.
                                </p>
                            </div>

                            <div class="legal-info-card">
                                <i class="fas fa-file-lines"></i>
                                <h3>Enquiry details</h3>
                                <p>
                                    Information you submit when requesting
                                    admission information, contacting the school
                                    or making an enquiry.
                                </p>
                            </div>

                            <div class="legal-info-card">
                                <i class="fas fa-laptop"></i>
                                <h3>Technical information</h3>
                                <p>
                                    Basic technical information may be processed
                                    to operate, secure and improve the website.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="use" class="legal-section">
                    <span class="legal-section-number">03</span>
                    <div>
                        <span class="legal-section-kicker">PURPOSE</span>
                        <h2>How information is <em>used</em>.</h2>

                        <ul class="legal-check-list">
                            <li><i class="fas fa-check"></i><span>Respond to enquiries and requests submitted through the website.</span></li>
                            <li><i class="fas fa-check"></i><span>Provide information about admissions, academics, events and school services.</span></li>
                            <li><i class="fas fa-check"></i><span>Maintain website functionality, security and reliability.</span></li>
                            <li><i class="fas fa-check"></i><span>Improve the website experience and understand general usage patterns.</span></li>
                            <li><i class="fas fa-check"></i><span>Meet applicable legal, administrative or security requirements where necessary.</span></li>
                        </ul>
                    </div>
                </section>

                <section id="sharing" class="legal-section">
                    <span class="legal-section-number">04</span>
                    <div>
                        <span class="legal-section-kicker">DISCLOSURE</span>
                        <h2>When information may be <em>shared</em>.</h2>
                        <p>
                            Personal information is not intended to be sold as a
                            product. Information may be shared with authorised
                            personnel, service providers or authorities where
                            reasonably necessary to provide a requested service,
                            operate the website, protect users or comply with law.
                        </p>

                        <div class="legal-callout">
                            <i class="fas fa-circle-info"></i>
                            <div>
                                <strong>Important</strong>
                                <p>
                                    The exact third-party services used by a live
                                    deployment should be reviewed before publishing
                                    this policy as a final legal document.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="security" class="legal-section">
                    <span class="legal-section-number">05</span>
                    <div>
                        <span class="legal-section-kicker">PROTECTION</span>
                        <h2>Security matters.</h2>
                        <p>
                            Reasonable administrative, technical and organisational
                            measures may be used to protect information from
                            unauthorised access, alteration, disclosure or misuse.
                        </p>
                        <p>
                            No internet transmission or storage system can be
                            guaranteed to be completely secure. Users should also
                            take reasonable care when sharing information online.
                        </p>
                    </div>
                </section>

                <section id="cookies" class="legal-section">
                    <span class="legal-section-number">06</span>
                    <div>
                        <span class="legal-section-kicker">BROWSING</span>
                        <h2>Cookies & similar <em>technology</em>.</h2>
                        <p>
                            The website may use cookies or similar technologies
                            where needed for functionality, preferences, security,
                            analytics or a smoother browsing experience.
                        </p>
                        <p>
                            Browser settings may allow you to control or restrict
                            cookies. Disabling certain cookies can affect some
                            website functionality.
                        </p>
                    </div>
                </section>

                <section id="choices" class="legal-section">
                    <span class="legal-section-number">07</span>
                    <div>
                        <span class="legal-section-kicker">YOUR CONTROL</span>
                        <h2>Your information, your <em>choices</em>.</h2>
                        <p>
                            Where applicable, you may request clarification about
                            information submitted through the website or ask how
                            that information is being handled.
                        </p>
                        <p>
                            Requests may be subject to identity verification and
                            applicable legal or administrative requirements.
                        </p>
                    </div>
                </section>

                <section id="contact" class="legal-section legal-contact-section">
                    <span class="legal-section-number">08</span>
                    <div>
                        <span class="legal-section-kicker">GET IN TOUCH</span>
                        <h2>Questions about <em>privacy?</em></h2>
                        <p>
                            For privacy-related questions, please contact Gyan Jyoti
                            International School using the official contact details
                            provided on this website.
                        </p>

                        <div class="legal-contact-card">
                            <div>
                                <span><i class="fas fa-envelope"></i> Email</span>
                                <strong>info@gyanjyoti.com</strong>
                            </div>
                            <div>
                                <span><i class="fas fa-phone"></i> Phone</span>
                                <strong>+91 98765-43210</strong>
                            </div>
                            <a href="/contact" class="legal-primary-btn">
                                Contact School
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </section>

                <div class="legal-bottom-note">
                    <i class="fas fa-circle-exclamation"></i>
                    <span>
                        This page is a website-ready privacy policy draft.
                        Confirm the school's actual data practices, retention
                        periods, processors and legal requirements before treating
                        it as the final legal policy.
                    </span>
                </div>

            </article>
        </div>
    </section>
</main>

