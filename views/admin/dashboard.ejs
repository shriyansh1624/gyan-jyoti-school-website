========================================================= -->

<section
    class="section"
    id="notifications"
>


    <div class="section-title">

        <h2>

            <i class="fas fa-bell"></i>

            Latest Notifications

        </h2>


        <span class="pill">

            <%= notificationCount || 0 %>

            New

        </span>

    </div>


    <div class="table-wrap">


        <table>


            <thead>

                <tr>

                    <th>Type</th>

                    <th>Name</th>

                    <th>Contact</th>

                    <th>Message</th>

                    <th>Date</th>

                    <th>Open</th>

                </tr>

            </thead>


            <tbody>


            <% if (
                (admissions && admissions.length) ||
                (enquiries && enquiries.length) ||
                (contacts && contacts.length)
            ) { %>


                <% if (admissions) {
                    admissions.forEach(a => { %>

                    <tr>

                        <td>
                            <span class="badge admission">
                                Admission
                            </span>
                        </td>


                        <td>

                            <a
                                class="record-link"
                                href="#admission-<%= a._id %>"
                            >

                                <%= a.studentName || '-' %>

                            </a>

                        </td>


                        <td>
                            <%= a.phone || '-' %>
                        </td>


                        <td class="message">

                            Class:
                            <%= a.class || '-' %>,

                            Parent:
                            <%= a.parentName || '-' %>

                        </td>


                        <td>

                            <%= a.createdAt
                                ? new Date(a.createdAt)
                                    .toLocaleDateString('en-IN')
                                : '-'
                            %>

                        </td>


                        <td>

                            <a
                                href="#admission-<%= a._id %>"
                                class="action-btn view-btn"
                            >

                                <i class="fas fa-arrow-right"></i>

                            </a>

                        </td>

                    </tr>

                <% }) } %>



                <% if (enquiries) {
                    enquiries.forEach(e => { %>

                    <tr>

                        <td>

                            <span class="badge enquiry">
                                Enquiry
                            </span>

                        </td>


                        <td>

                            <a
                                class="record-link"
                                href="#enquiry-<%= e._id %>"
                            >

                                <%= e.name || '-' %>

                            </a>

                        </td>


                        <td>
                            <%= e.phone || '-' %>
                        </td>


                        <td class="message">
                            <%= e.message || '-' %>
                        </td>


                        <td>

                            <%= e.createdAt
                                ? new Date(e.createdAt)
                                    .toLocaleDateString('en-IN')
                                : '-'
                            %>

                        </td>


                        <td>

                            <a
                                href="#enquiry-<%= e._id %>"
                                class="action-btn view-btn"
                            >

                                <i class="fas fa-arrow-right"></i>

                            </a>

                        </td>

                    </tr>

                <% }) } %>



                <% if (contacts) {
                    contacts.forEach(c => { %>

                    <tr>

                        <td>

                            <span class="badge contact">
                                Contact
                            </span>

                        </td>


                        <td>

                            <a
                                class="record-link"
                                href="#contact-<%= c._id %>"
                            >

                                <%= c.name || '-' %>

                            </a>

                        </td>


                        <td>
                            <%= c.email || '-' %>
                        </td>


                        <td class="message">
                            <%= c.subject || '-' %>
                        </td>


                        <td>

                            <%= c.createdAt
                                ? new Date(c.createdAt)
                                    .toLocaleDateString('en-IN')
                                : '-'
                            %>

                        </td>


                        <td>

                            <a
                                href="#contact-<%= c._id %>"
                                class="action-btn view-btn"
                            >

                                <i class="fas fa-arrow-right"></i>

                            </a>

                        </td>

                    </tr>

                <% }) } %>


            <% } else { %>


                <tr>

                    <td
                        colspan="6"
                        class="empty"
                    >

                        <i class="fas fa-bell-slash"></i>

                        No notifications found

                    </td>

                </tr>


            <% } %>


            </tbody>


        </table>


    </div>


</section>



<!-- =========================================================
     ADMISSIONS
========================================================= -->

<section
    class="section"
    id="admissions"
>


    <div class="section-title">

        <h2>

            <i class="fas fa-user-graduate"></i>

            Registration / Admission Forms

        </h2>


        <span class="pill">

            <%= admissionCount || 0 %>

            Records

        </span>

    </div>


    <% if (
        admissions &&
        admissions.length > 0
    ) { %>


    <div class="table-wrap">


        <table>


            <thead>

                <tr>

                    <th>Student</th>

                    <th>Class</th>

                    <th>Parent</th>

                    <th>Phone</th>

                    <th>Email</th>

                    <th>Address</th>

                    <th>Document</th>

                    <th>Date</th>

                    <th>Type</th>

                    <th>Actions</th>

                </tr>

            </thead>


            <tbody>


            <% admissions.forEach(a => { %>


                <tr
                    id="admission-<%= a._id %>"
                >


                    <td>

                        <strong>
                            <%= a.studentName || '-' %>
                        </strong>

                    </td>


                    <td>
                        <%= a.class || '-' %>
                    </td>


                    <td>
                        <%= a.parentName || '-' %>
                    </td>


                    <td>
                        <%= a.phone || '-' %>
                    </td>


                    <td>
                        <%= a.email || '-' %>
                    </td>


                    <td class="message">
                        <%= a.address || '-' %>
                    </td>


                    <td>

                        <% if (a.document) { %>


                            <button
                                class="doc-link"
                                onclick="openDocument('/uploads/<%= a.document %>')"
                            >

                                <i class="fas fa-folder-open"></i>

                                Preview

                            </button>


                        <% } else { %>

                            -

                        <% } %>

                    </td>


                    <td>

                        <%= a.createdAt
                            ? new Date(a.createdAt)
                                .toLocaleDateString('en-IN')
                            : '-'
                        %>

                    </td>


                    <td>

                        <span class="badge admission">
                            Admission
                        </span>

                    </td>


                    <td>


                        <a
                            href="/admin/admission/edit/<%= a._id %>"
                            class="action-btn edit-btn"
                            title="Edit"
                        >

                            <i class="fas fa-edit"></i>

                        </a>


                        <a
                            href="/admin/admission/delete/<%= a._id %>"
                            class="action-btn delete-btn"
                            title="Delete"

                            onclick="
                                return confirm(
                                    'Are you sure you want to delete this admission record?'
                                )
                            "
                        >

                            <i class="fas fa-trash"></i>

                        </a>


                        <% if (a.document) { %>


                            <a
                                href="/uploads/<%= a.document %>"
                                target="_blank"
                                class="action-btn view-btn"
                                title="Open document"
                            >

                                <i class="fas fa-eye"></i>

                            </a>


                        <% } %>


                        <%

                            const pdfStudentName =
                                JSON.stringify(
                                    a.studentName || ''
                                );

                            const pdfClassName =
                                JSON.stringify(
                                    a.class || ''
                                );

                            const pdfParentName =
                                JSON.stringify(
                                    a.parentName || ''
                                );

                            const pdfPhone =
                                JSON.stringify(
                                    a.phone || ''
                                );

                            const pdfEmail =
                                JSON.stringify(
                                    a.email || ''
                                );

                            const pdfAddress =
                                JSON.stringify(
                                    a.address || ''
                                );

                            const pdfDate =
                                JSON.stringify(
                                    a.createdAt
                                        ? new Date(
                                            a.createdAt
                                        ).toLocaleDateString(
                                            'en-IN'
                                        )
                                        : '-'
                                );

                        %>


                        <button
                            type="button"
                            class="action-btn pdf-btn"
                            title="Print / Save PDF"

                            onclick='printAdmission(
                                <%- pdfStudentName %>,
                                <%- pdfClassName %>,
                                <%- pdfParentName %>,
                                <%- pdfPhone %>,
                                <%- pdfEmail %>,
                                <%- pdfAddress %>,
                                <%- pdfDate %>
                            )'
                        >

                            <i class="fas fa-file-pdf"></i>

                        </button>


                    </td>


                </tr>


            <% }) %>


            </tbody>


        </table>


    </div>


    <% } else { %>


        <div class="empty">

            <i class="fas fa-folder-open"></i>

            <p>
                No admission forms yet
            </p>

        </div>


    <% } %>


</section>



