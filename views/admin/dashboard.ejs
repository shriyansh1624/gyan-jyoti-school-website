                            ? new Date(
                                e.createdAt
                            ).toLocaleDateString(
                                'en-IN'
                            )
                            : '-'
                        %>

                    </td>


                    <td>

                        <span class="badge enquiry">
                            Enquiry
                        </span>

                    </td>


                    <td>


                        <a
                            href="/admin/enquiry/edit/<%= e._id %>"
                            class="action-btn edit-btn"
                            title="Edit"
                        >

                            <i class="fas fa-edit"></i>

                        </a>


                        <a
                            href="/admin/enquiry/delete/<%= e._id %>"
                            class="action-btn delete-btn"
                            title="Delete"

                            onclick="
                                return confirm(
                                    'Are you sure you want to delete this enquiry?'
                                )
                            "
                        >

                            <i class="fas fa-trash"></i>

                        </a>


                    </td>


                </tr>


            <% }) %>


            </tbody>


        </table>


    </div>


    <% } else { %>


        <div class="empty">

            <i class="fas fa-inbox"></i>

            <p>
                No enquiries yet
            </p>

        </div>


    <% } %>


</section>



<!-- =========================================================
     CONTACTS
========================================================= -->

<section
    class="section"
    id="contacts"
>


    <div class="section-title">

        <h2>

            <i class="fas fa-envelope"></i>

            Contact Submissions

        </h2>


        <span class="pill">

            <%= contactCount || 0 %>

            Records

        </span>

    </div>


    <% if (
        contacts &&
        contacts.length > 0
    ) { %>


    <div class="table-wrap">


        <table>


            <thead>

                <tr>

                    <th>Name</th>

                    <th>Email</th>

                    <th>Category</th>

                    <th>Subject</th>

                    <th>Date</th>

                    <th>Status</th>

                    <th>Actions</th>

                </tr>

            </thead>


            <tbody>


            <% contacts.forEach(c => { %>


                <tr
                    id="contact-<%= c._id %>"
                >


                    <td>

                        <strong>
                            <%= c.name || '-' %>
                        </strong>

                    </td>


                    <td>
                        <%= c.email || '-' %>
                    </td>


                    <td>
                        <%= c.category || '-' %>
                    </td>


                    <td class="message">
                        <%= c.subject || '-' %>
                    </td>


                    <td>

                        <%= c.createdAt
                            ? new Date(
                                c.createdAt
                            ).toLocaleDateString(
                                'en-IN'
                            )
                            : '-'
                        %>

                    </td>


                    <td>

                        <span class="badge contact">

                            <%= c.status || 'new' %>

                        </span>

                    </td>


                    <td>


                        <a
                            href="/admin/contact/<%= c._id %>"
                            class="action-btn view-btn"
                            title="View"
                        >

                            <i class="fas fa-eye"></i>

                        </a>


                        <a
                            href="/admin/contact/delete/<%= c._id %>"
                            class="action-btn delete-btn"
                            title="Delete"

                            onclick="
                                return confirm(
                                    'Are you sure you want to delete this contact?'
                                )
                            "
                        >

                            <i class="fas fa-trash"></i>

                        </a>


                    </td>


                </tr>


            <% }) %>


            </tbody>


        </table>


    </div>


    <% } else { %>


        <div class="empty">

            <i class="fas fa-inbox"></i>

            <p>
                No contact submissions yet
            </p>

        </div>


    <% } %>


</section>



</main>

</div>



<!-- =========================================================
     DOCUMENT PREVIEW
========================================================= -->

<div
    class="modal"
    id="docModal"
>


    <div class="modal-content">


        <div class="modal-head">


            <h3>

                <i class="fas fa-file"></i>

                Document Preview

            </h3>


            <button
                class="modal-close"
                onclick="closeDocument()"
            >

                Close

            </button>


        </div>


        <div class="modal-body">

            <iframe
                id="docFrame"
                src=""
                title="Document Preview"
            ></iframe>

        </div>


    </div>


</div>



<script>

/* =========================================================
   CHART DATA
========================================================= */

const monthlyLabels =
    <%- JSON.stringify(
        typeof monthlyLabels !== 'undefined'
            ? monthlyLabels
            : []
    ) %>;


const monthlyAdmissions =
    <%- JSON.stringify(
        typeof monthlyAdmissions !== 'undefined'
            ? monthlyAdmissions
            : []
    ) %>;


const monthlyEnquiries =
    <%- JSON.stringify(
        typeof monthlyEnquiries !== 'undefined'
            ? monthlyEnquiries
            : []
    ) %>;



/* =========================================================
   DARK MODE
========================================================= */

function toggleDarkMode(){

    const enabled =
        !document.body.classList.contains(
            'dark-mode'
        );


    document.body.classList.toggle(
        'dark-mode',
        enabled
    );


    localStorage.setItem(
        'adminDarkMode',
        enabled
    );

}


if (
    localStorage.getItem(
        'adminDarkMode'
    ) === 'true'
){

    document.body.classList.add(
        'dark-mode'
    );

}



/* =========================================================
   COUNTER ANIMATION
========================================================= */

document
    .querySelectorAll('.counter')
    .forEach(counter => {


        const target =
            Number(
                counter.dataset.count || 0
            );


        if(!target){

            counter.textContent =
                '0';

            return;

        }


        const start =
            performance.now();


        const duration =
            850;


        function animate(now){

            const progress =
                Math.min(
                    (now - start) /
                    duration,
                    1
                );


            const eased =
                1 -
                Math.pow(
                    1 - progress,
                    3
                );


            counter.textContent =
                Math.floor(
                    target * eased
                ).toLocaleString(
                    'en-IN'
                );


            if(progress < 1){

                requestAnimationFrame(
                    animate
                );

            } else {

                counter.textContent =
                    target.toLocaleString(
                        'en-IN'
                    );

            }

        }


        requestAnimationFrame(
            animate
        );

    });



/* =========================================================
   DOCUMENT PREVIEW
========================================================= */

function openDocument(url){

    if(!url){

        return;

    }


    document
        .getElementById(
            'docFrame'
        )
        .src = url;


    document
        .getElementById(
            'docModal'
        )
        .style.display =
            'block';


    document.body.style.overflow =
        'hidden';

}


function closeDocument(){

    document
        .getElementById(
            'docFrame'
        )
        .src = '';


    document
        .getElementById(
            'docModal'
        )
        .style.display =
            'none';


    document.body.style.overflow =
        '';

}


window.addEventListener(
    'click',
    function(e){

        const modal =
            document.getElementById(
                'docModal'
            );


        if(
            e.target === modal
        ){

            closeDocument();

        }

    }
);


document.addEventListener(
    'keydown',
    function(e){

        if(
            e.key === 'Escape'
        ){

            closeDocument();

        }

    }
);



/* =========================================================
   PRINT ADMISSION
========================================================= */

function printAdmission(
    studentName,
    className,
    parentName,
    phone,
    email,
    address,
    date
){

    const content = `

    <!DOCTYPE html>

    <html>

    <head>

        <title>
            Gyan Jyoti School - Admission Form
        </title>

        <style>

            body{
                font-family:Arial;
                padding:35px;
                color:#111;
            }

            .box{
                max-width:850px;
                margin:auto;
                border:2px solid #001f3f;
                padding:30px;
                border-radius:16px;
            }

            h1{
                text-align:center;
                color:#001f3f;
                margin-bottom:4px;
            }

            h2{
                text-align:center;
                color:#001f3f;
            }

            .sub{
                text-align:center;
                color:#64748b;
                margin-bottom:25px;
            }

            table{
                width:100%;
                border-collapse:collapse;
                margin-top:20px;
            }

            td{
                padding:12px;
                border:1px solid #ddd;
            }

            .label{
                font-weight:bold;
                background:#f3f4f6;
                width:220px;
            }

        </style>

    </head>


    <body>


        <div class="box">


            <h1>
                Gyan Jyoti School
            </h1>


            <div class="sub">
                Admission & Registration Department
            </div>


            <h2>
                Admission / Registration Form
            </h2>


            <table>


                <tr>

                    <td class="label">
                        Student Name
                    </td>

                    <td>
                        ${studentName}
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Class
                    </td>

                    <td>
                        ${className}
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Parent Name
                    </td>

                    <td>
                        ${parentName}
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Phone
                    </td>

                    <td>
                        ${phone}
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Email
                    </td>

                    <td>
                        ${email}
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Address
                    </td>

                    <td>
                        ${address}
                    </td>

                </tr>


                <tr>

                    <td class="label">
                        Submitted Date
                    </td>

                    <td>
                        ${date}
                    </td>

                </tr>


            </table>


        </div>


    </body>

    </html>

    `;


    const win =
        window.open(
            '',
            '_blank'
        );


    if(!win){

        alert(
            'Please allow pop-ups to print the admission form.'
        );

        return;

    }


    win.document.write(
        content
    );


    win.document.close();


    setTimeout(
        () => win.print(),
        250
    );

}



/* =========================================================
   CHARTS
========================================================= */

const labels =
    monthlyLabels.length

        ? monthlyLabels

        : [
            'Jan',
            'Feb',
            'Mar',
            'Apr',
            'May',
            'Jun'
        ];


const admissions =
    monthlyAdmissions.length

        ? monthlyAdmissions

        : [
            0,
            0,
            0,
            0,
            0,
            <%= admissionCount || 0 %>
        ];


const enquiries =
    monthlyEnquiries.length

        ? monthlyEnquiries

        : [
            0,
            0,
            0,
            0,
            0,
            <%= enquiryCount || 0 %>
        ];


const dark =
    document.body.classList.contains(
        'dark-mode'
    );


const fontColor =
    dark
        ? '#cbd5e1'
        : '#64748b';


const gridColor =
    dark
        ? 'rgba(148,163,184,.12)'
        : 'rgba(100,116,139,.12)';


const lineCanvas =
    document.getElementById(
        'monthlyAdmissionChart'
    );


const barCanvas =
    document.getElementById(
        'admissionEnquiryChart'
    );



if(
    typeof Chart !== 'undefined'
    &&
    lineCanvas
){

    new Chart(
        lineCanvas,
        {

            type:'line',

            data:{

                labels,

                datasets:[{

                    label:
                        'Admissions',

                    data:
                        admissions,

                    borderWidth:
                        3,

                    tension:
                        .38,

                    fill:
                        true,

                    borderColor:
                        '#0053a6',

                    backgroundColor:
                        'rgba(0,83,166,.10)',

                    pointBackgroundColor:
                        '#ffc300',

                    pointBorderColor:
                        '#0053a6',

                    pointRadius:
                        4,

                    pointHoverRadius:
                        6

                }]

            },


            options:{

                responsive:true,

                maintainAspectRatio:false,

                interaction:{
                    intersect:false,
                    mode:'index'
                },


                plugins:{

                    legend:{
                        labels:{
                            color:
                                fontColor,

                            font:{
                                weight:'700'
                            }
                        }
                    }

                },


                scales:{

                    x:{
                        grid:{
                            color:
                                gridColor
                        },

                        ticks:{
                            color:
                                fontColor
                        }
                    },


                    y:{

                        beginAtZero:true,

                        ticks:{
                            precision:0,
                            color:
                                fontColor
                        },

                        grid:{
                            color:
                                gridColor
                        }

                    }

                }

            }

        }
    );

}



if(
    typeof Chart !== 'undefined'
    &&
    barCanvas
){

    new Chart(
        barCanvas,
        {

            type:'bar',


            data:{

                labels,


                datasets:[

                    {

                        label:
                            'Admissions',

                        data:
                            admissions,

                        backgroundColor:
                            '#0053a6',

                        borderRadius:
                            7

                    },


                    {

                        label:
                            'Enquiries',

                        data:
                            enquiries,

                        backgroundColor:
                            '#ffc300',

                        borderRadius:
                            7

                    }

                ]

            },


            options:{

                responsive:true,

                maintainAspectRatio:false,


                plugins:{

                    legend:{

                        labels:{

                            color:
                                fontColor,

                            font:{
                                weight:'700'
                            }

                        }

                    }

                },


                scales:{

                    x:{

                        grid:{
                            display:false
                        },

                        ticks:{
                            color:
                                fontColor
                        }

                    },


                    y:{

                        beginAtZero:true,

                        ticks:{
                            precision:0,

                            color:
                                fontColor
                        },

                        grid:{
                            color:
                                gridColor
                        }

                    }

                }

            }

        }
    );

}

</script>


</body>

</html>