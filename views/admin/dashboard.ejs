<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    <%= title || 'Admin Dashboard - Gyan Jyoti School' %>
</title>


<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
>

<script
    src="https://cdn.jsdelivr.net/npm/chart.js"
></script>


<style>

/* =========================================================
   ROOT
========================================================= */

:root{

    --navy:#001f3f;
    --blue:#0053a6;
    --gold:#ffc300;

    --bg:#eef3fb;
    --card:#fff;

    --text:#172033;
    --muted:#64748b;

    --line:#e5e7eb;

    --green:#10b981;
    --red:#dc2626;
    --purple:#7c3aed;

    --shadow:
        0 16px 45px rgba(0,31,63,.09);
}


/* =========================================================
   GLOBAL
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:
        Inter,
        "Segoe UI",
        Arial,
        sans-serif;

    background:
        var(--bg);

    color:
        var(--text);

    min-height:100vh;
}

a{
    text-decoration:none;
}

button,
input{
    font:inherit;
}


/* =========================================================
   LAYOUT
========================================================= */

.layout{

    display:flex;

    min-height:100vh;
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar{

    width:280px;

    position:fixed;

    inset:
        0 auto 0 0;

    z-index:1000;

    padding:18px;

    color:#fff;

    overflow-y:auto;

    background:
        linear-gradient(
            180deg,
            #00172f,
            #002b55 55%,
            #003b73
        );

    box-shadow:
        12px 0 35px rgba(0,0,0,.14);
}


.sidebar-logo{

    display:flex;

    align-items:center;

    gap:12px;

    padding:
        15px 10px 23px;

    margin-bottom:20px;

    border-bottom:
        1px solid
        rgba(255,255,255,.1);
}


.sidebar-logo img{

    width:62px;
    height:62px;

    object-fit:contain;

    border-radius:17px;

    background:#fff;

    padding:4px;
}


.logo-text h2{

    color:#fff;

    font-size:23px;

    font-weight:900;
}


.logo-text span{

    display:block;

    margin-top:4px;

    color:#ffffff99;

    font-size:9px;

    letter-spacing:1.2px;

    text-transform:uppercase;
}


.menu-title{

    padding:
        0 12px 9px;

    color:#ffffff70;

    font-size:10px;

    font-weight:900;

    letter-spacing:1.5px;

    text-transform:uppercase;
}


.menu a{

    display:flex;

    align-items:center;

    gap:12px;

    padding:
        13px 14px;

    margin-bottom:7px;

    border-radius:14px;

    color:#ffffffd9;

    font-size:14px;

    font-weight:800;

    transition:.25s;
}


.menu a i{

    width:22px;

    text-align:center;

    color:#8eb9e8;
}


.menu a:hover,
.menu a.active{

    color:var(--navy);

    background:
        linear-gradient(
            135deg,
            #ffc300,
            #ffdc55
        );

    transform:
        translateX(4px);
}


.menu a:hover i,
.menu a.active i{

    color:var(--navy);
}


/* =========================================================
   SIDEBAR SPECIAL LINKS
========================================================= */

.menu .faculty-menu,
.menu .academic-menu,
.menu .sports-menu,
.menu .events-menu,
.menu .popup-menu,
.menu .whatsapp-menu{

    background:
        linear-gradient(
            135deg,
            #ffc30022,
            #ffffff08
        );

    border:
        1px solid
        #ffc30030;
}


.menu .faculty-menu i,
.menu .academic-menu i,
.menu .sports-menu i,
.menu .events-menu i,
.menu .popup-menu i,
.menu .whatsapp-menu i{

    color:
        var(--gold);
}


.menu .academic-menu::after{

    content:"TOPPERS";

    margin-left:auto;

    padding:
        3px 7px;

    border-radius:99px;

    background:
        var(--gold);

    color:
        var(--navy);

    font-size:7px;

    font-weight:1000;
}


.menu .sports-menu::after{

    content:"NEW";

    margin-left:auto;

    padding:
        3px 7px;

    border-radius:99px;

    background:
        var(--gold);

    color:
        var(--navy);

    font-size:7px;

    font-weight:1000;
}


.menu-new{

    margin-left:auto;

    padding:
        3px 7px;

    border-radius:99px;

    background:
        #10b981;

    color:#fff;

    font-size:7px;

    font-weight:1000;

    letter-spacing:.5px;
}


.sidebar-footer{

    margin-top:24px;

    padding:14px;

    border-radius:16px;

    background:#ffffff0a;

    border:
        1px solid
        #ffffff10;
}


.sidebar-footer small{

    display:block;

    color:#ffffff70;

    font-size:9px;

    margin-bottom:4px;
}


.sidebar-footer strong{

    color:#fff;

    font-size:13px;
}


/* =========================================================
   MAIN
========================================================= */

.main{

    margin-left:280px;

    width:
        calc(100% - 280px);

    padding:28px;
}


/* =========================================================
   HERO
========================================================= */

.hero{

    position:relative;

    overflow:hidden;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:25px;

    min-height:185px;

    padding:32px;

    margin-bottom:22px;

    color:#fff;

    border-radius:30px;

    background:

        radial-gradient(
            circle at 85% 20%,
            #ffc30033,
            transparent 24%
        ),

        linear-gradient(
            135deg,
            #00172f,
            #0053a6
        );

    box-shadow:
        0 20px 50px
        #001f3f38;
}


.hero:after{

    content:"";

    position:absolute;

    inset:0;

    opacity:.13;

    background-image:
        radial-gradient(
            #fff 1px,
            transparent 1px
        );

    background-size:
        30px 30px;

    pointer-events:none;
}


.hero>*{

    position:relative;

    z-index:2;
}


.hero-badge{

    display:inline-flex;

    align-items:center;

    gap:7px;

    margin-bottom:11px;

    padding:
        7px 11px;

    border-radius:99px;

    color:var(--gold);

    background:#ffc30015;

    border:
        1px solid
        #ffc30045;

    font-size:9px;

    font-weight:900;

    letter-spacing:1.2px;

    text-transform:uppercase;
}


.hero h1{

    color:#fff;

    font-size:
        clamp(
            30px,
            3vw,
            42px
        );

    font-weight:950;
}


.hero p{

    margin-top:9px;

    color:#ffffffc9;

    line-height:1.6;

    font-size:14px;
}


.hero-actions{

    display:flex;

    gap:10px;

    flex-wrap:wrap;
}


.bell,
.theme-toggle{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    min-height:46px;

    padding:
        0 17px;

    border:0;

    border-radius:14px;

    color:var(--navy);

    background:#fff;

    box-shadow:
        0 12px 28px #0002;

    font-weight:900;

    cursor:pointer;

    transition:.25s;
}


.bell:hover,
.theme-toggle:hover{

    transform:
        translateY(-3px);
}


.bell span{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    min-width:23px;

    height:23px;

    padding:
        0 6px;

    border-radius:99px;

    background:#ef4444;

    color:#fff;

    font-size:11px;
}


/* =========================================================
   SEARCH
========================================================= */

.search-form{

    display:flex;

    gap:10px;

    padding:14px;

    margin-bottom:22px;

    background:#fffffff0;

    border:
        1px solid
        #e5e7eb;

    border-radius:20px;

    box-shadow:
        var(--shadow);

    backdrop-filter:
        blur(10px);
}


.search-form input{

    flex:1;

    min-width:0;

    height:50px;

    padding:
        0 17px;

    border:
        1px solid
        #dbe1ea;

    outline:none;

    border-radius:13px;

    background:#fff;
}


.search-form input:focus{

    border-color:
        var(--gold);

    box-shadow:
        0 0 0 4px
        #ffc30026;
}


.search-form button,
.clear-btn{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:8px;

    height:50px;

    padding:
        0 20px;

    border:0;

    border-radius:13px;

    background:
        var(--navy);

    color:#fff;

    font-weight:900;

    cursor:pointer;
}


.clear-btn{

    background:
        #64748b;
}


/* =========================================================
   STAT CARDS
========================================================= */

.cards{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:17px;

    margin-bottom:22px;
}


.card{

    position:relative;

    overflow:hidden;

    min-height:145px;

    padding:22px;

    border:
        1px solid
        var(--line);

    border-radius:22px;

    background:
        var(--card);

    box-shadow:
        var(--shadow);

    transition:.3s;
}


.card:hover{

    transform:
        translateY(-6px);
}


.card:before{

    content:"";

    position:absolute;

    inset:
        0 0 auto;

    height:4px;

    background:
        linear-gradient(
            90deg,
            var(--gold),
            #ffe37c
        );
}


.card i{

    display:flex;

    align-items:center;

    justify-content:center;

    width:45px;

    height:45px;

    margin-bottom:12px;

    border-radius:14px;

    background:#fff6d8;

    color:var(--navy);

    font-size:18px;
}


.card h3{

    color:var(--navy);

    font-size:34px;

    line-height:1;

    font-weight:950;
}


.card p{

    margin-top:7px;

    color:var(--muted);

    font-size:12px;

    font-weight:800;
}


/* =========================================================
   COMMON MANAGEMENT CARD
========================================================= */

.management-box{

    position:relative;

    overflow:hidden;

    padding:25px;

    margin-bottom:22px;

    border:
        1px solid
        #e0e8f3;

    border-radius:28px;

    background:

        radial-gradient(
            circle at 95% 10%,
            #ffc30030,
            transparent 25%
        ),

        linear-gradient(
            135deg,
            #fff,
            #f7fbff
        );

    box-shadow:
        var(--shadow);
}


.management-box::after{

    content:"";

    position:absolute;

    width:250px;

    height:250px;

    right:-110px;

    bottom:-140px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            #0053a620,
            transparent 70%
        );

    pointer-events:none;
}


.management-head{

    position:relative;

    z-index:2;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:20px;
}


.management-title{

    display:flex;

    align-items:center;

    gap:15px;
}


.management-icon{

    width:56px;

    height:56px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border-radius:17px;

    background:
        linear-gradient(
            135deg,
            #001f3f,
            #0053a6
        );

    color:
        var(--gold);

    font-size:22px;

    box-shadow:
        0 12px 28px
        #001f3f2e;
}


.management-title h2{

    color:
        var(--navy);

    font-size:23px;

    font-weight:950;
}


.management-title p{

    margin-top:5px;

    color:
        var(--muted);

    font-size:12px;

    line-height:1.5;
}


.management-main-btn{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:9px;

    padding:
        14px 18px;

    border-radius:14px;

    background:
        var(--navy);

    color:#fff;

    font-size:11px;

    font-weight:900;

    white-space:nowrap;

    transition:.25s;
}


.management-main-btn:hover{

    transform:
        translateY(-3px);

    background:
        var(--gold);

    color:
        var(--navy);
}


.management-actions{

    position:relative;

    z-index:2;

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:14px;
}


.management-action{

    display:flex;

    align-items:center;

    gap:12px;

    padding:16px;

    border:
        1px solid
        #e4eaf2;

    border-radius:18px;

    background:
        #f8fafc;

    color:
        var(--navy);

    transition:.3s;
}


.management-action:hover{

    transform:
        translateY(-5px);

    background:#fff;

    border-color:
        var(--gold);

    box-shadow:
        0 15px 32px
        #00000012;
}


.management-action i{

    width:42px;

    height:42px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border-radius:13px;

    background:
        #fff5d5;

    color:
        #d89b00;
}


.management-action strong{

    display:block;

    font-size:13px;

    font-weight:950;
}


.management-action span{

    display:block;

    margin-top:3px;

    color:
        var(--muted);

    font-size:10px;
}


/* =========================================================
   EVENTS MANAGEMENT
========================================================= */

.events-management{
    position:relative;
    overflow:hidden;
    padding:25px;
    margin-bottom:22px;
    border:1px solid #dfe7f2;
    border-radius:28px;
    background:
        radial-gradient(circle at 95% 8%,#ffc30030,transparent 25%),
        linear-gradient(135deg,#fff,#f7fbff);
    box-shadow:var(--shadow);
}

.events-management:after{
    content:"";
    position:absolute;
    width:250px;
    height:250px;
    right:-120px;
    bottom:-140px;
    border-radius:50%;
    background:radial-gradient(circle,#0053a620,transparent 70%);
    pointer-events:none;
}

.events-management-header{
    position:relative;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:20px;
}

.events-management-title{
    display:flex;
    align-items:center;
    gap:15px;
}

.events-management-icon{
    width:56px;
    height:56px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:none;
    border-radius:17px;
    background:linear-gradient(135deg,#001f3f,#0053a6);
    color:var(--gold);
    font-size:22px;
    box-shadow:0 12px 28px #001f3f2e;
}

.events-management h2{
    color:var(--navy);
    font-size:23px;
    font-weight:950;
}

.events-management-title p{
    margin-top:5px;
    color:var(--muted);
    font-size:12px;
    line-height:1.5;
}

.events-main-btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:9px;
    padding:14px 18px;
    border-radius:14px;
    color:#fff;
    background:var(--navy);
    font-size:11px;
    font-weight:900;
    white-space:nowrap;
    transition:.25s;
}

.events-main-btn:hover{
    transform:translateY(-3px);
    color:var(--navy);
    background:var(--gold);
}

.events-stats{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-bottom:14px;
}

.event-stat-card{
    display:flex;
    align-items:center;
    gap:11px;
    padding:14px;
    border:1px solid #e4eaf2;
    border-radius:16px;
    background:#f8fafc;
    transition:.25s;
}

.event-stat-card:hover{
    transform:translateY(-3px);
    background:#fff;
    border-color:var(--gold);
}

.event-stat-icon{
    width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:none;
    border-radius:12px;
    font-size:16px;
}

.event-stat-icon.blue{color:#2563eb;background:#eff6ff;}
.event-stat-icon.green{color:#16a34a;background:#dcfce7;}
.event-stat-icon.orange{color:#ea580c;background:#fff7ed;}
.event-stat-icon.purple{color:#7c3aed;background:#f5f3ff;}

.event-stat-card strong{
    display:block;
    color:var(--navy);
    font-size:22px;
    line-height:1;
    font-weight:950;
}

.event-stat-card span{
    display:block;
    margin-top:4px;
    color:var(--muted);
    font-size:9px;
    font-weight:800;
}

.events-category-grid{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.event-category-card{
    display:flex;
    align-items:center;
    gap:10px;
    min-width:0;
    padding:14px;
    border:1px solid #e4eaf2;
    border-radius:16px;
    color:var(--navy);
    background:#fff;
    transition:.25s;
}

.event-category-card:hover{
    transform:translateY(-4px);
    border-color:var(--gold);
    box-shadow:0 12px 28px #00000010;
}

.event-category-icon{
    width:40px;
    height:40px;
    display:flex;
    align-items:center;
    justify-content:center;
    flex:none;
    border-radius:12px;
    font-size:15px;
}

.event-category-icon.fiesta{color:#db2777;background:#fce7f3;}
.event-category-icon.sports{color:#d97706;background:#fef3c7;}
.event-category-icon.national{color:#ea580c;background:#ffedd5;}
.event-category-icon.memory{color:#475569;background:#f1f5f9;}

.event-category-card strong{
    display:block;
    overflow:hidden;
    font-size:11px;
    font-weight:950;
    white-space:nowrap;
    text-overflow:ellipsis;
}

.event-category-card span{
    display:block;
    margin-top:3px;
    color:var(--muted);
    font-size:9px;
}

.event-category-card .arrow{
    margin-left:auto;
    color:#94a3b8;
    font-size:9px;
}

.events-quick-actions{
    position:relative;
    z-index:2;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:10px;
    margin-top:13px;
}

.event-quick-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    min-height:42px;
    padding:10px 13px;
    border-radius:12px;
    font-size:9px;
    font-weight:950;
    transition:.25s;
}

.event-quick-btn.primary{color:var(--navy);background:var(--gold);}
.event-quick-btn.secondary{color:var(--navy);border:1px solid #dfe7f2;background:#f8fafc;}
.event-quick-btn:hover{transform:translateY(-3px);}
.event-quick-btn.secondary:hover{border-color:var(--gold);background:#fff;}

/* =========================================================
   FACULTY MANAGEMENT
========================================================= */

.faculty-management{

    position:relative;

    overflow:hidden;

    padding:25px;

    margin-bottom:22px;

    border:
        1px solid
        #dfe7f2;

    border-radius:28px;

    background:
        linear-gradient(
            135deg,
            #fff,
            #f7fbff
        );

    box-shadow:
        var(--shadow);
}


.faculty-management:before{

    content:"";

    position:absolute;

    width:260px;

    height:260px;

    right:-125px;

    top:-130px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            #ffc30040,
            transparent 70%
        );
}


.faculty-management-header{

    position:relative;

    z-index:2;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:21px;
}


.faculty-management-title{

    display:flex;

    align-items:center;

    gap:15px;
}


.faculty-management-icon{

    width:56px;

    height:56px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border-radius:17px;

    background:
        var(--navy);

    color:
        var(--gold);

    font-size:22px;

    box-shadow:
        0 12px 28px
        #001f3f2e;
}


.faculty-management h2{

    color:
        var(--navy);

    font-size:23px;

    font-weight:950;
}


.faculty-management-title p{

    color:
        var(--muted);

    font-size:12px;

    margin-top:5px;
}


.faculty-main-btn{

    display:inline-flex;

    align-items:center;

    gap:9px;

    padding:
        14px 18px;

    border-radius:14px;

    background:
        var(--navy);

    color:#fff;

    font-weight:900;

    transition:.25s;

    white-space:nowrap;
}


.faculty-main-btn:hover{

    transform:
        translateY(-3px);

    background:
        var(--gold);

    color:
        var(--navy);
}


.faculty-actions{

    position:relative;

    z-index:2;

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:14px;
}


.faculty-action{

    display:flex;

    align-items:center;

    gap:12px;

    padding:16px;

    border:
        1px solid
        #e4eaf2;

    border-radius:18px;

    background:
        #f8fafc;

    color:
        var(--navy);

    transition:.3s;
}


.faculty-action:hover{

    transform:
        translateY(-5px);

    background:#fff;

    border-color:
        var(--gold);

    box-shadow:
        0 15px 32px
        #00000012;
}


.faculty-action i{

    width:42px;

    height:42px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border-radius:13px;

    background:
        #eaf2ff;

    color:
        var(--blue);
}


.faculty-action strong{

    display:block;

    font-size:13px;
}


.faculty-action span{

    display:block;

    margin-top:3px;

    color:
        var(--muted);

    font-size:10px;
}


/* =========================================================
   WHATSAPP ANNOUNCEMENT MANAGEMENT
========================================================= */

.whatsapp-management{

    position:relative;

    overflow:hidden;

    padding:25px;

    margin-bottom:22px;

    border:1px solid #d9eadf;

    border-radius:28px;

    background:
        radial-gradient(
            circle at 95% 10%,
            #25d36628,
            transparent 25%
        ),
        linear-gradient(135deg,#ffffff,#f6fffa);

    box-shadow:var(--shadow);
}

.whatsapp-management:after{

    content:"";

    position:absolute;

    width:250px;
    height:250px;

    right:-110px;
    bottom:-140px;

    border-radius:50%;

    background:radial-gradient(
        circle,
        #25d36620,
        transparent 70%
    );

    pointer-events:none;
}

.whatsapp-management-head{

    position:relative;
    z-index:2;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:20px;
}

.whatsapp-management-title{

    display:flex;
    align-items:center;
    gap:15px;
}

.whatsapp-management-icon{

    width:56px;
    height:56px;

    display:flex;
    align-items:center;
    justify-content:center;
    flex:none;

    border-radius:17px;

    background:linear-gradient(135deg,#075e54,#25d366);

    color:#fff;
    font-size:24px;

    box-shadow:0 12px 28px #25d36635;
}

.whatsapp-management h2{

    color:#075e54;
    font-size:23px;
    font-weight:950;
}

.whatsapp-management-title p{

    margin-top:5px;
    color:var(--muted);
    font-size:12px;
    line-height:1.5;
}

.whatsapp-main-btn{

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:9px;

    padding:14px 18px;
    border-radius:14px;

    background:#075e54;
    color:#fff;

    font-size:11px;
    font-weight:900;
    white-space:nowrap;
    transition:.25s;
}

.whatsapp-main-btn:hover{

    transform:translateY(-3px);
    background:#25d366;
    color:#073b34;
}

.whatsapp-actions{

    position:relative;
    z-index:2;

    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}

.whatsapp-action{

    display:flex;
    align-items:center;
    gap:12px;

    padding:16px;

    border:1px solid #dcefe3;
    border-radius:18px;
    background:#f7fffa;
    color:#075e54;
    transition:.3s;
}

.whatsapp-action:hover{

    transform:translateY(-5px);
    background:#fff;
    border-color:#25d366;
    box-shadow:0 15px 32px #25d36618;
}

.whatsapp-action i{

    width:42px;
    height:42px;

    display:flex;
    align-items:center;
    justify-content:center;
    flex:none;

    border-radius:13px;
    background:#dcfce7;
    color:#16a34a;
}

.whatsapp-action strong{
    display:block;
    font-size:13px;
}

.whatsapp-action span{
    display:block;
    margin-top:3px;
    color:var(--muted);
    font-size:10px;
}

/* =========================================================
   POPUP MANAGEMENT
========================================================= */

.popup-management{

    position:relative;

    overflow:hidden;

    padding:25px;

    margin-bottom:22px;

    border:
        1px solid
        #e0e8f3;

    border-radius:28px;

    background:

        radial-gradient(
            circle at 95% 10%,
            #ffc30030,
            transparent 25%
        ),

        linear-gradient(
            135deg,
            #fff,
            #f7fbff
        );

    box-shadow:
        var(--shadow);
}


.popup-management:after{

    content:"";

    position:absolute;

    width:230px;

    height:230px;

    right:-100px;

    bottom:-130px;

    border-radius:50%;

    background:
        radial-gradient(
            circle,
            #0053a620,
            transparent 70%
        );
}


.popup-management-head{

    position:relative;

    z-index:2;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;

    margin-bottom:20px;
}


.popup-management-title{

    display:flex;

    align-items:center;

    gap:15px;
}


.popup-management-icon{

    width:56px;

    height:56px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border-radius:17px;

    background:
        linear-gradient(
            135deg,
            #001f3f,
            #0053a6
        );

    color:
        var(--gold);

    font-size:22px;
}


.popup-management h2{

    color:
        var(--navy);

    font-size:23px;

    font-weight:950;
}


.popup-management-title p{

    color:
        var(--muted);

    font-size:12px;

    margin-top:5px;
}


.popup-main-btn{

    display:inline-flex;

    align-items:center;

    gap:9px;

    padding:
        14px 18px;

    border-radius:14px;

    background:
        var(--navy);

    color:#fff;

    font-weight:900;

    transition:.25s;

    white-space:nowrap;
}


.popup-main-btn:hover{

    transform:
        translateY(-3px);

    background:
        var(--gold);

    color:
        var(--navy);
}


.popup-actions{

    position:relative;

    z-index:2;

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:14px;
}


.popup-action{

    display:flex;

    align-items:center;

    gap:12px;

    padding:16px;

    border:
        1px solid
        #e4eaf2;

    border-radius:18px;

    background:
        #f8fafc;

    color:
        var(--navy);

    transition:.3s;
}


.popup-action:hover{

    transform:
        translateY(-5px);

    background:#fff;

    border-color:
        var(--gold);

    box-shadow:
        0 15px 32px
        #00000012;
}


.popup-action i{

    width:42px;

    height:42px;

    display:flex;

    align-items:center;

    justify-content:center;

    flex:none;

    border-radius:13px;

    background:
        #fff5d5;

    color:
        #d89b00;
}


.popup-action strong{

    display:block;

    font-size:13px;
}


.popup-action span{

    display:block;

    margin-top:3px;

    color:
        var(--muted);

    font-size:10px;
}


.popup-live{

    position:absolute;

    top:20px;

    right:24px;

    display:inline-flex;

    align-items:center;

    gap:6px;

    padding:
        6px 10px;

    border-radius:99px;

    background:
        #dcfce7;

    color:
        #15803d;

    font-size:9px;

    font-weight:950;

    z-index:3;
}


.popup-live:before{

    content:"";

    width:7px;

    height:7px;

    border-radius:50%;

    background:
        #10b981;

    box-shadow:
        0 0 0 4px
        #10b98122;
}


/* =========================================================
   CHARTS
========================================================= */

.analytics-grid{

    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:18px;

    margin-bottom:22px;
}


.chart-card{

    min-height:350px;

    padding:23px;

    border:
        1px solid
        var(--line);

    border-radius:23px;

    background:
        var(--card);

    box-shadow:
        var(--shadow);
}


.chart-head{

    display:flex;

    justify-content:space-between;

    gap:15px;

    margin-bottom:17px;
}


.chart-card h2{

    color:
        var(--navy);

    font-size:18px;

    font-weight:950;
}


.chart-card h2 i{

    color:
        var(--gold);

    margin-right:7px;
}


.chart-sub{

    margin-top:4px;

    color:
        var(--muted);

    font-size:11px;
}


.chart-wrap{

    position:relative;

    height:265px;
}


/* =========================================================
   SECTIONS / TABLES
========================================================= */

.section{

    overflow:hidden;

    margin-bottom:22px;

    border:
        1px solid
        var(--line);

    border-radius:23px;

    background:
        var(--card);

    box-shadow:
        var(--shadow);
}


.section-title{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    flex-wrap:wrap;

    padding:
        19px 22px;

    border-bottom:
        1px solid
        var(--line);

    background:
        linear-gradient(
            180deg,
            #fbfdff,
            #f8fafc
        );
}


.section-title h2{

    color:
        var(--navy);

    font-size:19px;

    font-weight:950;
}


.section-title h2 i{

    color:
        var(--gold);

    margin-right:7px;
}


.pill{

    padding:
        7px 12px;

    border-radius:99px;

    background:
        var(--navy);

    color:#fff;

    font-size:10px;

    font-weight:900;
}


.table-wrap{

    width:100%;

    overflow-x:auto;
}


table{

    width:100%;

    border-collapse:collapse;

    min-width:760px;
}


th,
td{

    padding:
        14px 18px;

    text-align:left;

    vertical-align:middle;

    border-bottom:
        1px solid
        #eef2f7;

    font-size:13px;
}


th{

    color:
        #536174;

    background:
        #fbfdff;

    font-size:10px;

    letter-spacing:.7px;

    text-transform:uppercase;

    white-space:nowrap;
}


tbody tr:hover{

    background:
        #f8fbff;
}


.badge{

    display:inline-flex;

    padding:
        6px 10px;

    border-radius:99px;

    font-size:10px;

    font-weight:950;

    white-space:nowrap;
}


.admission{

    background:#dbeafe;

    color:#1d4ed8;
}


.enquiry{

    background:#dcfce7;

    color:#15803d;
}


.contact{

    background:#fef3c7;

    color:#92400e;
}


.message{

    max-width:340px;

    white-space:nowrap;

    overflow:hidden;

    text-overflow:ellipsis;
}


.record-link{

    color:
        var(--navy);

    font-weight:900;
}


.action-btn,
.doc-link{

    display:inline-flex;

    align-items:center;

    justify-content:center;

    gap:5px;

    min-width:32px;

    min-height:32px;

    margin:2px;

    padding:
        7px 9px;

    border:0;

    border-radius:9px;

    color:#fff;

    font-size:11px;

    font-weight:900;

    cursor:pointer;

    transition:.2s;
}


.action-btn:hover,
.doc-link:hover{

    transform:
        translateY(-2px);

    opacity:.9;
}


.doc-link{

    background:
        var(--navy);
}


.edit-btn{

    background:#2563eb;
}


.delete-btn{

    background:
        var(--red);
}


.view-btn{

    background:
        var(--green);
}


.pdf-btn{

    background:
        var(--purple);
}


.empty{

    padding:
        42px 20px;

    text-align:center;

    color:
        var(--muted);
}


.empty i{

    display:block;

    margin-bottom:10px;

    color:#cbd5e1;

    font-size:38px;
}


/* =========================================================
   MODAL
========================================================= */

.modal{

    display:none;

    position:fixed;

    inset:0;

    z-index:999999;

    padding:22px;

    background:
        #000000b8;

    backdrop-filter:
        blur(7px);
}


.modal-content{

    display:flex;

    flex-direction:column;

    width:
        min(1050px,100%);

    height:
        min(88vh,850px);

    margin:auto;

    overflow:hidden;

    border-radius:23px;

    background:#fff;

    box-shadow:
        0 30px 100px
        #0006;
}


.modal-head{

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:
        14px 19px;

    color:#fff;

    background:
        var(--navy);
}


.modal-head h3{

    color:#fff;

    font-size:16px;
}


.modal-close{

    padding:
        8px 12px;

    border:0;

    border-radius:9px;

    background:
        var(--gold);

    color:
        var(--navy);

    font-weight:950;

    cursor:pointer;
}


.modal-body{

    flex:1;
}


.modal-body iframe{

    width:100%;

    height:100%;

    border:0;
}


/* =========================================================
   DARK MODE
========================================================= */

body.dark-mode{

    --bg:#0b1220;

    --card:#111827;

    --text:#e5e7eb;

    --muted:#94a3b8;

    --line:#263244;

    background:
        #0b1220;
}


body.dark-mode .search-form{

    background:
        #111827;

    border-color:
        #263244;
}


body.dark-mode .search-form input{

    background:
        #0b1220;

    color:#fff;

    border-color:
        #334155;
}


body.dark-mode .card h3,
body.dark-mode .chart-card h2,
body.dark-mode .section-title h2,
body.dark-mode .faculty-management h2,
body.dark-mode .management-title h2,
body.dark-mode .popup-management h2{

    color:
        var(--gold);
}


body.dark-mode .section-title,
body.dark-mode th{

    background:
        #182235;

    border-color:
        #263244;
}


body.dark-mode td{

    border-color:
        #263244;
}


body.dark-mode tbody tr:hover{

    background:
        #172033;
}


body.dark-mode .faculty-management,
body.dark-mode .management-box,
body.dark-mode .popup-management{

    background:
        linear-gradient(
            135deg,
            #111827,
            #0f1b2d
        );

    border-color:
        #263244;
}


body.dark-mode .whatsapp-management{

    background:linear-gradient(135deg,#10231f,#0f1b2d);
    border-color:#244b40;
}

body.dark-mode .whatsapp-management h2{
    color:#4ade80;
}

body.dark-mode .whatsapp-action{
    background:#162a25;
    border-color:#285044;
    color:#bbf7d0;
}

body.dark-mode .faculty-action,
body.dark-mode .management-action,
body.dark-mode .popup-action{

    background:
        #182235;

    border-color:
        #334155;

    color:#fff;
}


body.dark-mode .popup-live{

    background:
        #123c29;

    color:
        #86efac;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1150px){

    .cards,
    .faculty-actions,
    .events-stats,
    .events-category-grid{

        grid-template-columns:
            repeat(2,1fr);
    }

}


@media(max-width:1000px){

    .analytics-grid{

        grid-template-columns:
            1fr;
    }

}


@media(max-width:900px){

    .sidebar{

        position:relative;

        width:100%;

        height:auto;
    }


    .layout{

        display:block;
    }


    .main{

        width:100%;

        margin-left:0;

        padding:18px;
    }


    .hero{

        display:block;

        padding:26px;
    }


    .hero-actions{

        justify-content:flex-start;

        margin-top:18px;
    }


    .faculty-management-header,
    .events-management-header,
    .management-head,
    .popup-management-head,
    .whatsapp-management-head{

        align-items:flex-start;

        flex-direction:column;
    }


    .faculty-main-btn,
    .events-main-btn,
    .management-main-btn,
    .popup-main-btn,
    .whatsapp-main-btn{

        width:100%;

        justify-content:center;
    }


    .popup-live{

        position:static;

        width:max-content;

        margin-bottom:14px;
    }


    .management-actions,
    .events-quick-actions,
    .popup-actions,
    .whatsapp-actions{

        grid-template-columns:
            1fr;
    }


    .search-form{

        flex-direction:column;
    }


    .search-form button,
    .search-form .clear-btn{

        width:100%;
    }

}


@media(max-width:600px){

    .cards,
    .faculty-actions,
    .events-stats,
    .events-category-grid{

        grid-template-columns:
            1fr;
    }


    .hero h1{

        font-size:30px;
    }


    .chart-wrap{

        height:235px;
    }

}

</style>

</head>


<body>

<div class="layout">


<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside class="sidebar">


    <div class="sidebar-logo">

        <img
            src="/images/logo.png"
            alt="Gyan Jyoti School Logo"
        >

        <div class="logo-text">

            <h2>
                Gyan Jyoti
            </h2>

            <span>
                School Administration
            </span>

        </div>

    </div>


    <div class="menu-title">
        Management
    </div>


    <div class="menu">


        <a
            class="active"
            href="/admin/dashboard"
        >

            <i class="fas fa-chart-line"></i>

            Dashboard

        </a>


        <a href="#analytics">

            <i class="fas fa-chart-pie"></i>

            Analytics

        </a>


        <a href="#notifications">

            <i class="fas fa-bell"></i>

            Notifications

        </a>


        <a href="#admissions">

            <i class="fas fa-user-graduate"></i>

            Admissions

        </a>


        <a href="#enquiries">

            <i class="fas fa-comments"></i>

            Enquiries

        </a>


        <a href="#contacts">

            <i class="fas fa-envelope"></i>

            Contacts

        </a>


        <!-- FACULTY -->

        <a
            href="/admin/faculty"
            class="faculty-menu"
        >

            <i class="fas fa-chalkboard-teacher"></i>

            Faculty Management

        </a>


        <!-- EVENTS -->

        <a
            href="/admin/events"
            class="events-menu"
        >

            <i class="fas fa-calendar-days"></i>

            Events Management

            <span class="menu-new">NEW</span>

        </a>


        <!-- TOPPERS -->

        <a
            href="/admin/academics"
            class="academic-menu"
        >

            <i class="fas fa-graduation-cap"></i>

            Topper & Academic Records

        </a>


        <!-- SPORTS -->

        <a
            href="/admin/sports-dance"
            class="sports-menu"
        >

            <i class="fas fa-trophy"></i>

            Sports & Dance

        </a>


        <!-- WHATSAPP ANNOUNCEMENTS -->

        <a
            href="/admin/whatsapp"
            class="whatsapp-menu"
        >

            <i class="fab fa-whatsapp"></i>

            WhatsApp Announcements

            <span class="menu-new">NEW</span>

        </a>


        <!-- POPUP -->

        <a
            href="/admin/popup"
            class="popup-menu"
        >

            <i class="fas fa-images"></i>

            Popup Management

            <span class="menu-new">
                LIVE
            </span>

        </a>


        <!-- LOGOUT -->

        <a href="/admin/logout">

            <i class="fas fa-sign-out-alt"></i>

            Logout

        </a>


    </div>


    <div class="sidebar-footer">

        <small>
            ADMIN ACCOUNT
        </small>

        <strong>
            <%= adminName || 'Administrator' %>
        </strong>

    </div>


</aside>



<!-- =========================================================
     MAIN
========================================================= -->

<main class="main">


<!-- =========================================================
     HERO
========================================================= -->

<section class="hero">


    <div>

        <div class="hero-badge">

            <i class="fas fa-shield-halved"></i>

            Secure Administration

        </div>


        <h1>
            Admin Dashboard
        </h1>


        <p>

            Welcome back,
            <strong>
                <%= adminName || 'Administrator' %>
            </strong>
            👋

            Manage admissions, enquiries, contacts,
            documents, faculty, toppers, achievements
            and homepage popups from one central dashboard.

        </p>

    </div>


    <div class="hero-actions">


        <a
            href="#notifications"
            class="bell"
        >

            <i class="fas fa-bell"></i>

            Notifications

            <span>
                <%= notificationCount || 0 %>
            </span>

        </a>


        <button
            type="button"
            class="theme-toggle"
            onclick="toggleDarkMode()"
        >

            <i class="fas fa-moon"></i>

            Dark Mode

        </button>


    </div>


</section>



<!-- =========================================================
     SEARCH
========================================================= -->

<form
    method="GET"
    action="/admin/dashboard"
    class="search-form"
>

    <input
        type="text"
        name="keyword"
        placeholder="Search name, phone, email, class, parent or message..."
        value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
        autocomplete="off"
    >


    <button type="submit">

        <i class="fas fa-search"></i>

        Search

    </button>


    <% if (
        typeof keyword !== 'undefined'
        && keyword
    ) { %>

        <a
            href="/admin/dashboard"
            class="clear-btn"
        >

            <i class="fas fa-xmark"></i>

            Clear

        </a>

    <% } %>


</form>



<!-- =========================================================
     STATISTICS
========================================================= -->

<div class="cards">


    <div class="card">

        <i class="fas fa-database"></i>

        <h3
            class="counter"
            data-count="<%= totalCount || 0 %>"
        >
            0
        </h3>

        <p>
            Total Records
        </p>

    </div>


    <div class="card">

        <i class="fas fa-envelope-open-text"></i>

        <h3
            class="counter"
            data-count="<%= contactCount || 0 %>"
        >
            0
        </h3>

        <p>
            Contact Messages
        </p>

    </div>


    <div class="card">

        <i class="fas fa-comments"></i>

        <h3
            class="counter"
            data-count="<%= enquiryCount || 0 %>"
        >
            0
        </h3>

        <p>
            Enquiries
        </p>

    </div>


