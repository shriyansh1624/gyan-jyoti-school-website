<%- include('../partials/header') %>

<section class="edit-admission-page">

    <div class="edit-container">

        <!-- =========================
             PAGE HEADER
        ========================== -->

        <div class="page-header">

            <div>
                <div class="eyebrow">
                    <i class="fas fa-user-graduate"></i>
                    ADMINISTRATION
                </div>

                <h1>
                    <i class="fas fa-user-edit"></i>
                    Edit Admission
                </h1>

                <p>
                    Update the student's admission information and save the changes.
                </p>
            </div>

            <a
                href="/admin/dashboard#admissions"
                class="back-btn">

                <i class="fas fa-arrow-left"></i>
                Back to Admissions

            </a>

        </div>


        <!-- =========================
             EDIT CARD
        ========================== -->

        <div class="edit-card">

            <div class="card-top">

                <div class="card-icon">
                    <i class="fas fa-user-graduate"></i>
                </div>

                <div>
                    <h2>Admission Details</h2>
                    <p>Modify the information below and click Update Admission.</p>
                </div>

            </div>


            <form
                method="POST"
                action="/admin/admission/edit/<%= admission._id %>"
                id="admissionEditForm">

                <!-- =====================
                     STUDENT INFORMATION
                ====================== -->

                <div class="section-title">
                    <span class="section-number">01</span>

                    <div>
                        <h3>Student Information</h3>
                        <p>Basic details of the student.</p>
                    </div>
                </div>


                <div class="form-grid">

                    <div class="form-group">

                        <label for="studentName">
                            Student Name
                            <span>*</span>
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-user"></i>

                            <input
                                type="text"
                                id="studentName"
                                name="studentName"
                                value="<%= admission.studentName || '' %>"
                                maxlength="60"
                                required
                                autocomplete="name"
                                placeholder="Enter student name">

                        </div>

                    </div>


                    <div class="form-group">

                        <label for="class">
                            Class
                            <span>*</span>
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-school"></i>

                            <input
                                type="text"
                                id="class"
                                name="class"
                                value="<%= admission.class || '' %>"
                                maxlength="20"
                                required
                                placeholder="e.g. Class 6">

                        </div>

                    </div>

                </div>


                <!-- =====================
                     PARENT INFORMATION
                ====================== -->

                <div class="section-title">

                    <span class="section-number">02</span>

                    <div>
                        <h3>Parent / Guardian Information</h3>
                        <p>Contact details of the parent or guardian.</p>
                    </div>

                </div>


                <div class="form-grid">

                    <div class="form-group">

                        <label for="parentName">
                            Parent / Guardian Name
                            <span>*</span>
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-user-tie"></i>

                            <input
                                type="text"
                                id="parentName"
                                name="parentName"
                                value="<%= admission.parentName || '' %>"
                                maxlength="60"
                                required
                                autocomplete="name"
                                placeholder="Enter parent name">

                        </div>

                    </div>


                    <div class="form-group">

                        <label for="phone">
                            Phone Number
                            <span>*</span>
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-phone"></i>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                value="<%= admission.phone || '' %>"
                                maxlength="10"
                                minlength="10"
                                pattern="[0-9]{10}"
                                required
                                autocomplete="tel"
                                placeholder="10 digit mobile number">

                        </div>

                    </div>


                    <div class="form-group full">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="<%= admission.email || '' %>"
                                maxlength="120"
                                autocomplete="email"
                                placeholder="Enter email address">

                        </div>

                    </div>

                </div>


                <!-- =====================
                     ADDRESS
                ====================== -->

                <div class="section-title">

                    <span class="section-number">03</span>

                    <div>
                        <h3>Address</h3>
                        <p>Residential address provided during admission.</p>
                    </div>

                </div>


                <div class="form-group">

                    <label for="address">
                        Address
                    </label>

                    <div class="textarea-wrap">

                        <i class="fas fa-location-dot"></i>

                        <textarea
                            id="address"
                            name="address"
                            maxlength="300"
                            rows="5"
                            placeholder="Enter complete address"><%= admission.address || '' %></textarea>

                    </div>

                    <div class="character-count">
                        <span id="addressCount">
                            <%= (admission.address || '').length %>
                        </span>
                        / 300
                    </div>

                </div>


                <!-- =====================
                     DOCUMENT
                ====================== -->

                <% if (admission.document) { %>

                    <div class="section-title">

                        <span class="section-number">04</span>

                        <div>
                            <h3>Submitted Document</h3>
                            <p>The existing document is kept unchanged.</p>
                        </div>

                    </div>


                    <div class="document-box">

                        <div class="document-icon">
                            <i class="fas fa-file-image"></i>
                        </div>

                        <div class="document-info">

                            <strong>Admission Document</strong>

                            <span>
                                Existing document attached to this admission.
                            </span>

                        </div>

                        <button
                            type="button"
                            class="document-btn"
                            onclick="openDocument('<%= admission.document %>')">

                            <i class="fas fa-eye"></i>
                            Preview

                        </button>

                    </div>

                <% } %>


                <!-- =====================
                     ACTIONS
                ====================== -->

                <div class="form-actions">

                    <a
                        href="/admin/dashboard#admissions"
                        class="cancel-btn">

                        <i class="fas fa-xmark"></i>
                        Cancel

                    </a>


                    <button
                        type="submit"
                        class="update-btn">

                        <i class="fas fa-save"></i>
                        Update Admission

                    </button>

                </div>

            </form>

        </div>

    </div>

</section>


<!-- =========================
     DOCUMENT PREVIEW MODAL
========================== -->

<div
    id="documentModal"
    class="document-modal"
    aria-hidden="true">

    <div class="document-modal-card">

        <div class="document-modal-head">

            <h3>
                <i class="fas fa-file"></i>
                Document Preview
            </h3>

            <button
                type="button"
                onclick="closeDocument()"
                class="modal-close">

                Close

            </button>

        </div>

        <div class="document-modal-body">

            <iframe
                id="documentFrame"
                src="about:blank"
                title="Document Preview">
            </iframe>

        </div>

    </div>

</div>


<style>

/* =========================================================
   PREMIUM ADMISSION EDIT PAGE
========================================================= */

.edit-admission-page {
    min-height: calc(100vh - 120px);
    padding: 55px 25px 85px;
    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(255,193,7,.08),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #f5f8fc 0%,
            #eef4f9 100%
        );
}

.edit-container {
    width: min(1050px, 100%);
    margin: 0 auto;
}


/* =========================
   HEADER
========================= */

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 25px;
    margin-bottom: 28px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    color: #b27c00;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.5px;
}

.page-header h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    color: #002b57 !important;
    font-size: 38px;
    font-weight: 900;
}

.page-header h1 i {
    color: #f4b900 !important;
}

.page-header p {
    margin: 9px 0 0;
    color: #6c7e91 !important;
    font-size: 14px;
}

.back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid #d9e4ed;
    border-radius: 12px;
    background: #fff;
    color: #002b57 !important;
    text-decoration: none !important;
    font-size: 13px;
    font-weight: 800;
    box-shadow: 0 8px 22px rgba(0,33,71,.06);
    transition: .2s ease;
}

.back-btn:hover {
    transform: translateY(-2px);
    background: #002b57;
    color: #fff !important;
}


/* =========================
   CARD
========================= */

.edit-card {
    overflow: hidden;
    background: #fff;
    border: 1px solid #e0e9f1;
    border-radius: 22px;
    box-shadow: 0 25px 65px rgba(0,33,71,.10);
}

.card-top {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 25px 30px;
    background:
        linear-gradient(
            135deg,
            #002b57,
            #063e6e
        );
    color: #fff;
}

.card-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 15px;
    background: #ffc107;
    color: #002b57;
    font-size: 22px;
}

.card-top h2 {
    margin: 0;
    color: #fff !important;
    font-size: 20px;
}

.card-top p {
    margin: 5px 0 0;
    color: rgba(255,255,255,.72) !important;
    font-size: 12px;
}


/* =========================
   FORM
========================= */

#admissionEditForm {
    padding: 35px 32px 30px;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 8px 0 22px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e8eef4;
}

.section-number {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: #fff4d0;
    color: #a87300;
    font-size: 11px;
    font-weight: 900;
}

.section-title h3 {
    margin: 0;
    color: #002b57 !important;
    font-size: 16px;
    font-weight: 900;
}

.section-title p {
    margin: 3px 0 0;
    color: #8090a0 !important;
    font-size: 11px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 34px;
}

.form-group {
    position: relative;
    margin-bottom: 24px;
}

.form-grid .form-group {
    margin-bottom: 0;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    color: #173b5c !important;
    font-size: 12px;
    font-weight: 850;
}

.form-group label span {
    color: #d32f2f;
}

.input-wrap,
.textarea-wrap {
    position: relative;
}

.input-wrap i,
.textarea-wrap i {
    position: absolute;
    top: 50%;
    left: 15px;
    z-index: 2;
    transform: translateY(-50%);
    color: #8496a7;
    font-size: 13px;
    pointer-events: none;
}

.textarea-wrap i {
    top: 20px;
    transform: none;
}

.input-wrap input,
.textarea-wrap textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #d8e2eb;
    outline: none;
    border-radius: 13px;
    background: #fbfdff;
    color: #193b59;
    font-family: inherit;
    font-size: 13px;
    transition: .2s ease;
}

.input-wrap input {
    height: 48px;
    padding: 0 15px 0 43px;
}

.textarea-wrap textarea {
    min-height: 130px;
    padding: 15px 15px 15px 43px;
    resize: vertical;
    line-height: 1.55;
}

.input-wrap input:focus,
.textarea-wrap textarea:focus {
    border-color: #ffc107;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(255,193,7,.12);
}

.character-count {
    margin-top: 6px;
    color: #91a0ae;
    font-size: 10px;
    text-align: right;
}


/* =========================
   DOCUMENT
========================= */

.document-box {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 35px;
    padding: 17px;
    border: 1px solid #dfe8ef;
    border-radius: 15px;
    background: #f8fbfe;
}

.document-icon {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 45px;
    border-radius: 12px;
    background: #e8f1ff;
    color: #2872df;
    font-size: 18px;
}

.document-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
}

.document-info strong {
    color: #173b5c;
    font-size: 13px;
}

.document-info span {
    color: #8495a5;
    font-size: 11px;
}

.document-btn {
    height: 40px;
    padding: 0 15px;
    border: 0;
    border-radius: 10px;
    background: #002b57;
    color: #fff;
    cursor: pointer;
    font-size: 12px;
    font-weight: 800;
}

.document-btn:hover {
    background: #ffc107;
    color: #002b57;
}


/* =========================
   ACTIONS
========================= */

.form-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid #e8eef4;
}

.cancel-btn,
.update-btn {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 22px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 850;
    cursor: pointer;
    text-decoration: none !important;
    transition: .2s ease;
}

.cancel-btn {
    border: 1px solid #d9e3eb;
    background: #fff;
    color: #52697d !important;
}

.cancel-btn:hover {
    background: #f1f5f8;
}

.update-btn {
    border: 0;
    background: linear-gradient(
        135deg,
        #ffc107,
        #ffda57
    );
    color: #002b57;
    box-shadow: 0 10px 25px rgba(255,193,7,.25);
}

.update-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(255,193,7,.35);
}


/* =========================
   DOCUMENT MODAL
========================= */

.document-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 25px;
    background: rgba(0, 20, 40, .78);
}

.document-modal.open {
    display: flex;
}

.document-modal-card {
    width: min(1100px, 96vw);
    height: min(800px, 90vh);
    overflow: hidden;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 30px 100px rgba(0,0,0,.4);
}

.document-modal-head {
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px 0 22px;
    box-sizing: border-box;
    background: #002b57;
    color: #fff;
}

.document-modal-head h3 {
    margin: 0;
    color: #fff !important;
    font-size: 16px;
}

.modal-close {
    height: 38px;
    padding: 0 17px;
    border: 0;
    border-radius: 10px;
    background: #ffc107;
    color: #002b57;
    cursor: pointer;
    font-weight: 900;
}

.document-modal-body {
    height: calc(100% - 62px);
    background: #f3f5f7;
}

.document-modal-body iframe {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 750px) {

    .edit-admission-page {
        padding: 35px 15px 60px;
    }

    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .page-header h1 {
        font-size: 30px;
    }

    .back-btn {
        width: 100%;
    }

    #admissionEditForm {
        padding: 25px 20px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .cancel-btn,
    .update-btn {
        width: 100%;
    }

    .document-box {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .document-btn {
        width: 100%;
    }

}

</style>


<script>

/* =========================================================
   ADDRESS CHARACTER COUNTER
========================================================= */

document.addEventListener(
    'DOMContentLoaded',
    function () {

        const address =
            document.getElementById('address');

        const counter =
            document.getElementById('addressCount');


        if (address && counter) {

            address.addEventListener(
                'input',
                function () {

                    counter.textContent =
                        this.value.length;

                }
            );

        }

    }
);


/* =========================================================
   DOCUMENT PREVIEW
========================================================= */

function openDocument(url) {

    if (!url) return;

    const modal =
        document.getElementById(
            'documentModal'
        );

    const frame =
        document.getElementById(
            'documentFrame'
        );


    if (!modal || !frame) return;


    frame.src = url;

    modal.classList.add('open');

    modal.setAttribute(
        'aria-hidden',
        'false'
    );

    document.body.style.overflow =
        'hidden';

}


function closeDocument() {

    const modal =
        document.getElementById(
            'documentModal'
        );

    const frame =
        document.getElementById(
            'documentFrame'
        );


    if (frame) {

        frame.src =
            'about:blank';

    }


    if (modal) {

        modal.classList.remove('open');

        modal.setAttribute(
            'aria-hidden',
            'true'
        );

    }


    document.body.style.overflow =
        '';

}


/* Close outside modal */

document.addEventListener(
    'click',
    function (event) {

        const modal =
            document.getElementById(
                'documentModal'
            );


        if (
            modal &&
            event.target === modal
        ) {

            closeDocument();

        }

    }
);


/* Escape */

document.addEventListener(
    'keydown',
    function (event) {

        if (event.key === 'Escape') {

            closeDocument();

        }

    }
);


/* =========================================================
   FORM SUBMIT PROTECTION
========================================================= */

document.addEventListener(
    'DOMContentLoaded',
    function () {

        const form =
            document.getElementById(
                'admissionEditForm'
            );


        if (!form) return;


        form.addEventListener(
            'submit',
            function () {

                const button =
                    form.querySelector(
                        '.update-btn'
                    );


                if (button) {

                    button.disabled = true;

                    button.innerHTML =
                        '<i class="fas fa-spinner fa-spin"></i> Updating...';

                }

            }
        );

    }
);

</script>

<%- include('../partials/footer') %>
