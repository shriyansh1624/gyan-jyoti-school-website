<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#001f3f"
    >

    <title>
        <%= typeof title !== 'undefined' && title
            ? title
            : 'Admin Login - Gyan Jyoti School' %>
    </title>


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- =====================================================
         GOOGLE FONT
    ====================================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =====================================================
           RESET
        ====================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        /* =====================================================
           BODY
        ====================================================== */

        body {

            min-height: 100vh;

            font-family:
                'Inter',
                'Segoe UI',
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;

            color: #001f3f;

            background:

                radial-gradient(
                    circle at 10% 10%,
                    rgba(255, 195, 0, 0.14),
                    transparent 28%
                ),

                radial-gradient(
                    circle at 90% 90%,
                    rgba(0, 83, 166, 0.25),
                    transparent 32%
                ),

                linear-gradient(
                    135deg,
                    #00152d 0%,
                    #002f5f 48%,
                    #004f91 100%
                );

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 25px;

            overflow-x: hidden;

        }


        /* =====================================================
           BACKGROUND DECORATION
        ====================================================== */

        body::before {

            content: "";

            position: fixed;

            width: 420px;

            height: 420px;

            top: -180px;

            left: -180px;

            border-radius: 50%;

            border:
                1px solid
                rgba(255, 195, 0, 0.18);

            box-shadow:

                0 0 0 40px
                rgba(255, 195, 0, 0.025),

                0 0 0 80px
                rgba(255, 195, 0, 0.02);

            pointer-events: none;

        }


        body::after {

            content: "";

            position: fixed;

            width: 500px;

            height: 500px;

            right: -220px;

            bottom: -240px;

            border-radius: 50%;

            border:
                1px solid
                rgba(255, 255, 255, 0.08);

            box-shadow:

                0 0 0 50px
                rgba(255, 255, 255, 0.025);

            pointer-events: none;

        }


        /* =====================================================
           LOGIN WRAPPER
        ====================================================== */

        .login-wrapper {

            width: 100%;

            max-width: 460px;

            position: relative;

            z-index: 2;

        }


        /* =====================================================
           LOGIN CARD
        ====================================================== */

        .login-card {

            position: relative;

            overflow: hidden;

            background:
                rgba(255, 255, 255, 0.98);

            border:
                1px solid
                rgba(255, 255, 255, 0.7);

            border-radius: 28px;

            padding: 42px;

            box-shadow:

                0 30px 80px
                rgba(0, 0, 0, 0.30),

                0 8px 25px
                rgba(0, 0, 0, 0.12);

            animation:
                cardEnter 0.55s ease both;

        }


        @keyframes cardEnter {

            from {

                opacity: 0;

                transform:
                    translateY(18px)
                    scale(0.98);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);

            }

        }


        /* =====================================================
           TOP GOLD LINE
        ====================================================== */

        .login-card::before {

            content: "";

            position: absolute;

            top: 0;

            left: 0;

            right: 0;

            height: 5px;

            background:
                linear-gradient(
                    90deg,
                    #ffc300,
                    #ffdc62,
                    #ffc300
                );

        }


        /* =====================================================
           BRAND
        ====================================================== */

        .brand {

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 11px;

            margin-bottom: 28px;

        }


        .brand-icon {

            width: 38px;

            height: 38px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 11px;

            color: #001f3f;

            background: #ffc300;

            font-size: 17px;

            box-shadow:
                0 8px 20px
                rgba(255, 195, 0, 0.28);

        }


        .brand-text {

            color: #001f3f;

            font-size: 15px;

            font-weight: 800;

            letter-spacing: 0.2px;

        }


        /* =====================================================
           HEADER
        ====================================================== */

        .login-header {

            text-align: center;

            margin-bottom: 30px;

        }


        .lock-icon {

            width: 78px;

            height: 78px;

            display: flex;

            align-items: center;

            justify-content: center;

            margin:
                0 auto 20px;

            border-radius: 22px;

            color: #ffffff;

            background:
                linear-gradient(
                    135deg,
                    #001f3f,
                    #0053a6
                );

            font-size: 29px;

            box-shadow:

                0 15px 35px
                rgba(0, 31, 63, 0.25);

        }


        .login-header h1 {

            color: #001f3f;

            font-size: 29px;

            line-height: 1.2;

            font-weight: 800;

            margin-bottom: 8px;

        }


        .login-header p {

            color: #64748b;

            font-size: 13px;

            font-weight: 500;

        }


        /* =====================================================
           ERROR ALERT
        ====================================================== */

        .alert {

            display: flex;

            align-items: flex-start;

            gap: 11px;

            padding: 13px 14px;

            margin-bottom: 22px;

            border-radius: 13px;

            font-size: 12px;

            line-height: 1.5;

        }


        .alert-error {

            color: #991b1b;

            background: #fef2f2;

            border:
                1px solid
                #fecaca;

        }


        .alert-error i {

            margin-top: 2px;

            color: #dc2626;

        }


        /* =====================================================
           FORM
        ====================================================== */

        .login-form {

            width: 100%;

        }


        .form-group {

            margin-bottom: 20px;

        }


        .form-group label {

            display: block;

            color: #0f2945;

            font-size: 12px;

            font-weight: 700;

            margin-bottom: 8px;

        }


        .input-wrapper {

            position: relative;

        }


        .input-icon {

            position: absolute;

            left: 15px;

            top: 50%;

            transform:
                translateY(-50%);

            color: #94a3b8;

            font-size: 14px;

            pointer-events: none;

            transition: 0.2s;

        }


        .form-group input {

            width: 100%;

            height: 52px;

            padding:
                0 45px 0 43px;

            color: #0f2945;

            background: #f8fafc;

            border:
                1px solid
                #dbe3ed;

            border-radius: 13px;

            outline: none;

            font-family: inherit;

            font-size: 13px;

            transition:
                border-color 0.2s,
                box-shadow 0.2s,
                background 0.2s;

        }


        .form-group input::placeholder {

            color: #a1acba;

        }


        .form-group input:focus {

            background: #ffffff;

            border-color: #ffc300;

            box-shadow:
                0 0 0 4px
                rgba(255, 195, 0, 0.12);

        }


        .input-wrapper:focus-within
        .input-icon {

            color: #001f3f;

        }


        /* =====================================================
           PASSWORD TOGGLE
        ====================================================== */

        .password-toggle {

            position: absolute;

            right: 13px;

            top: 50%;

            width: 32px;

            height: 32px;

            display: flex;

            align-items: center;

            justify-content: center;

            transform:
                translateY(-50%);

            border: none;

            border-radius: 8px;

            color: #64748b;

            background: transparent;

            cursor: pointer;

            transition: 0.2s;

        }


        .password-toggle:hover {

            color: #001f3f;

            background: #eef3f8;

        }


        /* =====================================================
           CSRF / SECURITY NOTE
        ====================================================== */

        .security-note {

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            margin-top: 15px;

            color: #64748b;

            font-size: 10px;

        }


        .security-note i {

            color: #16a34a;

        }


        /* =====================================================
           LOGIN BUTTON
        ====================================================== */

        .btn-login {

            width: 100%;

            height: 53px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 10px;

            margin-top: 5px;

            border: none;

            border-radius: 13px;

            color: #ffffff;

            background:
                linear-gradient(
                    135deg,
                    #001f3f,
                    #004f91
                );

            font-family: inherit;

            font-size: 14px;

            font-weight: 800;

            cursor: pointer;

            box-shadow:
                0 12px 25px
                rgba(0, 31, 63, 0.22);

            transition:
                transform 0.2s,
                box-shadow 0.2s,
                background 0.2s;

        }


        .btn-login:hover {

            transform:
                translateY(-2px);

            background:
                linear-gradient(
                    135deg,
                    #ffc300,
                    #f2b900
                );

            color: #001f3f;

            box-shadow:
                0 15px 30px
                rgba(255, 195, 0, 0.28);

        }


        .btn-login:active {

            transform:
                translateY(0);

        }


        .btn-login.loading {

            pointer-events: none;

            opacity: 0.8;

        }


        .btn-login .spinner {

            display: none;

            width: 16px;

            height: 16px;

            border:
                2px solid
                rgba(255,255,255,0.35);

            border-top-color:
                #ffffff;

            border-radius: 50%;

            animation:
                spin 0.7s linear infinite;

        }


        .btn-login.loading .spinner {

            display: block;

        }


        .btn-login.loading
        .login-icon {

            display: none;

        }


        @keyframes spin {

            to {

                transform:
                    rotate(360deg);

            }

        }


        /* =====================================================
           FOOTER
        ====================================================== */

        .login-footer {

            text-align: center;

            margin-top: 25px;

            padding-top: 22px;

            border-top:
                1px solid
                #edf1f5;

        }


        .login-footer p {

            color: #64748b;

            font-size: 12px;

        }


        .login-footer a {

            color: #0053a6;

            font-weight: 700;

            text-decoration: none;

            transition: 0.2s;

        }


        .login-footer a:hover {

            color: #001f3f;

            text-decoration: underline;

        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 600px) {

            body {

                padding: 16px;

            }


            .login-card {

                padding: 30px 22px;

                border-radius: 22px;

            }


            .login-header {

                margin-bottom: 25px;

            }


            .lock-icon {

                width: 68px;

                height: 68px;

                border-radius: 19px;

                font-size: 25px;

            }


            .login-header h1 {

                font-size: 25px;

            }


            .brand {

                margin-bottom: 23px;

            }

        }


        @media (max-width: 380px) {

            .login-card {

                padding: 27px 18px;

            }


            .login-header h1 {

                font-size: 23px;

            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         LOGIN WRAPPER
    ====================================================== -->

    <main class="login-wrapper">


        <section class="login-card">


            <!-- =================================================
                 BRAND
            ================================================== -->

            <div class="brand">

                <div class="brand-icon">

                    <i class="fas fa-school"></i>

                </div>

                <div class="brand-text">

                    Gyan Jyoti School

                </div>

            </div>


            <!-- =================================================
                 HEADER
            ================================================== -->

            <div class="login-header">

                <div class="lock-icon">

                    <i class="fas fa-lock"></i>

                </div>


                <h1>
                    Admin Login
                </h1>


                <p>
                    Secure access to school administration
                </p>

            </div>


            <!-- =================================================
                 ERROR MESSAGE
            ================================================== -->

            <% if (
                typeof error !== 'undefined' &&
                error
            ) { %>

                <div
                    class="alert alert-error"
                    role="alert"
                >

                    <i
                        class="fas fa-circle-exclamation"
                    ></i>

                    <span>
                        <%= error %>
                    </span>

                </div>

            <% } %>


            <!-- =================================================
                 LOGIN FORM
            ================================================== -->

            <form
                method="POST"
                action="/admin/login"
                class="login-form"
                id="loginForm"
            >


                <!-- =============================================
                     CSRF TOKEN
                ============================================== -->

                <input
                    type="hidden"
                    name="_csrf"
                    value="<%= (typeof csrfToken !== 'undefined' && csrfToken) ? csrfToken : '' %>"
                >


                <!-- =============================================
                     EMAIL
                ============================================== -->

                <div class="form-group">

                    <label for="email">

                        Email Address

                    </label>


                    <div class="input-wrapper">

                        <i
                            class="fas fa-envelope input-icon"
                        ></i>


                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            autocomplete="username"
                            placeholder="Enter admin email"
                            maxlength="150"
                        >

                    </div>

                </div>


                <!-- =============================================
                     PASSWORD
                ============================================== -->

                <div class="form-group">

                    <label for="password">

                        Password

                    </label>


                    <div class="input-wrapper">

                        <i
                            class="fas fa-key input-icon"
                        ></i>


                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            autocomplete="current-password"
                            placeholder="Enter your password"
                            maxlength="200"
                        >


                        <button
                            type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password"
                        >

                            <i
                                class="fas fa-eye"
                            ></i>

                        </button>

                    </div>

                </div>


                <!-- =============================================
                     LOGIN BUTTON
                ============================================== -->

                <button
                    type="submit"
                    class="btn-login"
                    id="loginButton"
                >

                    <span class="spinner"></span>


                    <i
                        class="fas fa-right-to-bracket login-icon"
                    ></i>


                    <span class="button-text">

                        Login to Dashboard

                    </span>

                </button>


                <!-- =============================================
                     SECURITY NOTE
                ============================================== -->

                <div class="security-note">

                    <i class="fas fa-shield-halved"></i>

                    Secure administrator login

                </div>

            </form>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="login-footer">

                <p>

                    Don't have access?

                    <a href="/">
                        Go to Home
                    </a>

                </p>

            </div>


        </section>

    </main>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

        // =====================================================
        // PASSWORD SHOW / HIDE
        // =====================================================

        const passwordInput =
            document.getElementById(
                'password'
            );

        const passwordToggle =
            document.getElementById(
                'passwordToggle'
            );


        if (
            passwordInput &&
            passwordToggle
        ) {

            passwordToggle.addEventListener(
                'click',
                function () {

                    const isPassword =
                        passwordInput.type ===
                        'password';


                    passwordInput.type =
                        isPassword
                            ? 'text'
                            : 'password';


                    const icon =
                        passwordToggle.querySelector(
                            'i'
                        );


                    if (icon) {

                        icon.className =
                            isPassword
                                ? 'fas fa-eye-slash'
                                : 'fas fa-eye';

                    }


                    passwordToggle.setAttribute(
                        'aria-label',
                        isPassword
                            ? 'Hide password'
                            : 'Show password'
                    );

                }
            );

        }


        // =====================================================
        // LOGIN BUTTON LOADING STATE
        // =====================================================

        const loginForm =
            document.getElementById(
                'loginForm'
            );

        const loginButton =
            document.getElementById(
                'loginButton'
            );


        if (
            loginForm &&
            loginButton
        ) {

            loginForm.addEventListener(
                'submit',
                function () {

                    loginButton.classList.add(
                        'loading'
                    );


                    const buttonText =
                        loginButton.querySelector(
                            '.button-text'
                        );


                    if (buttonText) {

                        buttonText.textContent =
                            'Signing in...';

                    }

                }
            );

        }

    </script>

</body>

</html>