<%- include('../../partials/header') %>

<style>

/* =========================================================
   SPORTS & DANCE — PREMIUM EDIT PAGE
========================================================= */

.sd-edit-page {

    --navy: #002b57;
    --navy-dark: #001b35;
    --blue: #075c98;

    --yellow: #ffbd00;
    --yellow-soft: #fff6d7;

    --text: #102f4d;
    --muted: #72869a;

    --border: #dce6ef;

    --danger: #dc3f4d;
    --danger-soft: #fff0f2;

    min-height: 100vh;

    padding:
        32px 25px 70px;

    background:

        radial-gradient(
            circle at 90% 0%,
            rgba(255,189,0,.08),
            transparent 25%
        ),

        radial-gradient(
            circle at 5% 20%,
            rgba(7,92,152,.06),
            transparent 25%
        ),

        linear-gradient(
            135deg,
            #edf4f9,
            #f9fbfd 50%,
            #e7f0f7
        );

    color:
        var(--text);

    font-family:
        "Segoe UI",
        Arial,
        sans-serif;
}


.sd-edit-container {

    width:
        min(1080px, 100%);

    margin:
        auto;
}


/* =========================================================
   HEADER
========================================================= */

.sd-edit-header {

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        20px;

    margin-bottom:
        25px;
}


.sd-edit-heading {

    display:
        flex;

    align-items:
        center;

    gap:
        15px;
}


.sd-edit-heading-icon {

    width:
        58px;

    height:
        58px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        17px;

    background:
        linear-gradient(
            135deg,
            var(--navy-dark),
            var(--blue)
        );

    color:
        var(--yellow);

    font-size:
        21px;

    box-shadow:
        0 10px 25px
        rgba(0,43,87,.18);
}


.sd-edit-heading h1 {

    margin:
        0;

    color:
        var(--navy);

    font-size:
        28px;

    font-weight:
        950;

    letter-spacing:
        -.7px;
}


.sd-edit-heading p {

    margin:
        5px 0 0;

    color:
        var(--muted);

    font-size:
        11px;

    font-weight:
        600;
}


.sd-back-btn {

    display:
        inline-flex;

    align-items:
        center;

    justify-content:
        center;

    gap:
        8px;

    min-height:
        42px;

    padding:
        0 16px;

    border:
        1px solid
        var(--border);

    border-radius:
        11px;

    background:
        white;

    color:
        var(--navy);

    text-decoration:
        none;

    font-size:
        10px;

    font-weight:
        900;

    transition:
        .2s ease;
}


.sd-back-btn:hover {

    background:
        var(--navy);

    border-color:
        var(--navy);

    color:
        white;
}


/* =========================================================
   MAIN FORM
========================================================= */

.sd-edit-card {

    overflow:
        hidden;

    background:
        rgba(255,255,255,.97);

    border:
        1px solid
        var(--border);

    border-radius:
        25px;

    box-shadow:
        0 22px 55px
        rgba(0,43,87,.09);
}


/* =========================================================
   HERO
========================================================= */

.sd-edit-hero {

    position:
        relative;

    overflow:
        hidden;

    padding:
        31px 32px;

    background:

        radial-gradient(
            circle at 92% 15%,
            rgba(255,255,255,.13),
            transparent 22%
        ),

        linear-gradient(
            125deg,
            var(--navy-dark),
            #003c70 55%,
            var(--blue)
        );
}


.sd-edit-hero::before {

    content:
        "";

    position:
        absolute;

    width:
        300px;

    height:
        300px;

    right:
        -130px;

    top:
        -210px;

    border:
        1px solid
        rgba(255,255,255,.10);

    border-radius:
        50%;
}


.sd-edit-hero h2 {

    position:
        relative;

    z-index:
        2;

    margin:
        0;

    color:
        white;

    font-size:
        21px;

    font-weight:
        950;
}


.sd-edit-hero p {

    position:
        relative;

    z-index:
        2;

    margin:
        6px 0 0;

    color:
        rgba(255,255,255,.68);

    font-size:
        11px;
}


/* =========================================================
   BODY
========================================================= */

.sd-edit-body {

    padding:
        32px;
}


/* =========================================================
   SECTION
========================================================= */

.sd-edit-section {

    margin-bottom:
        32px;
}


.sd-edit-section:last-child {

    margin-bottom:
        0;
}


.sd-edit-section-head {

    display:
        flex;

    align-items:
        center;

    gap:
        11px;

    margin-bottom:
        18px;

    padding-bottom:
        13px;

    border-bottom:
        1px solid
        #e6edf3;
}


.sd-edit-section-icon {

    width:
        34px;

    height:
        34px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        10px;

    background:
        var(--yellow-soft);

    color:
        var(--navy);

    font-size:
        12px;
}


.sd-edit-section-head h3 {

    margin:
        0;

    color:
        var(--navy);

    font-size:
        14px;

    font-weight:
        950;
}


/* =========================================================
   GRID
========================================================= */

.sd-edit-grid {

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        18px;
}


.sd-edit-group {

    display:
        flex;

    flex-direction:
        column;
}


.sd-edit-group.full {

    grid-column:
        1 / -1;
}


.sd-edit-group label {

    margin-bottom:
        7px;

    color:
        var(--navy);

    font-size:
        10px;

    font-weight:
        900;
}


.sd-required {

    color:
        var(--danger);
}


.sd-edit-input,
.sd-edit-select,
.sd-edit-textarea {

    width:
        100%;

    box-sizing:
        border-box;

    border:
        1px solid
        #d8e3ec;

    border-radius:
        11px;

    background:
        #fbfdff;

    color:
        var(--text);

    font-family:
        inherit;

    font-size:
        11px;

    font-weight:
        600;

    outline:
        none;

    transition:
        .2s ease;
}


.sd-edit-input,
.sd-edit-select {

    height:
        45px;

    padding:
        0 13px;
}


.sd-edit-textarea {

    min-height:
        120px;

    padding:
        13px;

    resize:
        vertical;
}


.sd-edit-input:focus,
.sd-edit-select:focus,
.sd-edit-textarea:focus {

    border-color:
        #4c89b3;

    background:
        white;

    box-shadow:
        0 0 0 3px
        rgba(7,92,152,.08);
}


.sd-edit-help {

    margin-top:
        5px;

    color:
        #8b9bab;

    font-size:
        8px;

    line-height:
        1.5;
}


/* =========================================================
   SPORTS / DANCE SELECTOR
========================================================= */

.sd-type-grid {

    display:
        grid;

    grid-template-columns:
        1fr 1fr;

    gap:
        14px;
}


.sd-type-option {

    position:
        relative;
}


.sd-type-option input {

    position:
        absolute;

    opacity:
        0;

    pointer-events:
        none;
}


.sd-type-option label {

    min-height:
        85px;

    display:
        flex;

    align-items:
        center;

    gap:
        14px;

    padding:
        17px;

    cursor:
        pointer;

    border:
        1px solid
        var(--border);

    border-radius:
        15px;

    background:
        #f8fafc;

    transition:
        .22s ease;
}


.sd-type-option label:hover {

    border-color:
        #a9c3d7;

    transform:
        translateY(-2px);
}


.sd-type-option label i {

    width:
        46px;

    height:
        46px;

    flex-shrink:
        0;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        13px;

    background:
        #e9f2f8;

    color:
        var(--navy);

    font-size:
        18px;
}


.sd-type-option label strong {

    display:
        block;

    color:
        var(--navy);

    font-size:
        12px;

    font-weight:
        950;
}


.sd-type-option label span {

    display:
        block;

    margin-top:
        4px;

    color:
        var(--muted);

    font-size:
        9px;

    line-height:
        1.45;
}


.sd-type-option input:checked + label {

    border-color:
        var(--navy);

    background:
        linear-gradient(
            135deg,
            #eef6fc,
            white
        );

    box-shadow:
        0 10px 25px
        rgba(0,43,87,.09);
}


.sd-type-option input:checked + label i {

    background:
        var(--navy);

    color:
        var(--yellow);
}


/* =========================================================
   PHOTO AREA
========================================================= */

.sd-photo-grid {

    display:
        grid;

    grid-template-columns:
        180px 1fr;

    gap:
        20px;

    align-items:
        start;
}


.sd-current-photo {

    overflow:
        hidden;

    width:
        180px;

    height:
        180px;

    border:
        4px solid
        white;

    border-radius:
        20px;

    background:
        #edf3f7;

    box-shadow:
        0 10px 25px
        rgba(0,43,87,.12);
}


.sd-current-photo img {

    width:
        100%;

    height:
        100%;

    display:
        block;

    object-fit:
        cover;
}


.sd-no-photo {

    width:
        100%;

    height:
        100%;

    display:
        flex;

    flex-direction:
        column;

    align-items:
        center;

    justify-content:
        center;

    gap:
        8px;

    color:
        #91a3b2;

    font-size:
        10px;

    font-weight:
        800;
}


.sd-no-photo i {

    font-size:
        32px;

    color:
        #c0ccd5;
}


/* =========================================================
   PHOTO UPLOAD BOX
========================================================= */

.sd-photo-upload {

    padding:
        18px;

    border:
        1px dashed
        #b9ccda;

    border-radius:
        15px;

    background:
        linear-gradient(
            135deg,
            #f8fbfd,
            #eef5f9
        );

    transition:
        .2s ease;
}


.sd-photo-upload:hover {

    border-color:
        #6997b7;

    background:
        linear-gradient(
            135deg,
            #f2f8fc,
            #e9f2f7
        );
}


.sd-photo-upload-head {

    display:
        flex;

    align-items:
        center;

    gap:
        12px;

    margin-bottom:
        13px;
}


.sd-photo-upload-icon {

    width:
        43px;

    height:
        43px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        12px;

    background:
        var(--navy);

    color:
        var(--yellow);

    font-size:
        16px;
}


.sd-photo-upload-title strong {

    display:
        block;

    color:
        var(--navy);

    font-size:
        10px;

    font-weight:
        950;
}


.sd-photo-upload-title span {

    display:
        block;

    margin-top:
        3px;

    color:
        var(--muted);

    font-size:
        8px;
}


.sd-file-input {

    width:
        100%;

    padding:
        9px;

    border:
        1px solid
        #d7e3eb;

    border-radius:
        10px;

    background:
        white;

    color:
        var(--text);

    font-family:
        inherit;

    font-size:
        9px;

    font-weight:
        700;

    cursor:
        pointer;
}


/* =========================================================
   NEW PHOTO PREVIEW
========================================================= */

.sd-new-preview {

    display:
        none;

    margin-top:
        14px;

    padding:
        10px;

    border:
        1px solid
        #dbe6ee;

    border-radius:
        12px;

    background:
        white;
}


.sd-new-preview.show {

    display:
        flex;

    align-items:
        center;

    gap:
        12px;
}


.sd-new-preview img {

    width:
        70px;

    height:
        70px;

    object-fit:
        cover;

    border-radius:
        11px;

    border:
        2px solid
        white;

    box-shadow:
        0 5px 14px
        rgba(0,43,87,.12);
}


.sd-new-preview-info strong {

    display:
        block;

    color:
        var(--navy);

    font-size:
        10px;

    font-weight:
        900;
}


.sd-new-preview-info span {

    display:
        block;

    margin-top:
        4px;

    color:
        var(--muted);

    font-size:
        8px;
}


/* =========================================================
   ACTIONS
========================================================= */

.sd-edit-actions {

    display:
        flex;

    justify-content:
        space-between;

    gap:
        10px;

    margin-top:
        30px;

    padding-top:
        25px;

    border-top:
        1px solid
        #e5ecf2;
}


.sd-action-right {

    display:
        flex;

    gap:
        10px;
}


.sd-cancel-btn,
.sd-delete-btn,
.sd-update-btn {

    min-height:
        45px;

    padding:
        0 19px;

    display:
        inline-flex;

    align-items:
        center;

    justify-content:
        center;

    gap:
        7px;

    border-radius:
        11px;

    font-family:
        inherit;

    font-size:
        10px;

    font-weight:
        900;

    text-decoration:
        none;

    cursor:
        pointer;

    transition:
        .2s ease;
}


.sd-cancel-btn {

    border:
        1px solid
        var(--border);

    background:
        #f3f6f8;

    color:
        #607487;
}


.sd-cancel-btn:hover {

    background:
        #e7edf1;

    color:
        var(--navy);
}


.sd-delete-btn {

    border:
        1px solid
        #f2d4d8;

    background:
        var(--danger-soft);

    color:
        var(--danger);
}


.sd-delete-btn:hover {

    border-color:
        var(--danger);

    background:
        var(--danger);

    color:
        white;
}


.sd-update-btn {

    border:
        none;

    background:
        linear-gradient(
            135deg,
            var(--navy),
            var(--blue)
        );

    color:
        white;

    box-shadow:
        0 9px 22px
        rgba(0,43,87,.18);
}


.sd-update-btn:hover {

    transform:
        translateY(-2px);

    box-shadow:
        0 13px 28px
        rgba(0,43,87,.25);
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:750px) {

    .sd-edit-page {

        padding:
            20px 14px 50px;

    }


    .sd-edit-header {

        align-items:
            flex-start;

        flex-direction:
            column;

    }


    .sd-back-btn {

        width:
            100%;

    }


    .sd-edit-body {

        padding:
            22px 18px;

    }


    .sd-edit-grid,
    .sd-type-grid {

        grid-template-columns:
            1fr;

    }


    .sd-edit-group.full {

        grid-column:
            auto;

    }


    .sd-photo-grid {

        grid-template-columns:
            1fr;

    }


    .sd-current-photo {

        width:
            150px;

        height:
            150px;

    }


    .sd-edit-actions {

        flex-direction:
            column;

    }


    .sd-action-right {

        width:
            100%;

        flex-direction:
            column;

    }


    .sd-cancel-btn,
    .sd-delete-btn,
    .sd-update-btn {

        width:
            100%;

    }

}


@media(max-width:430px) {

    .sd-edit-heading h1 {

        font-size:
            23px;

    }


    .sd-edit-heading-icon {

        width:
            50px;

        height:
            50px;

    }

}

</style>


<div class="sd-edit-page">

    <div class="sd-edit-container">


        <!-- =================================================
             PAGE HEADER
        ================================================= -->

        <div class="sd-edit-header">


            <div class="sd-edit-heading">

                <div class="sd-edit-heading-icon">

                    <i class="fa-solid fa-pen-to-square"></i>

                </div>


                <div>

                    <h1>
                        Edit Achievement
                    </h1>

                    <p>
                        Update the Sports or Dance achievement record
                    </p>

                </div>

            </div>


            <a
                href="/admin/sports-dance"
                class="sd-back-btn"
            >

                <i class="fa-solid fa-arrow-left"></i>

                Back to Records

            </a>


        </div>



        <!-- =================================================
             FORM
        ================================================= -->

        <form
            action="/admin/sports-dance/edit/<%= record._id %>"
            method="POST"
            enctype="multipart/form-data"
            class="sd-edit-card"
        >


            <!-- CSRF -->

            <input
                type="hidden"
                name="_csrf"
                value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
            >


            <!-- =================================================
                 HERO
            ================================================= -->

            <div class="sd-edit-hero">

                <h2>
                    Achievement Information
                </h2>

                <p>
                    Update details, achievement information or replace the photo.
                </p>

            </div>


            <div class="sd-edit-body">


                <!-- =================================================
                     TYPE
                ================================================= -->

                <section class="sd-edit-section">


                    <div class="sd-edit-section-head">

                        <div class="sd-edit-section-icon">

                            <i class="fa-solid fa-layer-group"></i>

                        </div>


                        <h3>
                            Achievement Type
                        </h3>

                    </div>


                    <div class="sd-type-grid">


                        <div class="sd-type-option">

                            <input
                                type="radio"
                                id="sports"
                                name="recordType"
                                value="sports"

                                <%= record.recordType === 'sports'
                                    ? 'checked'
                                    : '' %>
                            >


                            <label for="sports">

                                <i class="fa-solid fa-futbol"></i>


                                <div>

                                    <strong>
                                        Sports Achievement
                                    </strong>

                                    <span>
                                        Individual, player, team or sports group.
                                    </span>

                                </div>

                            </label>

                        </div>



                        <div class="sd-type-option">

                            <input
                                type="radio"
                                id="dance"
                                name="recordType"
                                value="dance"

                                <%= record.recordType === 'dance'
                                    ? 'checked'
                                    : '' %>
                            >


                            <label for="dance">

                                <i class="fa-solid fa-music"></i>


                                <div>

                                    <strong>
                                        Dance Achievement
                                    </strong>

                                    <span>
                                        Individual performer or dance group.
                                    </span>

                                </div>

                            </label>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     STUDENT / GROUP
                ================================================= -->

                <section class="sd-edit-section">


                    <div class="sd-edit-section-head">

                        <div class="sd-edit-section-icon">

                            <i class="fa-solid fa-users"></i>

                        </div>


                        <h3>
                            Student / Group Information
                        </h3>

                    </div>


                    <div class="sd-edit-grid">


                        <div class="sd-edit-group full">

                            <label for="studentName">

                                Student / Group Name

                                <span class="sd-required">
                                    *
                                </span>

                            </label>


                            <input
                                type="text"
                                id="studentName"
                                name="studentName"
                                class="sd-edit-input"

                                value="<%= record.studentName || '' %>"

                                maxlength="100"

                                required
                            >


                            <span class="sd-edit-help">

                                Individual winner ka naam ya team/group ka naam enter karein.

                            </span>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     PHOTO
                ================================================= -->

                <section class="sd-edit-section">


                    <div class="sd-edit-section-head">

                        <div class="sd-edit-section-icon">

                            <i class="fa-solid fa-camera"></i>

                        </div>


                        <h3>
                            Achievement Photo
                        </h3>

                    </div>


                    <div class="sd-photo-grid">


                        <!-- CURRENT PHOTO -->

                        <div>


                            <div class="sd-current-photo">


                                <% if (record.photo) { %>

                                    <img
                                        src="<%= record.photo %>"
                                        alt="<%= record.studentName %>"
                                    >

                                <% } else { %>

                                    <div class="sd-no-photo">

                                        <i class="fa-solid fa-image"></i>

                                        No Photo

                                    </div>

                                <% } %>


                            </div>


                        </div>



                        <!-- CHANGE PHOTO -->

                        <div class="sd-photo-upload">


                            <div class="sd-photo-upload-head">


                                <div class="sd-photo-upload-icon">

                                    <i class="fa-solid fa-camera"></i>

                                </div>


                                <div class="sd-photo-upload-title">

                                    <strong>
                                        Change Achievement Photo
                                    </strong>

                                    <span>
                                        Leave empty to keep the current photo.
                                    </span>

                                </div>


                            </div>


                            <input
                                type="file"
                                id="photo"
                                name="photo"
                                class="sd-file-input"
                                accept="image/jpeg,image/png,image/webp"
                            >


                            <div
                                class="sd-new-preview"
                                id="newPhotoPreview"
                            >

                                <img
                                    id="newPreviewImage"
                                    src=""
                                    alt="New photo preview"
                                >


                                <div class="sd-new-preview-info">

                                    <strong>
                                        New Photo
                                    </strong>

                                    <span id="newPhotoName">
                                        -
                                    </span>

                                </div>

                            </div>


                            <span class="sd-edit-help">

                                JPG, PNG or WebP • Maximum 2 MB.
                                Uploading a new photo will replace the current one.

                            </span>


                        </div>


                    </div>

                </section>



                <!-- =================================================
                     YEAR / BATCH
                ================================================= -->

                <section class="sd-edit-section">


                    <div class="sd-edit-section-head">

                        <div class="sd-edit-section-icon">

                            <i class="fa-solid fa-calendar-days"></i>

                        </div>


                        <h3>
                            Year & Batch
                        </h3>

                    </div>


                    <div class="sd-edit-grid">


                        <div class="sd-edit-group">

                            <label for="batch">

                                Batch

                                <span class="sd-required">
                                    *
                                </span>

                            </label>


                            <input
                                type="text"
                                id="batch"
                                name="batch"
                                class="sd-edit-input"

                                value="<%= record.batch || '' %>"

                                required
                            >

                        </div>



                        <div class="sd-edit-group">

                            <label for="year">

                                Achievement Year

                                <span class="sd-required">
                                    *
                                </span>

                            </label>


                            <input
                                type="text"
                                id="year"
                                name="year"
                                class="sd-edit-input"

                                value="<%= record.year || '' %>"

                                required
                            >

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     DETAILS
                ================================================= -->

                <section class="sd-edit-section">


                    <div class="sd-edit-section-head">

                        <div class="sd-edit-section-icon">

                            <i class="fa-solid fa-medal"></i>

                        </div>


                        <h3>
                            Achievement Details
                        </h3>

                    </div>


                    <div class="sd-edit-grid">


                        <div class="sd-edit-group">

                            <label for="category">
                                Category
                            </label>


                            <input
                                type="text"
                                id="category"
                                name="category"
                                class="sd-edit-input"

                                value="<%= record.category || '' %>"

                                placeholder="e.g. Cricket / Classical Dance"
                            >

                        </div>



                        <div class="sd-edit-group">

                            <label for="level">
                                Achievement Level
                            </label>


                            <select
                                id="level"
                                name="level"
                                class="sd-edit-select"
                            >

                                <option value="">
                                    Select level
                                </option>


                                <option
                                    value="School"
                                    <%= record.level === 'School'
                                        ? 'selected'
                                        : '' %>
                                >
                                    School
                                </option>


                                <option
                                    value="District"
                                    <%= record.level === 'District'
                                        ? 'selected'
                                        : '' %>
                                >
                                    District
                                </option>


                                <option
                                    value="State"
                                    <%= record.level === 'State'
                                        ? 'selected'
                                        : '' %>
                                >
                                    State
                                </option>


                                <option
                                    value="National"
                                    <%= record.level === 'National'
                                        ? 'selected'
                                        : '' %>
                                >
                                    National
                                </option>


                                <option
                                    value="International"
                                    <%= record.level === 'International'
                                        ? 'selected'
                                        : '' %>
                                >
                                    International
                                </option>

                            </select>

                        </div>



                        <div class="sd-edit-group">

                            <label for="position">
                                Position / Award
                            </label>


                            <input
                                type="text"
                                id="position"
                                name="position"
                                class="sd-edit-input"

                                value="<%= record.position || '' %>"

                                placeholder="e.g. 1st Position / Gold Medal"
                            >

                        </div>



                        <div class="sd-edit-group">

                            <label for="competition">
                                Competition / Event
                            </label>


                            <input
                                type="text"
                                id="competition"
                                name="competition"
                                class="sd-edit-input"

                                value="<%= record.competition || '' %>"

                                placeholder="Enter competition or event"
                            >

                        </div>



                        <div class="sd-edit-group full">

                            <label for="achievement">
                                Achievement Description
                            </label>


                            <textarea
                                id="achievement"
                                name="achievement"
                                class="sd-edit-textarea"
                                maxlength="1000"
                                placeholder="Write a short description..."
                            ><%= record.achievement || '' %></textarea>


                            <span class="sd-edit-help">

                                Maximum 1000 characters.

                            </span>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     DISPLAY
                ================================================= -->

                <section class="sd-edit-section">


                    <div class="sd-edit-section-head">

                        <div class="sd-edit-section-icon">

                            <i class="fa-solid fa-sliders"></i>

                        </div>


                        <h3>
                            Display Settings
                        </h3>

                    </div>


                    <div class="sd-edit-grid">


                        <div class="sd-edit-group">

                            <label for="priority">
                                Display Priority
                            </label>


                            <input
                                type="number"
                                id="priority"
                                name="priority"
                                class="sd-edit-input"

                                value="<%= record.priority || 0 %>"

                                min="0"
                                max="999"
                            >


                            <span class="sd-edit-help">

                                Lower number appears first for records from the same year.

                            </span>

                        </div>


                    </div>

                </section>



                <!-- =================================================
                     ACTIONS
                ================================================= -->

                <div class="sd-edit-actions">


                    <a
                        href="/admin/sports-dance"
                        class="sd-cancel-btn"
                    >

                        <i class="fa-solid fa-arrow-left"></i>

                        Cancel

                    </a>


                    <div class="sd-action-right">


                        <button
                            type="button"
                            class="sd-delete-btn"
                            onclick="deleteRecord()"
                        >

                            <i class="fa-solid fa-trash"></i>

                            Delete

                        </button>


                        <button
                            type="submit"
                            class="sd-update-btn"
                        >

                            <i class="fa-solid fa-check"></i>

                            Save Changes

                        </button>


                    </div>


                </div>


            </div>

        </form>



        <!-- =================================================
             HIDDEN DELETE FORM
        ================================================= -->

        <form
            id="deleteForm"
            action="/admin/sports-dance/delete/<%= record._id %>"
            method="POST"
            style="display:none;"
        >

            <input
                type="hidden"
                name="_csrf"
                value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"
            >

        </form>


    </div>

</div>



<script>

/* =========================================================
   PHOTO PREVIEW
========================================================= */

const photoInput =
    document.getElementById(
        'photo'
    );

const newPhotoPreview =
    document.getElementById(
        'newPhotoPreview'
    );

const newPreviewImage =
    document.getElementById(
        'newPreviewImage'
    );

const newPhotoName =
    document.getElementById(
        'newPhotoName'
    );


if (photoInput) {

    photoInput.addEventListener(
        'change',
        function () {


            const file =
                this.files[0];


            if (!file) {

                newPhotoPreview.classList.remove(
                    'show'
                );

                return;

            }


            const allowedTypes = [

                'image/jpeg',

                'image/png',

                'image/webp'

            ];


            if (
                !allowedTypes.includes(
                    file.type
                )
            ) {

                alert(
                    'Please select a JPG, PNG or WebP image.'
                );


                this.value = '';


                newPhotoPreview.classList.remove(
                    'show'
                );


                return;

            }


            if (
                file.size >
                2 * 1024 * 1024
            ) {

                alert(
                    'Image size must be less than 2 MB.'
                );


                this.value = '';


                newPhotoPreview.classList.remove(
                    'show'
                );


                return;

            }


            const reader =
                new FileReader();


            reader.onload =
                function (
                    event
                ) {


                    newPreviewImage.src =
                        event.target.result;


                    newPhotoName.textContent =
                        file.name;


                    newPhotoPreview.classList.add(
                        'show'
                    );

                };


            reader.readAsDataURL(
                file
            );

        }
    );

}


/* =========================================================
   DELETE
========================================================= */

function deleteRecord() {


    const confirmed =
        confirm(

            'Are you sure you want to delete this achievement record?\n\n' +
            'The record and its uploaded photo will be permanently deleted.'

        );


    if (!confirmed) {

        return;

    }


    document
        .getElementById(
            'deleteForm'
        )
        .submit();

}


/* =========================================================
   FORM SUBMIT PROTECTION
========================================================= */

const editForm =
    document.querySelector(
        '.sd-edit-card'
    );


if (editForm) {

    editForm.addEventListener(
        'submit',
        function () {


            const button =
                this.querySelector(
                    '.sd-update-btn'
                );


            if (button) {

                button.disabled =
                    true;


                button.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            }

        }
    );

}

</script>


