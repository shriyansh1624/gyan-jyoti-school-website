<%- include('../partials/header') %>

<section class="edit-enquiry-page">

    <div class="edit-container">

        <!-- =========================
             PAGE HEADER
        ========================== -->

        <div class="page-header">

            <div>
                <div class="eyebrow">
                    <i class="fas fa-envelope-open-text"></i>
                    ADMINISTRATION
                </div>

                <h1>
                    <i class="fas fa-pen-to-square"></i>
                    Edit Enquiry
                </h1>

                <p>
                    Update the enquiry information and save the changes.
                </p>
            </div>

            <a
                href="/admin/dashboard#enquiries"
                class="back-btn">

                <i class="fas fa-arrow-left"></i>
                Back to Enquiries

            </a>

        </div>


        <!-- =========================
             EDIT CARD
        ========================== -->

        <div class="edit-card">

            <div class="card-top">

                <div class="card-icon">
                    <i class="fas fa-envelope-open-text"></i>
                </div>

                <div>
                    <h2>Enquiry Details</h2>
                    <p>Modify the information below and click Update Enquiry.</p>
                </div>

            </div>


            <form
                method="POST"
                action="/admin/enquiry/edit/<%= enquiry._id %>"
                id="enquiryEditForm">

                <!-- =====================
                     CONTACT INFORMATION
                ====================== -->

                <div class="section-title">

                    <span class="section-number">01</span>

                    <div>
                        <h3>Contact Information</h3>
                        <p>Basic details of the person who submitted the enquiry.</p>
                    </div>

                </div>


                <div class="form-grid">

                    <div class="form-group">

                        <label for="name">
                            Name
                            <span>*</span>
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-user"></i>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                value="<%= enquiry.name || '' %>"
                                maxlength="60"
                                required
                                autocomplete="name"
                                placeholder="Enter name">

                        </div>

                    </div>


                    <div class="form-group">

                        <label for="phone">
                            Phone Number
                            <span>*</span>
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-phone"></i>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                value="<%= enquiry.phone || '' %>"
                                maxlength="10"
                                minlength="10"
                                pattern="[0-9]{10}"
                                required
                                autocomplete="tel"
                                placeholder="10 digit mobile number">

                        </div>

                    </div>


                    <div class="form-group full">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="input-wrap">

                            <i class="fas fa-envelope"></i>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="<%= enquiry.email || '' %>"
                                maxlength="120"
                                autocomplete="email"
                                placeholder="Enter email address">

                        </div>

                    </div>

                </div>


                <!-- =====================
                     ENQUIRY MESSAGE
                ====================== -->

                <div class="section-title">

                    <span class="section-number">02</span>

                    <div>
                        <h3>Enquiry Message</h3>
                        <p>Update the question or message submitted by the visitor.</p>
                    </div>

                </div>


                <div class="form-group">

                    <label for="message">
                        Message
                        <span>*</span>
                    </label>

                    <div class="textarea-wrap">

                        <i class="fas fa-message"></i>

                        <textarea
                            id="message"
                            name="message"
                            maxlength="500"
                            rows="8"
                            required
                            placeholder="Enter enquiry message"><%= enquiry.message || '' %></textarea>

                    </div>

                    <div class="character-count">
                        <span id="messageCount">
                            <%= (enquiry.message || '').length %>
                        </span>
                        / 500
                    </div>

                </div>


                <!-- =====================
                     SUBMITTED DATE
                ====================== -->

                <% if (enquiry.createdAt) { %>

                    <div class="submitted-info">

                        <div class="submitted-icon">
                            <i class="fas fa-clock"></i>
                        </div>

                        <div>
                            <strong>Submitted On</strong>

                            <span>
                                <%= new Date(enquiry.createdAt).toLocaleString('en-IN', {
                                    dateStyle: 'medium',
                                    timeStyle: 'short'
                                }) %>
                            </span>
                        </div>

                    </div>

                <% } %>


                <!-- =====================
                     ACTIONS
                ====================== -->

                <div class="form-actions">

                    <a
                        href="/admin/dashboard#enquiries"
                        class="cancel-btn">

                        <i class="fas fa-xmark"></i>
                        Cancel

                    </a>


                    <button
                        type="submit"
                        class="update-btn">

                        <i class="fas fa-save"></i>
                        Update Enquiry

                    </button>

                </div>

            </form>

        </div>

    </div>

</section>


<style>

/* =========================================================
   PREMIUM ENQUIRY EDIT PAGE
========================================================= */

.edit-enquiry-page {
    min-height: calc(100vh - 120px);
    padding: 55px 25px 85px;

    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(255,193,7,.08),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #f5f8fc 0%,
            #eef4f9 100%
        );
}

.edit-container {
    width: min(1050px, 100%);
    margin: 0 auto;
}


/* =========================
   HEADER
========================= */

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 25px;
    margin-bottom: 28px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;

    color: #b27c00;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.5px;
}

.page-header h1 {
    display: flex;
    align-items: center;
    gap: 12px;

    margin: 0;

    color: #002b57 !important;

    font-size: 38px;
    font-weight: 900;
}

.page-header h1 i {
    color: #f4b900 !important;
}

.page-header p {
    margin: 9px 0 0;

    color: #6c7e91 !important;

    font-size: 14px;
}

.back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    min-height: 46px;
    padding: 0 18px;

    border: 1px solid #d9e4ed;
    border-radius: 12px;

    background: #fff;
    color: #002b57 !important;

    text-decoration: none !important;

    font-size: 13px;
    font-weight: 800;

    box-shadow: 0 8px 22px rgba(0,33,71,.06);

    transition: .2s ease;
}

.back-btn:hover {
    transform: translateY(-2px);

    background: #002b57;
    color: #fff !important;
}


/* =========================
   CARD
========================= */

.edit-card {
    overflow: hidden;

    background: #fff;

    border: 1px solid #e0e9f1;
    border-radius: 22px;

    box-shadow: 0 25px 65px rgba(0,33,71,.10);
}

.card-top {
    display: flex;
    align-items: center;
    gap: 16px;

    padding: 25px 30px;

    background:
        linear-gradient(
            135deg,
            #002b57,
            #063e6e
        );

    color: #fff;
}

.card-icon {
    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 15px;

    background: #ffc107;
    color: #002b57;

    font-size: 22px;
}

.card-top h2 {
    margin: 0;

    color: #fff !important;

    font-size: 20px;
}

.card-top p {
    margin: 5px 0 0;

    color: rgba(255,255,255,.72) !important;

    font-size: 12px;
}


/* =========================
   FORM
========================= */

#enquiryEditForm {
    padding: 35px 32px 30px;
}

.section-title {
    display: flex;
    align-items: center;
    gap: 13px;

    margin: 8px 0 22px;
    padding-bottom: 14px;

    border-bottom: 1px solid #e8eef4;
}

.section-number {
    width: 36px;
    height: 36px;

    flex: 0 0 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #fff4d0;
    color: #a87300;

    font-size: 11px;
    font-weight: 900;
}

.section-title h3 {
    margin: 0;

    color: #002b57 !important;

    font-size: 16px;
    font-weight: 900;
}

.section-title p {
    margin: 3px 0 0;

    color: #8090a0 !important;

    font-size: 11px;
}

.form-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 20px;

    margin-bottom: 34px;
}

.form-group {
    position: relative;

    margin-bottom: 24px;
}

.form-grid .form-group {
    margin-bottom: 0;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    display: block;

    margin-bottom: 8px;

    color: #173b5c !important;

    font-size: 12px;
    font-weight: 850;
}

.form-group label span {
    color: #d32f2f;
}

.input-wrap,
.textarea-wrap {
    position: relative;
}

.input-wrap i,
.textarea-wrap i {
    position: absolute;

    top: 50%;
    left: 15px;

    z-index: 2;

    transform: translateY(-50%);

    color: #8496a7;

    font-size: 13px;

    pointer-events: none;
}

.textarea-wrap i {
    top: 20px;

    transform: none;
}

.input-wrap input,
.textarea-wrap textarea {
    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d8e2eb;
    outline: none;

    border-radius: 13px;

    background: #fbfdff;
    color: #193b59;

    font-family: inherit;
    font-size: 13px;

    transition: .2s ease;
}

.input-wrap input {
    height: 48px;

    padding: 0 15px 0 43px;
}

.textarea-wrap textarea {
    min-height: 180px;

    padding: 15px 15px 15px 43px;

    resize: vertical;

    line-height: 1.6;
}

.input-wrap input:focus,
.textarea-wrap textarea:focus {
    border-color: #ffc107;

    background: #fff;

    box-shadow:
        0 0 0 4px rgba(255,193,7,.12);
}

.character-count {
    margin-top: 6px;

    color: #91a0ae;

    font-size: 10px;

    text-align: right;
}


/* =========================
   SUBMITTED INFORMATION
========================= */

.submitted-info {
    display: flex;
    align-items: center;
    gap: 13px;

    margin: 10px 0 30px;

    padding: 15px 17px;

    border: 1px solid #e1e9f0;
    border-radius: 14px;

    background: #f8fbfe;
}

.submitted-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 42px;

    border-radius: 11px;

    background: #e8f1ff;
    color: #2872df;

    font-size: 16px;
}

.submitted-info div:last-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.submitted-info strong {
    color: #173b5c;

    font-size: 12px;
}

.submitted-info span {
    color: #8292a1;

    font-size: 11px;
}


/* =========================
   ACTIONS
========================= */

.form-actions {
    display: flex;

    justify-content: flex-end;
    align-items: center;

    gap: 12px;

    padding-top: 24px;

    border-top: 1px solid #e8eef4;
}

.cancel-btn,
.update-btn {
    min-height: 48px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 0 22px;

    border-radius: 12px;

    font-size: 13px;
    font-weight: 850;

    cursor: pointer;

    text-decoration: none !important;

    transition: .2s ease;
}

.cancel-btn {
    border: 1px solid #d9e3eb;

    background: #fff;

    color: #52697d !important;
}

.cancel-btn:hover {
    background: #f1f5f8;
}

.update-btn {
    border: 0;

    background:
        linear-gradient(
            135deg,
            #ffc107,
            #ffda57
        );

    color: #002b57;

    box-shadow:
        0 10px 25px rgba(255,193,7,.25);
}

.update-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 14px 30px rgba(255,193,7,.35);
}

.update-btn:disabled {
    cursor: not-allowed;

    opacity: .7;

    transform: none;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 750px) {

    .edit-enquiry-page {
        padding: 35px 15px 60px;
    }

    .page-header {
        align-items: flex-start;

        flex-direction: column;
    }

    .page-header h1 {
        font-size: 30px;
    }

    .back-btn {
        width: 100%;
    }

    #enquiryEditForm {
        padding: 25px 20px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .cancel-btn,
    .update-btn {
        width: 100%;
    }

}

</style>


<script>

/* =========================================================
   MESSAGE CHARACTER COUNTER
========================================================= */

document.addEventListener(
    'DOMContentLoaded',
    function () {

        const message =
            document.getElementById('message');

        const counter =
            document.getElementById('messageCount');


        if (message && counter) {

            message.addEventListener(
                'input',
                function () {

                    counter.textContent =
                        this.value.length;

                }
            );

        }

    }
);


/* =========================================================
   FORM SUBMIT PROTECTION
========================================================= */

document.addEventListener(
    'DOMContentLoaded',
    function () {

        const form =
            document.getElementById(
                'enquiryEditForm'
            );


        if (!form) return;


        form.addEventListener(
            'submit',
            function () {

                const button =
                    form.querySelector(
                        '.update-btn'
                    );


                if (button) {

                    button.disabled = true;

                    button.innerHTML =
                        '<i class="fas fa-spinner fa-spin"></i> Updating...';

                }

            }
        );

    }
);

</script>

<%- include('../partials/footer') %>
