<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#001f3f"
    >

    <title>
        Add Fee Structure - Admin
    </title>


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >


    <style>

        * {
            box-sizing: border-box;
        }


        html,
        body {

            margin: 0;
            padding: 0;
            width: 100%;

        }


        body {

            font-family:
                "Segoe UI",
                Tahoma,
                Geneva,
                Verdana,
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #f4f7fb,
                    #eef3f9
                );

            color: #172b4d;

        }


        /* =====================================================
           PAGE
        ====================================================== */

        .page {

            min-height: 100vh;

            padding:
                35px 25px
                60px;

        }


        .container {

            width: 100%;

            max-width: 1050px;

            margin: 0 auto;

        }


        /* =====================================================
           HEADER
        ====================================================== */

        .page-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 25px;

        }


        .heading {

            display: flex;

            align-items: center;

            gap: 16px;

        }


        .heading-icon {

            width: 58px;

            height: 58px;

            border-radius: 17px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    135deg,
                    #ffc300,
                    #ffdb55
                );

            color: #001f3f;

            font-size: 24px;

            box-shadow:
                0 12px 28px
                rgba(255,195,0,.25);

        }


        .heading h1 {

            margin: 0;

            color: #001f3f;

            font-size: 28px;

            font-weight: 900;

        }


        .heading p {

            margin:
                4px 0 0;

            color: #7b8aa1;

            font-size: 13px;

        }


        .back-btn {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding:
                12px 17px;

            border-radius: 11px;

            background: #fff;

            border:
                1px solid
                #dfe6ef;

            color: #001f3f;

            text-decoration: none;

            font-size: 13px;

            font-weight: 800;

            transition: .2s;

        }


        .back-btn:hover {

            background: #001f3f;

            color: #fff;

            border-color:
                #001f3f;

        }


        /* =====================================================
           CARD
        ====================================================== */

        .form-card {

            background: #fff;

            border:
                1px solid
                #e2e8f0;

            border-radius: 22px;

            overflow: hidden;

            box-shadow:
                0 15px 40px
                rgba(22,48,80,.08);

        }


        /* =====================================================
           SECTION
        ====================================================== */

        .form-section {

            padding: 27px;

            border-bottom:
                1px solid
                #edf0f4;

        }


        .form-section:last-child {

            border-bottom: none;

        }


        .section-heading {

            display: flex;

            align-items: center;

            gap: 11px;

            margin-bottom: 21px;

        }


        .section-heading-icon {

            width: 38px;

            height: 38px;

            border-radius: 11px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #edf5ff;

            color: #0066b3;

        }


        .section-heading h2 {

            margin: 0;

            font-size: 17px;

            color: #001f3f;

            font-weight: 900;

        }


        .section-heading p {

            margin:
                3px 0 0;

            color: #8a98ac;

            font-size: 11px;

        }


        /* =====================================================
           GRID
        ====================================================== */

        .form-grid {

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 18px;

        }


        .form-group {

            display: flex;

            flex-direction: column;

            gap: 7px;

        }


        .form-group.full {

            grid-column:
                1 / -1;

        }


        .form-group label {

            color: #304561;

            font-size: 12px;

            font-weight: 800;

        }


        .required {

            color: #d53d3d;

        }


        .form-control {

            width: 100%;

            height: 47px;

            border:
                1px solid
                #dce4ee;

            border-radius: 11px;

            padding:
                0 14px;

            background: #fff;

            color: #172b4d;

            font-size: 13px;

            outline: none;

            transition: .2s;

        }


        textarea.form-control {

            height: 110px;

            padding:
                13px 14px;

            resize: vertical;

            line-height: 1.5;

        }


        .form-control:focus {

            border-color:
                #ffc300;

            box-shadow:
                0 0 0 4px
                rgba(255,195,0,.12);

        }


        .help-text {

            color: #8a98ac;

            font-size: 11px;

            line-height: 1.4;

        }


        /* =====================================================
           CHECKBOX
        ====================================================== */

        .checkbox-wrapper {

            display: flex;

            align-items: center;

            gap: 10px;

            min-height: 47px;

            padding:
                0 14px;

            border:
                1px solid
                #dce4ee;

            border-radius: 11px;

            background: #fafcff;

        }


        .checkbox-wrapper input {

            width: 18px;

            height: 18px;

            accent-color:
                #001f3f;

            cursor: pointer;

        }


        .checkbox-wrapper label {

            margin: 0;

            cursor: pointer;

            font-size: 13px;

        }


        /* =====================================================
           FEE TABLE
        ====================================================== */

        .fee-list {

            display: flex;

            flex-direction: column;

            gap: 12px;

        }


        .fee-item {

            display: grid;

            grid-template-columns:
                1fr 190px 48px;

            gap: 10px;

            align-items: end;

            padding: 13px;

            border:
                1px solid
                #e3e9f1;

            border-radius: 13px;

            background: #fafcff;

        }


        .fee-item .form-group {

            gap: 6px;

        }


        .fee-item label {

            font-size: 10px;

            color: #7789a1;

            text-transform: uppercase;

            letter-spacing: .4px;

        }


        .remove-fee {

            width: 43px;

            height: 43px;

            border: none;

            border-radius: 10px;

            background: #fff0f0;

            color: #c43b3b;

            cursor: pointer;

            transition: .2s;

        }


        .remove-fee:hover {

            background: #ffe0e0;

            transform:
                translateY(-1px);

        }


        .add-fee-btn {

            margin-top: 14px;

            display: inline-flex;

            align-items: center;

            gap: 8px;

            border:
                1px dashed
                #b8c7d9;

            background: #f7faff;

            color: #0066b3;

            border-radius: 11px;

            padding:
                11px 15px;

            font-size: 12px;

            font-weight: 800;

            cursor: pointer;

            transition: .2s;

        }


        .add-fee-btn:hover {

            border-color:
                #0066b3;

            background: #edf5ff;

        }


        /* =====================================================
           TOTAL
        ====================================================== */

        .total-box {

            margin-top: 18px;

            padding:
                17px 20px;

            border-radius: 14px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            background:
                linear-gradient(
                    90deg,
                    #ffc300,
                    #ffda45
                );

        }


        .total-box span {

            color: #001f3f;

            font-size: 14px;

            font-weight: 900;

        }


        .total-box strong {

            color: #001f3f;

            font-size: 20px;

            font-weight: 900;

        }


        /* =====================================================
           FOOTER
        ====================================================== */

        .form-footer {

            padding:
                20px 27px;

            display: flex;

            align-items: center;

            justify-content: flex-end;

            gap: 11px;

            background: #fafcff;

            border-top:
                1px solid
                #edf0f4;

        }


        .btn {

            height: 46px;

            padding:
                0 20px;

            border-radius: 11px;

            border: none;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            font-size: 13px;

            font-weight: 800;

            cursor: pointer;

            text-decoration: none;

            transition: .2s;

        }


        .btn-cancel {

            background: #edf1f6;

            color: #405572;

        }


        .btn-cancel:hover {

            background: #dfe6ef;

        }


        .btn-save {

            background:
                linear-gradient(
                    135deg,
                    #001f3f,
                    #06477f
                );

            color: #fff;

            box-shadow:
                0 10px 22px
                rgba(0,31,63,.18);

        }


        .btn-save i {

            color: #ffc300;

        }


        .btn-save:hover {

            transform:
                translateY(-2px);

        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media(max-width:700px) {

            .page {

                padding:
                    22px 14px
                    45px;

            }


            .page-header {

                align-items:
                    flex-start;

                flex-direction:
                    column;

            }


            .back-btn {

                width: 100%;

                justify-content:
                    center;

            }


            .heading h1 {

                font-size: 23px;

            }


            .form-section {

                padding: 21px 17px;

            }


            .form-grid {

                grid-template-columns:
                    1fr;

            }


            .form-group.full {

                grid-column: auto;

            }


            .fee-item {

                grid-template-columns:
                    1fr;

            }


            .remove-fee {

                width: 100%;

            }


            .total-box {

                align-items:
                    flex-start;

                flex-direction:
                    column;

                gap: 6px;

            }


            .form-footer {

                padding:
                    17px;

                flex-direction:
                    column-reverse;

            }


            .btn {

                width: 100%;

            }

        }

    </style>

</head>


<body>


<div class="page">

<div class="container">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="page-header">


        <div class="heading">


            <div class="heading-icon">

                <i class="fas fa-file-invoice-dollar"></i>

            </div>


            <div>

                <h1>
                    Add Fee Structure
                </h1>

                <p>
                    Create a new academic fee structure for the school website.
                </p>

            </div>


        </div>


        <a
            href="/admin/fees"
            class="back-btn"
        >

            <i class="fas fa-arrow-left"></i>

            Back to Fees

        </a>


    </div>



    <!-- =====================================================
         FORM
    ====================================================== -->

    <form
        method="POST"
        action="/admin/fees/add"
        id="feeForm"
        class="form-card"
    >


        <!-- =================================================
             CSRF
        ================================================== -->

        <input
            type="hidden"
            name="_csrf"
            value="<%= csrfToken %>"
        >



        <!-- =================================================
             BASIC INFORMATION
        ================================================== -->

        <section class="form-section">


            <div class="section-heading">


                <div class="section-heading-icon">

                    <i class="fas fa-graduation-cap"></i>

                </div>


                <div>

                    <h2>
                        Basic Information
                    </h2>

                    <p>
                        Enter the academic section and session details.
                    </p>

                </div>


            </div>



            <div class="form-grid">


                <!-- TITLE -->

                <div class="form-group">

                    <label for="title">

                        Fee Structure Title

                        <span class="required">
                            *
                        </span>

                    </label>


                    <input
                        type="text"
                        id="title"
                        name="title"
                        class="form-control"
                        placeholder="Primary Section"
                        maxlength="100"
                        required
                    >


                    <span class="help-text">
                        Example: Primary Section Fees
                    </span>

                </div>



                <!-- SECTION -->

                <div class="form-group">

                    <label for="section">

                        Section

                        <span class="required">
                            *
                        </span>

                    </label>


                    <select
                        id="section"
                        name="section"
                        class="form-control"
                        required
                    >

                        <option value="">
                            Select Section
                        </option>

                        <option value="primary">
                            Primary
                        </option>

                        <option value="middle">
                            Middle
                        </option>

                        <option value="secondary">
                            Secondary
                        </option>

                        <option value="senior-secondary">
                            Senior Secondary
                        </option>

                    </select>

                </div>



                <!-- CLASS RANGE -->

                <div class="form-group">

                    <label for="classRange">

                        Class Range

                        <span class="required">
                            *
                        </span>

                    </label>


                    <input
                        type="text"
                        id="classRange"
                        name="classRange"
                        class="form-control"
                        placeholder="Class I - V"
                        maxlength="50"
                        required
                    >

                </div>



                <!-- SESSION -->

                <div class="form-group">

                    <label for="session">

                        Academic Session

                        <span class="required">
                            *
                        </span>

                    </label>


                    <input
                        type="text"
                        id="session"
                        name="session"
                        class="form-control"
                        placeholder="2026-27"
                        maxlength="20"
                        required
                    >

                </div>



                <!-- PRIORITY -->

                <div class="form-group">

                    <label for="priority">

                        Display Priority

                    </label>


                    <input
                        type="number"
                        id="priority"
                        name="priority"
                        class="form-control"
                        value="0"
                        min="0"
                        max="999"
                    >


                    <span class="help-text">
                        Lower number appears first.
                    </span>

                </div>



                <!-- ICON -->

                <div class="form-group">

                    <label for="icon">

                        Section Icon

                    </label>


                    <select
                        id="icon"
                        name="icon"
                        class="form-control"
                    >

                        <option value="fas fa-graduation-cap">
                            Graduation Cap
                        </option>

                        <option value="fas fa-child">
                            Child
                        </option>

                        <option value="fas fa-school">
                            School
                        </option>

                        <option value="fas fa-book">
                            Book
                        </option>

                        <option value="fas fa-user-graduate">
                            Student
                        </option>

                        <option value="fas fa-flask">
                            Science
                        </option>

                    </select>

                </div>



                <!-- PUBLISHED -->

                <div class="form-group full">

                    <label>
                        Website Visibility
                    </label>


                    <div class="checkbox-wrapper">

                        <input
                            type="checkbox"
                            id="published"
                            name="published"
                            value="true"
                            checked
                        >


                        <label for="published">

                            Publish this fee structure on the public website

                        </label>

                    </div>

                </div>


            </div>

        </section>



        <!-- =================================================
             FEE ITEMS
        ================================================== -->

        <section class="form-section">


            <div class="section-heading">


                <div class="section-heading-icon">

                    <i class="fas fa-list-check"></i>

                </div>


                <div>

                    <h2>
                        Fee Items
                    </h2>

                    <p>
                        Add individual fees such as tuition, admission, transport etc.
                    </p>

                </div>


            </div>



            <div
                id="feeList"
                class="fee-list"
            >


                <!-- =========================================
                     FIRST FEE ROW
                ========================================== -->

                <div class="fee-item">


                    <div class="form-group">

                        <label>
                            Fee Name
                        </label>


                        <input
                            type="text"
                            name="fees[0][name]"
                            class="form-control fee-name-input"
                            placeholder="Tuition Fee"
                            maxlength="100"
                            required
                        >

                    </div>



                    <div class="form-group">

                        <label>
                            Amount (₹)
                        </label>


                        <input
                            type="number"
                            name="fees[0][amount]"
                            class="form-control fee-amount-input"
                            placeholder="25000"
                            min="0"
                            step="1"
                            required
                        >

                    </div>



                    <button
                        type="button"
                        class="remove-fee"
                        title="Remove fee"
                    >

                        <i class="fas fa-trash"></i>

                    </button>


                </div>


            </div>



            <!-- ADD ROW -->

            <button
                type="button"
                class="add-fee-btn"
                id="addFeeBtn"
            >

                <i class="fas fa-plus"></i>

                Add Another Fee

            </button>



            <!-- TOTAL -->

            <div class="total-box">


                <span>

                    Calculated Annual Total

                </span>


                <strong>

                    ₹
                    <span id="calculatedTotal">
                        0
                    </span>

                </strong>


            </div>


        </section>



        <!-- =================================================
             ANNUAL APPROX + NOTES
        ================================================== -->

        <section class="form-section">


            <div class="section-heading">


                <div class="section-heading-icon">

                    <i class="fas fa-calculator"></i>

                </div>


                <div>

                    <h2>
                        Additional Information
                    </h2>

                    <p>
                        Add annual amount and any important notes.
                    </p>

                </div>


            </div>



            <div class="form-grid">


                <!-- ANNUAL APPROX -->

                <div class="form-group">

                    <label for="annualApprox">

                        Annual Approx. (₹)

                        <span class="required">
                            *
                        </span>

                    </label>


                    <input
                        type="number"
                        id="annualApprox"
                        name="annualApprox"
                        class="form-control"
                        min="0"
                        step="1"
                        placeholder="50000"
                        required
                    >


                    <span class="help-text">
                        You can use the calculated total above or enter your own amount.
                    </span>

                </div>



                <!-- NOTES -->

                <div class="form-group">

                    <label for="notes">

                        Notes

                    </label>


                    <textarea
                        id="notes"
                        name="notes"
                        class="form-control"
                        maxlength="500"
                        placeholder="Transport charges may vary according to route..."
                    ></textarea>

                </div>


            </div>

        </section>



        <!-- =================================================
             FOOTER
        ================================================== -->

        <div class="form-footer">


            <a
                href="/admin/fees"
                class="btn btn-cancel"
            >

                <i class="fas fa-xmark"></i>

                Cancel

            </a>


            <button
                type="submit"
                class="btn btn-save"
            >

                <i class="fas fa-floppy-disk"></i>

                Save Fee Structure

            </button>


        </div>


    </form>


</div>

</div>



<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
    'DOMContentLoaded',
    function () {


        const feeList =
            document.getElementById(
                'feeList'
            );


        const addFeeBtn =
            document.getElementById(
                'addFeeBtn'
            );


        const totalElement =
            document.getElementById(
                'calculatedTotal'
            );


        const annualInput =
            document.getElementById(
                'annualApprox'
            );


        let feeIndex = 1;



        // =====================================================
        // FORMAT NUMBER
        // =====================================================

        function formatNumber(number) {

            return Number(
                number || 0
            ).toLocaleString(
                'en-IN'
            );

        }



        // =====================================================
        // CALCULATE TOTAL
        // =====================================================

        function calculateTotal() {


            const amountInputs =
                document.querySelectorAll(
                    '.fee-amount-input'
                );


            let total = 0;


            amountInputs.forEach(
                function (input) {

                    const value =
                        parseFloat(
                            input.value
                        ) || 0;


                    total += value;

                }
            );


            totalElement.textContent =
                formatNumber(
                    total
                );


        }



        // =====================================================
        // CREATE FEE ROW
        // =====================================================

        function createFeeRow(index) {


            const row =
                document.createElement(
                    'div'
                );


            row.className =
                'fee-item';


            row.innerHTML = `

                <div class="form-group">

                    <label>
                        Fee Name
                    </label>

                    <input
                        type="text"
                        name="fees[${index}][name]"
                        class="form-control fee-name-input"
                        placeholder="Transport Fee"
                        maxlength="100"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Amount (₹)
                    </label>

                    <input
                        type="number"
                        name="fees[${index}][amount]"
                        class="form-control fee-amount-input"
                        placeholder="10000"
                        min="0"
                        step="1"
                        required
                    >

                </div>


                <button
                    type="button"
                    class="remove-fee"
                    title="Remove fee"
                >

                    <i class="fas fa-trash"></i>

                </button>

            `;


            feeList.appendChild(
                row
            );


            attachRowEvents(
                row
            );


        }



        // =====================================================
        // ATTACH ROW EVENTS
        // =====================================================

        function attachRowEvents(row) {


            const amountInput =
                row.querySelector(
                    '.fee-amount-input'
                );


            const removeBtn =
                row.querySelector(
                    '.remove-fee'
                );


            if (amountInput) {

                amountInput.addEventListener(
                    'input',
                    calculateTotal
                );

            }


            if (removeBtn) {

                removeBtn.addEventListener(
                    'click',
                    function () {


                        const rows =
                            feeList.querySelectorAll(
                                '.fee-item'
                            );


                        if (
                            rows.length <= 1
                        ) {

                            alert(
                                'At least one fee item is required.'
                            );

                            return;

                        }


                        row.remove();


                        calculateTotal();

                    }
                );

            }

        }



        // =====================================================
        // ADD FEE
        // =====================================================

        addFeeBtn.addEventListener(
            'click',
            function () {


                createFeeRow(
                    feeIndex
                );


                feeIndex++;


                const rows =
                    feeList.querySelectorAll(
                        '.fee-item'
                    );


                const lastRow =
                    rows[
                        rows.length - 1
                    ];


                if (lastRow) {

                    const nameInput =
                        lastRow.querySelector(
                            '.fee-name-input'
                        );


                    if (nameInput) {

                        nameInput.focus();

                    }

                }

            }
        );



        // =====================================================
        // INITIAL ROW
        // =====================================================

        const firstRow =
            feeList.querySelector(
                '.fee-item'
            );


        if (firstRow) {

            attachRowEvents(
                firstRow
            );

        }



        // =====================================================
        // AUTO UPDATE ANNUAL APPROX
        // =====================================================

        feeList.addEventListener(
            'input',
            function () {

                calculateTotal();

            }
        );



        // =====================================================
        // FORM VALIDATION
        // =====================================================

        const form =
            document.getElementById(
                'feeForm'
            );


        form.addEventListener(
            'submit',
            function (event) {


                const names =
                    document.querySelectorAll(
                        '.fee-name-input'
                    );


                const amounts =
                    document.querySelectorAll(
                        '.fee-amount-input'
                    );


                if (
                    names.length === 0
                ) {

                    event.preventDefault();

                    alert(
                        'Please add at least one fee item.'
                    );

                    return;

                }


                let valid = true;


                amounts.forEach(
                    function (input) {

                        const amount =
                            parseFloat(
                                input.value
                            );


                        if (
                            Number.isNaN(
                                amount
                            ) ||
                            amount < 0
                        ) {

                            valid = false;

                        }

                    }
                );


                if (!valid) {

                    event.preventDefault();

                    alert(
                        'Please enter valid fee amounts.'
                    );

                }

            }
        );



        // =====================================================
        // INITIAL CALCULATION
        // =====================================================

        calculateTotal();

    }
);

</script>


</body>

</html>