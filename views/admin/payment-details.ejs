/*
  Gyan Jyoti — Premium Payment Details
  File: views/admin/payment-details.ejs

  Backend contract:
  res.render('admin/payment-details', { payment });

  This view is intentionally defensive so older payment records
  with missing fields do not crash the EJS page.
*/

const p = payment || {};

const applicantName =
  p.applicantName || p.studentName || p.name || 'Unknown Applicant';

const applicantPhone =
  p.phone || p.mobile || p.contact || '';

const applicantEmail =
  p.email || p.parentEmail || '';

const amount =
  Number(p.amount ?? p.totalAmount ?? 0);

const currency =
  p.currency || 'INR';

const paymentType =
  p.type || p.paymentType || 'enquiry';

const paymentMethod =
  p.method || p.paymentMethod || 'online';

const gateway =
  p.gateway || p.provider || p.gatewayName || 'demo';

const transactionId =
  p.transactionId || p.orderId || p.transaction || '';

const paymentId =
  String(p.paymentId || p._id || '');

const status =
  String(p.status || 'pending').toLowerCase();

const createdAt =
  p.createdAt ? new Date(p.createdAt) : null;

const updatedAt =
  p.updatedAt ? new Date(p.updatedAt) : null;

const failureReason =
  p.failureReason || p.errorMessage || p.error || '';

const description =
  p.description || p.note || 'No additional description provided.';

const statusLabel =
  status.charAt(0).toUpperCase() + status.slice(1);

const statusTone =
  ['paid','success','successful','completed'].includes(status)
    ? 'success'
    : ['failed','failure','cancelled','canceled'].includes(status)
      ? 'danger'
      : status === 'refunded'
        ? 'purple'
        : 'warning';

const formatDate = (date) => {
  if (!date || Number.isNaN(date.getTime())) return '—';
  return date.toLocaleDateString('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric'
  });
};

const formatDateTime = (date) => {
  if (!date || Number.isNaN(date.getTime())) return '—';
  return date.toLocaleString('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
};

const formatAmount = (value) => {
  try {
    return new Intl.NumberFormat('en-IN', {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2
    }).format(value);
  } catch (_) {
    return String(value);
  }
};

const safe = (value) =>
  String(value || '')
    .replace(/\\/g, '\\\\')
    .replace(/'/g, "\\'");

const safePaymentId = safe(paymentId);
const safeTransactionId = safe(transactionId);
