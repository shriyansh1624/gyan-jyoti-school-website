  font-size:12px;
  font-weight:900;
  transform:translateY(25px);
  opacity:0;
  pointer-events:none;
  transition:.3s ease;
}

.toast.show{
  transform:translateY(0);
  opacity:1;
}

.toast-icon{
  width:25px;
  height:25px;
  display:grid;
  place-items:center;
  border-radius:8px;
  color:#07223e;
  background:#72d9b6;
}

/* ========================= ENTRANCE MOTION ========================= */

.reveal{
  opacity:0;
  transform:translateY(14px);
  animation:reveal .6s cubic-bezier(.2,.8,.2,1) forwards;
}

.reveal:nth-child(2){animation-delay:.05s}
.reveal:nth-child(3){animation-delay:.1s}
.reveal:nth-child(4){animation-delay:.15s}

@keyframes reveal{
  to{opacity:1;transform:none}
}

/* ========================= RESPONSIVE ========================= */

@media(max-width:1050px){
  .content{grid-template-columns:1fr}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .hero{min-height:280px}
  .hero-actions{position:static;margin-top:24px}
}

@media(max-width:700px){
  .shell{width:min(100% - 22px,1540px);padding-top:11px}
  .topnav{min-height:58px}
  .brand-sub{display:none}
  .top-btn{padding:0 11px;font-size:11px}
  .hero{padding:25px 22px;border-radius:23px;min-height:320px}
  .hero h1{font-size:40px}
  .hero-actions{gap:8px}
  .hero-btn{flex:1}
  .statusbar{align-items:flex-start;flex-direction:column}
  .status-pill{align-self:flex-start}
  .kpis{grid-template-columns:1fr}
  .info-grid{grid-template-columns:1fr}
  .info:nth-child(odd){border-right:0}
  .info{min-height:80px;padding:16px 20px}
  .card-head{padding:20px}
  .description,.failure{margin-left:20px;margin-right:20px}
  .amount-card{min-height:245px}
}

@media print{
  body{background:#fff!important}
  body:before,.topnav,.hero-actions,.action,.toast{display:none!important}
  .shell{width:100%;padding:0}
  .hero,.card,.statusbar,.amount-card{box-shadow:none!important;break-inside:avoid}
  .hero{border-radius:0}
  .content{grid-template-columns:1fr}
  .amount-card{color:#000;background:#fff!important;border:1px solid #ddd}
  .amount-card:before,.amount-card:after{display:none}
}
</style>
</head>

<body>

<div class="shell">

  <!-- TOP NAV -->
  <header class="topnav reveal">
    <a href="/admin" class="brand">
      <div class="brand-logo">🏫</div>
      <div>
        <div class="brand-name">Gyan Jyoti</div>
        <div class="brand-sub">SCHOOL ADMINISTRATION</div>
      </div>
    </a>

    <div class="top-actions">
      <a href="/admin/payments" class="top-btn">← Payments</a>
      <a href="/admin" class="top-btn"><span style="color:#1769ff">●</span> Admin</a>
    </div>
  </header>


  <!-- HERO -->
  <section class="hero reveal">

    <div class="hero-content">

      <div class="eyebrow">
        <span class="eyebrow-dot"></span>
        Secure Finance Console
      </div>

      <h1>Payment Details</h1>

      <p class="hero-copy">
        A complete financial snapshot of this payment record —
        applicant identity, collection amount, gateway information,
        transaction identifiers, status history and administrative actions.
      </p>

      <div class="hero-actions">
        <a href="/admin/payments" class="hero-btn">← Dashboard</a>
        <button type="button" class="hero-btn primary" onclick="window.print()">
          ▣ Print Report
        </button>
      </div>

    </div>
  </section>


  <!-- STATUS -->
  <section class="statusbar reveal">

    <div class="status-main">

      <div class="status-icon <%= statusTone %>">
        <% if (statusTone === 'success') { %>✓
        <% } else if (statusTone === 'danger') { %>!
        <% } else if (statusTone === 'purple') { %>↻
        <% } else { %>!
        <% } %>
      </div>

      <div>
        <div class="status-title">Payment <%= statusLabel %></div>
        <div class="status-sub">
          <%= paymentType %> • Created <%= formatDateTime(createdAt) %>
        </div>
      </div>

    </div>

    <span class="status-pill <%= statusTone %>">
      <span class="status-dot"></span>
      <%= statusLabel %>
    </span>

  </section>


  <!-- KPI STRIP -->
  <section class="kpis">

    <div class="kpi reveal">
      <div class="kpi-label">Collection</div>
      <div class="kpi-value">₹<%= formatAmount(amount) %></div>
    </div>

    <div class="kpi reveal">
      <div class="kpi-label">Payment Type</div>
      <div class="kpi-value"><%= paymentType %></div>
    </div>

    <div class="kpi reveal">
      <div class="kpi-label">Provider</div>
      <div class="kpi-value"><%= gateway %></div>
    </div>

    <div class="kpi reveal">
      <div class="kpi-label">Received</div>
      <div class="kpi-value"><%= formatDate(createdAt) %></div>
    </div>

  </section>


  <!-- CONTENT -->
  <section class="content">

    <!-- LEFT COLUMN -->
    <div class="column">

      <!-- TRANSACTION CARD -->
      <article class="card reveal">

        <div class="card-head">
          <h2 class="card-title">Transaction Information</h2>
          <p class="card-subtitle">
            Core payment, gateway and transaction information.
          </p>
        </div>

        <div class="info-grid">

          <div class="info">
            <div class="label">Amount</div>
            <div class="value amount">₹<%= formatAmount(amount) %></div>
          </div>

          <div class="info">
            <div class="label">Currency</div>
            <div class="value"><%= currency %></div>
          </div>

          <div class="info">
            <div class="label">Payment Type</div>
            <div class="value"><%= paymentType %></div>
          </div>

          <div class="info">
            <div class="label">Payment Method</div>
            <div class="value"><%= paymentMethod %></div>
          </div>

          <div class="info">
            <div class="label">Gateway / Provider</div>
            <div class="value"><%= gateway %></div>
          </div>

          <div class="info">
            <div class="label">Transaction / Order ID</div>

            <% if (transactionId) { %>
              <div class="copy-line">
                <span class="value mono"><%= transactionId %></span>
                <button
                  type="button"
                  class="copy-btn"
                  title="Copy transaction ID"
                  data-copy="<%= safeTransactionId %>">⧉</button>
              </div>
            <% } else { %>
              <div class="value">Not available</div>
            <% } %>
          </div>

          <div class="info">
            <div class="label">Payment ID</div>

            <% if (paymentId) { %>
              <div class="copy-line">
                <span class="value mono"><%= paymentId %></span>
                <button
                  type="button"
                  class="copy-btn"
                  title="Copy payment ID"
                  data-copy="<%= safePaymentId %>">⧉</button>
              </div>
            <% } else { %>
              <div class="value">Not available</div>
            <% } %>
          </div>

          <div class="info">
            <div class="label">Last Updated</div>
            <div class="value"><%= formatDateTime(updatedAt || createdAt) %></div>
          </div>

        </div>

        <div class="description">
          <div class="label">Description</div>
          <div style="margin-top:7px"><%= description %></div>
        </div>

        <% if (failureReason) { %>
          <div class="failure">
            <div class="failure-title">⚠ Payment Failure Reason</div>
            <div class="failure-text"><%= failureReason %></div>
          </div>
        <% } %>

      </article>


      <!-- APPLICANT CARD -->
      <article class="card reveal">

        <div class="applicant-top">

          <div class="avatar">
            <%= applicantName.charAt(0).toUpperCase() %>
          </div>

          <div>
            <div class="applicant-name"><%= applicantName %></div>
            <div class="applicant-meta">
              Applicant associated with this payment record
            </div>
          </div>

        </div>

        <div class="info-grid">

          <div class="info">
            <div class="label">Applicant</div>
            <div class="value"><%= applicantName %></div>
          </div>

          <div class="info">
            <div class="label">Phone</div>
            <div class="value">
              <% if (applicantPhone) { %>
                <a href="tel:<%= applicantPhone %>"><%= applicantPhone %></a>
              <% } else { %>
                Not provided
              <% } %>
            </div>
          </div>

          <div class="info">
            <div class="label">Email</div>
            <div class="value">
              <% if (applicantEmail) { %>
                <a href="mailto:<%= applicantEmail %>"><%= applicantEmail %></a>
              <% } else { %>
                Not provided
              <% } %>
            </div>
          </div>

          <div class="info">
            <div class="label">Record Updated</div>
            <div class="value"><%= formatDateTime(updatedAt || createdAt) %></div>
          </div>

        </div>

      </article>

    </div>


    <!-- RIGHT COLUMN -->
    <aside class="column">

      <!-- AMOUNT CARD -->
      <article class="amount-card reveal">

        <div class="amount-content">

          <div class="amount-label">Payment Amount</div>

          <div class="amount">
            ₹<%= formatAmount(amount) %>
          </div>

          <div class="amount-meta">
            <%= currency %> • <%= paymentType %>
          </div>

          <div class="chips">
            <span class="chip">● <%= status %></span>
            <span class="chip"><%= gateway %></span>
            <span class="chip"><%= paymentMethod %></span>
          </div>

        </div>

      </article>


      <!-- TIMELINE -->
      <article class="card reveal">

        <div class="card-head">
          <h2 class="card-title">Payment Timeline</h2>
          <p class="card-subtitle">
            Important timestamps associated with this record.
          </p>
        </div>

        <div class="timeline">

          <div class="timeline-item">
            <div class="timeline-dot"></div>
            <div>
              <div class="timeline-title">Payment record created</div>
              <div class="timeline-date"><%= formatDateTime(createdAt) %></div>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-dot current"></div>
            <div>
              <div class="timeline-title">
                Current status: <%= statusLabel %>
              </div>
              <div class="timeline-date">
                <%= formatDateTime(updatedAt || createdAt) %>
              </div>
            </div>
          </div>

          <% if (failureReason) { %>
            <div class="timeline-item">
              <div class="timeline-dot red"></div>
              <div>
                <div class="timeline-title">Failure information recorded</div>
                <div class="timeline-date">Review the failure reason in the transaction card.</div>
              </div>
            </div>
          <% } %>

        </div>

      </article>


      <!-- QUICK ACTIONS -->
      <article class="card reveal">

        <div class="card-head">
          <h2 class="card-title">Quick Actions</h2>
          <p class="card-subtitle">
            Fast administrative controls for this payment.
          </p>
        </div>

        <div class="actions">

          <% if (paymentId) { %>
            <button
              type="button"
              class="action"
              data-copy="<%= safePaymentId %>">
              <span class="action-icon">⧉</span>
              Copy Payment ID
            </button>
          <% } %>

          <% if (transactionId) { %>
            <button
              type="button"
              class="action"
              data-copy="<%= safeTransactionId %>">
              <span class="action-icon">⌁</span>
              Copy Transaction ID
            </button>
          <% } %>

          <% if (applicantEmail) { %>
            <a class="action" href="mailto:<%= applicantEmail %>">
              <span class="action-icon">✉</span>
              Contact Applicant
            </a>
          <% } %>

          <% if (applicantPhone) { %>
            <a class="action" href="tel:<%= applicantPhone %>">
              <span class="action-icon">☎</span>
              Call Applicant
            </a>
          <% } %>

          <button type="button" class="action" onclick="window.print()">
            <span class="action-icon">▣</span>
            Print Payment Report
          </button>

          <a href="/admin/payments" class="action primary">
            <span class="action-icon">←</span>
            Back to Payments
          </a>

        </div>

      </article>

    </aside>

  </section>


  <footer class="footer">
    Gyan Jyoti School Administration • Secure Finance Console
  </footer>

</div>


<!-- TOAST -->
<div id="toast" class="toast">
  <span class="toast-icon">✓</span>
  <span id="toastText">Copied successfully.</span>
</div>


<script>
(function(){

  const toast = document.getElementById('toast');
  const toastText = document.getElementById('toastText');

  function showToast(message){
    toastText.textContent = message;
    toast.classList.add('show');

    clearTimeout(window.__gyanToastTimer);

    window.__gyanToastTimer = setTimeout(function(){
      toast.classList.remove('show');
    },2200);
  }

  async function copyText(value){
    try{
      await navigator.clipboard.writeText(String(value));
      showToast('Copied to clipboard.');
      return;
    }catch(e){}

    try{
      const textarea = document.createElement('textarea');
      textarea.value = String(value);
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
      showToast('Copied to clipboard.');
    }catch(e){
      showToast('Copy failed. Please copy it manually.');
    }
  }

  document.querySelectorAll('[data-copy]').forEach(function(button){

    button.addEventListener('click',function(){

      const value = this.getAttribute('data-copy') || '';

      copyText(value);

      const old = this.innerHTML;

      if(this.classList.contains('copy-btn')){
        this.classList.add('copied');
        this.innerHTML = '✓';

        setTimeout(function(){
          button.classList.remove('copied');
          button.innerHTML = old;
        },1500);
      }

    });

  });

})();
</script>

</body>
</html>
