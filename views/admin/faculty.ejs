<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= title || 'Faculty Management' %>
    </title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <style>

        /* =====================================================
           RESET
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Inter,
                "Segoe UI",
                Arial,
                sans-serif;

            background: #eef3f9;

            color: #172033;

            min-height: 100vh;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
           VARIABLES
        ===================================================== */

        :root {

            --navy: #001f3f;
            --navy2: #003b73;
            --blue: #0066c0;
            --gold: #ffc300;
            --white: #ffffff;
            --text: #172033;
            --muted: #64748b;
            --border: #e2e8f0;
            --bg: #eef3f9;
            --green: #16a34a;
            --red: #dc2626;
            --purple: #7c3aed;

            --shadow:
                0 18px 50px rgba(0,31,63,.09);

        }


        /* =====================================================
           PAGE
        ===================================================== */

        .page {

            width: 100%;

            min-height: 100vh;

            padding: 30px;

        }


        .container {

            max-width: 1500px;

            margin: auto;

        }


        /* =====================================================
           TOP BAR
        ===================================================== */

        .topbar {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 25px;

        }


        .back-btn,
        .dashboard-btn {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 9px;

            padding: 12px 17px;

            border-radius: 13px;

            font-size: 13px;

            font-weight: 850;

            transition: .25s;

        }


        .back-btn {

            color: var(--navy);

            background: #fff;

            border: 1px solid var(--border);

            box-shadow:
                0 8px 25px rgba(0,0,0,.05);

        }


        .back-btn:hover {

            transform: translateY(-2px);

            border-color: var(--gold);

        }


        .top-right {

            display: flex;

            align-items: center;

            gap: 10px;

        }


        .dashboard-btn {

            background: var(--navy);

            color: #fff;

        }


        .dashboard-btn:hover {

            transform: translateY(-2px);

            background: var(--gold);

            color: var(--navy);

        }


        /* =====================================================
           HERO
        ===================================================== */

        .hero {

            position: relative;

            overflow: hidden;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 30px;

            padding: 38px;

            min-height: 230px;

            margin-bottom: 25px;

            border-radius: 30px;

            color: #fff;

            background:

                radial-gradient(
                    circle at 85% 15%,
                    rgba(255,195,0,.32),
                    transparent 25%
                ),

                radial-gradient(
                    circle at 10% 100%,
                    rgba(0,128,255,.25),
                    transparent 30%
                ),

                linear-gradient(
                    135deg,
                    #00172f,
                    #003b73 55%,
                    #0053a6
                );

            box-shadow:
                0 25px 65px rgba(0,31,63,.25);

        }


        .hero::before {

            content: "";

            position: absolute;

            width: 330px;

            height: 330px;

            right: -100px;

            top: -150px;

            border-radius: 50%;

            border: 1px solid rgba(255,255,255,.12);

            box-shadow:
                0 0 0 35px rgba(255,255,255,.025),
                0 0 0 70px rgba(255,255,255,.02);

        }


        .hero::after {

            content: "";

            position: absolute;

            inset: 0;

            opacity: .08;

            background-image:
                radial-gradient(
                    #fff 1px,
                    transparent 1px
                );

            background-size: 28px 28px;

            pointer-events: none;

        }


        .hero-content {

            position: relative;

            z-index: 2;

            max-width: 850px;

        }


        .hero-badge {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding: 8px 13px;

            margin-bottom: 14px;

            border-radius: 999px;

            color: var(--gold);

            background:
                rgba(255,195,0,.10);

            border:
                1px solid rgba(255,195,0,.38);

            font-size: 10px;

            font-weight: 950;

            letter-spacing: 1.5px;

            text-transform: uppercase;

        }


        .hero h1 {

            font-size:
                clamp(34px,4vw,55px);

            line-height: 1;

            font-weight: 950;

            letter-spacing: -1.5px;

        }


        .hero h1 span {

            color: var(--gold);

        }


        .hero p {

            max-width: 720px;

            margin-top: 14px;

            color:
                rgba(255,255,255,.78);

            line-height: 1.7;

            font-size: 14px;

        }


        .hero-icon {

            position: relative;

            z-index: 2;

            width: 105px;

            height: 105px;

            display: flex;

            align-items: center;

            justify-content: center;

            flex: none;

            border-radius: 30px;

            color: var(--gold);

            background:
                rgba(255,255,255,.08);

            border:
                1px solid rgba(255,255,255,.18);

            backdrop-filter: blur(15px);

            box-shadow:
                0 20px 45px rgba(0,0,0,.18);

            font-size: 42px;

        }


        /* =====================================================
           STATISTICS
        ===================================================== */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 16px;

            margin-bottom: 25px;

        }


        .stat {

            position: relative;

            overflow: hidden;

            padding: 21px;

            border: 1px solid var(--border);

            border-radius: 21px;

            background: #fff;

            box-shadow: var(--shadow);

            transition: .3s;

        }


        .stat:hover {

            transform:
                translateY(-5px);

        }


        .stat::before {

            content: "";

            position: absolute;

            left: 0;

            top: 0;

            width: 100%;

            height: 4px;

            background:
                linear-gradient(
                    90deg,
                    var(--gold),
                    #ffe37c
                );

        }


        .stat-icon {

            width: 43px;

            height: 43px;

            display: flex;

            align-items: center;

            justify-content: center;

            margin-bottom: 13px;

            border-radius: 13px;

            color: var(--navy);

            background: #fff5c9;

        }


        .stat h3 {

            color: var(--navy);

            font-size: 29px;

            font-weight: 950;

        }


        .stat p {

            margin-top: 5px;

            color: var(--muted);

            font-size: 11px;

            font-weight: 800;

        }


        /* =====================================================
           MANAGEMENT GRID
        ===================================================== */

        .management-grid {

            display: grid;

            grid-template-columns:
                minmax(350px,430px)
                1fr;

            gap: 22px;

            align-items: start;

        }


        /* =====================================================
           FORM CARD
        ===================================================== */

        .form-card {

            position: sticky;

            top: 20px;

            overflow: hidden;

            border: 1px solid var(--border);

            border-radius: 25px;

            background: #fff;

            box-shadow: var(--shadow);

        }


        .form-header {

            display: flex;

            align-items: center;

            gap: 13px;

            padding: 20px;

            color: #fff;

            background:
                linear-gradient(
                    135deg,
                    var(--navy),
                    var(--navy2)
                );

        }


        .form-header-icon {

            width: 44px;

            height: 44px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 13px;

            color: var(--navy);

            background: var(--gold);

        }


        .form-header h2 {

            color: #fff;

            font-size: 18px;

            font-weight: 950;

        }


        .form-header p {

            margin-top: 3px;

            color: #ffffffaa;

            font-size: 10px;

        }


        .form-body {

            padding: 21px;

        }


        /* =====================================================
           FORM
        ===================================================== */

        .field {

            margin-bottom: 15px;

        }


        .field label {

            display: flex;

            align-items: center;

            gap: 6px;

            margin-bottom: 7px;

            color: #334155;

            font-size: 11px;

            font-weight: 900;

        }


        .field label i {

            color: var(--blue);

            font-size: 10px;

        }


        .field input,
        .field select,
        .field textarea {

            width: 100%;

            border: 1px solid #dbe2ea;

            outline: none;

            border-radius: 12px;

            background: #f8fafc;

            color: var(--text);

            transition: .2s;

        }


        .field input,
        .field select {

            height: 46px;

            padding: 0 13px;

        }


        .field textarea {

            min-height: 88px;

            padding: 12px 13px;

            resize: vertical;

            line-height: 1.5;

        }


        .field input:focus,
        .field select:focus,
        .field textarea:focus {

            border-color: var(--gold);

            background: #fff;

            box-shadow:
                0 0 0 4px
                rgba(255,195,0,.13);

        }


        .field-help {

            display: block;

            margin-top: 5px;

            color: #94a3b8;

            font-size: 9px;

        }


        .two-columns {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 10px;

        }


        /* =====================================================
           WHATSAPP
        ===================================================== */

        .whatsapp-input {

            position: relative;

        }


        .whatsapp-input input {

            padding-left: 40px;

        }


        .whatsapp-input > i {

            position: absolute;

            left: 14px;

            bottom: 15px;

            color: #16a34a;

            font-size: 16px;

        }


        .whatsapp-help {

            color: #16a34a;

        }


        /* =====================================================
           IMAGE UPLOAD
        ===================================================== */

        .image-upload {

            position: relative;

            padding: 16px;

            border: 1px dashed #cbd5e1;

            border-radius: 15px;

            background: #f8fafc;

        }


        .image-upload input {

            height: auto;

            padding: 10px;

            background: #fff;

        }


        .image-preview {

            display: none;

            overflow: hidden;

            height: 150px;

            margin-top: 10px;

            border-radius: 14px;

            background: #e2e8f0;

            border: 1px solid var(--border);

        }


        .image-preview img {

            width: 100%;

            height: 100%;

            object-fit: cover;

        }


        /* =====================================================
           SUBMIT
        ===================================================== */

        .submit-btn {

            width: 100%;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 9px;

            height: 50px;

            margin-top: 5px;

            border: 0;

            border-radius: 14px;

            color: var(--navy);

            background:
                linear-gradient(
                    135deg,
                    var(--gold),
                    #ffdb54
                );

            font-weight: 950;

            box-shadow:
                0 12px 30px
                rgba(255,195,0,.25);

            transition: .25s;

        }


        .submit-btn:hover {

            transform:
                translateY(-3px);

            box-shadow:
                0 18px 35px
                rgba(255,195,0,.35);

        }


        .submit-btn:disabled {

            opacity: .7;

            cursor: wait;

            transform: none;

        }


        /* =====================================================
           LIST
        ===================================================== */

        .list-card {

            min-width: 0;

            overflow: hidden;

            border: 1px solid var(--border);

            border-radius: 25px;

            background: #fff;

            box-shadow: var(--shadow);

        }


        .list-header {

            padding: 20px;

            border-bottom:
                1px solid var(--border);

        }


        .list-title-row {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            margin-bottom: 16px;

        }


        .list-title h2 {

            color: var(--navy);

            font-size: 20px;

            font-weight: 950;

        }


        .list-title p {

            margin-top: 4px;

            color: var(--muted);

            font-size: 10px;

        }


        .result-count {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 36px;

            height: 32px;

            padding: 0 10px;

            border-radius: 99px;

            color: var(--navy);

            background: var(--gold);

            font-size: 11px;

            font-weight: 950;

        }


        /* =====================================================
           FILTERS
        ===================================================== */

        .filters {

            display: grid;

            grid-template-columns:
                1.5fr 1fr 1fr;

            gap: 9px;

        }


        .filter {

            height: 42px;

            padding: 0 12px;

            border: 1px solid var(--border);

            border-radius: 11px;

            outline: none;

            background: #f8fafc;

            color: #334155;

            font-size: 11px;

            font-weight: 700;

        }


        .filter:focus {

            border-color: var(--gold);

        }


        /* =====================================================
           FACULTY GRID
        ===================================================== */

        .faculty-grid {

            display: grid;

            grid-template-columns:
                repeat(2,minmax(0,1fr));

            gap: 14px;

            padding: 20px;

        }


        .faculty-card {

            position: relative;

            overflow: hidden;

            display: flex;

            gap: 14px;

            min-width: 0;

            padding: 15px;

            border: 1px solid #e5eaf1;

            border-radius: 19px;

            background:
                linear-gradient(
                    135deg,
                    #fff,
                    #f8fbff
                );

            transition: .3s;

        }


        .faculty-card:hover {

            transform:
                translateY(-5px);

            border-color:
                #ffc30066;

            box-shadow:
                0 15px 35px
                rgba(0,31,63,.09);

        }


        /* =====================================================
           IMAGE
        ===================================================== */

        .faculty-image {

            position: relative;

            width: 92px;

            height: 112px;

            flex: none;

            overflow: hidden;

            border-radius: 15px;

            background: #e8eef5;

        }


        .faculty-image img {

            width: 100%;

            height: 100%;

            object-fit: cover;

            transition: .4s;

        }


        .faculty-card:hover
        .faculty-image img {

            transform: scale(1.06);

        }


        /* =====================================================
           DETAILS
        ===================================================== */

        .faculty-details {

            min-width: 0;

            flex: 1;

        }


        .faculty-name {

            color: var(--navy);

            font-size: 15px;

            font-weight: 950;

            white-space: nowrap;

            overflow: hidden;

            text-overflow: ellipsis;

            padding-right: 65px;

        }


        .faculty-role {

            display: inline-flex;

            margin-top: 5px;

            padding: 5px 8px;

            border-radius: 7px;

            color: #075985;

            background: #e0f2fe;

            font-size: 9px;

            font-weight: 900;

        }


        .faculty-meta {

            margin-top: 10px;

        }


        .meta-row {

            display: flex;

            gap: 6px;

            margin-bottom: 5px;

            color: #64748b;

            font-size: 9px;

            line-height: 1.4;

        }


        .meta-row i {

            width: 12px;

            color: var(--blue);

        }


        .meta-row.whatsapp {

            color: #15803d;

            font-weight: 800;

        }


        .meta-row.whatsapp i {

            color: #16a34a;

        }


        /* =====================================================
           CATEGORY BADGE
        ===================================================== */

        .category-badge {

            position: absolute;

            top: 10px;

            right: 10px;

            padding: 5px 8px;

            border-radius: 99px;

            font-size: 7px;

            font-weight: 950;

            letter-spacing: .3px;

            text-transform: uppercase;

        }


        .category-top {

            color: #92400e;

            background: #fef3c7;

        }


        .category-incharge {

            color: #3730a3;

            background: #e0e7ff;

        }


        .category-library {

            color: #166534;

            background: #dcfce7;

        }


        /* =====================================================
           QUALITIES
        ===================================================== */

        .qualities {

            display: flex;

            flex-wrap: wrap;

            gap: 5px;

            margin-top: 9px;

        }


        .quality {

            padding: 4px 7px;

            border-radius: 6px;

            color: #166534;

            background: #dcfce7;

            font-size: 8px;

            font-weight: 850;

        }


        /* =====================================================
           ACTIONS
        ===================================================== */

        .faculty-actions {

            display: flex;

            align-items: center;

            gap: 6px;

            margin-top: 12px;

        }


        .action {

            width: 32px;

            height: 32px;

            display: flex;

            align-items: center;

            justify-content: center;

            border: 0;

            border-radius: 9px;

            color: #fff;

            transition: .2s;

        }


        .action:hover {

            transform:
                translateY(-2px);

        }


        .edit {

            background: #2563eb;

        }


        .delete {

            background: var(--red);

        }


        .whatsapp-btn {

            background: #16a34a;

        }


        .whatsapp-btn.disabled {

            background: #cbd5e1;

            color: #64748b;

            cursor: not-allowed;

        }


        .priority {

            display: flex;

            align-items: center;

            gap: 5px;

            margin-left: auto;

            color: #64748b;

            font-size: 8px;

            font-weight: 800;

        }


        /* =====================================================
           EMPTY
        ===================================================== */

        .empty {

            grid-column: 1/-1;

            padding: 70px 20px;

            text-align: center;

            color: var(--muted);

        }


        .empty i {

            display: block;

            margin-bottom: 13px;

            color: #cbd5e1;

            font-size: 45px;

        }


        .empty strong {

            display: block;

            color: #475569;

            font-size: 16px;

        }


        .empty span {

            display: block;

            margin-top: 5px;

            font-size: 11px;

        }


        /* =====================================================
           TOAST
        ===================================================== */

        .toast {

            position: fixed;

            right: 25px;

            bottom: 25px;

            z-index: 1000000;

            display: none;

            align-items: center;

            gap: 10px;

            padding: 14px 18px;

            border-radius: 13px;

            color: #fff;

            background: var(--navy);

            box-shadow:
                0 15px 40px rgba(0,0,0,.2);

            font-size: 12px;

            font-weight: 850;

        }


        .toast.show {

            display: flex;

            animation:
                toastIn .3s ease;

        }


        @keyframes toastIn {

            from {

                opacity: 0;

                transform:
                    translateY(15px);

            }

            to {

                opacity: 1;

                transform:
                    translateY(0);

            }

        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media(max-width:1200px) {

            .management-grid {

                grid-template-columns:
                    350px 1fr;

            }

            .faculty-grid {

                grid-template-columns: 1fr;

            }

            .stats {

                grid-template-columns:
                    repeat(2,1fr);

            }

        }


        @media(max-width:900px) {

            .page {

                padding: 18px;

            }

            .hero {

                padding: 28px;

            }

            .hero-icon {

                display: none;

            }

            .management-grid {

                grid-template-columns: 1fr;

            }

            .form-card {

                position: relative;

                top: 0;

            }

        }


        @media(max-width:600px) {

            .topbar {

                align-items: stretch;

                flex-direction: column;

            }

            .top-right {

                width: 100%;

            }

            .dashboard-btn {

                flex: 1;

                justify-content: center;

            }

            .hero {

                border-radius: 22px;

            }

            .hero h1 {

                font-size: 32px;

            }

            .stats {

                grid-template-columns: 1fr;

            }

            .two-columns {

                grid-template-columns: 1fr;

            }

            .filters {

                grid-template-columns: 1fr;

            }

            .faculty-card {

                align-items: flex-start;

            }

            .faculty-image {

                width: 75px;

                height: 95px;

            }

        }


        /* =====================================================
           PREMIUM SEARCH / LIGHTWEIGHT PERFORMANCE
           Frontend-only: backend routes and EJS flow untouched.
        ===================================================== */

        .search-filter-wrap{position:relative;min-width:0;}
        .search-filter-wrap .search-filter{width:100%;padding-left:42px;padding-right:42px;}
        .search-filter-icon{
            position:absolute;left:15px;top:50%;z-index:2;
            transform:translateY(-50%);color:#64748b;
            pointer-events:none;font-size:12px;
        }
        .clear-search{
            position:absolute;right:8px;top:50%;z-index:3;
            width:28px;height:28px;display:grid;place-items:center;
            transform:translateY(-50%);border:0;border-radius:8px;
            background:transparent;color:#64748b;cursor:pointer;
        }
        .clear-search:hover{background:#eaf0f7;color:var(--navy);}
        .search-filter-wrap:focus-within .search-filter-icon{color:var(--blue);}
        .filter{min-width:0;transition:border-color .16s ease,box-shadow .16s ease,background-color .16s ease;}
        .filter:hover,.filter:focus{background:#fff;}
        .filter:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(255,195,0,.12);}
        .filtered-empty{grid-column:1/-1;width:100%;padding:58px 20px;}
        .filtered-empty[hidden]{display:none;}
        .faculty-card.is-hidden{display:none !important;}
        .action,.submit-btn,.back-btn,.dashboard-btn,.clear-search{
            -webkit-tap-highlight-color:transparent;touch-action:manipulation;
        }
        .faculty-card{contain:layout paint;}
        .faculty-card:hover{transform:translateY(-3px);}
        .faculty-card:hover .faculty-image img{transform:scale(1.035);}

        @media (prefers-reduced-motion:reduce){
            *,*::before,*::after{
                animation-duration:.001ms !important;
                animation-iteration-count:1 !important;
                transition-duration:.001ms !important;
                scroll-behavior:auto !important;
            }
        }

        @media (max-width:900px){
            .page{padding:16px;}
            .faculty-grid{grid-template-columns:1fr;}
        }

        @media (max-width:680px){
            .page{padding:12px;}
            .topbar{gap:10px;margin-bottom:14px;}
            .hero{min-height:190px;padding:24px;margin-bottom:14px;}
            .stats{gap:10px;margin-bottom:14px;}
            .stat{padding:17px;border-radius:17px;}
            .management-grid{gap:14px;}
            .form-card,.list-card{border-radius:18px;}
            .list-header{padding:16px;}
            .filters{grid-template-columns:1fr;gap:9px;}
            .filter{height:46px;font-size:12px;}
            .faculty-grid{padding:14px;gap:10px;}
            .faculty-card{gap:11px;padding:12px;border-radius:15px;}
            .faculty-image{width:72px;height:90px;border-radius:12px;}
            .faculty-name{font-size:14px;padding-right:72px;}
            .action{width:38px;height:38px;border-radius:10px;}
            .toast{left:12px;right:12px;bottom:12px;justify-content:center;}
        }

        @media (max-width:420px){
            .topbar{flex-direction:column;}
            .top-right{width:100%;}
            .dashboard-btn{width:100%;}
            .hero{padding:20px;}
            .stats{grid-template-columns:1fr 1fr;}
            .stat{padding:14px;}
            .stat h3{font-size:24px;}
            .faculty-card{display:grid;grid-template-columns:72px minmax(0,1fr);}
            .faculty-actions{grid-column:1/-1;width:100%;margin-top:4px;}
        }

    </style>

</head>


<body>


<div class="page">

<div class="container">


    <!-- =================================================
         TOP BAR
    ================================================== -->

    <div class="topbar">

        <a
            href="/admin/dashboard"
            class="back-btn"
        >

            <i class="fas fa-arrow-left"></i>

            Back to Dashboard

        </a>


        <div class="top-right">

            <a
                href="/admin/dashboard"
                class="dashboard-btn"
            >

                <i class="fas fa-chart-line"></i>

                Dashboard

            </a>

        </div>

    </div>


    <!-- =================================================
         HERO
    ================================================== -->

    <section class="hero">

        <div class="hero-content">

            <div class="hero-badge">

                <i class="fas fa-shield-halved"></i>

                Administration

            </div>


            <h1>

                Faculty

                <span>Management</span>

            </h1>


            <p>

                Manage your school's educators,
                top faculty, section incharges and
                academic staff from one professional
                workspace.

            </p>

        </div>


        <div class="hero-icon">

            <i class="fas fa-chalkboard-teacher"></i>

        </div>

    </section>


    <!-- =================================================
         STATISTICS
    ================================================== -->

    <div class="stats">


        <div class="stat">

            <div class="stat-icon">

                <i class="fas fa-users"></i>

            </div>

            <h3 id="totalCount">
                0
            </h3>

            <p>
                Total Faculty
            </p>

        </div>


        <div class="stat">

            <div class="stat-icon">

                <i class="fas fa-star"></i>

            </div>

            <h3 id="topCount">
                0
            </h3>

            <p>
                Top Faculty
            </p>

        </div>


        <div class="stat">

            <div class="stat-icon">

                <i class="fas fa-user-tie"></i>

            </div>

            <h3 id="inchargeCount">
                0
            </h3>

            <p>
                Section Incharges
            </p>

        </div>


        <div class="stat">

            <div class="stat-icon">

                <i class="fas fa-computer"></i>

            </div>

            <h3 id="libraryCount">
                0
            </h3>

            <p>
                Library &amp; Computing
            </p>

        </div>


    </div>


    <!-- =================================================
         MANAGEMENT
    ================================================== -->

    <div class="management-grid">


        <!-- =================================================
             ADD FACULTY
        ================================================== -->

        <section class="form-card">


            <div class="form-header">

                <div class="form-header-icon">

                    <i class="fas fa-user-plus"></i>

                </div>


                <div>

                    <h2>
                        Add New Faculty
                    </h2>

                    <p>
                        Create a new faculty profile
                    </p>

                </div>

            </div>


            <form
                class="form-body"
                method="POST"
                action="/admin/faculty/add"
                enctype="multipart/form-data"
                id="addFacultyForm"
            >


                <!-- NAME -->

                <div class="field">

                    <label>

                        <i class="fas fa-user"></i>

                        Faculty Name

                    </label>


                    <input
                        type="text"
                        name="name"
                        placeholder="e.g. Mrs. Priya Sharma"
                        maxlength="60"
                        required
                    >

                </div>


                <!-- ROLE -->

                <div class="field">

                    <label>

                        <i class="fas fa-id-badge"></i>

                        Role / Designation

                    </label>


                    <input
                        type="text"
                        name="role"
                        placeholder="e.g. Senior Mathematics Teacher"
                        maxlength="100"
                        required
                    >

                </div>


                <!-- CATEGORY -->

                <div class="field">

                    <label>

                        <i class="fas fa-layer-group"></i>

                        Category

                    </label>


                    <select
                        name="category"
                        id="category"
                        required
                    >

                        <option value="">
                            Select Category
                        </option>

                        <option value="top-faculty">
                            Top Faculty
                        </option>

                        <option value="incharge">
                            Section Incharge
                        </option>

                        <option value="library-computing">
                            Library &amp; Computing
                        </option>

                    </select>

                </div>


                <!-- SECTION -->

                <div class="field">

                    <label>

                        <i class="fas fa-school"></i>

                        Academic Section

                    </label>


                    <select
                        name="section"
                        required
                    >

                        <option value="general">
                            General
                        </option>

                        <option value="primary">
                            Primary
                        </option>

                        <option value="middle">
                            Middle
                        </option>

                        <option value="higher">
                            Higher / Higher Secondary
                        </option>

                    </select>

                </div>


                <!-- SPECIALIZATION -->

                <div class="field">

                    <label>

                        <i class="fas fa-book-open"></i>

                        Specialization

                    </label>


                    <input
                        type="text"
                        name="specialization"
                        placeholder="e.g. Mathematics & Science"
                        maxlength="150"
                    >

                </div>


                <!-- DEPARTMENT -->

                <div class="field">

                    <label>

                        <i class="fas fa-building"></i>

                        Department

                    </label>


                    <input
                        type="text"
                        name="department"
                        placeholder="e.g. Academic Department"
                        maxlength="150"
                    >

                </div>


                <!-- =================================================
                     WHATSAPP NUMBER
                ================================================== -->

                <div class="field whatsapp-input">

                    <label>

                        <i class="fab fa-whatsapp"></i>

                        WhatsApp Number

                    </label>


                    <i class="fab fa-whatsapp"></i>


                    <input
                        type="text"
                        name="whatsappNumber"
                        id="whatsappNumber"
                        placeholder="919876543210"
                        inputmode="numeric"
                        maxlength="15"
                        pattern="[0-9]{10,15}"
                    >


                    <span
                        class="field-help whatsapp-help"
                    >

                        Country code + number.
                        Example: 919876543210

                    </span>

                </div>


                <!-- =================================================
                     IMAGE
                ================================================== -->

                <div class="field">

                    <label>

                        <i class="fas fa-image"></i>

                        Faculty Image

                    </label>


                    <div class="image-upload">


                        <input
                            type="file"
                            name="image"
                            id="imageInput"
                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                        >


                        <span class="field-help">

                            JPG, JPEG, PNG or WEBP.
                            Maximum 5MB.

                        </span>


                        <div
                            class="image-preview"
                            id="imagePreview"
                        >

                            <img
                                id="previewImage"
                                src=""
                                alt="Faculty Preview"
                            >

                        </div>


                    </div>

                </div>


                <!-- PRIORITY + QUALITIES -->

                <div class="two-columns">


                    <div class="field">

                        <label>

                            <i class="fas fa-sort-numeric-down"></i>

                            Priority

                        </label>


                        <input
                            type="number"
                            name="priority"
                            value="0"
                            min="0"
                            max="9999"
                        >


                        <span class="field-help">

                            Lower number appears first.

                        </span>

                    </div>


                    <div class="field">

                        <label>

                            <i class="fas fa-award"></i>

                            Qualities

                        </label>


                        <input
                            type="text"
                            name="qualities"
                            placeholder="Leadership, Friendly..."
                        >


                        <span class="field-help">

                            Separate qualities with commas.

                        </span>

                    </div>


                </div>


                <!-- SUBMIT -->

                <button
                    type="submit"
                    class="submit-btn"
                >

                    <i class="fas fa-plus"></i>

                    Add Faculty Member

                </button>


            </form>

        </section>


        <!-- =================================================
             FACULTY DIRECTORY
        ================================================== -->

        <section class="list-card">


            <div class="list-header">


                <div class="list-title-row">


                    <div class="list-title">

                        <h2>

                            <i class="fas fa-users"></i>

                            Faculty Directory

                        </h2>


                        <p>

                            Search, filter and manage all
                            faculty members.

                        </p>

                    </div>


                    <span
                        class="result-count"
                        id="visibleCount"
                    >
                        0
                    </span>


                </div>


                <!-- FILTERS -->

                <div class="filters">


                    <div class="search-filter-wrap">
                        <i class="fas fa-magnifying-glass search-filter-icon" aria-hidden="true"></i>
                        <input
                            type="text"
                            id="searchInput"
                            class="filter search-filter"
                            placeholder="Search name, role, subject, department or WhatsApp..."
                            autocomplete="off"
                            spellcheck="false"
                            inputmode="search"
                            aria-label="Search faculty"
                        >
                        <button type="button" id="clearSearch" class="clear-search"
                                aria-label="Clear search" title="Clear search" hidden>
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>


                    <select
                        id="categoryFilter"
                        class="filter"
                    >

                        <option value="all">
                            All Categories
                        </option>

                        <option value="top-faculty">
                            Top Faculty
                        </option>

                        <option value="incharge">
                            Incharges
                        </option>

                        <option value="library-computing">
                            Library &amp; Computing
                        </option>

                    </select>


                    <select
                        id="sectionFilter"
                        class="filter"
                    >

                        <option value="all">
                            All Sections
                        </option>

                        <option value="primary">
                            Primary
                        </option>

                        <option value="middle">
                            Middle
                        </option>

                        <option value="higher">
                            Higher
                        </option>

                        <option value="general">
                            General
                        </option>

                    </select>


                </div>


            </div>


            <!-- =================================================
                 FACULTY GRID
            ================================================== -->

            <div
                class="faculty-grid"
                id="facultyGrid"
            >
                <div class="empty filtered-empty" id="filteredEmpty" hidden>
                    <i class="fas fa-magnifying-glass"></i>
                    <strong>No matching faculty found</strong>
                    <span>Try another name, role, subject, department or filter.</span>
                </div>


                <% if (faculties && faculties.length > 0) { %>


                    <% faculties.forEach(faculty => { %>


                        <article
                            class="faculty-card"

                            data-name="<%= (faculty.name || '').toLowerCase() %>"

                            data-role="<%= (faculty.role || '').toLowerCase() %>"

                            data-category="<%= faculty.category || '' %>"

                            data-section="<%= faculty.section || 'general' %>"
                        
                            data-search="<%= [
                                faculty.name,
                                faculty.role,
                                faculty.specialization,
                                faculty.department,
                                faculty.whatsappNumber,
                                faculty.section,
                                ...(Array.isArray(faculty.qualities) ? faculty.qualities : [])
                            ].filter(Boolean).join(' ').toLowerCase() %>"
                        >


                            <!-- CATEGORY -->

                            <% if (
                                faculty.category === 'top-faculty'
                            ) { %>


                                <span
                                    class="category-badge category-top"
                                >

                                    Top Faculty

                                </span>


                            <% } else if (
                                faculty.category === 'incharge'
                            ) { %>


                                <span
                                    class="category-badge category-incharge"
                                >

                                    Incharge

                                </span>


                            <% } else { %>


                                <span
                                    class="category-badge category-library"
                                >

                                    Library / Computing

                                </span>


                            <% } %>


                            <!-- IMAGE -->

                            <div class="faculty-image">

                                <img
                                    src="<%= faculty.image || '/images/faculty/default-teacher.jpg' %>"
                                    alt="<%= faculty.name %>"
                                    loading="lazy"
                                    onerror="this.src='/images/faculty/default-teacher.jpg'"
                                >

                            </div>


                            <!-- DETAILS -->

                            <div class="faculty-details">


                                <h3 class="faculty-name">

                                    <%= faculty.name %>

                                </h3>


                                <span class="faculty-role">

                                    <%= faculty.role %>

                                </span>


                                <div class="faculty-meta">


                                    <% if (faculty.section) { %>


                                        <div class="meta-row">

                                            <i class="fas fa-school"></i>

                                            <span>

                                                <%= faculty.section %>

                                            </span>

                                        </div>


                                    <% } %>


                                    <% if (
                                        faculty.specialization
                                    ) { %>


                                        <div class="meta-row">

                                            <i class="fas fa-book"></i>

                                            <span>

                                                <%= faculty.specialization %>

                                            </span>

                                        </div>


                                    <% } %>


                                    <% if (
                                        faculty.department
                                    ) { %>


                                        <div class="meta-row">

                                            <i class="fas fa-building"></i>

                                            <span>

                                                <%= faculty.department %>

                                            </span>

                                        </div>


                                    <% } %>


                                    <!-- WHATSAPP -->

                                    <% if (
                                        faculty.whatsappNumber
                                    ) { %>


                                        <div
                                            class="meta-row whatsapp"
                                        >

                                            <i
                                                class="fab fa-whatsapp"
                                            ></i>

                                            <span>

                                                <%= faculty.whatsappNumber %>

                                            </span>

                                        </div>


                                    <% } else { %>


                                        <div class="meta-row">

                                            <i
                                                class="fas fa-phone-slash"
                                            ></i>

                                            <span>
                                                WhatsApp not added
                                            </span>

                                        </div>


                                    <% } %>


                                </div>


                                <!-- QUALITIES -->

                                <% if (
                                    faculty.qualities &&
                                    faculty.qualities.length > 0
                                ) { %>


                                    <div class="qualities">


                                        <% faculty.qualities
                                            .slice(0,4)
                                            .forEach(quality => { %>


                                            <span class="quality">

                                                <%= quality %>

                                            </span>


                                        <% }) %>


                                    </div>


                                <% } %>


                                <!-- ACTIONS -->

                                <div class="faculty-actions">


                                    <!-- EDIT -->

                                    <a
                                        href="/admin/faculty/edit/<%= faculty._id %>"
                                        class="action edit"
                                        title="Edit Faculty"
                                    >

                                        <i
                                            class="fas fa-pen"
                                        ></i>

                                    </a>


                                    <!-- DELETE -->

                                    <form
                                        method="POST"
                                        action="/admin/faculty/delete/<%= faculty._id %>"
                                        style="display:inline;"
                                        onsubmit="
                                            return confirm(
                                                'Are you sure you want to permanently delete <%= faculty.name %>?'
                                            );
                                        "
                                    >

                                        <button
                                            type="submit"
                                            class="action delete"
                                            title="Delete Faculty"
                                        >

                                            <i
                                                class="fas fa-trash"
                                            ></i>

                                        </button>

                                    </form>


                                    <!-- WHATSAPP -->

                                    <% if (
                                        faculty.whatsappNumber
                                    ) { %>


                                        <a
                                            href="https://wa.me/<%= faculty.whatsappNumber %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="action whatsapp-btn"
                                            title="Open WhatsApp"
                                        >

                                            <i
                                                class="fab fa-whatsapp"
                                            ></i>

                                        </a>


                                    <% } else { %>


                                        <button
                                            type="button"
                                            class="action whatsapp-btn disabled"
                                            title="WhatsApp number not available"
                                            disabled
                                        >

                                            <i
                                                class="fab fa-whatsapp"
                                            ></i>

                                        </button>


                                    <% } %>


                                    <div class="priority">

                                        <i
                                            class="fas fa-ranking-star"
                                        ></i>

                                        Priority:

                                        <strong>

                                            <%= faculty.priority || 0 %>

                                        </strong>

                                    </div>


                                </div>


                            </div>


                        </article>


                    <% }) %>


                <% } else { %>


                    <div class="empty">

                        <i
                            class="fas fa-user-slash"
                        ></i>


                        <strong>

                            No Faculty Members Yet

                        </strong>


                        <span>

                            Add your first faculty member
                            using the form.

                        </span>

                    </div>


                <% } %>


            </div>


        </section>


    </div>


</div>

</div>


<!-- =====================================================
     TOAST
====================================================== -->

<div
    class="toast"
    id="toast"
>

    <i
        class="fas fa-check-circle"
    ></i>

    <span id="toastMessage">
        Done
    </span>

</div>


<script>
(() => {
    'use strict';

    const cards = Array.from(document.querySelectorAll('.faculty-card'));
    const searchInput = document.getElementById('searchInput');
    const clearSearch = document.getElementById('clearSearch');
    const categoryFilter = document.getElementById('categoryFilter');
    const sectionFilter = document.getElementById('sectionFilter');
    const visibleCount = document.getElementById('visibleCount');
    const filteredEmpty = document.getElementById('filteredEmpty');

    function animateCounter(element, target){
        if (!element) return;

        if (
            target === 0 ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ){
            element.textContent = String(target);
            return;
        }

        const duration = 420;
        const start = performance.now();

        function frame(now){
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            element.textContent = String(Math.floor(target * eased));

            if (progress < 1){
                requestAnimationFrame(frame);
            }else{
                element.textContent = String(target);
            }
        }

        requestAnimationFrame(frame);
    }

    const total = cards.length;
    const top = cards.filter(c => c.dataset.category === 'top-faculty').length;
    const incharge = cards.filter(c => c.dataset.category === 'incharge').length;
    const library = cards.filter(c => c.dataset.category === 'library-computing').length;

    animateCounter(document.getElementById('totalCount'), total);
    animateCounter(document.getElementById('topCount'), top);
    animateCounter(document.getElementById('inchargeCount'), incharge);
    animateCounter(document.getElementById('libraryCount'), library);

    /* Fast browser-side search:
       name, role, subject, department, WhatsApp, section, qualities. */
    let filterFrame = 0;

    function updateClearButton(){
        if (!clearSearch || !searchInput) return;
        clearSearch.hidden = searchInput.value.trim() === '';
    }

    function filterFaculty(){
        filterFrame = 0;

        const search = (searchInput?.value || '').trim().toLowerCase();
        const category = categoryFilter?.value || 'all';
        const section = sectionFilter?.value || 'all';

        let visible = 0;

        for (const card of cards){
            const searchable = card.dataset.search || [
                card.dataset.name || '',
                card.dataset.role || '',
                card.dataset.category || '',
                card.dataset.section || ''
            ].join(' ');

            const show =
                (!search || searchable.includes(search)) &&
                (category === 'all' || card.dataset.category === category) &&
                (section === 'all' || card.dataset.section === section);

            card.classList.toggle('is-hidden', !show);
            if (show) visible++;
        }

        if (visibleCount) visibleCount.textContent = String(visible);
        if (filteredEmpty) filteredEmpty.hidden = visible !== 0 || cards.length === 0;
        updateClearButton();
    }

    function scheduleFilter(){
        if (filterFrame) return;
        filterFrame = requestAnimationFrame(filterFaculty);
    }

    searchInput?.addEventListener('input', scheduleFilter, {passive:true});
    categoryFilter?.addEventListener('change', filterFaculty);
    sectionFilter?.addEventListener('change', filterFaculty);

    clearSearch?.addEventListener('click', () => {
        searchInput.value = '';
        filterFaculty();
        searchInput.focus({preventScroll:true});
    });

    filterFaculty();

    /* Faster image preview using an object URL instead of base64. */
    const imageInput = document.getElementById('imageInput');
    const imagePreview = document.getElementById('imagePreview');
    const previewImage = document.getElementById('previewImage');

    imageInput?.addEventListener('change', function(){
        const file = this.files?.[0];

        if (!file){
            imagePreview.style.display = 'none';
            previewImage.removeAttribute('src');
            return;
        }

        if (file.size > 5 * 1024 * 1024){
            alert('Image must be smaller than 5MB.');
            this.value = '';
            imagePreview.style.display = 'none';
            return;
        }

        const allowed = ['image/jpeg','image/jpg','image/png','image/webp'];

        if (!allowed.includes(file.type)){
            alert('Only JPG, JPEG, PNG and WEBP images are allowed.');
            this.value = '';
            imagePreview.style.display = 'none';
            return;
        }

        const objectUrl = URL.createObjectURL(file);
        previewImage.src = objectUrl;
        imagePreview.style.display = 'block';
        previewImage.onload = () => URL.revokeObjectURL(objectUrl);
    });

    /* WhatsApp digits only. */
    const whatsappInput = document.getElementById('whatsappNumber');

    whatsappInput?.addEventListener('input', function(){
        this.value = this.value.replace(/\D/g, '').slice(0, 15);
    }, {passive:true});

    /* Existing backend action is untouched:
       POST /admin/faculty/add */
    const addForm = document.getElementById('addFacultyForm');

    addForm?.addEventListener('submit', function(event){
        const button = this.querySelector('.submit-btn');
        const number = whatsappInput?.value.trim() || '';

        if (number && !/^\d{10,15}$/.test(number)){
            event.preventDefault();
            alert('WhatsApp number must contain 10 to 15 digits only.');
            whatsappInput?.focus();
            return;
        }

        if (!button) return;

        button.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Adding Faculty...';
        button.disabled = true;
    });

    /* Existing backend delete route is untouched:
       POST /admin/faculty/delete/:id */
    for (const form of document.querySelectorAll(
        'form[action*="/admin/faculty/delete/"]'
    )){
        const button = form.querySelector('button[type="submit"]');
        const nameElement = form.closest('.faculty-card')?.querySelector('.faculty-name');

        if (button && nameElement){
            button.dataset.facultyName = nameElement.textContent.trim();
        }

        form.addEventListener('submit', function(event){
            if (this.dataset.confirmed === 'true') return;

            const name = button?.dataset.facultyName || 'this faculty member';

            if (!window.confirm(
                `Are you sure you want to permanently delete ${name}?`
            )){
                event.preventDefault();
                return;
            }

            this.dataset.confirmed = 'true';

            if (button){
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            }
        });
    }
})();
</script>


</body>

</html>