<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= title || 'Events Manager' %>
    </title>


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        :root {

            --navy: #001f3f;
            --navy2: #003b73;
            --blue: #0066c7;

            --gold: #ffc300;
            --gold2: #ffe16a;

            --bg: #f3f6fb;
            --white: #ffffff;

            --text: #172033;
            --muted: #64748b;

            --border: #e2e8f0;

            --green: #16a34a;
            --green-bg: #ecfdf3;

            --red: #dc2626;
            --red-bg: #fef2f2;

            --orange: #ea580c;
            --purple: #7c3aed;

            --shadow:
                0 18px 50px
                rgba(0,31,63,.08);

            --shadow2:
                0 10px 30px
                rgba(0,31,63,.10);
        }


        body {

            min-height: 100vh;

            font-family:
                Inter,
                "Segoe UI",
                Arial,
                sans-serif;

            color:
                var(--text);

            background:

                radial-gradient(
                    circle at 10% 0%,
                    #e6f0ff,
                    transparent 27%
                ),

                var(--bg);
        }


        a {
            text-decoration: none;
        }


        button,
        input,
        select {
            font: inherit;
        }


        /* =====================================================
           PAGE
        ====================================================== */

        .page {

            width:
                min(
                    1280px,
                    calc(100% - 32px)
                );

            margin:
                auto;

            padding:
                24px 0 55px;
        }


        /* =====================================================
           TOPBAR
        ====================================================== */

        .topbar {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            gap:
                15px;

            margin-bottom:
                18px;
        }


        .brand-area {

            display:
                flex;

            align-items:
                center;

            gap:
                11px;
        }


        .brand-icon {

            width:
                45px;

            height:
                45px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            border-radius:
                13px;

            color:
                var(--navy);

            background:
                var(--gold);

            box-shadow:
                0 8px 20px
                rgba(255,195,0,.20);
        }


        .brand-area strong {

            display:
                block;

            color:
                var(--navy);

            font-size:
                13px;

            font-weight:
                950;
        }


        .brand-area span {

            display:
                block;

            margin-top:
                3px;

            color:
                var(--muted);

            font-size:
                9px;
        }


        .top-actions {

            display:
                flex;

            gap:
                8px;
        }


        .top-btn {

            min-height:
                42px;

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            gap:
                8px;

            padding:
                0 14px;

            border-radius:
                11px;

            font-size:
                10px;

            font-weight:
                950;

            transition:
                .25s;
        }


        .dashboard-btn {

            color:
                #fff;

            background:
                var(--navy);
        }


        .add-btn {

            color:
                var(--navy);

            background:
                var(--gold);
        }


        .top-btn:hover {

            transform:
                translateY(-2px);
        }


        .dashboard-btn:hover {

            color:
                var(--navy);

            background:
                var(--gold);
        }


        /* =====================================================
           HERO
        ====================================================== */

        .hero {

            position:
                relative;

            overflow:
                hidden;

            padding:
                32px;

            border-radius:
                27px;

            color:
                #fff;

            background:

                radial-gradient(
                    circle at 87% 10%,
                    rgba(255,195,0,.30),
                    transparent 25%
                ),

                radial-gradient(
                    circle at 75% 100%,
                    rgba(0,153,255,.18),
                    transparent 35%
                ),

                linear-gradient(
                    135deg,
                    #00172f,
                    #003b73,
                    #005cae
                );

            box-shadow:
                0 25px 70px
                rgba(0,31,63,.19);
        }


        .hero-content {

            position:
                relative;

            z-index:
                2;
        }


        .hero-badge {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                7px;

            padding:
                7px 11px;

            border:
                1px solid
                rgba(255,195,0,.30);

            border-radius:
                999px;

            color:
                var(--gold);

            background:
                rgba(255,195,0,.10);

            font-size:
                8px;

            font-weight:
                950;

            letter-spacing:
                1px;

            text-transform:
                uppercase;
        }


        .hero h1 {

            margin-top:
                12px;

            font-size:
                clamp(
                    30px,
                    4vw,
                    48px
                );

            line-height:
                1;

            letter-spacing:
                -1.5px;

            font-weight:
                950;
        }


        .hero h1 span {

            color:
                var(--gold);
        }


        .hero p {

            max-width:
                700px;

            margin-top:
                11px;

            color:
                rgba(255,255,255,.72);

            font-size:
                11px;

            line-height:
                1.7;
        }


        /* =====================================================
           STATS
        ====================================================== */

        .stats {

            display:
                grid;

            grid-template-columns:
                repeat(
                    4,
                    minmax(0,1fr)
                );

            gap:
                12px;

            margin-top:
                18px;
        }


        .stat {

            position:
                relative;

            overflow:
                hidden;

            padding:
                18px;

            border:
                1px solid
                var(--border);

            border-radius:
                17px;

            background:
                var(--white);

            box-shadow:
                var(--shadow);

            transition:
                .25s;
        }


        .stat:hover {

            transform:
                translateY(-3px);

            box-shadow:
                var(--shadow2);
        }


        .stat-top {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;
        }


        .stat-icon {

            width:
                38px;

            height:
                38px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            border-radius:
                11px;

            font-size:
                14px;
        }


        .stat-icon.blue {

            color:
                var(--blue);

            background:
                #eff6ff;
        }


        .stat-icon.green {

            color:
                var(--green);

            background:
                var(--green-bg);
        }


        .stat-icon.orange {

            color:
                var(--orange);

            background:
                #fff7ed;
        }


        .stat-icon.purple {

            color:
                var(--purple);

            background:
                #f5f3ff;
        }


        .stat-label {

            margin-top:
                13px;

            color:
                var(--muted);

            font-size:
                9px;

            font-weight:
                800;
        }


        .stat-number {

            margin-top:
                3px;

            color:
                var(--navy);

            font-size:
                25px;

            line-height:
                1;

            font-weight:
                950;
        }


        /* =====================================================
           CATEGORY BAR
        ====================================================== */

        .category-bar {

            display:
                flex;

            flex-wrap:
                wrap;

            gap:
                7px;

            margin-top:
                18px;

            padding:
                13px;

            border:
                1px solid
                var(--border);

            border-radius:
                17px;

            background:
                #fff;

            box-shadow:
                var(--shadow);
        }


        .category-link {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                7px;

            min-height:
                36px;

            padding:
                0 11px;

            border:
                1px solid
                var(--border);

            border-radius:
                10px;

            color:
                #475569;

            background:
                #f8fafc;

            font-size:
                9px;

            font-weight:
                900;

            transition:
                .2s;
        }


        .category-link:hover {

            border-color:
                #bfdbfe;

            color:
                var(--blue);

            background:
                #eff6ff;
        }


        .category-link.active {

            border-color:
                var(--navy);

            color:
                #fff;

            background:
                var(--navy);
        }


        .category-count {

            padding:
                3px 6px;

            border-radius:
                6px;

            color:
                inherit;

            background:
                rgba(255,255,255,.13);

            font-size:
                8px;
        }


        .category-link:not(.active)
        .category-count {

            background:
                #e2e8f0;
        }


        /* =====================================================
           TOOLBAR
        ====================================================== */

        .toolbar {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            gap:
                12px;

            margin-top:
                18px;

            padding:
                15px;

            border:
                1px solid
                var(--border);

            border-radius:
                17px;

            background:
                #fff;

            box-shadow:
                var(--shadow);
        }


        .search-form {

            flex:
                1;

            display:
                flex;

            gap:
                8px;

            min-width:
                0;
        }


        .search-box {

            position:
                relative;

            flex:
                1;
        }


        .search-box i {

            position:
                absolute;

            left:
                13px;

            top:
                50%;

            transform:
                translateY(-50%);

            color:
                #94a3b8;

            font-size:
                11px;
        }


        .search-box input {

            width:
                100%;

            height:
                43px;

            padding:
                0 13px 0 36px;

            outline:
                none;

            border:
                1px solid
                var(--border);

            border-radius:
                11px;

            color:
                var(--text);

            background:
                #f8fafc;

            font-size:
                10px;
        }


        .search-box input:focus {

            border-color:
                var(--gold);

            background:
                #fff;

            box-shadow:
                0 0 0 4px
                rgba(255,195,0,.10);
        }


        .search-btn {

            height:
                43px;

            padding:
                0 15px;

            border:
                0;

            border-radius:
                11px;

            color:
                var(--navy);

            background:
                var(--gold);

            font-size:
                10px;

            font-weight:
                950;

            cursor:
                pointer;
        }


        .clear-btn {

            height:
                43px;

            display:
                inline-flex;

            align-items:
                center;

            gap:
                7px;

            padding:
                0 12px;

            border:
                1px solid
                var(--border);

            border-radius:
                11px;

            color:
                #64748b;

            background:
                #fff;

            font-size:
                9px;

            font-weight:
                900;
        }


        /* =====================================================
           EVENTS CARD
        ====================================================== */

        .events-card {

            margin-top:
                18px;

            overflow:
                hidden;

            border:
                1px solid
                var(--border);

            border-radius:
                21px;

            background:
                #fff;

            box-shadow:
                var(--shadow);
        }


        .events-header {

            display:
                flex;

            align-items:
                center;

            justify-content:
                space-between;

            gap:
                10px;

            padding:
                18px 20px;

            border-bottom:
                1px solid
                var(--border);
        }


        .events-header h2 {

            color:
                var(--navy);

            font-size:
                15px;

            font-weight:
                950;
        }


        .events-header p {

            margin-top:
                3px;

            color:
                var(--muted);

            font-size:
                9px;
        }


        .result-count {

            padding:
                7px 10px;

            border-radius:
                8px;

            color:
                var(--blue);

            background:
                #eff6ff;

            font-size:
                8px;

            font-weight:
                950;
        }


        /* =====================================================
           EVENT GRID
        ====================================================== */

        .events-grid {

            display:
                grid;

            grid-template-columns:
                repeat(
                    3,
                    minmax(0,1fr)
                );

            gap:
                15px;

            padding:
                18px;
        }


        .event-card {

            overflow:
                hidden;

            border:
                1px solid
                var(--border);

            border-radius:
                17px;

            background:
                #fff;

            transition:
                .25s;
        }


        .event-card:hover {

            transform:
                translateY(-4px);

            box-shadow:
                0 15px 35px
                rgba(0,31,63,.10);
        }


        /* =====================================================
           EVENT IMAGE
        ====================================================== */

        .event-image {

            position:
                relative;

            height:
                190px;

            overflow:
                hidden;

            background:
                linear-gradient(
                    135deg,
                    #dbeafe,
                    #e2e8f0
                );
        }


        .event-image img {

            width:
                100%;

            height:
                100%;

            display:
                block;

            object-fit:
                cover;

            transition:
                .4s;
        }


        .event-card:hover
        .event-image img {

            transform:
                scale(1.04);
        }


        .image-placeholder {

            width:
                100%;

            height:
                100%;

            display:
                flex;

            flex-direction:
                column;

            align-items:
                center;

            justify-content:
                center;

            color:
                #94a3b8;

            font-size:
                28px;
        }


        .image-placeholder span {

            margin-top:
                7px;

            font-size:
                8px;

            font-weight:
                900;
        }


        .status {

            position:
                absolute;

            top:
                10px;

            right:
                10px;

            display:
                inline-flex;

            align-items:
                center;

            gap:
                5px;

            padding:
                6px 8px;

            border-radius:
                8px;

            color:
                #fff;

            background:
                rgba(0,0,0,.65);

            backdrop-filter:
                blur(8px);

            font-size:
                8px;

            font-weight:
                950;
        }


        .status.published {

            color:
                #bbf7d0;

            background:
                rgba(20,83,45,.90);
        }


        .status.draft {

            color:
                #fed7aa;

            background:
                rgba(124,45,18,.90);
        }


        .category-badge {

            position:
                absolute;

            left:
                10px;

            bottom:
                10px;

            padding:
                6px 8px;

            border-radius:
                8px;

            color:
                #fff;

            background:
                rgba(0,31,63,.86);

            backdrop-filter:
                blur(7px);

            font-size:
                8px;

            font-weight:
                900;
        }


        /* =====================================================
           CARD CONTENT
        ====================================================== */

        .event-content {

            padding:
                15px;
        }


        .event-title {

            min-height:
                38px;

            color:
                var(--navy);

            font-size:
                13px;

            line-height:
                1.45;

            font-weight:
                950;
        }


        .event-description {

            display:
                -webkit-box;

            overflow:
                hidden;

            margin-top:
                6px;

            color:
                var(--muted);

            font-size:
                9px;

            line-height:
                1.6;

            -webkit-line-clamp:
                2;

            -webkit-box-orient:
                vertical;
        }


        /* =====================================================
           META
        ====================================================== */

        .event-meta {

            display:
                grid;

            grid-template-columns:
                repeat(
                    2,
                    minmax(0,1fr)
                );

            gap:
                6px;

            margin-top:
                12px;
        }


        .meta {

            min-width:
                0;

            padding:
                8px;

            border-radius:
                9px;

            background:
                #f8fafc;
        }


        .meta-label {

            display:
                flex;

            align-items:
                center;

            gap:
                5px;

            color:
                #94a3b8;

            font-size:
                7px;

            font-weight:
                900;

            text-transform:
                uppercase;
        }


        .meta-value {

            overflow:
                hidden;

            margin-top:
                3px;

            color:
                #334155;

            font-size:
                9px;

            font-weight:
                900;

            white-space:
                nowrap;

            text-overflow:
                ellipsis;
        }


        /* =====================================================
           MEDIA COUNT
        ====================================================== */

        .media-counts {

            display:
                flex;

            flex-wrap:
                wrap;

            gap:
                6px;

            margin-top:
                10px;
        }


        .media-pill {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                5px;

            padding:
                6px 8px;

            border-radius:
                8px;

            color:
                #475569;

            background:
                #f1f5f9;

            font-size:
                8px;

            font-weight:
                900;
        }


        .media-pill.photo i {

            color:
                var(--blue);
        }


        .media-pill.video i {

            color:
                var(--red);
        }


        /* =====================================================
           CARD ACTIONS
        ====================================================== */

        .card-actions {

            display:
                grid;

            grid-template-columns:
                1fr 1fr 1fr;

            gap:
                6px;

            margin-top:
                13px;

            padding-top:
                12px;

            border-top:
                1px solid
                var(--border);
        }


        .action-btn {

            min-height:
                35px;

            display:
                inline-flex;

            align-items:
                center;

            justify-content:
                center;

            gap:
                5px;

            padding:
                0 7px;

            border:
                0;

            border-radius:
                9px;

            font-size:
                8px;

            font-weight:
                950;

            cursor:
                pointer;

            transition:
                .2s;
        }


        .action-btn:hover {

            transform:
                translateY(-2px);
        }


        .edit-btn {

            color:
                var(--blue);

            background:
                #eff6ff;
        }


        .toggle-btn {

            color:
                var(--green);

            background:
                var(--green-bg);
        }


        .toggle-btn.draft-action {

            color:
                var(--orange);

            background:
                #fff7ed;
        }


        .delete-btn {

            color:
                var(--red);

            background:
                var(--red-bg);
        }


        /* =====================================================
           EMPTY STATE
        ====================================================== */

        .empty {

            padding:
                70px 25px;

            text-align:
                center;
        }


        .empty-icon {

            width:
                70px;

            height:
                70px;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            margin:
                auto;

            border-radius:
                21px;

            color:
                var(--blue);

            background:
                #eff6ff;

            font-size:
                25px;
        }


        .empty h3 {

            margin-top:
                15px;

            color:
                var(--navy);

            font-size:
                17px;

            font-weight:
                950;
        }


        .empty p {

            max-width:
                420px;

            margin:
                7px auto 16px;

            color:
                var(--muted);

            font-size:
                10px;

            line-height:
                1.6;
        }


        .empty-add {

            display:
                inline-flex;

            align-items:
                center;

            gap:
                7px;

            padding:
                11px 14px;

            border-radius:
                10px;

            color:
                var(--navy);

            background:
                var(--gold);

            font-size:
                9px;

            font-weight:
                950;
        }


        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 1050px) {

            .events-grid {

                grid-template-columns:
                    repeat(
                        2,
                        minmax(0,1fr)
                    );
            }

        }


        @media (max-width: 850px) {

            .stats {

                grid-template-columns:
                    repeat(
                        2,
                        minmax(0,1fr)
                    );
            }

        }


        @media (max-width: 650px) {

            .page {

                width:
                    calc(100% - 22px);

                padding-top:
                    13px;
            }


            .topbar {

                flex-direction:
                    column;

                align-items:
                    stretch;
            }


            .top-actions {

                width:
                    100%;
            }


            .top-btn {

                flex:
                    1;
            }


            .hero {

                padding:
                    26px 22px;
            }


            .hero h1 {

                font-size:
                    33px;
            }


            .toolbar {

                flex-direction:
                    column;

                align-items:
                    stretch;
            }


            .search-form {

                width:
                    100%;
            }


            .category-bar {

                overflow-x:
                    auto;

                flex-wrap:
                    nowrap;

                padding-bottom:
                    11px;
            }


            .category-link {

                flex:
                    0 0 auto;
            }


            .events-grid {

                grid-template-columns:
                    1fr;

                padding:
                    12px;
            }

        }


        @media (max-width: 430px) {

            .stats {

                grid-template-columns:
                    1fr 1fr;

                gap:
                    8px;
            }


            .stat {

                padding:
                    13px;
            }


            .stat-number {

                font-size:
                    21px;
            }


            .stat-label {

                font-size:
                    8px;
            }


            .search-form {

                flex-wrap:
                    wrap;
            }


            .search-box {

                flex:
                    1 1 100%;
            }


            .search-btn {

                flex:
                    1;
            }


            .clear-btn {

                flex:
                    1;

                justify-content:
                    center;
            }

        }

    </style>

</head>


<body>


<div class="page">


    <!-- =====================================================
         TOP BAR
    ====================================================== -->

    <div class="topbar">


        <div class="brand-area">

            <div class="brand-icon">

                <i class="fas fa-calendar-days"></i>

            </div>


            <div>

                <strong>
                    Events Manager
                </strong>

                <span>
                    School memories &amp; celebrations
                </span>

            </div>

        </div>


        <div class="top-actions">


            <a
                href="/admin/dashboard"
                class="top-btn dashboard-btn"
            >

                <i class="fas fa-chart-line"></i>

                Dashboard

            </a>


            <a
                href="/admin/events/add"
                class="top-btn add-btn"
            >

                <i class="fas fa-plus"></i>

                Add Event

            </a>


        </div>

    </div>


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="hero">


        <div class="hero-content">


            <div class="hero-badge">

                <i class="fas fa-sparkles"></i>

                Admin Control Center

            </div>


            <h1>

                School

                <span>Events</span>

            </h1>


            <p>

                Manage Fun &amp; Fiesta, Sports, National
                Celebrations and Old Memories from one place.

            </p>


        </div>


    </section>


    <!-- =====================================================
         STATS
    ====================================================== -->

    <section class="stats">


        <div class="stat">

            <div class="stat-top">

                <div class="stat-icon blue">

                    <i class="fas fa-calendar-check"></i>

                </div>

            </div>


            <div class="stat-label">
                Total Events
            </div>


            <div class="stat-number">
                <%= totalEvents || 0 %>
            </div>

        </div>


        <div class="stat">

            <div class="stat-top">

                <div class="stat-icon green">

                    <i class="fas fa-eye"></i>

                </div>

            </div>


            <div class="stat-label">
                Published
            </div>


            <div class="stat-number">
                <%= publishedEvents || 0 %>
            </div>

        </div>


        <div class="stat">

            <div class="stat-top">

                <div class="stat-icon orange">

                    <i class="fas fa-file-pen"></i>

                </div>

            </div>


            <div class="stat-label">
                Drafts
            </div>


            <div class="stat-number">
                <%= draftEvents || 0 %>
            </div>

        </div>


        <div class="stat">

            <div class="stat-top">

                <div class="stat-icon purple">

                    <i class="fas fa-party-horn"></i>

                </div>

            </div>


            <div class="stat-label">
                Fun &amp; Fiesta
            </div>


            <div class="stat-number">
                <%= funFiestaCount || 0 %>
            </div>

        </div>


    </section>


    <!-- =====================================================
         CATEGORY FILTER
    ====================================================== -->

    <nav class="category-bar">


        <a
            href="/admin/events"
            class="category-link <%= !selectedCategory ? 'active' : '' %>"
        >

            <i class="fas fa-border-all"></i>

            All

            <span class="category-count">
                <%= totalEvents || 0 %>
            </span>

        </a>


        <a
            href="/admin/events?category=fun-fiesta"
            class="category-link <%= selectedCategory === 'fun-fiesta' ? 'active' : '' %>"
        >

            <i class="fas fa-party-horn"></i>

            Fun &amp; Fiesta

            <span class="category-count">
                <%= funFiestaCount || 0 %>
            </span>

        </a>


        <a
            href="/admin/events?category=sports"
            class="category-link <%= selectedCategory === 'sports' ? 'active' : '' %>"
        >

            <i class="fas fa-trophy"></i>

            Sports

            <span class="category-count">
                <%= sportsCount || 0 %>
            </span>

        </a>


        <a
            href="/admin/events?category=national-celebration"
            class="category-link <%= selectedCategory === 'national-celebration' ? 'active' : '' %>"
        >

            <i class="fas fa-flag"></i>

            National Celebration

            <span class="category-count">
                <%= nationalCount || 0 %>
            </span>

        </a>


        <a
            href="/admin/events?category=old-memory"
            class="category-link <%= selectedCategory === 'old-memory' ? 'active' : '' %>"
        >

            <i class="fas fa-clock-rotate-left"></i>

            Old Memories

            <span class="category-count">
                <%= oldMemoryCount || 0 %>
            </span>

        </a>


    </nav>


    <!-- =====================================================
         SEARCH
    ====================================================== -->

    <section class="toolbar">


        <form
            method="GET"
            action="/admin/events"
            class="search-form"
        >


            <% if (selectedCategory) { %>

                <input
                    type="hidden"
                    name="category"
                    value="<%= selectedCategory %>"
                >

            <% } %>


            <div class="search-box">

                <i class="fas fa-search"></i>


                <input
                    type="search"
                    name="search"
                    value="<%= search || '' %>"
                    placeholder="Search by title, description, session or batch..."
                    autocomplete="off"
                >

            </div>


            <button
                type="submit"
                class="search-btn"
            >

                <i class="fas fa-search"></i>

                Search

            </button>


            <% if (search) { %>

                <a
                    href="<%= selectedCategory
                        ? '/admin/events?category=' + encodeURIComponent(selectedCategory)
                        : '/admin/events' %>"
                    class="clear-btn"
                >

                    <i class="fas fa-xmark"></i>

                    Clear

                </a>

            <% } %>


        </form>


        <a
            href="/admin/events/add"
            class="top-btn add-btn"
        >

            <i class="fas fa-plus"></i>

            Create Event

        </a>


    </section>


    <!-- =====================================================
         EVENTS
    ====================================================== -->

    <section class="events-card">


        <div class="events-header">


            <div>

                <h2>
                    Event Collection
                </h2>

                <p>
                    View, edit, publish or remove your events.
                </p>

            </div>


            <div class="result-count">

                <%= events ? events.length : 0 %>
                RESULT<%= events && events.length === 1 ? '' : 'S' %>

            </div>


        </div>


        <% if (
            events &&
            events.length
        ) { %>


            <div class="events-grid">


                <% events.forEach(
                    function(event)
                { %>


                    <article class="event-card">


                        <!-- =================================================
                             IMAGE
                        ================================================== -->

                        <div class="event-image">


                            <% if (
                                event.coverImage
                            ) { %>


                                <img
                                    src="<%= event.coverImage %>"
                                    alt="<%= event.title %>"
                                    loading="lazy"
                                >


                            <% } else { %>


                                <div class="image-placeholder">

                                    <i class="fas fa-images"></i>

                                    <span>
                                        No Cover Image
                                    </span>

                                </div>


                            <% } %>


                            <!-- STATUS -->

                            <div class="status <%= event.published ? 'published' : 'draft' %>">

                                <i class="fas <%= event.published
                                    ? 'fa-circle-check'
                                    : 'fa-file-pen' %>"></i>

                                <%= event.published
                                    ? 'Published'
                                    : 'Draft' %>

                            </div>


                            <!-- CATEGORY -->

                            <div class="category-badge">


                                <% if (
                                    event.category ===
                                    'fun-fiesta'
                                ) { %>

                                    🎉 Fun &amp; Fiesta


                                <% } else if (
                                    event.category ===
                                    'sports'
                                ) { %>

                                    🏆 Sports


                                <% } else if (
                                    event.category ===
                                    'national-celebration'
                                ) { %>

                                    🇮🇳 National Celebration


                                <% } else { %>

                                    🕰️ Old Memories

                                <% } %>


                            </div>


                        </div>


                        <!-- =================================================
                             CONTENT
                        ================================================== -->

                        <div class="event-content">


                            <h3 class="event-title">

                                <%= event.title %>

                            </h3>


                            <% if (
                                event.description
                            ) { %>

                                <div class="event-description">

                                    <%= event.description %>

                                </div>

                            <% } %>


                            <!-- META -->

                            <div class="event-meta">


                                <div class="meta">

                                    <div class="meta-label">

                                        <i class="far fa-calendar"></i>

                                        Date

                                    </div>


                                    <div class="meta-value">

                                        <%= event.date
                                            ? new Date(event.date)
                                                .toLocaleDateString(
                                                    'en-IN',
                                                    {
                                                        day: '2-digit',
                                                        month: 'short',
                                                        year: 'numeric'
                                                    }
                                                )
                                            : '—' %>

                                    </div>

                                </div>


                                <div class="meta">

                                    <div class="meta-label">

                                        <i class="fas fa-sort"></i>

                                        Priority

                                    </div>


                                    <div class="meta-value">

                                        <%= event.priority ?? 0 %>

                                    </div>

                                </div>


                                <% if (
                                    event.session
                                ) { %>


                                    <div class="meta">

                                        <div class="meta-label">

                                            <i class="fas fa-graduation-cap"></i>

                                            Session

                                        </div>


                                        <div class="meta-value">

                                            <%= event.session %>

                                        </div>

                                    </div>


                                <% } %>


                                <% if (
                                    event.batch
                                ) { %>


                                    <div class="meta">

                                        <div class="meta-label">

                                            <i class="fas fa-users"></i>

                                            Batch

                                        </div>


                                        <div class="meta-value">

                                            <%= event.batch %>

                                        </div>

                                    </div>


                                <% } %>


                            </div>


                            <!-- MEDIA -->

                            <div class="media-counts">


                                <span class="media-pill photo">

                                    <i class="fas fa-images"></i>

                                    <%= event.photos
                                        ? event.photos.length
                                        : 0 %>

                                    Photos

                                </span>


                                <span class="media-pill video">

                                    <i class="fas fa-video"></i>

                                    <%= event.videos
                                        ? event.videos.length
                                        : 0 %>

                                    Videos

                                </span>


                            </div>


                            <!-- ACTIONS -->

                            <div class="card-actions">


                                <a
                                    href="/admin/events/edit/<%= event._id %>"
                                    class="action-btn edit-btn"
                                >

                                    <i class="fas fa-pen"></i>

                                    Edit

                                </a>


                                <!-- TOGGLE -->

                                <form
                                    method="POST"
                                    action="/admin/events/toggle/<%= event._id %>"
                                    class="toggle-form"
                                >


                                    <input
                                        type="hidden"
                                        name="_csrf"
                                        value="<%= csrfToken %>"
                                    >


                                    <button
                                        type="submit"
                                        class="action-btn toggle-btn <%= event.published ? 'draft-action' : '' %>"
                                    >

                                        <i class="fas <%= event.published
                                            ? 'fa-eye-slash'
                                            : 'fa-eye' %>"></i>

                                        <%= event.published
                                            ? 'Draft'
                                            : 'Publish' %>

                                    </button>


                                </form>


                                <!-- DELETE -->

                                <form
                                    method="POST"
                                    action="/admin/events/delete/<%= event._id %>"
                                    class="delete-form"
                                >


                                    <input
                                        type="hidden"
                                        name="_csrf"
                                        value="<%= csrfToken %>"
                                    >


                                    <button
                                        type="submit"
                                        class="action-btn delete-btn"
                                    >

                                        <i class="fas fa-trash"></i>

                                        Delete

                                    </button>


                                </form>


                            </div>


                        </div>


                    </article>


                <% }) %>


            </div>


        <% } else { %>


            <!-- =================================================
                 EMPTY
            ================================================== -->

            <div class="empty">


                <div class="empty-icon">

                    <i class="fas fa-calendar-xmark"></i>

                </div>


                <h3>
                    No Events Found
                </h3>


                <p>

                    <% if (search) { %>

                        No event matched
                        "<strong><%= search %></strong>".
                        Try another search.

                    <% } else if (selectedCategory) { %>

                        There are no events in this category yet.

                    <% } else { %>

                        Your event collection is empty.
                        Create your first event to get started.

                    <% } %>

                </p>


                <a
                    href="/admin/events/add"
                    class="empty-add"
                >

                    <i class="fas fa-plus"></i>

                    Create First Event

                </a>


            </div>


        <% } %>


    </section>


</div>


<script>

    // =========================================================
    // DELETE CONFIRMATION
    // =========================================================

    document
        .querySelectorAll(
            '.delete-form'
        )
        .forEach(
            form => {

                form.addEventListener(
                    'submit',
                    function (event) {

                        const confirmed =
                            confirm(
                                'Delete this event permanently? Its uploaded cover, photos and videos will also be removed.'
                            );


                        if (!confirmed) {

                            event.preventDefault();

                            return;

                        }


                        const button =
                            form.querySelector(
                                'button'
                            );


                        if (button) {

                            button.disabled =
                                true;


                            button.innerHTML = `

                                <i class="fas fa-spinner fa-spin"></i>

                                Deleting

                            `;

                        }

                    }
                );

            }
        );


    // =========================================================
    // TOGGLE LOADING
    // =========================================================

    document
        .querySelectorAll(
            '.toggle-form'
        )
        .forEach(
            form => {

                form.addEventListener(
                    'submit',
                    function () {

                        const button =
                            form.querySelector(
                                'button'
                            );


                        if (button) {

                            button.disabled =
                                true;


                            button.innerHTML = `

                                <i class="fas fa-spinner fa-spin"></i>

                            `;

                        }

                    }
                );

            }
        );


    // =========================================================
    // SEARCH SHORTCUT
    // =========================================================

    document.addEventListener(
        'keydown',
        function (event) {

            if (
                event.key === '/' &&
                document.activeElement.tagName !== 'INPUT'
            ) {

                event.preventDefault();


                const input =
                    document.querySelector(
                        'input[name="search"]'
                    );


                if (input) {

                    input.focus();

                }

            }

        }
    );

</script>


</body>

</html>