<div class="toast" id="toast">
    <i class="fas fa-circle-check"></i>
    <span id="toastText">Preference saved</span>
</div>


<script>
(function(){

    const STORAGE_KEY = "gyanJyotiAdminSettings";

    const defaults = {
        theme: "light",
        compact: false,
        motion: true,
        counters: true,
        sound: false
    };

    let state = defaults;

    try{
        const stored = JSON.parse(
            localStorage.getItem(STORAGE_KEY) || "{}"
        );

        state = Object.assign({}, defaults, stored);
    }catch(error){
        state = defaults;
    }


    function save(){
        try{
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(state)
            );
        }catch(error){}
    }


    function applyTheme(){

        let theme = state.theme;

        if(theme === "system"){
            theme =
                window.matchMedia &&
                window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
        }

        document.body.classList.toggle(
            "dark",
            theme === "dark"
        );

        const icon =
            document.getElementById("themeIcon");

        if(icon){
            icon.className =
                theme === "dark"
                    ? "fas fa-sun"
                    : "fas fa-moon";
        }
    }


    function applyCompact(){

        document.body.style.setProperty(
            "--radius",
            state.compact ? "16px" : "22px"
        );

        document.body.classList.toggle(
            "compact-mode",
            !!state.compact
        );
    }


    function applyMotion(){

        document.body.classList.toggle(
            "reduce-motion",
            !state.motion
        );

        if(!state.motion){
            document.body.style.setProperty(
                "scroll-behavior",
                "auto"
            );
        }else{
            document.body.style.removeProperty(
                "scroll-behavior"
            );
        }
    }


    function showToast(message){

        const toast =
            document.getElementById("toast");

        const text =
            document.getElementById("toastText");

        if(!toast || !text) return;

        text.textContent = message;

        toast.classList.add("show");

        clearTimeout(window.__gjToast);

        window.__gjToast =
            setTimeout(function(){
                toast.classList.remove("show");
            },2200);
    }


    window.toggleTheme = function(){

        state.theme =
            document.body.classList.contains("dark")
                ? "light"
                : "dark";

        save();
        applyTheme();

        const select =
            document.getElementById("themeSelect");

        if(select){
            select.value = state.theme;
        }

        showToast(
            state.theme === "dark"
                ? "Dark theme enabled"
                : "Light theme enabled"
        );
    };


    window.toggleSidebar = function(){
        document.body.classList.toggle(
            "sidebar-open"
        );
    };


    /* ---------- tabs ---------- */

    document.querySelectorAll(".settings-tab")
        .forEach(function(button){

            button.addEventListener("click",function(){

                const id =
                    button.getAttribute("data-tab");

                document.querySelectorAll(".settings-tab")
                    .forEach(function(item){
                        item.classList.toggle(
                            "active",
                            item === button
                        );
                    });

                document.querySelectorAll(".tab-panel")
                    .forEach(function(panel){
                        panel.classList.toggle(
                            "active",
                            panel.id === id
                        );
                    });

                history.replaceState(
                    null,
                    "",
                    "#" + id
                );
            });

        });


    /* ---------- theme ---------- */

    const themeSelect =
        document.getElementById("themeSelect");

    if(themeSelect){

        themeSelect.value = state.theme;

        themeSelect.addEventListener(
            "change",
            function(){

                state.theme =
                    themeSelect.value;

                save();
                applyTheme();

                showToast(
                    "Appearance preference saved"
                );
            }
        );
    }


    /* ---------- compact ---------- */

    const compact =
        document.getElementById("compactMode");

    if(compact){

        compact.checked =
            !!state.compact;

        compact.addEventListener(
            "change",
            function(){

                state.compact =
                    compact.checked;

                save();
                applyCompact();

                showToast(
                    state.compact
                        ? "Compact interface enabled"
                        : "Standard interface enabled"
                );
            }
        );
    }


    /* ---------- motion ---------- */

    const motion =
        document.getElementById("motionMode");

    if(motion){

        motion.checked =
            !!state.motion;

        motion.addEventListener(
            "change",
            function(){

                state.motion =
                    motion.checked;

                save();
                applyMotion();

                showToast(
                    state.motion
                        ? "Motion effects enabled"
                        : "Motion effects disabled"
                );
            }
        );
    }


    /* ---------- counters ---------- */

    const counters =
        document.getElementById("counterMode");

    if(counters){

        counters.checked =
            !!state.counters;

        counters.addEventListener(
            "change",
            function(){

                state.counters =
                    counters.checked;

                save();

                document.querySelectorAll(".menu-count")
                    .forEach(function(item){
                        item.style.display =
                            state.counters
                                ? ""
                                : "none";
                    });

                showToast(
                    state.counters
                        ? "Sidebar counters enabled"
                        : "Sidebar counters hidden"
                );
            }
        );
    }


    /* ---------- sound ---------- */

    const sound =
        document.getElementById("soundMode");

    if(sound){

        sound.checked =
            !!state.sound;

        sound.addEventListener(
            "change",
            function(){

                state.sound =
                    sound.checked;

                save();

                showToast(
                    state.sound
                        ? "Notification sound preference enabled"
                        : "Notification sound preference disabled"
                );
            }
        );
    }


    /* ---------- hash tab ---------- */

    const hash =
        window.location.hash
            .replace("#","");

    if(hash){

        const target =
            document.querySelector(
                '.settings-tab[data-tab="' + hash + '"]'
            );

        if(target){
            target.click();
        }
    }


    /* ---------- apply initial state ---------- */

    applyTheme();
    applyCompact();
    applyMotion();

    if(counters && !state.counters){
        document.querySelectorAll(".menu-count")
            .forEach(function(item){
                item.style.display = "none";
            });
    }


    /* ---------- system theme ---------- */

    if(
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme: dark)")
    ){

        window.matchMedia(
            "(prefers-color-scheme: dark)"
        ).addEventListener(
            "change",
            function(){

                if(state.theme === "system"){
                    applyTheme();
                }

            }
        );
    }

})();
</script>

</body>
