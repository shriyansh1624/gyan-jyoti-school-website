 * - Navigation points to the existing admin pages.
 * - UI preferences are stored in localStorage, so no database/backend
 *   changes are required for theme/layout preferences.
 *
 * For server-side account/site settings, use the route snippet supplied
 * separately with your existing routes/admin.js.
 */

const safeAdminName =
    (typeof adminName !== 'undefined' && adminName)
        ? String(adminName)
        : 'Administrator';

const safeAdmissionCount =
    Number(typeof admissionCount !== 'undefined' ? admissionCount : 0) || 0;

const safeEnquiryCount =
    Number(typeof enquiryCount !== 'undefined' ? enquiryCount : 0) || 0;

const safeContactCount =
    Number(typeof contactCount !== 'undefined' ? contactCount : 0) || 0;

const safeNotificationCount =
    Number(typeof notificationCount !== 'undefined' ? notificationCount : 0) || 0;

const safeCsrf =
    typeof csrfToken !== 'undefined' ? csrfToken : '';
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#061a33">
<title>Settings — Gyan Jyoti School</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
:root{
    --navy:#061a33;
    --navy2:#0a315b;
    --blue:#1769e0;
    --blue2:#0f5dbb;
    --gold:#f6c343;
    --gold2:#ffd967;
    --green:#0e9f6e;
    --red:#dc4050;
    --purple:#7357d8;

    --bg:#f3f7fc;
    --surface:#fff;
    --surface2:#f8fbff;
    --text:#142238;
    --muted:#73839a;
    --line:#e4ebf4;

    --shadow:0 18px 50px rgba(15,39,69,.09);
    --radius:22px;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{scroll-behavior:smooth}

body{
    min-height:100vh;
    font-family:Inter,"Segoe UI",Arial,sans-serif;
    color:var(--text);
    background:
        radial-gradient(circle at 85% 8%,rgba(23,105,224,.09),transparent 26%),
        radial-gradient(circle at 45% 80%,rgba(246,195,67,.08),transparent 28%),
        var(--bg);
    overflow-x:hidden;
}

body.dark{
    --bg:#07111f;
    --surface:#0e1c2e;
    --surface2:#12243a;
    --text:#edf4ff;
    --muted:#9aaac0;
    --line:#21354e;
    background:
        radial-gradient(circle at 85% 8%,rgba(23,105,224,.12),transparent 28%),
        #07111f;
}

a{
    color:inherit;
    text-decoration:none;
}

button,input,select{
    font:inherit;
}

button{cursor:pointer}

::selection{
    background:var(--gold);
    color:var(--navy);
}

/* ---------- ambient ---------- */

.ambient{
    position:fixed;
    inset:0;
    overflow:hidden;
    pointer-events:none;
    z-index:-1;
}

.orb{
    position:absolute;
    border-radius:50%;
    filter:blur(1px);
    opacity:.55;
    animation:float 10s ease-in-out infinite;
}

.orb.one{
    width:330px;
    height:330px;
    right:-130px;
    top:90px;
    background:rgba(23,105,224,.12);
}

.orb.two{
    width:270px;
    height:270px;
    left:180px;
    bottom:-120px;
    background:rgba(246,195,67,.13);
    animation-delay:-3s;
}

.orb.three{
    width:180px;
    height:180px;
    right:30%;
    bottom:12%;
    background:rgba(115,87,216,.10);
    animation-delay:-6s;
}

@keyframes float{
    0%,100%{transform:translate3d(0,0,0)}
    50%{transform:translate3d(0,-18px,0)}
}

/* ---------- layout ---------- */

.app{
    min-height:100vh;
}

.sidebar{
    position:fixed;
    inset:0 auto 0 0;
    z-index:1000;
    width:272px;
    padding:20px 16px;
    overflow:auto;
    color:#fff;
    background:
        linear-gradient(180deg,#04162b 0%,#092e55 58%,#0b3b6c 100%);
    box-shadow:12px 0 38px rgba(0,0,0,.14);
}

.brand{
    display:flex;
    align-items:center;
    gap:13px;
    padding:9px 9px 22px;
    margin-bottom:20px;
    border-bottom:1px solid rgba(255,255,255,.1);
}

.brand-logo{
    width:55px;
    height:55px;
    flex:none;
    display:grid;
    place-items:center;
    border-radius:17px;
    background:#fff;
    color:var(--navy);
    font-size:23px;
    box-shadow:0 10px 28px rgba(0,0,0,.12);
}

.brand h2{
    font-size:18px;
    font-weight:900;
    line-height:1.1;
}

.brand span{
    display:block;
    margin-top:5px;
    color:rgba(255,255,255,.52);
    font-size:8px;
    letter-spacing:1.4px;
    text-transform:uppercase;
}

.menu-label{
    margin:0 10px 8px;
    color:rgba(255,255,255,.42);
    font-size:9px;
    font-weight:900;
    letter-spacing:1.6px;
    text-transform:uppercase;
}

.menu{
    display:grid;
    gap:5px;
}

.menu a{
    position:relative;
    display:flex;
    align-items:center;
    gap:12px;
    min-height:45px;
    padding:0 13px;
    border:1px solid transparent;
    border-radius:14px;
    color:rgba(255,255,255,.76);
    font-size:11px;
    font-weight:800;
    transition:.22s ease;
}

.menu a i{
    width:20px;
    text-align:center;
    color:#8dbce9;
}

.menu a:hover{
    color:#fff;
    background:rgba(255,255,255,.075);
    border-color:rgba(255,255,255,.08);
    transform:translateX(3px);
}

.menu a.active{
    color:var(--navy);
    background:linear-gradient(135deg,var(--gold),var(--gold2));
    box-shadow:0 12px 28px rgba(246,195,67,.22);
}

.menu a.active i{color:var(--navy)}

.menu-count{
    min-width:21px;
    height:21px;
    margin-left:auto;
    display:grid;
    place-items:center;
    padding:0 5px;
    border-radius:99px;
    background:#e84958;
    color:#fff;
    font-size:9px;
    font-weight:900;
}

.sidebar-footer{
    margin-top:24px;
    padding:14px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:16px;
    background:rgba(255,255,255,.055);
}

.sidebar-footer small{
    display:block;
    margin-bottom:5px;
    color:rgba(255,255,255,.43);
    font-size:8px;
}

.sidebar-footer strong{
    font-size:11px;
}

/* ---------- main ---------- */

.main{
    width:calc(100% - 272px);
    min-height:100vh;
    margin-left:272px;
    padding:28px;
}

.topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    margin-bottom:20px;
}

.breadcrumbs{
    color:var(--muted);
    font-size:11px;
    font-weight:700;
}

.breadcrumbs strong{color:var(--text)}

.top-actions{
    display:flex;
    gap:8px;
}

.icon-btn{
    width:42px;
    height:42px;
    display:grid;
    place-items:center;
    border:1px solid var(--line);
    border-radius:13px;
    background:var(--surface);
    color:var(--text);
    box-shadow:0 7px 22px rgba(0,0,0,.04);
    transition:.2s ease;
}

.icon-btn:hover{
    border-color:var(--gold);
    transform:translateY(-2px);
}

.mobile-menu{display:none}

/* ---------- hero ---------- */

.hero{
    position:relative;
    overflow:hidden;
    min-height:205px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:25px;
    padding:34px;
    margin-bottom:20px;
    border-radius:28px;
    color:#fff;
    background:
        radial-gradient(circle at 85% 20%,rgba(246,195,67,.23),transparent 23%),
        linear-gradient(135deg,#05182f,#0d5ca4);
    box-shadow:0 24px 55px rgba(6,26,51,.2);
}

.hero:after{
    content:"";
    position:absolute;
    inset:0;
    opacity:.1;
    background-image:radial-gradient(#fff 1px,transparent 1px);
    background-size:27px 27px;
    pointer-events:none;
}

.hero-content,
.hero-actions{
    position:relative;
    z-index:2;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:7px;
    padding:7px 11px;
    margin-bottom:11px;
    border:1px solid rgba(246,195,67,.35);
    border-radius:99px;
    background:rgba(246,195,67,.12);
    color:var(--gold);
    font-size:8px;
    font-weight:900;
    letter-spacing:1.2px;
    text-transform:uppercase;
}

.hero h1{
    font-size:clamp(29px,3.4vw,43px);
    font-weight:900;
    letter-spacing:-1px;
}

.hero p{
    max-width:690px;
    margin-top:9px;
    color:rgba(255,255,255,.72);
    font-size:12px;
    line-height:1.7;
}

.hero-actions{
    display:flex;
    flex-wrap:wrap;
    gap:9px;
}

.hero-btn{
    min-height:45px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    padding:0 16px;
    border:0;
    border-radius:13px;
    background:#fff;
    color:var(--navy);
    font-size:10px;
    font-weight:900;
    box-shadow:0 12px 28px rgba(0,0,0,.12);
    transition:.2s ease;
}

.hero-btn:hover{
    transform:translateY(-2px);
}

/* ---------- settings shell ---------- */

.settings-grid{
    display:grid;
    grid-template-columns:260px minmax(0,1fr);
    gap:18px;
    align-items:start;
}

.settings-nav,
.settings-card{
    border:1px solid var(--line);
    border-radius:22px;
    background:var(--surface);
    box-shadow:var(--shadow);
}

.settings-nav{
    padding:10px;
    position:sticky;
    top:20px;
}

.settings-tab{
    width:100%;
    display:flex;
    align-items:center;
    gap:11px;
    min-height:48px;
    padding:0 13px;
    border:1px solid transparent;
    border-radius:13px;
    background:transparent;
    color:var(--muted);
    text-align:left;
    font-size:10px;
    font-weight:800;
    transition:.2s ease;
}

.settings-tab i{
    width:21px;
    color:var(--blue);
    text-align:center;
}

.settings-tab:hover{
    color:var(--text);
    background:var(--surface2);
}

.settings-tab.active{
    color:var(--navy);
    background:linear-gradient(135deg,#fff4c8,#ffdf73);
    border-color:rgba(246,195,67,.4);
    box-shadow:0 9px 20px rgba(246,195,67,.14);
}

.settings-tab.active i{color:var(--navy)}

.settings-content{
    min-width:0;
}

.tab-panel{
    display:none;
    animation:panelIn .35s ease both;
}

.tab-panel.active{display:block}

@keyframes panelIn{
    from{opacity:0;transform:translateY(8px)}
    to{opacity:1;transform:none}
}

.settings-card{
    overflow:hidden;
    margin-bottom:16px;
}

.card-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:21px 22px;
    border-bottom:1px solid var(--line);
}

.card-title{
    display:flex;
    align-items:center;
    gap:12px;
}

.card-icon{
    width:42px;
    height:42px;
    display:grid;
    place-items:center;
    border-radius:12px;
    background:var(--blue-soft,#eaf2ff);
    color:var(--blue);
}

.card-head h2{
    font-size:15px;
    font-weight:900;
}

.card-head p{
    margin-top:4px;
    color:var(--muted);
    font-size:9px;
}

.card-body{
    padding:22px;
}

.setting-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    padding:17px 0;
    border-bottom:1px solid var(--line);
}

.setting-row:first-child{padding-top:0}
.setting-row:last-child{
    padding-bottom:0;
    border-bottom:0;
}

.setting-info{
    min-width:0;
}

.setting-info strong{
    display:block;
    font-size:11px;
    font-weight:900;
}

.setting-info span{
    display:block;
    margin-top:5px;
    color:var(--muted);
    font-size:9px;
    line-height:1.5;
}

.select{
    min-width:180px;
    height:42px;
    padding:0 12px;
    border:1px solid var(--line);
    border-radius:11px;
    outline:none;
    background:var(--surface2);
    color:var(--text);
    font-size:10px;
    font-weight:700;
}

.select:focus{
    border-color:var(--blue);
    box-shadow:0 0 0 3px rgba(23,105,224,.1);
}

/* toggle */

.switch{
    position:relative;
    width:48px;
    height:27px;
    flex:none;
}

.switch input{
    opacity:0;
    width:0;
    height:0;
}

.slider{
    position:absolute;
    inset:0;
    border-radius:99px;
    background:#cbd5e1;
    transition:.25s;
}

.slider:before{
    content:"";
    position:absolute;
    width:21px;
    height:21px;
    left:3px;
    top:3px;
    border-radius:50%;
    background:#fff;
    box-shadow:0 2px 7px rgba(0,0,0,.2);
    transition:.25s;
}

.switch input:checked + .slider{
    background:var(--blue);
}

.switch input:checked + .slider:before{
    transform:translateX(21px);
}

/* profile */

.profile{
    display:grid;
    grid-template-columns:80px 1fr;
    gap:18px;
    align-items:center;
    padding-bottom:20px;
    margin-bottom:20px;
    border-bottom:1px solid var(--line);
}

.profile-avatar{
    width:78px;
    height:78px;
    display:grid;
    place-items:center;
    border-radius:23px;
    color:var(--navy);
    background:linear-gradient(135deg,#fff,#dfeeff);
    box-shadow:0 12px 30px rgba(23,105,224,.12);
    font-size:26px;
}

.profile h3{
    font-size:17px;
    font-weight:900;
}

.profile p{
    margin-top:5px;
    color:var(--muted);
    font-size:9px;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:5px;
    margin-top:9px;
    padding:6px 9px;
    border-radius:99px;
    background:#e8f8f1;
    color:var(--green);
    font-size:8px;
    font-weight:900;
}

/* inputs */

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.form-group label{
    display:block;
    margin-bottom:7px;
    color:var(--muted);
    font-size:9px;
    font-weight:800;
}

.form-input{
    width:100%;
    height:44px;
    padding:0 12px;
    border:1px solid var(--line);
    border-radius:11px;
    outline:none;
    background:var(--surface2);
    color:var(--text);
    font-size:10px;
    font-weight:600;
}

.form-input:focus{
    border-color:var(--blue);
    box-shadow:0 0 0 3px rgba(23,105,224,.1);
}

.actions{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:18px;
}

.btn{
    min-height:42px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;
    padding:0 15px;
    border:0;
    border-radius:11px;
    font-size:9px;
    font-weight:900;
    transition:.2s ease;
}

.btn:hover{transform:translateY(-1px)}

.btn-primary{
    background:var(--navy);
    color:#fff;
    box-shadow:0 10px 22px rgba(6,26,51,.15);
}

.btn-light{
    border:1px solid var(--line);
    background:var(--surface);
    color:var(--text);
}

.btn-danger{
    background:#fff0f1;
    color:var(--red);
}

/* connected pages */

.page-links{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.page-link{
    display:flex;
    align-items:center;
    gap:12px;
    min-height:68px;
    padding:0 13px;
    border:1px solid var(--line);
    border-radius:14px;
    background:var(--surface2);
    transition:.22s ease;
}

.page-link:hover{
    transform:translateY(-3px);
    border-color:rgba(23,105,224,.35);
    box-shadow:0 12px 25px rgba(23,105,224,.08);
}

.page-link-icon{
    width:38px;
    height:38px;
    display:grid;
    place-items:center;
    flex:none;
    border-radius:11px;
    background:#eaf2ff;
    color:var(--blue);
}

.page-link strong{
    display:block;
    font-size:10px;
    font-weight:900;
}

.page-link span{
    display:block;
    margin-top:3px;
    color:var(--muted);
    font-size:8px;
}

/* status */

.status-box{
    display:flex;
    align-items:center;
    gap:12px;
    padding:14px;
    margin-bottom:15px;
    border:1px solid rgba(14,159,110,.15);
    border-radius:14px;
    background:rgba(14,159,110,.06);
}

.status-icon{
    width:38px;
    height:38px;
    display:grid;
    place-items:center;
    border-radius:11px;
    background:#e8f8f1;
    color:var(--green);
}

.status-box strong{
    display:block;
    font-size:10px;
}

.status-box span{
    display:block;
    margin-top:3px;
    color:var(--muted);
    font-size:8px;
}

/* toast */

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    z-index:3000;
    display:flex;
    align-items:center;
    gap:10px;
    max-width:340px;
    padding:13px 15px;
    border:1px solid var(--line);
    border-radius:14px;
    background:var(--surface);
    color:var(--text);
    box-shadow:0 18px 45px rgba(0,0,0,.18);
    opacity:0;
    pointer-events:none;
    transform:translateY(18px);
    transition:.3s ease;
    font-size:9px;
    font-weight:800;
}

.toast.show{
    opacity:1;
    pointer-events:auto;
    transform:none;
}

.toast i{color:var(--green)}

.footer{
    padding:22px 2px 5px;
    color:var(--muted);
    text-align:center;
    font-size:8px;
}

/* ---------- responsive ---------- */

@media(max-width:1150px){
    .settings-grid{
        grid-template-columns:1fr;
    }

    .settings-nav{
        position:static;
        display:flex;
        gap:5px;
        overflow-x:auto;
        padding:7px;
    }

    .settings-tab{
        width:auto;
        min-width:max-content;
    }
}

@media(max-width:850px){
    .sidebar{
        width:240px;
        transform:translateX(-100%);
        transition:.25s ease;
    }

    body.sidebar-open .sidebar{
        transform:none;
    }

    .main{
        width:100%;
        margin-left:0;
        padding:17px;
    }

    .mobile-menu{display:grid}

    .hero{
        align-items:flex-start;
        flex-direction:column;
        padding:25px;
    }
}

@media(max-width:650px){
    .main{padding:12px}

    .topbar{margin-bottom:13px}

    .hero h1{font-size:28px}

    .hero p{font-size:10px}

    .hero-actions{width:100%}

    .hero-btn{
        flex:1;
    }

    .card-head,
    .card-body{
        padding:17px;
    }

    .setting-row{
        align-items:flex-start;
        flex-direction:column;
        gap:12px;
    }

    .select{
        width:100%;
    }

    .form-grid,
    .page-links{
        grid-template-columns:1fr;
    }

    .profile{
        grid-template-columns:60px 1fr;
    }

    .profile-avatar{
        width:60px;
        height:60px;
        border-radius:18px;
        font-size:21px;
    }

    .toast{
        left:12px;
        right:12px;
        bottom:12px;
        max-width:none;
    }
}

@media(prefers-reduced-motion:reduce){
    *,*:before,*:after{
        animation-duration:.01ms!important;
        animation-iteration-count:1!important;
        scroll-behavior:auto!important;
        transition:none!important;
    }
}

@media print{
    .sidebar,
    .topbar,
    .hero-actions,
    .settings-nav{
        display:none!important;
    }

    .main{
        width:100%;
        margin:0;
        padding:0;
    }

    .hero{
        border-radius:0;
        box-shadow:none;
    }
}
</style>
</head>

<body>

<div class="ambient">
    <span class="orb one"></span>
    <span class="orb two"></span>
    <span class="orb three"></span>
</div>

<div class="app">

<!-- ================= SIDEBAR ================= -->

<aside class="sidebar">

    <div class="brand">
        <div class="brand-logo">
            <i class="fas fa-school"></i>
        </div>
        <div>
            <h2>Gyan Jyoti</h2>
            <span>School Administration</span>
        </div>
    </div>

    <div class="menu-label">Main Menu</div>

    <nav class="menu">

        <a href="/admin/dashboard">
            <i class="fas fa-grid-2"></i>
            <span>Dashboard</span>
