<%- include('../../partials/header') %>

<section class="popup-manager">
  <div class="container">

    <div class="popup-header">
      <div>

        <div class="popup-eyebrow">
          <i class="fas fa-sliders"></i>
          ADMIN CONTROL PANEL
        </div>

        <h1>
          <i class="fas fa-images"></i>
          Popup Manager
        </h1>

        <p>
          Manage, edit and monitor all homepage popups from one place.
        </p>

      </div>

      <div class="header-actions">

        <div class="popup-count">
          <strong><%= popups.length %></strong>
          <span>
            <%= popups.length === 1 ? 'Popup' : 'Popups' %>
          </span>
        </div>

        <a
          href="/admin/popup/add"
          class="add-popup-btn"
        >
          <i class="fas fa-plus"></i>
          Add New Popup
        </a>

      </div>
    </div>


    <!-- TOOLBAR -->

    <div class="popup-toolbar">

      <div class="toolbar-title">
        <i class="fas fa-list"></i>
        <span>All Homepage Popups</span>
      </div>

      <div class="search-box">

        <i class="fas fa-search"></i>

        <input
          id="popupSearch"
          type="search"
          placeholder="Search popup..."
          autocomplete="off"
        >

      </div>

    </div>


    <!-- TABLE -->

    <div class="popup-table-card">

      <% if (popups && popups.length > 0) { %>

        <div class="table-scroll">

          <table class="popup-table">

            <thead>

              <tr>

                <th>Preview</th>
                <th>Popup Details</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Delay</th>
                <th>Show Once</th>
                <th>Created</th>
                <th>Actions</th>

              </tr>

            </thead>


            <tbody id="popupRows">

              <% popups.forEach((popup) => { %>

                <tr class="popup-row">

                  <!-- PREVIEW -->

                  <td>

                    <div class="image-wrap">

                      <% if (popup.image) { %>

                        <img
                          src="<%= popup.image %>"
                          class="popup-preview"
                          alt="<%= popup.title || 'Popup' %>"
                          loading="lazy"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                        >

                        <div class="image-fallback">

                          <i class="fas fa-image"></i>

                          <span>
                            Image unavailable
                          </span>

                        </div>

                      <% } else { %>

                        <div class="image-fallback visible">

                          <i class="fas fa-image"></i>

                          <span>
                            No image
                          </span>

                        </div>

                      <% } %>

                    </div>

                  </td>


                  <!-- TITLE / SUBTITLE -->

                  <td class="details-cell">

                    <div class="popup-title">
                      <%= popup.title || 'Untitled Popup' %>
                    </div>

                    <div class="popup-subtitle">
                      <%= popup.subtitle || 'No description added.' %>
                    </div>


                    <% if (popup.buttonText) { %>

                      <div class="popup-link">

                        <i class="fas fa-link"></i>

                        <%= popup.buttonText %>

                        <% if (popup.buttonLink) { %>

                          · <%= popup.buttonLink %>

                        <% } %>

                      </div>

                    <% } %>

                  </td>


                  <!-- STATUS -->

                  <td>

                    <% if (popup.enabled) { %>

                      <span class="status-badge enabled">

                        <span class="status-dot"></span>

                        Enabled

                      </span>

                    <% } else { %>

                      <span class="status-badge disabled">

                        <span class="status-dot"></span>

                        Disabled

                      </span>

                    <% } %>

                  </td>


                  <!-- PRIORITY -->

                  <td>

                    <span class="number-pill">
                      <%= popup.priority ?? 0 %>
                    </span>

                  </td>


                  <!-- DELAY -->

                  <td>

                    <span class="delay-text">
                      <%= popup.delay ?? 0 %> ms
                    </span>

                  </td>


                  <!-- SHOW ONCE -->

                  <td>

                    <% if (popup.showOnce) { %>

                      <span class="yes-badge">
                        Yes
                      </span>

                    <% } else { %>

                      <span class="no-badge">
                        No
                      </span>

                    <% } %>

                  </td>


                  <!-- CREATED -->

                  <td>

                    <span class="date-text">

                      <%= popup.createdAt
                        ? new Date(popup.createdAt).toLocaleDateString('en-IN')
                        : '-'
                      %>

                    </span>

                  </td>


                  <!-- ACTIONS -->

                  <td class="actions-cell">

                    <div class="popup-actions">


                      <!-- EDIT -->

                      <a
                        href="/admin/popup/edit/<%= popup._id %>"
                        class="action-btn edit-btn"
                        title="Edit Popup"
                      >

                        <i class="fas fa-pen"></i>

                        <span>
                          Edit
                        </span>

                      </a>


                      <!-- DELETE -->

                      <form
                        action="/admin/popup/delete/<%= popup._id %>"
                        method="POST"
                        class="delete-popup-form"
                        onsubmit="return confirm('Are you sure you want to delete this popup?')"
                      >

                        <input
                          type="hidden"
                          name="_csrf"
                          value="<%= csrfToken %>"
                        >

                        <button
                          type="submit"
                          class="action-btn delete-btn"
                          title="Delete Popup"
                        >

                          <i class="fas fa-trash"></i>

                          <span>
                            Delete
                          </span>

                        </button>

                      </form>


                    </div>

                  </td>

                </tr>

              <% }) %>

            </tbody>

          </table>

        </div>


        <!-- NO SEARCH RESULTS -->

        <div
          id="noSearchResults"
          class="no-search-results"
          hidden
        >

          <i class="fas fa-search"></i>

          <h3>
            No matching popup
          </h3>

          <p>
            Try another title or keyword.
          </p>

        </div>


      <% } else { %>


        <!-- EMPTY -->

        <div class="empty-popup">

          <div class="empty-icon">

            <i class="fas fa-images"></i>

          </div>

          <h3>
            No Popup Found
          </h3>

          <p>
            Create your first homepage popup to start managing campaigns.
          </p>

          <a
            href="/admin/popup/add"
            class="add-popup-btn"
          >

            <i class="fas fa-plus"></i>

            Create Popup

          </a>

        </div>


      <% } %>

    </div>

  </div>
</section>


<!-- =========================================================
     CSS
========================================================= -->

<style>

.popup-manager{
  min-height:calc(100vh - 120px);
  padding:55px 30px 80px;
  background:
    radial-gradient(circle at 10% 10%, rgba(255,193,7,.08), transparent 28%),
    linear-gradient(135deg,#f4f8fc 0%,#eef4fa 100%);
  color:#17324d;
}

.popup-manager .container{
  width:min(1280px,100%);
  margin:0 auto;
}

.popup-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:30px;
  margin-bottom:28px;
}

.popup-eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin-bottom:10px;
  color:#b07b00;
  font-size:11px;
  font-weight:800;
  letter-spacing:1.6px;
}

.popup-header h1{
  display:flex;
  align-items:center;
  gap:12px;
  margin:0;
  color:#002b57 !important;
  font-size:38px;
  line-height:1.1;
  font-weight:900;
}

.popup-header h1 i{
  color:#f5b900 !important;
}

.popup-header p{
  margin:10px 0 0;
  color:#66798c !important;
  font-size:15px;
}

.header-actions{
  display:flex;
  align-items:center;
  gap:14px;
}

.popup-count{
  display:flex;
  align-items:center;
  gap:8px;
  padding:12px 16px;
  background:#fff;
  border:1px solid #e2eaf2;
  border-radius:15px;
  box-shadow:0 10px 25px rgba(0,33,71,.06);
}

.popup-count strong{
  color:#002b57;
  font-size:20px;
}

.popup-count span{
  color:#708296;
  font-size:13px;
  font-weight:700;
}

.add-popup-btn{
  display:inline-flex !important;
  align-items:center;
  justify-content:center;
  gap:9px;
  min-height:48px;
  padding:0 23px;
  border:0;
  border-radius:14px;
  background:linear-gradient(135deg,#ffc107,#ffda57) !important;
  color:#002b57 !important;
  text-decoration:none !important;
  font-size:14px;
  font-weight:800;
  box-shadow:0 12px 30px rgba(255,193,7,.28);
  transition:transform .2s ease,box-shadow .2s ease;
}

.add-popup-btn:hover{
  transform:translateY(-2px);
  box-shadow:0 16px 35px rgba(255,193,7,.38);
}

.popup-toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin-bottom:14px;
}

.toolbar-title{
  display:flex;
  align-items:center;
  gap:9px;
  color:#002b57;
  font-size:14px;
  font-weight:800;
}

.toolbar-title i{
  color:#d59b00;
}

.search-box{
  width:min(300px,100%);
  height:44px;
  display:flex;
  align-items:center;
  gap:9px;
  padding:0 14px;
  background:#fff;
  border:1px solid #dce6ef;
  border-radius:13px;
  box-shadow:0 8px 20px rgba(0,33,71,.04);
}

.search-box i{
  color:#7d91a5;
}

.search-box input{
  width:100%;
  border:0;
  outline:0;
  background:transparent;
  color:#17324d;
  font-size:13px;
}

.popup-table-card{
  overflow:hidden;
  background:#fff;
  border:1px solid #e1eaf2;
  border-radius:22px;
  box-shadow:0 22px 60px rgba(0,33,71,.09);
}

.table-scroll{
  width:100%;
  overflow-x:auto;
}

.popup-table{
  width:100%;
  min-width:1120px;
  border-collapse:separate;
  border-spacing:0;
  table-layout:auto;
}

.popup-table thead{
  background:#002b57 !important;
}

.popup-table th{
  padding:18px 16px !important;
  background:#002b57 !important;
  color:#fff !important;
  border:0 !important;
  font-size:12px !important;
  font-weight:800 !important;
  letter-spacing:.3px;
  text-align:left !important;
  white-space:nowrap;
}

.popup-table tbody tr{
  opacity:1 !important;
  visibility:visible !important;
  display:table-row !important;
  background:#fff !important;
}

.popup-table tbody tr:hover{
  background:#f8fbff !important;
}

.popup-table td{
  padding:17px 16px !important;
  background:#fff !important;
  color:#233c54 !important;
  border-bottom:1px solid #eaf0f5 !important;
  vertical-align:middle !important;
}

.popup-table td h4,
.popup-table td .popup-title{
  color:#002b57 !important;
  opacity:1 !important;
}

.image-wrap{
  position:relative;
  width:120px;
  height:72px;
}

.popup-preview{
  display:block !important;
  width:120px !important;
  height:72px !important;
  object-fit:cover;
  border-radius:12px;
  border:1px solid #e0e8ef;
  box-shadow:0 7px 18px rgba(0,0,0,.12);
  cursor:pointer;
}

.image-fallback{
  display:none;
  width:120px;
  height:72px;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:4px;
  border-radius:12px;
  background:#edf3f8;
  color:#7c8e9f;
  font-size:10px;
  text-align:center;
}

.image-fallback.visible{
  display:flex;
}

.image-fallback i{
  font-size:19px;
}

.details-cell{
  min-width:230px;
}

.popup-title{
  font-size:16px;
  line-height:1.25;
  font-weight:850;
}

.popup-subtitle{
  max-width:330px;
  margin-top:6px;
  color:#728397 !important;
  font-size:12px;
  line-height:1.5;
}

.popup-link{
  margin-top:8px;
  color:#47718f !important;
  font-size:11px;
  font-weight:700;
}

.popup-link i{
  margin-right:4px;
  color:#d29a00;
}

.status-badge,
.yes-badge,
.no-badge,
.number-pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  white-space:nowrap;
  border-radius:999px;
  font-size:11px;
  font-weight:800;
}

.status-badge{
  gap:7px;
  padding:8px 12px;
}

.status-badge.enabled{
  background:#e7f8ed !important;
  color:#187542 !important;
}

.status-badge.disabled{
  background:#ffebeb !important;
  color:#bd3333 !important;
}

.status-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:currentColor;
}

.number-pill{
  min-width:30px;
  height:30px;
  padding:0 9px;
  background:#eef5fb;
  color:#003b70 !important;
}

.delay-text,
.date-text{
  color:#536b81 !important;
  font-size:12px;
  font-weight:700;
}

.yes-badge{
  padding:7px 11px;
  background:#e8f8ef !important;
  color:#16743f !important;
}

.no-badge{
  padding:7px 11px;
  background:#f0f2f4 !important;
  color:#6d7780 !important;
}

.actions-cell{
  min-width:190px;
}

.popup-actions{
  display:flex;
  align-items:center;
  gap:8px;
}

.action-btn{
  display:inline-flex !important;
  align-items:center;
  justify-content:center;
  gap:7px;
  min-width:82px;
  height:40px;
  padding:0 12px;
  border-radius:10px;
  text-decoration:none !important;
  font-family:inherit;
  font-size:12px;
  font-weight:800;
  opacity:1 !important;
  visibility:visible !important;
  transition:transform .18s ease,background .18s ease;
  cursor:pointer;
}

.action-btn:hover{
  transform:translateY(-2px);
}

.edit-btn{
  background:#fff3d0 !important;
  color:#8b6500 !important;
  border:1px solid #f2d98a !important;
}

.edit-btn:hover{
  background:#ffc107 !important;
  color:#002b57 !important;
}

.delete-btn{
  background:#ffeded !important;
  color:#c32d2d !important;
  border:1px solid #f2c0c0 !important;
}

.delete-btn:hover{
  background:#dc3545 !important;
  color:#fff !important;
}

.delete-popup-form{
  display:inline;
  margin:0;
  padding:0;
}

.empty-popup,
.no-search-results{
  padding:75px 25px;
  text-align:center;
}

.empty-icon{
  width:80px;
  height:80px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 20px;
  border-radius:24px;
  background:#fff4d2;
  color:#d59b00;
  font-size:32px;
}

.empty-popup h3,
.no-search-results h3{
  margin:0 0 8px;
  color:#002b57;
  font-size:24px;
}

.empty-popup p,
.no-search-results p{
  margin:0 0 24px;
  color:#708296;
}

.no-search-results[hidden]{
  display:none !important;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:900px){

  .popup-header{
    align-items:flex-start;
    flex-direction:column;
  }

  .header-actions{
    width:100%;
    justify-content:space-between;
  }

  .popup-toolbar{
    align-items:stretch;
    flex-direction:column;
  }

  .search-box{
    width:100%;
  }

}


@media(max-width:600px){

  .popup-manager{
    padding:35px 14px 60px;
  }

  .popup-header h1{
    font-size:29px;
  }

  .header-actions{
    align-items:stretch;
    flex-direction:column;
  }

  .popup-count{
    justify-content:center;
  }

  .add-popup-btn{
    width:100%;
  }

}

</style>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

document.addEventListener(
  'DOMContentLoaded',
  function () {


    /* =====================================================
       SEARCH
    ===================================================== */

    const search =
      document.getElementById(
        'popupSearch'
      );


    const rows =
      document.querySelectorAll(
        '.popup-row'
      );


    const noResults =
      document.getElementById(
        'noSearchResults'
      );


    if (search) {

      search.addEventListener(
        'input',
        function () {

          const keyword =
            this.value
              .trim()
              .toLowerCase();


          let visible = 0;


          rows.forEach(
            function (row) {

              const match =
                row.textContent
                  .toLowerCase()
                  .includes(keyword);


              row.style.display =
                match
                  ? 'table-row'
                  : 'none';


              if (match) {
                visible++;
              }

            }
          );


          if (noResults) {

            noResults.hidden =
              visible !== 0;

          }

        }
      );

    }


    /* =====================================================
       IMAGE LIGHTBOX
    ===================================================== */

    document
      .querySelectorAll(
        '.popup-preview'
      )
      .forEach(
        function (img) {

          img.addEventListener(
            'click',
            function () {


              const overlay =
                document.createElement(
                  'div'
                );


              overlay.style.cssText = `
                position:fixed;
                inset:0;
                z-index:99999;
                display:flex;
                align-items:center;
                justify-content:center;
                padding:30px;
                background:rgba(0,20,40,.88);
                cursor:zoom-out;
              `;


              const preview =
                document.createElement(
                  'img'
                );


              preview.src =
                img.src;


              preview.style.cssText = `
                max-width:92vw;
                max-height:88vh;
                object-fit:contain;
                border-radius:18px;
                box-shadow:0 25px 80px rgba(0,0,0,.45);
              `;


              overlay.appendChild(
                preview
              );


              document.body.appendChild(
                overlay
              );


              overlay.addEventListener(
                'click',
                function () {

                  overlay.remove();

                }
              );

            }
          );

        }
      );

  }
);

</script>