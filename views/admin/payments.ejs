<%
/*
 * GYAN JYOTI SCHOOL
 * ADMIN - PAYMENT MANAGEMENT
 *
 * Expected route:
 * GET /admin/payments
 *
 * Expected view:
 * views/admin/payment.ejs
 *
 * Safe defaults are intentionally used so this page does not throw
 * EJS ReferenceError when an optional value is not supplied by admin.js.
 */

const safePayments =
    (typeof payments !== 'undefined' && Array.isArray(payments))
        ? payments
        : [];

const rawStats =
    (typeof stats !== 'undefined' && stats)
        ? stats
        : {};

const safeStats = {
    total: Number(rawStats.total) || 0,
    paid: Number(rawStats.paid) || 0,
    pending: Number(rawStats.pending) || 0,
    failed: Number(rawStats.failed) || 0,
    cancelled: Number(rawStats.cancelled) || 0,
    refunded: Number(rawStats.refunded) || 0,
    revenue: Number(rawStats.revenue) || 0
};

const safePaidAmount =
    Number(typeof paidAmount !== 'undefined' ? paidAmount : safeStats.revenue) || 0;

const safePendingAmount =
    Number(typeof pendingAmount !== 'undefined' ? pendingAmount : 0) || 0;

const safeFailedAmount =
    Number(typeof failedAmount !== 'undefined' ? failedAmount : 0) || 0;

/*
 * Sidebar counters.
 * Each counter is declared exactly once.
 * typeof prevents EJS ReferenceError when admin.js does not pass it.
 */
const safeAdmissionCount =
    Number(typeof admissionCount !== 'undefined' ? admissionCount : 0) || 0;

const safeEnquiryCount =
    Number(typeof enquiryCount !== 'undefined' ? enquiryCount : 0) || 0;

const safeContactCount =
    Number(typeof contactCount !== 'undefined' ? contactCount : 0) || 0;

const safeNotificationCount =
    Number(typeof notificationCount !== 'undefined' ? notificationCount : 0) || 0;

const safeKeyword =
    typeof keyword !== 'undefined' ? keyword : '';

const safeStatus =
    typeof status !== 'undefined' ? status : '';

const safeType =
    typeof type !== 'undefined' ? type : '';

const safeAdminName =
    typeof adminName !== 'undefined'
        ? adminName
        : 'Administrator';

const safeCsrf =
    typeof csrfToken !== 'undefined'
        ? csrfToken
        : '';

function money(value) {
    return '₹' + Number(value || 0).toLocaleString('en-IN');
}

function formatDate(value) {
    if (!value) return '-';

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) return '-';

    return date.toLocaleString('en-IN', {
        day: '2-digit',
        month: 'short',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
}

function paymentPerson(payment) {
    if (
        payment &&
        payment.admission &&
        payment.admission.studentName
    ) {
        return payment.admission.studentName;
    }

    if (
        payment &&
        payment.enquiry &&
        payment.enquiry.name
    ) {
        return payment.enquiry.name;
    }

    return 'Unknown applicant';
}

function paymentPhone(payment) {
    if (
        payment &&
        payment.admission &&
        payment.admission.phone
    ) {
        return payment.admission.phone;
    }

    if (
        payment &&
        payment.enquiry &&
        payment.enquiry.phone
    ) {
        return payment.enquiry.phone;
    }

    return '';
}

function methodLabel(method) {
    const labels = {
        online: 'Online',
        upi: 'UPI',
        netbanking: 'Net Banking',
        card: 'Card',
        cash: 'Cash'
    };

    return labels[method] || method || '-';
}
%>

