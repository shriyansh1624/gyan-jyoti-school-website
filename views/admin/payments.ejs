</head>
<body>
<div class="ambient"><span class="orb one"></span><span class="orb two"></span><span class="orb three"></span></div>
<div class="app">
<aside class="sidebar">
<div class="brand"><div class="brand-logo"><i class="fas fa-school"></i></div><div><h2>Gyan Jyoti</h2><span>School Administration</span></div></div>
<div class="menu-label">Main Menu</div>
<nav class="menu">
<a href="/admin/dashboard"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>
<a href="/admin/admissions"><i class="fas fa-user-graduate"></i><span>Admissions</span><% if(safeAdmissionCount>0){ %><b class="menu-count"><%= safeAdmissionCount %></b><% } %></a>
<a href="/admin/enquiries><i class="fas fa-message"></i><span>Enquiries</span><% if(safeEnquiryCount>0){ %><b class="menu-count"><%= safeEnquiryCount %></b><% } %></a>
<a href="/admin/contacts"><i class="fas fa-address-book"></i><span>Contacts</span><% if(safeContactCount>0){ %><b class="menu-count"><%= safeContactCount %></b><% } %></a>
<a href="/admin/payments" class="active"><i class="fas fa-wallet"></i><span>Fees & Payments</span></a>
<a href="/admin/events"><i class="fas fa-calendar-days"></i><span>Events</span></a>
<a href="/admin/faculty"><i class="fas fa-chalkboard-user"></i><span>Faculty</span></a>
</nav>
<div class="menu-label" style="margin-top:24px">System</div>
<nav class="menu"><a href="/admin/settings"><i class="fas fa-gear"></i><span>Settings</span></a><a href="/admin/logout"><i class="fas fa-right-from-bracket"></i><span>Logout</span></a></nav>
<div class="sidebar-footer"><small>SIGNED IN AS</small><strong><%= safeAdminName %></strong></div>
</aside>
<main class="main">
<div class="topbar reveal"><div class="breadcrumbs">Admin <span>/</span> <strong>Fees & Payments</strong></div><div class="top-actions"><button class="icon-btn mobile-menu" type="button" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button><a href="/admin/dashboard" class="icon-btn" title="Dashboard"><i class="fas fa-house"></i></a><button type="button" class="icon-btn" onclick="toggleTheme()" title="Toggle theme"><i class="fas fa-moon"></i></button></div></div>
<section class="hero reveal delay1"><div class="hero-content"><div class="eyebrow"><i class="fas fa-shield-halved"></i> Secure Finance Console</div><h1>Fees & Payments</h1><p>Manage school payment activity with a clean, premium finance workspace. Track collections, monitor pending amounts, search transactions and update payment status without changing your existing backend.</p></div><div class="hero-actions"><a href="/admin/dashboard" class="hero-btn"><i class="fas fa-arrow-left"></i> Dashboard</a><button type="button" class="hero-btn" onclick="window.print()"><i class="fas fa-print"></i> Print Report</button></div></section>
<section class="kpis">
<article class="kpi reveal delay1" style="--accent:#1769e0;--icon-bg:#eaf2ff"><div class="kpi-icon"><i class="fas fa-receipt"></i></div><div class="kpi-value counter" data-value="<%= safeStats.total %>">0</div><div class="kpi-label">Total Transactions</div><div class="kpi-sub">All payment records</div></article>
<article class="kpi reveal delay2" style="--accent:#0f9f6e;--icon-bg:#e8f8f1"><div class="kpi-icon"><i class="fas fa-circle-check"></i></div><div class="kpi-value counter" data-value="<%= safeStats.paid %>">0</div><div class="kpi-label">Successful Payments</div><div class="kpi-sub">Successfully collected</div></article>
<article class="kpi reveal delay3" style="--accent:#e98b2a;--icon-bg:#fff4e5"><div class="kpi-icon"><i class="fas fa-clock"></i></div><div class="kpi-value counter" data-value="<%= safeStats.pending %>">0</div><div class="kpi-label">Pending Payments</div><div class="kpi-sub">Awaiting completion</div></article>
<article class="kpi reveal delay4" style="--accent:#f6c343;--icon-bg:#fff6d8"><div class="kpi-icon"><i class="fas fa-indian-rupee-sign"></i></div><div class="kpi-value"><%= money(safePaidAmount) %></div><div class="kpi-label">Collected Revenue</div><div class="kpi-sub">From paid transactions</div></article>
</section>
<section class="filter-card reveal"><div class="filter-head"><div><h2><i class="fas fa-sliders"></i> Transaction Search</h2><span>Filter payments by applicant, status or type</span></div><% if(safeNotificationCount>0){ %><span class="result-pill"><i class="fas fa-bell"></i><%= safeNotificationCount %> notifications</span><% } %></div>
<form class="filters" method="GET" action="/admin/payments"><div class="field"><i class="fas fa-magnifying-glass"></i><input type="search" name="search" value="<%= safeKeyword %>" placeholder="Search student, parent, phone, order ID..." autocomplete="off"></div><div class="field"><select name="status"><option value="">All Status</option><option value="paid" <%= safeStatus==='paid'?'selected':'' %>>Paid</option><option value="pending" <%= safeStatus==='pending'?'selected':'' %>>Pending</option><option value="failed" <%= safeStatus==='failed'?'selected':'' %>>Failed</option><option value="cancelled" <%= safeStatus==='cancelled'?'selected':'' %>>Cancelled</option><option value="refunded" <%= safeStatus==='refunded'?'selected':'' %>>Refunded</option></select></div><div class="field"><select name="type"><option value="">All Types</option><option value="admission" <%= safeType==='admission'?'selected':'' %>>Admission</option><option value="enquiry" <%= safeType==='enquiry'?'selected':'' %>>Enquiry</option></select></div><button class="filter-btn" type="submit"><i class="fas fa-search"></i> Apply</button><a href="/admin/payments" class="clear-btn"><i class="fas fa-rotate-left"></i> Reset</a></form></section>
<div class="content-grid">
<section class="panel reveal delay2"><div class="panel-head"><div class="panel-title"><div class="panel-title-icon"><i class="fas fa-money-check-dollar"></i></div><div><h2>Payment Transactions</h2><p>Review and manage all recorded payments</p></div></div><span class="result-pill"><%= safePayments.length %> shown</span></div>
<div class="table-wrap"><table><thead><tr><th>Applicant</th><th>Type</th><th>Amount</th><th>Method</th><th>Status</th><th>Transaction</th><th>Date</th><th>Action</th></tr></thead><tbody>
<% if(safePayments.length>0){ safePayments.forEach(payment=>{ const person=paymentPerson(payment); const phone=paymentPhone(payment); const initial=person.charAt(0).toUpperCase(); const paymentType=payment.type==='admission'?'Admission':'Enquiry'; const statusValue=payment.status||'pending'; %>
<tr><td><div class="person"><div class="avatar"><%= initial||'?' %></div><div><strong><%= person %></strong><small><%= phone||'No phone available' %></small></div></div></td>
<td><span class="type-pill <%= payment.type==='admission'?'type-admission':'type-enquiry' %>"><i class="fas <%= payment.type==='admission'?'fa-user-graduate':'fa-message' %>"></i><%= paymentType %></span></td>
<td><span class="amount"><%= money(payment.amount) %></span></td><td><span style="color:var(--text);font-size:9px;font-weight:750"><%= methodLabel(payment.method) %></span></td>
<td><span class="status-pill status-<%= statusValue %>"><i class="fas <%= statusValue==='paid'?'fa-circle-check':statusValue==='pending'?'fa-clock':statusValue==='refunded'?'fa-rotate-left':'fa-circle-xmark' %>"></i><%= String(statusValue).replace(/-/g,' ').replace(/\b\w/g,c=>c.toUpperCase()) %></span></td>
<td><div class="transaction"><%= payment.transactionId||payment.orderId||payment.receiptNumber||'-' %></div></td><td><span class="date"><%= formatDate(payment.createdAt) %></span></td>
<td><div class="actions"><a href="/admin/payment/<%= payment._id %>" class="view-btn" title="View payment"><i class="fas fa-eye"></i></a><form class="status-form" method="POST" action="/admin/payment/<%= payment._id %>/status"><% if(safeCsrf){ %><input type="hidden" name="_csrf" value="<%= safeCsrf %>"><% } %><select name="status" onchange="confirmStatusChange(this)" title="Change payment status"><option value="pending" <%= statusValue==='pending'?'selected':'' %>>Pending</option><option value="paid" <%= statusValue==='paid'?'selected':'' %>>Paid</option><option value="failed" <%= statusValue==='failed'?'selected':'' %>>Failed</option><option value="cancelled" <%= statusValue==='cancelled'?'selected':'' %>>Cancelled</option><option value="refunded" <%= statusValue==='refunded'?'selected':'' %>>Refunded</option></select></form></div></td></tr>
<% }); } else { %><tr><td colspan="8" class="empty"><div class="empty-icon"><i class="fas fa-wallet"></i></div><strong>No payment records found</strong><span>Try changing your search or filters.</span></td></tr><% } %>
</tbody></table></div></section>
<aside class="side-stack">
<section class="mini-card reveal delay3"><div class="mini-head"><h3>Revenue Summary</h3><i class="fas fa-chart-line"></i></div><div class="revenue-box"><small>TOTAL COLLECTED</small><strong><%= money(safePaidAmount) %></strong><span>From successful payments</span></div></section>
<section class="mini-card reveal delay4"><div class="mini-head"><h3>Status Breakdown</h3><i class="fas fa-chart-pie"></i></div><div class="breakdown">
<% const statusRows=[['green','fa-check','Paid',safeStats.paid],['orange','fa-clock','Pending',safeStats.pending],['red','fa-xmark','Failed',safeStats.failed],['purple','fa-rotate-left','Refunded',safeStats.refunded]]; statusRows.forEach(r=>{ const pct=safeStats.total?Math.min(100,(Number(r[3])||0)/safeStats.total*100):0; %><div class="breakdown-row"><div class="break-icon <%= r[0] %>"><i class="fas <%= r[1] %>"></i></div><div class="break-label"><strong><%= r[2] %></strong><span><i style="width:<%= pct %>%;--bar:<%= r[0]==='green'?'#0f9f6e':r[0]==='orange'?'#e98b2a':r[0]==='red'?'#dc3f4d':'#7357d8' %>"></i></span></div><div class="break-value"><%= r[3] %></div></div><% }); %>
</div></section>
<section class="mini-card reveal"><div class="mini-head"><h3>Amount Overview</h3><i class="fas fa-hourglass-half"></i></div><div class="amount-list"><div class="amount-row"><span>Pending</span><strong style="color:var(--orange)"><%= money(safePendingAmount) %></strong></div><div class="amount-row"><span>Failed</span><strong style="color:var(--red)"><%= money(safeFailedAmount) %></strong></div><div class="amount-row"><span>Collected</span><strong style="color:var(--green)"><%= money(safePaidAmount) %></strong></div></div></section>
<section class="mini-card reveal"><div class="mini-head"><h3>Quick Navigation</h3><i class="fas fa-bolt"></i></div><div class="quick-links"><a class="quick-link" href="/admin/dashboard"><i class="fas fa-grid-2"></i>Dashboard</a><a class="quick-link" href="/admin/admissions"><i class="fas fa-user-graduate"></i>Admissions</a><a class="quick-link" href="/admin/enquiries"><i class="fas fa-message"></i>Enquiries</a><a class="quick-link" href="/admin/contacts"><i class="fas fa-address-book"></i>Contacts</a></div></section>
</aside></div>
<footer class="footer">Gyan Jyoti School Admin Panel • Secure Payment Management</footer>
</main></div>
<script>
function toggleTheme(){document.body.classList.toggle('dark');localStorage.setItem('adminPaymentTheme',document.body.classList.contains('dark')?'dark':'light')}
function toggleSidebar(){document.body.classList.toggle('sidebar-open')}
function confirmStatusChange(select){const form=select.closest('form');if(!form)return;const newStatus=select.value;if(window.confirm('Change this payment status to "'+newStatus.replace(/-/g,' ')+'"?'))form.submit();else window.location.reload()}
document.addEventListener('click',e=>{const s=document.querySelector('.sidebar'),b=document.querySelector('.mobile-menu');if(innerWidth<=850&&document.body.classList.contains('sidebar-open')&&s&&!s.contains(e.target)&&b&&!b.contains(e.target))document.body.classList.remove('sidebar-open')});
(function(){if(localStorage.getItem('adminPaymentTheme')==='dark')document.body.classList.add('dark');document.querySelectorAll('.counter').forEach(el=>{const target=Number(el.dataset.value)||0;let start=0;const duration=700;const t0=performance.now();function tick(t){const p=Math.min(1,(t-t0)/duration);const eased=1-Math.pow(1-p,3);el.textContent=Math.round(start+(target-start)*eased).toLocaleString('en-IN');if(p<1)requestAnimationFrame(tick)}requestAnimationFrame(tick)})})();
</script>
</body></html>
