1px solid var(--line);border-radius:11px;font-size:9px;font-weight:800;transition:.2s}.quick-link i{width:22px;text-align:center;color:var(--blue)}.quick-link:hover{transform:translateX(3px);border-color:var(--gold);background:rgba(246,195,67,.08)}.footer{text-align:center;padding:20px 2px 4px;color:var(--muted);font-size:8px}
.reveal{animation:reveal .65s cubic-bezier(.2,.8,.2,1) both}.delay1{animation-delay:.06s}.delay2{animation-delay:.12s}.delay3{animation-delay:.18s}.delay4{animation-delay:.24s}@keyframes reveal{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@media(max-width:1200px){.kpis{grid-template-columns:repeat(2,1fr)}.content-grid{grid-template-columns:1fr}.side-stack{grid-template-columns:repeat(3,1fr)}.filters{grid-template-columns:1fr 1fr}.filter-btn,.clear-btn{width:100%}}
@media(max-width:850px){.sidebar{width:240px;transform:translateX(-105%);transition:.25s}.sidebar-open .sidebar{transform:translateX(0)}.main{width:100%;margin-left:0;padding:17px}.mobile-menu{display:grid}.hero{align-items:flex-start;flex-direction:column;padding:26px}.side-stack{grid-template-columns:1fr}.topbar{margin-bottom:12px}}
