<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#001f3f"
    >

    <title>
        <%= typeof title !== 'undefined'
            ? title
            : 'Fun & Fiesta' %>
        - Gyan Jyoti School
    </title>


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <!-- =====================================================
         MAIN CSS
    ====================================================== -->

    <link
        rel="stylesheet"
        href="/stylesheets/style.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/responsive.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/hero.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/components.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/animations.css"
    >

</head>


<body>


<!-- =========================================================
     HEADER
========================================================= -->

<%- include('../partials/header') %>


<%
    const eventList =
        Array.isArray(events)
            ? events
            : [];
%>


<!-- =========================================================
     HERO
========================================================= -->

<section class="events-hero">

    <div class="hero-glow hero-glow-one"></div>

    <div class="hero-glow hero-glow-two"></div>


    <div class="events-hero-content">

        <div class="hero-kicker">

            <i class="fas fa-face-grin-stars"></i>

            SCHOOL LIFE

        </div>


        <h1>

            Fun <span>&amp;</span> Fiesta

        </h1>


        <p>

            Celebrating joy, creativity,
            friendship and unforgettable
            moments together.

        </p>


        <div class="breadcrumb">

            <a href="/">

                Home

            </a>

            <i class="fas fa-chevron-right"></i>

            <span>

                Fun &amp; Fiesta

            </span>

        </div>

    </div>

</section>


<!-- =========================================================
     MAIN
========================================================= -->

<main class="events-page">


    <!-- =====================================================
         INTRO
    ====================================================== -->

    <section class="events-intro">


        <div class="intro-content">

            <span class="section-kicker">

                <i class="fas fa-star"></i>

                OUR MEMORIES

            </span>


            <h2>

                Moments That
                <span>Make Us Smile</span>

            </h2>


            <p>

                From colourful celebrations to
                exciting school activities, every
                event gives our students a chance
                to learn, participate and create
                memories that last forever.

            </p>

        </div>


        <div class="intro-stat">

            <div class="stat-icon">

                <i class="fas fa-images"></i>

            </div>


            <div>

                <strong>

                    <%= eventList.length %>

                </strong>


                <span>

                    <%= eventList.length === 1
                        ? 'Event'
                        : 'Events' %>

                </span>

            </div>

        </div>

    </section>


    <!-- =====================================================
         EVENT SECTION
    ====================================================== -->

    <section class="events-section">


        <div class="section-heading">


            <div>

                <span class="section-kicker">

                    <i class="fas fa-calendar-days"></i>

                    FUN &amp; FIESTA

                </span>


                <h2>

                    Explore Our
                    <span>Events</span>

                </h2>

            </div>


            <% if (eventList.length > 0) { %>

                <div class="event-total">

                    <i class="fas fa-layer-group"></i>

                    <%= eventList.length %>

                    <%= eventList.length === 1
                        ? 'Event'
                        : 'Events' %>

                </div>

            <% } %>


        </div>


        <!-- =================================================
             EVENTS AVAILABLE
        ================================================== -->

        <% if (eventList.length > 0) { %>


            <div class="events-grid">


                <% eventList.forEach(
                    function(event, index)
                { %>


                    <article
                        class="event-card"
                    >


                        <!-- =====================================
                             IMAGE
                        ====================================== -->

                        <div class="event-image-wrap">


                            <%
                                const eventImage =
                                    event.coverImage ||
                                    event.image ||
                                    '';
                            %>


                            <% if (eventImage) { %>


                                <img
                                    src="<%= eventImage %>"
                                    alt="<%= event.title || 'Fun & Fiesta Event' %>"
                                    class="event-image"
                                    loading="<%= index < 2
                                        ? 'eager'
                                        : 'lazy' %>"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                >


                                <div
                                    class="event-image-placeholder"
                                    style="display:none;"
                                >

                                    <i class="fas fa-images"></i>

                                </div>


                            <% } else { %>


                                <div
                                    class="event-image-placeholder"
                                >

                                    <i class="fas fa-images"></i>

                                </div>


                            <% } %>


                            <!-- CATEGORY -->

                            <div class="event-category">

                                <i class="fas fa-face-grin-stars"></i>

                                FUN &amp; FIESTA

                            </div>


                            <!-- DATE -->

                            <% if (event.date) { %>


                                <div class="event-date-badge">

                                    <i class="far fa-calendar"></i>


                                    <%= new Date(
                                        event.date
                                    ).toLocaleDateString(
                                        'en-IN',
                                        {
                                            day: '2-digit',
                                            month: 'short',
                                            year: 'numeric'
                                        }
                                    ) %>

                                </div>


                            <% } %>


                        </div>


                        <!-- =====================================
                             CARD CONTENT
                        ====================================== -->

                        <div class="event-card-content">


                            <!-- TITLE -->

                            <h3>

                                <%= event.title ||
                                    'Fun & Fiesta Event' %>

                            </h3>


                            <!-- DESCRIPTION -->

                            <% if (
                                event.description
                            ) { %>


                                <p>

                                    <%= event.description %>

                                </p>


                            <% } else { %>


                                <p>

                                    Relive the wonderful
                                    moments and memories
                                    from this memorable
                                    school event.

                                </p>


                            <% } %>


                            <!-- =================================
                                 META
                            ================================== -->

                            <div class="event-meta">


                                <!-- DATE -->

                                <% if (
                                    event.date
                                ) { %>


                                    <span>

                                        <i class="fas fa-calendar-days"></i>


                                        <%= new Date(
                                            event.date
                                        ).toLocaleDateString(
                                            'en-IN',
                                            {
                                                day: '2-digit',
                                                month: 'short',
                                                year: 'numeric'
                                            }
                                        ) %>

                                    </span>


                                <% } %>


                                <!-- SESSION -->

                                <% if (
                                    event.session
                                ) { %>


                                    <span>

                                        <i class="fas fa-calendar-check"></i>

                                        <%= event.session %>

                                    </span>


                                <% } %>


                                <!-- YEAR -->

                                <% if (
                                    event.year
                                ) { %>


                                    <span>

                                        <i class="fas fa-clock"></i>

                                        <%= event.year %>

                                    </span>


                                <% } %>


                                <!-- BATCH -->

                                <% if (
                                    event.batch
                                ) { %>


                                    <span>

                                        <i class="fas fa-users"></i>

                                        <%= event.batch %>

                                    </span>


                                <% } %>


                                <!-- PHOTOS -->

                                <% if (
                                    Array.isArray(
                                        event.photos
                                    ) &&
                                    event.photos.length > 0
                                ) { %>


                                    <span>

                                        <i class="fas fa-images"></i>

                                        <%= event.photos.length %>

                                        <%= event.photos.length === 1
                                            ? 'Photo'
                                            : 'Photos' %>

                                    </span>


                                <% } %>


                                <!-- VIDEOS -->

                                <% if (
                                    Array.isArray(
                                        event.videos
                                    ) &&
                                    event.videos.length > 0
                                ) { %>


                                    <span>

                                        <i class="fas fa-video"></i>

                                        <%= event.videos.length %>

                                        <%= event.videos.length === 1
                                            ? 'Video'
                                            : 'Videos' %>

                                    </span>


                                <% } %>


                            </div>


                            <!-- =================================
                                 VIEW GALLERY
                            ================================== -->

                            <a
                               href="/gallery/<%= event._id %>"
                                class="view-gallery-btn"
                                aria-label="View <%= event.title || 'event' %> gallery"
                            >


                                <span class="view-gallery-text">

                                    <i class="fas fa-images"></i>

                                    View Gallery

                                </span>


                                <span class="gallery-arrow">

                                    <i class="fas fa-arrow-right"></i>

                                </span>


                            </a>


                        </div>


                    </article>


                <% }) %>


            </div>


        <% } else { %>


            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <div class="empty-events">


                <div class="empty-icon">

                    <i class="fas fa-camera-retro"></i>

                </div>


                <span class="section-kicker">

                    FUN &amp; FIESTA

                </span>


                <h2>

                    No Events Yet

                </h2>


                <p>

                    Fun &amp; Fiesta memories will
                    appear here once they are added
                    by the school administration.

                </p>


                <a
                    href="/"
                    class="back-home-btn"
                >

                    <i class="fas fa-house"></i>

                    Back to Home

                </a>


            </div>


        <% } %>


    </section>


    <!-- =====================================================
         OTHER EVENTS CTA
    ====================================================== -->

    <section class="events-cta">


        <div class="cta-icon">

            <i class="fas fa-heart"></i>

        </div>


        <div class="cta-content">

            <h3>

                More Memories,
                More Stories

            </h3>


            <p>

                Explore sports, national
                celebrations and old memories.

            </p>

        </div>


        <div class="cta-buttons">


            <a
                href="/events/sports"
                class="cta-secondary"
            >

                <i class="fas fa-trophy"></i>

                Sports

            </a>


            <a
                href="/events/national-days"
                class="cta-primary"
            >

                <i class="fas fa-flag"></i>

                National Celebrations

            </a>


            <a
                href="/events/old-memories"
                class="cta-secondary"
            >

                <i class="fas fa-clock-rotate-left"></i>

                Old Memories

            </a>


        </div>


    </section>


</main>


<!-- =========================================================
     FOOTER
========================================================= -->

<%- include('../partials/footer') %>


<!-- =========================================================
     PAGE CSS
========================================================= -->

<style>

    * {
        box-sizing: border-box;
    }


    html,
    body {

        margin: 0;

        padding: 0;

        overflow-x: hidden;

    }


    body {

        background: #f6f8fb;

        color: #102a43;

        font-family:
            'Segoe UI',
            Tahoma,
            Geneva,
            Verdana,
            sans-serif;

    }


    /* =====================================================
       HERO
    ====================================================== */

    .events-hero {

        position: relative;

        min-height: 450px;

        display: flex;

        align-items: center;

        justify-content: center;

        overflow: hidden;

        background:
            linear-gradient(
                135deg,
                #001f3f 0%,
                #003f68 55%,
                #006b9e 100%
            );

    }


    .events-hero::before {

        content: '';

        position: absolute;

        inset: 0;

        background:
            radial-gradient(
                circle at 50% 50%,
                rgba(255,195,0,.10),
                transparent 55%
            );

    }


    .hero-glow {

        position: absolute;

        border-radius: 50%;

        pointer-events: none;

    }


    .hero-glow-one {

        width: 500px;

        height: 500px;

        top: -300px;

        right: -120px;

        background:
            rgba(255,195,0,.10);

    }


    .hero-glow-two {

        width: 400px;

        height: 400px;

        bottom: -270px;

        left: -130px;

        background:
            rgba(255,255,255,.06);

    }


    .events-hero-content {

        position: relative;

        z-index: 2;

        width: 92%;

        max-width: 1000px;

        text-align: center;

        color: #fff;

    }


    .hero-kicker {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin-bottom: 15px;

        color: #ffc300;

        font-size: 11px;

        font-weight: 900;

        letter-spacing: 2px;

    }


    .events-hero h1 {

        margin: 0;

        font-size:
            clamp(
                44px,
                7vw,
                76px
            );

        line-height: 1;

        font-weight: 950;

        letter-spacing: -2px;

    }


    .events-hero h1 span {

        color: #ffc300;

    }


    .events-hero p {

        max-width: 650px;

        margin:
            22px auto 25px;

        color:
            rgba(255,255,255,.78);

        font-size: 15px;

        line-height: 1.8;

    }


    .breadcrumb {

        display: inline-flex;

        align-items: center;

        gap: 9px;

        padding:
            9px 14px;

        background:
            rgba(255,255,255,.09);

        border:
            1px solid
            rgba(255,255,255,.15);

        border-radius: 9px;

        font-size: 10px;

        font-weight: 800;

    }


    .breadcrumb a {

        color: #ffc300;

        text-decoration: none;

    }


    .breadcrumb i {

        color:
            rgba(255,255,255,.45);

        font-size: 8px;

    }


    .breadcrumb span {

        color:
            rgba(255,255,255,.75);

    }


    /* =====================================================
       PAGE
    ====================================================== */

    .events-page {

        width: 92%;

        max-width: 1180px;

        margin: 0 auto;

        padding:
            75px 0 100px;

    }


    /* =====================================================
       INTRO
    ====================================================== */

    .events-intro {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 40px;

        margin-bottom: 70px;

    }


    .intro-content {

        max-width: 760px;

    }


    .section-kicker {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        color: #00639b;

        font-size: 10px;

        font-weight: 900;

        letter-spacing: 1.5px;

        text-transform: uppercase;

    }


    .intro-content h2 {

        margin:
            12px 0 15px;

        color: #001f3f;

        font-size:
            clamp(
                30px,
                4vw,
                44px
            );

        line-height: 1.1;

        font-weight: 950;

        letter-spacing: -1px;

    }


    .intro-content h2 span {

        color: #b88300;

    }


    .intro-content p {

        max-width: 700px;

        margin: 0;

        color: #718292;

        font-size: 14px;

        line-height: 1.9;

    }


    .intro-stat {

        display: flex;

        align-items: center;

        gap: 13px;

        min-width: 160px;

        padding: 18px;

        background: #fff;

        border:
            1px solid
            #e4eaf0;

        border-radius: 16px;

        box-shadow:
            0 12px 30px
            rgba(0,31,63,.06);

    }


    .stat-icon {

        width: 46px;

        height: 46px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        color: #00639b;

        background: #eef7fc;

        border-radius: 12px;

        font-size: 19px;

    }


    .intro-stat strong {

        display: block;

        color: #001f3f;

        font-size: 23px;

        font-weight: 950;

        line-height: 1;

    }


    .intro-stat span {

        display: block;

        margin-top: 4px;

        color: #7d8c99;

        font-size: 9px;

        font-weight: 800;

        text-transform: uppercase;

    }


    /* =====================================================
       SECTION HEADING
    ====================================================== */

    .section-heading {

        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 30px;

    }


    .section-heading h2 {

        margin:
            9px 0 0;

        color: #001f3f;

        font-size: 32px;

        font-weight: 950;

    }


    .section-heading h2 span {

        color: #b88300;

    }


    .event-total {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding:
            9px 13px;

        color: #51687b;

        background: #fff;

        border:
            1px solid
            #e1e8ee;

        border-radius: 9px;

        font-size: 10px;

        font-weight: 800;

    }


    .event-total i {

        color: #b88300;

    }


    /* =====================================================
       EVENT GRID
    ====================================================== */

    .events-grid {

        display: grid;

        grid-template-columns:
            repeat(
                3,
                minmax(0, 1fr)
            );

        gap: 25px;

    }


    /* =====================================================
       EVENT CARD
    ====================================================== */

    .event-card {

        overflow: hidden;

        background: #fff;

        border:
            1px solid
            #e2e8ee;

        border-radius: 18px;

        box-shadow:
            0 12px 32px
            rgba(0,31,63,.055);

        transition:
            transform .3s ease,
            box-shadow .3s ease;

    }


    .event-card:hover {

        transform:
            translateY(-7px);

        box-shadow:
            0 22px 45px
            rgba(0,31,63,.13);

    }


    /* =====================================================
       IMAGE
    ====================================================== */

    .event-image-wrap {

        position: relative;

        height: 235px;

        overflow: hidden;

        background: #e8eef3;

    }


    .event-image {

        width: 100%;

        height: 100%;

        display: block;

        object-fit: cover;

        transition:
            transform .5s ease;

    }


    .event-card:hover
    .event-image {

        transform:
            scale(1.06);

    }


    .event-image-placeholder {

        width: 100%;

        height: 100%;

        display: flex;

        align-items: center;

        justify-content: center;

        color: #7c91a1;

        background:
            linear-gradient(
                135deg,
                #edf3f7,
                #dfe9ef
            );

        font-size: 42px;

    }


    /* =====================================================
       CATEGORY
    ====================================================== */

    .event-category {

        position: absolute;

        top: 14px;

        left: 14px;

        display: inline-flex;

        align-items: center;

        gap: 6px;

        padding:
            7px 10px;

        color: #001f3f;

        background: #ffc300;

        border-radius: 7px;

        font-size: 8px;

        font-weight: 950;

        letter-spacing: .5px;

        text-transform: uppercase;

        box-shadow:
            0 5px 15px
            rgba(0,0,0,.12);

    }


    /* =====================================================
       DATE
    ====================================================== */

    .event-date-badge {

        position: absolute;

        right: 14px;

        bottom: 14px;

        display: inline-flex;

        align-items: center;

        gap: 6px;

        padding:
            7px 10px;

        color: #fff;

        background:
            rgba(0,31,63,.84);

        border:
            1px solid
            rgba(255,255,255,.18);

        border-radius: 7px;

        backdrop-filter:
            blur(8px);

        font-size: 8px;

        font-weight: 800;

    }


    .event-date-badge i {

        color: #ffc300;

    }


    /* =====================================================
       CARD CONTENT
    ====================================================== */

    .event-card-content {

        padding: 21px;

    }


    .event-card-content h3 {

        min-height: 48px;

        margin:
            0 0 10px;

        color: #001f3f;

        font-size: 19px;

        line-height: 1.3;

        font-weight: 900;

    }


    .event-card-content > p {

        display: -webkit-box;

        min-height: 67px;

        margin:
            0 0 17px;

        overflow: hidden;

        color: #758696;

        font-size: 12px;

        line-height: 1.75;

        -webkit-line-clamp: 3;

        -webkit-box-orient: vertical;

    }


    /* =====================================================
       META
    ====================================================== */

    .event-meta {

        display: flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 7px;

        margin-bottom: 17px;

    }


    .event-meta span {

        display: inline-flex;

        align-items: center;

        gap: 5px;

        padding:
            6px 8px;

        color: #607485;

        background: #f4f7f9;

        border-radius: 6px;

        font-size: 8px;

        font-weight: 800;

    }


    .event-meta i {

        color: #00639b;

    }


    /* =====================================================
       VIEW GALLERY
    ====================================================== */

    .view-gallery-btn {

        display: flex;

        align-items: center;

        justify-content: space-between;

        width: 100%;

        padding:
            11px 12px;

        color: #fff;

        background: #001f3f;

        border-radius: 9px;

        text-decoration: none;

        font-size: 10px;

        font-weight: 900;

        transition:
            .25s ease;

    }


    .view-gallery-btn:hover {

        color: #001f3f;

        background: #ffc300;

    }


    .view-gallery-text {

        display: flex;

        align-items: center;

        gap: 8px;

    }


    .view-gallery-text i {

        color: #ffc300;

        transition: .25s ease;

    }


    .view-gallery-btn:hover
    .view-gallery-text i {

        color: #001f3f;

    }


    .gallery-arrow {

        width: 28px;

        height: 28px;

        display: flex;

        align-items: center;

        justify-content: center;

        color: #001f3f;

        background: #ffc300;

        border-radius: 7px;

        transition:
            .25s ease;

    }


    .view-gallery-btn:hover
    .gallery-arrow {

        color: #fff;

        background: #001f3f;

        transform:
            translateX(3px);

    }


    /* =====================================================
       EMPTY STATE
    ====================================================== */

    .empty-events {

        padding:
            80px 25px;

        text-align: center;

        background: #fff;

        border:
            1px dashed
            #d6e0e8;

        border-radius: 20px;

    }


    .empty-icon {

        width: 70px;

        height: 70px;

        display: flex;

        align-items: center;

        justify-content: center;

        margin:
            0 auto 18px;

        color: #00639b;

        background: #eef7fc;

        border-radius: 18px;

        font-size: 27px;

    }


    .empty-events h2 {

        margin:
            10px 0 8px;

        color: #001f3f;

        font-size: 27px;

        font-weight: 900;

    }


    .empty-events p {

        max-width: 500px;

        margin:
            0 auto 22px;

        color: #7a8b99;

        font-size: 13px;

        line-height: 1.8;

    }


    .back-home-btn {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        padding:
            11px 16px;

        color: #001f3f;

        background: #ffc300;

        border-radius: 8px;

        text-decoration: none;

        font-size: 10px;

        font-weight: 900;

    }


    /* =====================================================
       CTA
    ====================================================== */

    .events-cta {

        display: flex;

        align-items: center;

        gap: 18px;

        margin-top: 80px;

        padding: 25px;

        color: #fff;

        background:
            linear-gradient(
                135deg,
                #001f3f,
                #005b89
            );

