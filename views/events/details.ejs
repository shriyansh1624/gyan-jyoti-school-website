<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#001f3f"
    >

    <title>
        <%= event.title || 'Event Details' %> -
        Gyan Jyoti School
    </title>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/style.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/responsive.css"
    >

</head>


<body>


<!-- =========================================================
     HEADER
========================================================= -->

<%- include('../partials/header') %>


<%
    const photos =
        Array.isArray(event.photos)
            ? event.photos
            : [];

    const videos =
        Array.isArray(event.videos)
            ? event.videos
            : [];

    const categoryNames = {

        'fun-fiesta':
            'Fun & Fiesta',

        'sports':
            'Sports',

        'national-celebration':
            'National Celebration',

        'old-memory':
            'Old Memory'

    };

    const categoryName =
        categoryNames[event.category]
            || 'School Event';

    const formattedDate =
        event.date
            ? new Date(
                event.date
            ).toLocaleDateString(
                'en-IN',
                {
                    day: '2-digit',
                    month: 'long',
                    year: 'numeric'
                }
            )
            : 'Date not available';
%>


<!-- =========================================================
     HERO / COVER
========================================================= -->

<section class="event-detail-hero">


    <% if (event.coverImage) { %>

        <img
            class="hero-cover-image"
            src="<%= event.coverImage %>"
            alt="<%= event.title || 'Event' %>"
        >

    <% } else { %>

        <div class="hero-cover-placeholder">

            <i class="fas fa-images"></i>

        </div>

    <% } %>


    <div class="hero-dark-overlay"></div>


    <div class="hero-content">


        <a
            href="javascript:history.back()"
            class="back-button"
        >

            <i class="fas fa-arrow-left"></i>

            Back to Events

        </a>


        <div class="detail-category">

            <i class="fas fa-star"></i>

            <%= categoryName %>

        </div>


        <h1>

            <%= event.title || 'School Event' %>

        </h1>


        <div class="hero-meta">


            <span>

                <i class="far fa-calendar"></i>

                <%= formattedDate %>

            </span>


            <% if (event.session) { %>

                <span>

                    <i class="fas fa-calendar-days"></i>

                    <%= event.session %>

                </span>

            <% } %>


            <% if (event.batch) { %>

                <span>

                    <i class="fas fa-users"></i>

                    <%= event.batch %>

                </span>

            <% } %>


        </div>


    </div>

</section>


<!-- =========================================================
     MAIN CONTENT
========================================================= -->

<main class="event-detail-page">


    <!-- =====================================================
         EVENT INFORMATION
    ====================================================== -->

    <section class="event-information">


        <div class="information-left">


            <span class="section-kicker">

                <i class="fas fa-circle-info"></i>

                Event Details

            </span>


            <h2>

                <%= event.title || 'School Event' %>

            </h2>


            <% if (event.description) { %>

                <p>

                    <%= event.description %>

                </p>

            <% } %>


        </div>


        <!-- =================================================
             STATISTICS
        ================================================== -->

        <div class="event-stats">


            <div class="stat-box">

                <div class="stat-icon blue">

                    <i class="fas fa-images"></i>

                </div>

                <div>

                    <strong>
                        <%= photos.length %>
                    </strong>

                    <span>
                        Photos
                    </span>

                </div>

            </div>


            <div class="stat-box">

                <div class="stat-icon red">

                    <i class="fas fa-video"></i>

                </div>

                <div>

                    <strong>
                        <%= videos.length %>
                    </strong>

                    <span>
                        Videos
                    </span>

                </div>

            </div>


            <div class="stat-box">

                <div class="stat-icon gold">

                    <i class="fas fa-calendar"></i>

                </div>

                <div>

                    <strong>
                        <%= event.date
                            ? new Date(event.date)
                                .getFullYear()
                            : '-' %>
                    </strong>

                    <span>
                        Year
                    </span>

                </div>

            </div>


        </div>


    </section>


    <!-- =====================================================
         PHOTO GALLERY
    ====================================================== -->

    <% if (photos.length > 0) { %>


        <section class="gallery-section">


            <div class="section-heading">


                <div>

                    <span class="section-kicker">

                        <i class="fas fa-camera"></i>

                        Photo Gallery

                    </span>


                    <h2>

                        Moments From
                        <span>The Event</span>

                    </h2>

                </div>


                <div class="gallery-count">

                    <i class="fas fa-images"></i>

                    <%= photos.length %>
                    Photos

                </div>


            </div>


            <!-- =============================================
                 PHOTO GRID
            ============================================== -->

            <div class="photo-grid">


                <% photos.forEach(
                    function(photo, index)
                { %>


                    <button
                        type="button"
                        class="photo-card"
                        onclick="openLightbox(<%= index %>)"
                    >


                        <img
                            src="<%= photo %>"
                            alt="<%= event.title || 'Event photo' %> - Photo <%= index + 1 %>"
                            loading="lazy"
                        >


                        <div class="photo-overlay">

                            <span>

                                <i class="fas fa-expand"></i>

                                View

                            </span>

                        </div>


                    </button>


                <% }) %>


            </div>


        </section>


    <% } else { %>


        <!-- =============================================
             NO PHOTOS
        ============================================== -->

        <section class="empty-media">


            <div class="empty-media-icon">

                <i class="fas fa-images"></i>

            </div>


            <h3>

                No Photos Available

            </h3>


            <p>

                Photos from this event
                will appear here.

            </p>


        </section>


    <% } %>


    <!-- =====================================================
         VIDEOS
    ====================================================== -->

    <% if (videos.length > 0) { %>


        <section class="videos-section">


            <div class="section-heading">


                <div>

                    <span class="section-kicker">

                        <i class="fas fa-video"></i>

                        Video Gallery

                    </span>


                    <h2>

                        Relive The
                        <span>Moments</span>

                    </h2>

                </div>


                <div class="gallery-count">

                    <i class="fas fa-video"></i>

                    <%= videos.length %>
                    Videos

                </div>


            </div>


            <div class="video-grid">


                <% videos.forEach(
                    function(video, index)
                { %>


                    <div class="video-card">


                        <video
                            controls
                            preload="metadata"
                            playsinline
                        >

                            <source
                                src="<%= video %>"
                            >

                            Your browser does not
                            support video playback.

                        </video>


                        <div class="video-number">

                            <i class="fas fa-play"></i>

                            Video <%= index + 1 %>

                        </div>


                    </div>


                <% }) %>


            </div>


        </section>


    <% } %>


    <!-- =====================================================
         EVENT FOOTER
    ====================================================== -->

    <section class="event-bottom">


        <div class="bottom-icon">

            <i class="fas fa-heart"></i>

        </div>


        <div>

            <h3>

                Memories That Last Forever

            </h3>


            <p>

                Every celebration becomes
                a beautiful part of our school story.

            </p>

        </div>


        <a
            href="/events"
            class="all-events-button"
        >

            Explore More Events

            <i class="fas fa-arrow-right"></i>

        </a>


    </section>


</main>


<!-- =========================================================
     LIGHTBOX
========================================================= -->

<div
    id="lightbox"
    class="lightbox"
    onclick="closeLightbox(event)"
>


    <button
        type="button"
        class="lightbox-close"
        onclick="closeLightbox()"
        aria-label="Close"
    >

        <i class="fas fa-xmark"></i>

    </button>


    <button
        type="button"
        class="lightbox-prev"
        onclick="previousImage(event)"
        aria-label="Previous"
    >

        <i class="fas fa-chevron-left"></i>

    </button>


    <div class="lightbox-content">


        <img
            id="lightbox-image"
            src=""
            alt="Event photo"
        >


        <div
            id="lightbox-counter"
            class="lightbox-counter"
        >

            1 / 1

        </div>


    </div>


    <button
        type="button"
        class="lightbox-next"
        onclick="nextImage(event)"
        aria-label="Next"
    >

        <i class="fas fa-chevron-right"></i>

    </button>


</div>


<!-- =========================================================
     FOOTER
========================================================= -->

<%- include('../partials/footer') %>


<!-- =========================================================
     STYLES
========================================================= -->

<style>

    * {
        box-sizing: border-box;
    }


    body {

        margin: 0;

        background: #f6f8fb;

        color: #102a43;

        font-family:
            'Segoe UI',
            Tahoma,
            Geneva,
            Verdana,
            sans-serif;

    }


    /* =====================================================
       HERO
    ====================================================== */

    .event-detail-hero {

        position: relative;

        min-height: 560px;

        display: flex;

        align-items: flex-end;

        overflow: hidden;

        background: #001f3f;

    }


    .hero-cover-image {

        position: absolute;

        inset: 0;

        width: 100%;

        height: 100%;

        object-fit: cover;

    }


    .hero-cover-placeholder {

        position: absolute;

        inset: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        color: #fff;

        background:
            linear-gradient(
                135deg,
                #001f3f,
                #005d91
            );

        font-size: 70px;

    }


    .hero-dark-overlay {

        position: absolute;

        inset: 0;

        background:

            linear-gradient(
                to top,
                rgba(0,20,40,.96),
                rgba(0,20,40,.48) 55%,
                rgba(0,20,40,.18)
            );

    }


    .hero-content {

        position: relative;

        z-index: 2;

        width: min(
            1180px,
            92%
        );

        margin:
            0 auto 65px;

        color: #fff;

    }


    .back-button {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin-bottom: 25px;

        padding:
            9px 14px;

        color: #fff;

        background:
            rgba(255,255,255,.12);

        border:
            1px solid
            rgba(255,255,255,.2);

        border-radius: 9px;

        backdrop-filter:
            blur(10px);

        font-size: 11px;

        font-weight: 800;

        text-decoration: none;

        transition: .25s;

    }


    .back-button:hover {

        color: #001f3f;

        background: #ffc300;

        border-color: #ffc300;

    }


    .detail-category {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        margin-bottom: 12px;

        color: #ffc300;

        font-size: 11px;

        font-weight: 900;

        letter-spacing: 1.2px;

        text-transform: uppercase;

    }


    .hero-content h1 {

        max-width: 900px;

        margin: 0;

        color: #fff;

        font-size: clamp(
            36px,
            6vw,
            68px
        );

        line-height: 1.05;

        font-weight: 900;

        letter-spacing: -1.5px;

    }


    .hero-meta {

        display: flex;

        align-items: center;

        flex-wrap: wrap;

        gap: 12px;

        margin-top: 22px;

    }


    .hero-meta span {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding:
            8px 11px;

        color:
            rgba(255,255,255,.88);

        background:
            rgba(255,255,255,.1);

        border:
            1px solid
            rgba(255,255,255,.15);

        border-radius: 8px;

        backdrop-filter:
            blur(8px);

        font-size: 10px;

        font-weight: 700;

    }


    .hero-meta i {

        color: #ffc300;

    }


    /* =====================================================
       MAIN
    ====================================================== */

    .event-detail-page {

        width: min(
            1180px,
            92%
        );

        margin: 0 auto;

        padding:
            70px 0 100px;

    }


    /* =====================================================
       INFORMATION
    ====================================================== */

    .event-information {

        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            380px;

        gap: 50px;

        align-items: center;

        margin-bottom: 75px;

    }


    .section-kicker {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        color: #00639b;

        font-size: 11px;

        font-weight: 900;

        letter-spacing: 1px;

        text-transform: uppercase;

    }


    .information-left h2 {

        margin:
            12px 0 15px;

        color: #001f3f;

        font-size: clamp(
            28px,
            4vw,
            42px
        );

        line-height: 1.15;

        font-weight: 900;

    }


    .information-left p {

        max-width: 750px;

        margin: 0;

        color: #68798a;

        font-size: 15px;

        line-height: 1.9;

        white-space: pre-line;

    }


    /* =====================================================
       STATS
    ====================================================== */

    .event-stats {

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 12px;

    }


    .stat-box {

        display: flex;

        align-items: center;

        gap: 10px;

        padding: 15px;

        background: #fff;

        border:
            1px solid
            #e3e9ef;

        border-radius: 15px;

        box-shadow:
            0 10px 25px
            rgba(0,31,63,.05);

    }


    .stat-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

    }


    .stat-icon.blue {

        color: #2563eb;

        background: #eff6ff;

    }


    .stat-icon.red {

        color: #dc2626;

        background: #fef2f2;

    }


    .stat-icon.gold {

        color: #ca8a04;

        background: #fefce8;

    }


    .stat-box strong {

        display: block;

        color: #001f3f;

        font-size: 20px;

        line-height: 1;

        font-weight: 900;

    }


    .stat-box span {

        display: block;

        margin-top: 4px;

        color: #81909e;

        font-size: 9px;

        font-weight: 800;

    }


    /* =====================================================
       SECTION HEADING
    ====================================================== */

    .section-heading {

        display: flex;

        align-items: flex-end;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 28px;

    }


    .section-heading h2 {

        margin:
            10px 0 0;

        color: #001f3f;

        font-size: 32px;

        font-weight: 900;

    }


    .section-heading h2 span {

        color: #c18c00;

    }


    .gallery-count {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding:
            9px 13px;

        color: #496477;

        background: #fff;

        border:
            1px solid
            #e2e8ee;

        border-radius: 9px;

        font-size: 10px;

        font-weight: 800;

    }


    .gallery-count i {

        color: #c18c00;

    }


    /* =====================================================
       PHOTO GALLERY
    ====================================================== */

    .gallery-section {

        margin-bottom: 80px;

    }


    .photo-grid {

        display: grid;

        grid-template-columns:
            repeat(
                4,
                minmax(0, 1fr)
            );

        gap: 15px;

    }


    .photo-card {

        position: relative;

        width: 100%;

        height: 245px;

        padding: 0;

        overflow: hidden;

        border: none;

        border-radius: 16px;

        background: #dce4ea;

        cursor: pointer;

    }


    .photo-card img {

        width: 100%;

        height: 100%;

        display: block;

        object-fit: cover;

        transition:
            transform .5s ease;

    }


    .photo-card:hover img {

        transform:
            scale(1.08);

    }


    .photo-overlay {

        position: absolute;

        inset: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        background:
            rgba(0,25,50,.5);

        opacity: 0;

        transition: .3s;

    }


    .photo-card:hover
    .photo-overlay {

        opacity: 1;

    }


    .photo-overlay span {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding:
            10px 14px;

        color: #001f3f;

        background: #ffc300;

        border-radius: 9px;

        font-size: 11px;

        font-weight: 900;

    }


    /* =====================================================
       VIDEOS
    ====================================================== */

    .videos-section {

        margin-bottom: 80px;

    }


    .video-grid {

        display: grid;

        grid-template-columns:
            repeat(
                2,
                minmax(0, 1fr)
            );

        gap: 24px;

    }


    .video-card {

        position: relative;

        overflow: hidden;

        background: #00131f;

        border-radius: 18px;

        box-shadow:
            0 15px 35px
            rgba(0,31,63,.12);

    }


    .video-card video {

        width: 100%;

        height: 390px;

        display: block;

        object-fit: contain;

        background: #000;

    }


    .video-number {

        display: flex;

        align-items: center;

        gap: 7px;

        padding:
            12px 15px;

        color: #d9e5ed;

        background: #001f3f;

        font-size: 10px;

        font-weight: 800;

    }


    .video-number i {

        color: #ffc300;

    }


    /* =====================================================
       EMPTY
    ====================================================== */

    .empty-media {

        padding:
            65px 25px;

        margin-bottom: 75px;

        text-align: center;

        background: #fff;

        border:
            1px dashed
            #d5dfe8;

        border-radius: 20px;

    }


    .empty-media-icon {

        width: 65px;

        height: 65px;

        display: flex;

        align-items: center;

        justify-content: center;

        margin:
            0 auto 16px;

        color: #00639b;

        background: #eef6fb;

        border-radius: 17px;

        font-size: 25px;

    }


    .empty-media h3 {

        margin:
            0 0 7px;

        color: #001f3f;

        font-size: 20px;

    }


    .empty-media p {

        margin: 0;

        color: #7b8b98;

        font-size: 13px;

    }


    /* =====================================================
       BOTTOM
    ====================================================== */

    .event-bottom {

        display: flex;

        align-items: center;

        gap: 18px;

        padding:
            25px;

        background:
            linear-gradient(
                135deg,
                #001f3f,
                #004f7d
            );

        border-radius: 20px;

        color: #fff;

    }


    .bottom-icon {

        width: 52px;

        height: 52px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        color: #001f3f;

        background: #ffc300;

        border-radius: 15px;

        font-size: 20px;

    }


    .event-bottom h3 {

        margin:
            0 0 5px;

        font-size: 18px;

    }


    .event-bottom p {

        margin: 0;

        color:
            rgba(255,255,255,.68);

        font-size: 12px;

    }


    .all-events-button {

        display: inline-flex;

        align-items: center;

        gap: 8px;

        margin-left: auto;

        padding:
            11px 15px;

        color: #001f3f;

        background: #ffc300;

        border-radius: 9px;

        font-size: 10px;

        font-weight: 900;

        text-decoration: none;

        white-space: nowrap;

        transition: .25s;

    }


    .all-events-button:hover {

        background: #fff;

        transform:
            translateY(-2px);

    }


    /* =====================================================
       LIGHTBOX
    ====================================================== */

    .lightbox {

        position: fixed;

        inset: 0;

        z-index: 9999;

        display: none;

        align-items: center;

        justify-content: center;

        padding: 40px;

        background:
            rgba(0,8,18,.96);

    }


    .lightbox.active {

        display: flex;

    }


    .lightbox-content {

        position: relative;

        max-width: 90vw;

        max-height: 88vh;

    }


    .lightbox-content img {

        max-width: 90vw;

        max-height: 82vh;

        display: block;

        object-fit: contain;

        border-radius: 8px;

        box-shadow:
            0 25px 70px
            rgba(0,0,0,.5);

    }


    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {

        position: fixed;

        z-index: 3;

        width: 46px;

        height: 46px;

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 0;

        color: #fff;

        background:
            rgba(255,255,255,.12);

        border:
            1px solid
            rgba(255,255,255,.2);

        border-radius: 50%;

        cursor: pointer;

        transition: .25s;

    }


    .lightbox-close:hover,
    .lightbox-prev:hover,
    .lightbox-next:hover {

        color: #001f3f;

        background: #ffc300;

    }


    .lightbox-close {

        top: 25px;

        right: 25px;

    }


    .lightbox-prev {

        left: 25px;

        top: 50%;

        transform:
            translateY(-50%);

    }


    .lightbox-next {

        right: 25px;

        top: 50%;

        transform:
            translateY(-50%);

    }


    .lightbox-counter {

        position: absolute;

        left: 50%;

        bottom: -35px;

        transform:
            translateX(-50%);

        color:
            rgba(255,255,255,.75);

        font-size: 11px;

        font-weight: 700;

    }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @media(max-width: 1050px) {

        .photo-grid {

            grid-template-columns:
                repeat(
                    3,
                    minmax(0, 1fr)
                );

        }


        .event-information {

            grid-template-columns: 1fr;

        }


        .event-stats {

            max-width: 500px;

        }

    }


    @media(max-width: 750px) {

        .event-detail-hero {

            min-height: 500px;

        }


        .hero-content {

            margin-bottom: 45px;

        }


        .event-detail-page {

            width: 92%;

            padding:
                50px 0 70px;

        }


        .photo-grid {

            grid-template-columns:
                repeat(
                    2,
                    minmax(0, 1fr)
                );

        }


        .photo-card {

            height: 210px;

        }


        .video-grid {

            grid-template-columns: 1fr;

        }


        .video-card video {

            height: 300px;

        }


        .section-heading {

            align-items: flex-start;

            flex-direction: column;

        }


        .event-bottom {

            align-items: flex-start;

            flex-direction: column;

        }


        .all-events-button {

            margin-left: 0;

        }

    }


    @media(max-width: 480px) {

        .event-detail-hero {

            min-height: 470px;

        }


        .hero-content h1 {

            font-size: 34px;

        }


        .hero-meta {

            gap: 7px;

        }


        .hero-meta span {

            font-size: 9px;

        }


        .event-stats {

            grid-template-columns: 1fr;

        }


        .photo-grid {

            grid-template-columns: 1fr;

        }


        .photo-card {

            height: 260px;

        }


        .video-card video {

            height: 230px;

        }


        .lightbox {

            padding: 20px;

        }


        .lightbox-prev {

            left: 10px;

        }


        .lightbox-next {

            right: 10px;

        }


        .lightbox-close {

            top: 15px;

            right: 15px;

        }

    }

</style>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    const galleryImages = <%- JSON.stringify(photos) %>;

    let currentImage = 0;


    /* =====================================================
       OPEN LIGHTBOX
    ====================================================== */

    function openLightbox(index) {

        if (!galleryImages.length) {
            return;
        }

        currentImage = index;

        updateLightbox();

        document
            .getElementById('lightbox')
            .classList
            .add('active');

        document.body.style.overflow = 'hidden';

    }


    /* =====================================================
       UPDATE IMAGE
    ====================================================== */

    function updateLightbox() {

        const image =
            document.getElementById(
                'lightbox-image'
            );

        const counter =
            document.getElementById(
                'lightbox-counter'
            );

        image.src =
            galleryImages[currentImage];

        counter.textContent =
            `${currentImage + 1} / ${galleryImages.length}`;

    }


    /* =====================================================
       CLOSE
    ====================================================== */

    function closeLightbox(event) {

        if (
            event &&
            event.target !==
            document.getElementById('lightbox')
        ) {

            return;

        }

        document
            .getElementById('lightbox')
            .classList
            .remove('active');

        document.body.style.overflow = '';

    }


    /* =====================================================
       NEXT
    ====================================================== */

    function nextImage(event) {

        if (event) {
            event.stopPropagation();
        }

        if (!galleryImages.length) {
            return;
        }

        currentImage =
            (currentImage + 1)
            % galleryImages.length;

        updateLightbox();

    }


    /* =====================================================
       PREVIOUS
    ====================================================== */

    function previousImage(event) {

        if (event) {
            event.stopPropagation();
        }

        if (!galleryImages.length) {
            return;
        }

        currentImage =
            (
                currentImage -
                1 +
                galleryImages.length
            )
            % galleryImages.length;

        updateLightbox();

    }


    /* =====================================================
       KEYBOARD
    ====================================================== */

    document.addEventListener(
        'keydown',
        function(event) {

            const lightbox =
                document.getElementById(
                    'lightbox'
                );

            if (
                !lightbox.classList.contains(
                    'active'
                )
            ) {
                return;
            }


            if (
                event.key ===
                'ArrowRight'
            ) {

                nextImage();

            }


            if (
                event.key ===
                'ArrowLeft'
            ) {

                previousImage();

            }


            if (
                event.key ===
                'Escape'
            ) {

                closeLightbox();

            }

        }
    );

</script>


</body>

