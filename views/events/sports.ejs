<script>

/* =========================================================
   SPORTS CARD SCROLL REVEAL
   No backend dependency.
========================================================= */

document.addEventListener(
  "DOMContentLoaded",
  function () {

    const cards =
      document.querySelectorAll(
        ".sports-event-card"
      );

    if (
      !("IntersectionObserver" in window)
    ) {
      return;
    }

    const observer =
      new IntersectionObserver(
        function (entries) {

          entries.forEach(
            function (entry) {

              if (
                entry.isIntersecting
              ) {

                entry.target.classList.add(
                  "sports-card-visible"
                );

                observer.unobserve(
                  entry.target
                );

              }

            }
          );

        },
        {
          threshold: .12
        }
      );

    cards.forEach(
      function (card) {
        observer.observe(card);
      }
    );

  }
);

</script>


