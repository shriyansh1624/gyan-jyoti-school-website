<%- include('../partials/header') %>

<!-- =========================================================
     SPORTS EVENTS — PREMIUM ATHLETICS EXPERIENCE
     Backend-safe:
     Uses only the existing `events` array and:
     event.image
     event.title
     event.description
     event.date
========================================================= -->

<section class="sports-hero">

  <div class="sports-hero-grid"></div>
  <div class="sports-hero-glow glow-one"></div>
  <div class="sports-hero-glow glow-two"></div>

  <div class="sports-hero-inner">

    <div class="sports-kicker">
      <i class="fas fa-trophy"></i>
      GYAN JYOTI • SPORTS & ATHLETICS
    </div>

    <h1>
      Play Hard.
      <span>Dream Bigger.</span>
    </h1>

    <p>
      Discover the energy, teamwork and unforgettable sporting moments
      that bring the Gyan Jyoti School community together.
    </p>

    <div class="sports-hero-actions">

      <a href="#sports-events" class="sports-btn sports-btn-primary">
        <i class="fas fa-bolt"></i>
        Explore Events
      </a>

      <a href="/" class="sports-btn sports-btn-outline">
        <i class="fas fa-house"></i>
        Back Home
      </a>

    </div>

    <div class="sports-breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <strong>Sports Events</strong>
    </div>

  </div>

  <div class="sports-hero-badge badge-top">
    <i class="fas fa-medal"></i>
    <span>DISCIPLINE</span>
  </div>

  <div class="sports-hero-badge badge-right">
    <i class="fas fa-people-group"></i>
    <span>TEAMWORK</span>
  </div>

  <div class="sports-hero-badge badge-bottom">
    <i class="fas fa-fire"></i>
    <span>PASSION</span>
  </div>

  <div class="sports-scroll">
    <span>SCROLL TO PLAY</span>
    <i class="fas fa-arrow-down"></i>
  </div>

</section>


<section class="sports-intro" id="sports-events">

  <div class="sports-container">

    <div class="sports-intro-copy">

      <span class="sports-section-label">
        <i class="fas fa-flag-checkered"></i>
        ON THE FIELD
      </span>

      <h2>
        Where
        <span>teamwork</span>
        becomes a strength.
      </h2>

      <p>
        Sports activities at Gyan Jyoti School encourage discipline,
        teamwork, confidence, fitness and healthy competition among students.
        Every event is an opportunity to learn, perform and create memories.
      </p>

    </div>

    <div class="sports-intro-stats">

      <div class="sports-stat">
        <strong><%= Array.isArray(events) ? events.length : 0 %></strong>
        <span>Events</span>
      </div>

      <div class="sports-stat">
        <strong>01</strong>
        <span>Spirit</span>
      </div>

      <div class="sports-stat">
        <strong>∞</strong>
        <span>Memories</span>
      </div>

    </div>

  </div>

</section>


<section class="sports-events-section">

  <div class="sports-container">

    <div class="sports-heading">

      <div>
        <span class="sports-section-label">
          <i class="fas fa-calendar-star"></i>
          SPORTS ARCHIVE
        </span>

        <h2>
          Moments that
          <span>made us proud.</span>
        </h2>
      </div>

      <div class="sports-heading-line"></div>

    </div>


    <%
      const sportsEvents =
        Array.isArray(events) ? events : [];
    %>


    <% if (sportsEvents.length > 0) { %>

      <div class="sports-event-list">

        <% sportsEvents.forEach(function(event, index) { %>

          <article
            class="sports-event-card <%= index % 2 === 1 ? 'sports-reverse' : '' %>"
            style="--event-delay:<%= index * 0.08 %>s;"
          >

            <div class="sports-event-number">
              <span><%= String(index + 1).padStart(2, '0') %></span>
              <i class="fas fa-arrow-right"></i>
            </div>


            <div class="sports-event-image">

              <% if (event.image) { %>

                <img
                  src="<%= event.image %>"
                  alt="<%= event.title || 'Sports Event' %>"
                  loading="lazy"
                >

              <% } else { %>

                <div class="sports-image-placeholder">
                  <i class="fas fa-trophy"></i>
                  <span>Gyan Jyoti Sports</span>
                </div>

              <% } %>

              <div class="sports-image-overlay">

                <div class="sports-play-icon">
                  <i class="fas fa-expand"></i>
                </div>

                <span>SPORTS MOMENT</span>

              </div>

              <div class="sports-image-corner">
                <i class="fas fa-camera"></i>
              </div>

            </div>


            <div class="sports-event-content">

              <div class="sports-event-meta">

                <span>
                  <i class="far fa-calendar"></i>

                  <%= event.date
                    ? new Date(event.date).toLocaleDateString(
                        'en-IN',
                        {
                          day: '2-digit',
                          month: 'short',
                          year: 'numeric'
                        }
                      )
                    : 'Event Archive'
                  %>
                </span>

                <span>
                  <i class="fas fa-medal"></i>
                  GYAN JYOTI
                </span>

              </div>


              <h3>
                <%= event.title || 'Sports Event' %>
              </h3>

              <div class="sports-title-line"></div>


              <% if (event.description) { %>

                <div class="sports-description">
                  <%- event.description %>
                </div>

              <% } else { %>

                <p class="sports-description">
                  A memorable sporting occasion celebrating fitness,
                  teamwork, discipline and the competitive spirit of our students.
                </p>

              <% } %>


              <div class="sports-card-footer">

                <div class="sports-event-tag">
                  <i class="fas fa-bolt"></i>
                  SPORTS & FITNESS
                </div>

                <a
                  href="/events/event/<%= event._id %>"
                  class="sports-read-more"
                >
                  <span>View Event</span>
                  <i class="fas fa-arrow-right"></i>
                </a>

              </div>

            </div>

          </article>

        <% }) %>

      </div>


    <% } else { %>

      <div class="sports-empty">

        <div class="sports-empty-icon">
          <i class="fas fa-trophy"></i>
        </div>

        <span class="sports-section-label">
          SPORTS ARCHIVE
        </span>

        <h3>More sporting moments are coming soon.</h3>

        <p>
          Sports events and activities will appear here once they are
          added through the school management system.
        </p>

        <a href="/" class="sports-btn sports-btn-primary">
          <i class="fas fa-house"></i>
          Return Home
        </a>

      </div>

    <% } %>

  </div>

</section>


<section class="sports-values">

  <div class="sports-container">

    <div class="sports-values-heading">

      <span class="sports-section-label">
        <i class="fas fa-star"></i>
        BEYOND THE GAME
      </span>

      <h2>
        More than
        <span>a competition.</span>
      </h2>

      <p>
        The real victory is what students carry with them after the final whistle.
      </p>

    </div>


    <div class="sports-values-grid">

      <div class="sports-value-card">

        <div class="sports-value-icon">
          <i class="fas fa-people-group"></i>
        </div>

        <span>01</span>

        <h3>Teamwork</h3>

        <p>
          Learning to trust, communicate and grow together as a team.
        </p>

      </div>


      <div class="sports-value-card">

        <div class="sports-value-icon">
          <i class="fas fa-dumbbell"></i>
        </div>

        <span>02</span>

        <h3>Discipline</h3>

        <p>
          Building consistency, focus and the habit of giving your best.
        </p>

      </div>


      <div class="sports-value-card">

        <div class="sports-value-icon">
          <i class="fas fa-bullseye"></i>
        </div>

        <span>03</span>

        <h3>Confidence</h3>

        <p>
          Developing courage to compete, perform and rise after setbacks.
        </p>

      </div>


      <div class="sports-value-card">

        <div class="sports-value-icon">
          <i class="fas fa-heart-pulse"></i>
        </div>

        <span>04</span>

        <h3>Healthy Living</h3>

        <p>
          Encouraging fitness, active habits and a positive sporting mindset.
        </p>

      </div>

    </div>

  </div>

</section>


<section class="sports-closing">

  <div class="sports-closing-bg"></div>

  <div class="sports-container">

    <div class="sports-closing-content">

      <span class="sports-kicker">
        <i class="fas fa-flag-checkered"></i>
        THE GYAN JYOTI SPIRIT
      </span>

      <h2>
        Give your best.
        <span>Every single time.</span>
      </h2>

      <p>
        Because the greatest achievement is not simply winning —
        it is becoming stronger, more confident and better together.
      </p>

      <a href="#sports-events" class="sports-btn sports-btn-primary">
        <i class="fas fa-arrow-up"></i>
        Explore Sports Moments
      </a>

    </div>

  </div>

</section>


<style>

/* =========================================================
   PREMIUM SPORTS PAGE
========================================================= */

.sports-hero,
.sports-page,
.sports-intro,
.sports-events-section,
.sports-values,
.sports-closing {

  --sports-navy: #001f3f;
  --sports-blue: #003b67;
  --sports-blue-2: #005d8f;
  --sports-gold: #ffc300;
  --sports-gold-2: #ffda4d;
  --sports-white: #ffffff;
  --sports-bg: #f4f7fa;
  --sports-text: #183044;
  --sports-muted: #6d7d8b;

  font-family:
    "Segoe UI",
    Tahoma,
    Geneva,
    Verdana,
    sans-serif;

}


/* =========================================================
   HERO
========================================================= */

.sports-hero {

  position: relative;

  min-height: 650px;

  display: flex;
  align-items: center;

  overflow: hidden;

  background:
    linear-gradient(
      120deg,
      rgba(0,18,35,.97),
      rgba(0,54,87,.88)
    ),
    url('/images/events/event-bg.jpg')
    center / cover no-repeat;

}


.sports-hero::before {

  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      115deg,
      transparent 0 48%,
      rgba(255,195,0,.09) 48.2%,
      transparent 48.6%
    );

}


.sports-hero::after {

  content: "";

  position: absolute;

  width: 700px;
  height: 700px;

  right: -260px;
  top: -220px;

  border:
    1px solid
    rgba(255,195,0,.20);

  border-radius: 50%;

  box-shadow:
    0 0 0 80px rgba(255,195,0,.025),
    0 0 0 160px rgba(255,195,0,.018);

  animation:
    sportsPulse 7s ease-in-out infinite;

}


@keyframes sportsPulse {

  0%, 100% {
    transform: scale(1);
    opacity: .75;
  }

  50% {
    transform: scale(1.07);
    opacity: 1;
  }

}


.sports-hero-grid {

  position: absolute;
  inset: 0;

  opacity: .14;

  background-image:
    linear-gradient(
      rgba(255,255,255,.10) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,.10) 1px,
      transparent 1px
    );

  background-size: 70px 70px;

  mask-image:
    linear-gradient(
      90deg,
      transparent,
      black 25%,
      black 75%,
      transparent
    );

  animation:
    sportsGridMove 18s linear infinite;

}


@keyframes sportsGridMove {

  from {
    transform: translate(0,0);
  }

  to {
    transform: translate(70px,70px);
  }

}


.sports-hero-glow {

  position: absolute;

  border-radius: 50%;

  filter: blur(5px);

  pointer-events: none;

}


.glow-one {

  width: 340px;
  height: 340px;

  left: -150px;
  top: 15%;

  background:
    rgba(255,195,0,.12);

  animation:
    sportsGlow 6s ease-in-out infinite;

}


.glow-two {

  width: 260px;
  height: 260px;

  right: 17%;
  bottom: -160px;

  background:
    rgba(0,147,210,.14);

  animation:
    sportsGlow 7s 1s ease-in-out infinite;

}


@keyframes sportsGlow {

  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-25px);
  }

}


.sports-hero-inner {

  position: relative;

  z-index: 5;

  width: min(1160px, 90%);

  margin: auto;

  padding:
    100px 0 110px;

}


.sports-kicker {

  display: inline-flex;

  align-items: center;

  gap: 9px;

  padding:
    11px 17px;

  color: #142a3d;

  background:
    linear-gradient(
      135deg,
      #ffc300,
      #ffdc5b
    );

  border-radius: 999px;

  font-size: 11px;

  font-weight: 950;

  letter-spacing: 1.6px;

  box-shadow:
    0 12px 30px
    rgba(255,195,0,.18);

  animation:
    sportsReveal .8s ease both;

}


.sports-hero h1 {

  max-width: 900px;

  margin:
    24px 0 0;

  color: white;

  font-size:
    clamp(58px, 8vw, 106px);

  line-height: .91;

  letter-spacing: -5px;

  font-weight: 950;

  animation:
    sportsReveal .9s .1s ease both;

}


.sports-hero h1 span {

  display: block;

  color: var(--sports-gold);

  font-style: italic;

}


.sports-hero-inner > p {

  max-width: 720px;

  margin:
    28px 0 0;

  color:
    rgba(255,255,255,.76);

  font-size: 19px;

  line-height: 1.8;

  animation:
    sportsReveal .9s .2s ease both;

}


.sports-hero-actions {

  display: flex;

  flex-wrap: wrap;

  gap: 13px;

  margin-top: 31px;

  animation:
    sportsReveal .9s .3s ease both;

}


.sports-btn {

  min-height: 53px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  gap: 10px;

  padding:
    0 22px;

  border-radius: 13px;

  text-decoration: none;

  font-size: 13px;

  font-weight: 950;

  transition:
    transform .3s ease,
    box-shadow .3s ease,
    background .3s ease;

}


.sports-btn-primary {

  color: #142536;

  background:
    linear-gradient(
      135deg,
      #ffc300,
      #ffdb4d
    );

  box-shadow:
    0 15px 35px
    rgba(255,195,0,.24);

}


.sports-btn-primary:hover {

  transform:
    translateY(-5px);

  box-shadow:
    0 22px 45px
    rgba(255,195,0,.34);

}


.sports-btn-outline {

  color: white;

  border:
    1px solid
    rgba(255,255,255,.25);

  background:
    rgba(255,255,255,.06);

  backdrop-filter: blur(10px);

}


.sports-btn-outline:hover {

  transform:
    translateY(-5px);

  background:
    rgba(255,255,255,.13);

}


.sports-breadcrumb {

  display: flex;

  align-items: center;

  gap: 11px;

  margin-top: 28px;

  color:
    rgba(255,255,255,.55);

  font-size: 12px;

}


.sports-breadcrumb a {

  color: var(--sports-gold);

  text-decoration: none;

  font-weight: 900;

}


.sports-breadcrumb i {

  font-size: 8px;

  opacity: .45;

}


.sports-breadcrumb strong {

  color:
    rgba(255,255,255,.72);

}


.sports-hero-badge {

  position: absolute;

  z-index: 4;

  display: flex;

  align-items: center;

  gap: 9px;

  padding:
    12px 15px;

  color: #102b40;

  background:
    rgba(255,255,255,.92);

  border-radius: 13px;

  box-shadow:
    0 18px 35px
    rgba(0,0,0,.18);

  font-size: 9px;

  font-weight: 950;

  letter-spacing: 1px;

  animation:
    sportsFloat 5s ease-in-out infinite;

}


.sports-hero-badge i {

  color: #d69c00;

  font-size: 18px;

}


.badge-top {

  right: 15%;

  top: 22%;

  transform: rotate(6deg);

}


.badge-right {

  right: 7%;

  bottom: 24%;

  transform: rotate(-7deg);

  animation-delay: 1s;

}


.badge-bottom {

  right: 29%;

  bottom: 13%;

  transform: rotate(4deg);

  animation-delay: 2s;

}


@keyframes sportsFloat {

  0%,100% {
    margin-top: 0;
  }

  50% {
    margin-top: -13px;
  }

}


.sports-scroll {

  position: absolute;

  z-index: 5;

  right: 3%;

  bottom: 30px;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 10px;

  color:
    rgba(255,255,255,.43);

  font-size: 8px;

  font-weight: 900;

  letter-spacing: 2px;

  writing-mode: vertical-rl;

}


.sports-scroll i {

  color: var(--sports-gold);

  animation:
    sportsBounce 1.6s ease-in-out infinite;

}


@keyframes sportsBounce {

  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(8px);
  }

}


@keyframes sportsReveal {

  from {
    opacity: 0;
    transform: translateY(28px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}


/* =========================================================
   INTRO
========================================================= */

.sports-intro {

  padding:
    85px 0;

  background:
    #ffffff;

}


.sports-container {

  width: min(1180px, 90%);

  margin: auto;

}


.sports-intro .sports-container {

  display: grid;

  grid-template-columns:
    1.25fr
    .75fr;

  gap: 70px;

  align-items: center;

}


.sports-section-label {

  display: inline-flex;

  align-items: center;

  gap: 8px;

  color: #a67900;

  font-size: 10px;

  font-weight: 950;

  letter-spacing: 2px;

}


.sports-intro h2 {

  max-width: 720px;

  margin:
    15px 0;

  color: var(--sports-navy);

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size:
    clamp(35px, 5vw, 53px);

  line-height: 1.12;

}


.sports-intro h2 span {

  color: #c18c00;

  font-style: italic;

}


.sports-intro-copy > p {

  max-width: 730px;

  margin: 0;

  color: var(--sports-muted);

  font-size: 16px;

  line-height: 1.9;

}


.sports-intro-stats {

  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 10px;

  padding: 18px;

  background:
    #f5f7f9;

  border:
    1px solid
    #e7edf2;

  border-radius: 22px;

}


.sports-stat {

  padding:
    24px 10px;

  text-align: center;

  background: white;

  border-radius: 15px;

  box-shadow:
    0 10px 25px
    rgba(0,31,63,.06);

}


.sports-stat strong {

  display: block;

  color: var(--sports-navy);

  font-size: 31px;

  font-weight: 950;

}


.sports-stat span {

  color: #84909b;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 1px;

  text-transform: uppercase;

}


/* =========================================================
   EVENT SECTION
========================================================= */

.sports-events-section {

  padding:
    90px 0 110px;

  background:
    #f3f6f8;

}


.sports-heading {

  display: grid;

  grid-template-columns:
    auto
    1fr;

  align-items: end;

  gap: 35px;

  margin-bottom: 55px;

}


.sports-heading h2 {

  margin:
    13px 0 0;

  color: var(--sports-navy);

  font-family:
    Georgia,
    serif;

  font-size:
    clamp(37px, 5vw, 55px);

  line-height: 1.05;

}


.sports-heading h2 span {

  display: block;

  color: #bd8907;

  font-style: italic;

}


.sports-heading-line {

  height: 1px;

  margin-bottom: 10px;

  background:
    repeating-linear-gradient(
      90deg,
      #bca66f 0 7px,
      transparent 7px 14px
    );

}


/* =========================================================
   EVENT CARDS
========================================================= */

.sports-event-list {

  display: flex;

  flex-direction: column;

  gap: 35px;

}


.sports-event-card {

  position: relative;

  display: grid;

  grid-template-columns:
    .95fr
    1.05fr;

  min-height: 390px;

  overflow: hidden;

  background: white;

  border:
    1px solid
    #e2e9ee;

  border-radius: 27px;

  box-shadow:
    0 18px 48px
    rgba(0,31,63,.09);

  animation:
    sportsCardReveal .8s var(--event-delay) ease both;

  transition:
    transform .4s ease,
    box-shadow .4s ease;

}


.sports-event-card:hover {

  transform:
    translateY(-8px);

  box-shadow:
    0 28px 65px
    rgba(0,31,63,.16);

}


.sports-event-card::before {

  content: "";

  position: absolute;

  left: 0;
  top: 0;
  bottom: 0;

  width: 5px;

  background:
    linear-gradient(
      to bottom,
      #ffc300,
      #e4a800
    );

  z-index: 4;

}


@keyframes sportsCardReveal {

  from {
    opacity: 0;
    transform: translateY(35px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}


.sports-event-card.sports-reverse {

  grid-template-columns:
    1.05fr
    .95fr;

}


.sports-reverse .sports-event-image {

  grid-column: 2;
  grid-row: 1;

}


.sports-reverse .sports-event-content {

  grid-column: 1;
  grid-row: 1;

}


.sports-event-image {

  position: relative;

  min-height: 390px;

  overflow: hidden;

  background:
    #dfe7ec;

}


.sports-event-image img {

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition:
    transform .8s cubic-bezier(.2,.7,.2,1);

}


.sports-event-card:hover
.sports-event-image img {

  transform:
    scale(1.07);

}


.sports-image-overlay {

  position: absolute;

  inset: 0;

  display: flex;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 12px;

  opacity: 0;

