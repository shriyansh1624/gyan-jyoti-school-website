<script>

/* =========================================================
   GYAN JYOTI PREMIUM HOMEPAGE JS
========================================================= */

(function () {

    'use strict';


    /* =====================================================
       HERO CAROUSEL
    ====================================================== */

    const heroSlides =
        Array.from(
            document.querySelectorAll('.gj-hero-slide')
        );

    const heroDots =
        document.getElementById('gjHeroDots');

    const heroPrev =
        document.getElementById('gjHeroPrev');

    const heroNext =
        document.getElementById('gjHeroNext');

    const heroProgress =
        document.getElementById('gjHeroProgress');

    let heroIndex = 0;

    let heroTimer = null;

    const HERO_DELAY = 5600;


    function buildHeroDots() {

        if (!heroDots || heroSlides.length <= 1) {
            return;
        }

        heroDots.innerHTML = '';

        heroSlides.forEach(function (_, index) {

            const button =
                document.createElement('button');

            button.type = 'button';

            button.className =
                'gj-hero-dot' +
                (index === 0 ? ' is-active' : '');

            button.setAttribute(
                'aria-label',
                'Go to slide ' + (index + 1)
            );

            button.addEventListener(
                'click',
                function () {

                    showHeroSlide(index);

                    restartHeroTimer();

                }
            );

            heroDots.appendChild(button);

        });

    }


    function updateHeroDots() {

        if (!heroDots) {
            return;
        }

        const dots =
            heroDots.querySelectorAll('.gj-hero-dot');

        dots.forEach(function (dot, index) {

            dot.classList.toggle(
                'is-active',
                index === heroIndex
            );

        });

    }


    function animateHeroProgress() {

        if (!heroProgress) {
            return;
        }

        heroProgress.style.transition = 'none';

        heroProgress.style.width = '0%';

        requestAnimationFrame(function () {

            requestAnimationFrame(function () {

                heroProgress.style.transition =
                    'width ' + HERO_DELAY + 'ms linear';

                heroProgress.style.width = '100%';

            });

        });

    }


    function showHeroSlide(index) {

        if (!heroSlides.length) {
            return;
        }

        if (index < 0) {
            index = heroSlides.length - 1;
        }

        if (index >= heroSlides.length) {
            index = 0;
        }

        heroIndex = index;

        heroSlides.forEach(function (slide, i) {

            slide.classList.toggle(
                'is-active',
                i === heroIndex
            );

        });

        updateHeroDots();

        animateHeroProgress();

    }


    function nextHero() {

        showHeroSlide(heroIndex + 1);

    }


    function previousHero() {

        showHeroSlide(heroIndex - 1);

    }


    function restartHeroTimer() {

        if (heroTimer) {
            clearInterval(heroTimer);
        }

        if (heroSlides.length > 1) {

            heroTimer =
                setInterval(
                    nextHero,
                    HERO_DELAY
                );

        }

    }


    if (heroSlides.length) {

        buildHeroDots();

        showHeroSlide(0);

        restartHeroTimer();

    }


    if (heroNext) {

        heroNext.addEventListener(
            'click',
            function () {

                nextHero();

                restartHeroTimer();

            }
        );

    }


    if (heroPrev) {

        heroPrev.addEventListener(
            'click',
            function () {

                previousHero();

                restartHeroTimer();

            }
        );

    }


    const hero =
        document.querySelector('.gj-hero');


    if (hero) {

        hero.addEventListener(
            'mouseenter',
            function () {

                if (heroTimer) {
                    clearInterval(heroTimer);
                }

            }
        );


        hero.addEventListener(
            'mouseleave',
            function () {

                restartHeroTimer();

            }
        );

    }


    /* Keyboard controls */

    document.addEventListener(
        'keydown',
        function (event) {

            if (event.key === 'ArrowLeft') {

                previousHero();

                restartHeroTimer();

            }

            if (event.key === 'ArrowRight') {

                nextHero();

                restartHeroTimer();

            }

        }
    );



    /* =====================================================
       MOBILE HERO SWIPE — uses existing carousel functions
       and does not change routes/backend behaviour.
    ====================================================== */

    if (hero) {
        let heroTouchStartX = 0;
        let heroTouchStartY = 0;

        hero.addEventListener(
            'touchstart',
            function (event) {
                if (!event.touches || !event.touches.length) {
                    return;
                }

                heroTouchStartX = event.touches[0].clientX;
                heroTouchStartY = event.touches[0].clientY;
            },
            { passive: true }
        );

        hero.addEventListener(
            'touchend',
            function (event) {
                if (!event.changedTouches || !event.changedTouches.length) {
                    return;
                }

                const endX = event.changedTouches[0].clientX;
                const endY = event.changedTouches[0].clientY;

                const deltaX = endX - heroTouchStartX;
                const deltaY = endY - heroTouchStartY;

                /* Only treat clearly horizontal gestures as slides. */
                if (
                    Math.abs(deltaX) < 55 ||
                    Math.abs(deltaX) <= Math.abs(deltaY)
                ) {
                    return;
                }

                if (deltaX < 0) {
                    nextHero();
                } else {
                    previousHero();
                }

                restartHeroTimer();
            },
            { passive: true }
        );
    }

    /* =====================================================
       REVEAL ON SCROLL
    ====================================================== */

    const revealItems =
        document.querySelectorAll(
            '.reveal, .reveal-left, .reveal-right'
        );


    if ('IntersectionObserver' in window) {

        const revealObserver =
            new IntersectionObserver(
                function (entries, observer) {

                    entries.forEach(function (entry) {

                        if (entry.isIntersecting) {

                            entry.target.classList.add(
                                'is-visible'
                            );

                            observer.unobserve(
                                entry.target
                            );

                        }

                    });

                },
                {
                    threshold: 0.12,
                    rootMargin: '0px 0px -45px 0px'
                }
            );


        revealItems.forEach(
            function (element) {

                revealObserver.observe(element);

            }
        );

    } else {

        revealItems.forEach(
            function (element) {

                element.classList.add(
                    'is-visible'
                );

            }
        );

    }


    /* =====================================================
       STATS COUNTERS
    ====================================================== */

    const counters =
        document.querySelectorAll(
            '.gj-counter'
        );


    function runCounter(element) {

        if (
            element.dataset.counted === 'true'
        ) {
            return;
        }

        element.dataset.counted = 'true';

        const target =
            Number(
                element.dataset.target || 0
            );

        const duration = 1400;

        const start =
            performance.now();


        function update(now) {

            const progress =
                Math.min(
                    (now - start) / duration,
                    1
                );


            const eased =
                1 - Math.pow(
                    1 - progress,
                    3
                );


            element.textContent =
                Math.floor(
                    target * eased
                );


            if (progress < 1) {

                requestAnimationFrame(
                    update
                );

            } else {

                element.textContent =
                    target;

            }

        }


        requestAnimationFrame(update);

    }


    if ('IntersectionObserver' in window) {

        const counterObserver =
            new IntersectionObserver(
                function (entries, observer) {

                    entries.forEach(function (entry) {

                        if (entry.isIntersecting) {

                            runCounter(
                                entry.target
                            );

                            observer.unobserve(
                                entry.target
                            );

                        }

                    });

                },
                {
                    threshold: .5
                }
            );


        counters.forEach(
            function (counter) {

                counterObserver.observe(
                    counter
                );

            }
        );

    } else {

        counters.forEach(
            runCounter
        );

    }


    /* =====================================================
       IMAGE LAZY LOAD POLISH
    ====================================================== */

    const lazyImages =
        document.querySelectorAll(
            'img[loading="lazy"]'
        );


    lazyImages.forEach(
        function (image) {

            image.addEventListener(
                'error',
                function () {

                    image.style.opacity = '.35';

                },
                {
                    once: true
                }
            );

        }
    );


    /* =====================================================
       POPUP
    ====================================================== */

    const popupOverlay =
        document.getElementById(
            'gjPopupOverlay'
        );


    if (popupOverlay) {

        const popupSlides =
            Array.from(
                popupOverlay.querySelectorAll(
                    '.gj-popup-slide'
                )
            );

        const popupDots =
            document.getElementById(
                'gjPopupDots'
            );

        const popupProgress =
            document.getElementById(
                'gjPopupProgress'
            );

        const popupNext =
            document.getElementById(
                'gjPopupNext'
            );

        const popupPrev =
            document.getElementById(
                'gjPopupPrev'
            );

        const popupClose =
            document.getElementById(
                'gjPopupClose'
            );


        let popupIndex = 0;

        let popupTimer = null;

        const POPUP_DELAY = 5200;


        function buildPopupDots() {

            if (!popupDots) {
                return;
            }

            popupDots.innerHTML = '';


            popupSlides.forEach(
                function (_, index) {

                    const dot =
                        document.createElement(
                            'button'
                        );

                    dot.type = 'button';

                    dot.className =
                        'gj-popup-dot' +
                        (index === 0
                            ? ' is-active'
                            : ''
                        );

                    dot.setAttribute(
                        'aria-label',
                        'Popup ' + (index + 1)
                    );


                    dot.addEventListener(
                        'click',
                        function () {

                            showPopupSlide(
                                index
                            );

                            restartPopup();

                        }
                    );


                    popupDots.appendChild(
                        dot
                    );

                }
            );

        }


        function updatePopupDots() {

            if (!popupDots) {
                return;
            }

            popupDots
                .querySelectorAll(
                    '.gj-popup-dot'
                )
                .forEach(
                    function (dot, index) {

                        dot.classList.toggle(
                            'is-active',
                            index === popupIndex
                        );

                    }
                );

        }


        function animatePopupProgress() {

            if (!popupProgress) {
                return;
            }

            popupProgress.style.transition =
                'none';

            popupProgress.style.width =
                '0%';


            requestAnimationFrame(
                function () {

                    requestAnimationFrame(
                        function () {

                            popupProgress.style.transition =
                                'width ' +
                                POPUP_DELAY +
                                'ms linear';

                            popupProgress.style.width =
                                '100%';

                        }
                    );

                }
            );

        }


        function showPopupSlide(index) {

            if (!popupSlides.length) {
                return;
            }

            if (index < 0) {
                index =
                    popupSlides.length - 1;
            }

            if (
                index >= popupSlides.length
            ) {
                index = 0;
            }

            popupIndex = index;


            popupSlides.forEach(
                function (slide, i) {

                    slide.classList.toggle(
                        'is-active',
                        i === popupIndex
                    );

                }
            );


            updatePopupDots();

            animatePopupProgress();

        }


        function nextPopup() {

            showPopupSlide(
                popupIndex + 1
            );

        }


        function previousPopup() {

            showPopupSlide(
                popupIndex - 1
            );

        }


        function restartPopup() {

            if (popupTimer) {

                clearInterval(
                    popupTimer
                );

            }


            if (
                popupSlides.length > 1
            ) {

                popupTimer =
                    setInterval(
                        nextPopup,
                        POPUP_DELAY
                    );

            }

        }


        function openPopup() {

            popupOverlay.classList.add(
                'is-visible'
            );

            popupOverlay.setAttribute(
                'aria-hidden',
                'false'
            );

            document.body.dataset.gjPreviousOverflow =
                document.body.style.overflow || '';
            document.body.style.overflow = 'hidden';

            showPopupSlide(0);

            restartPopup();

        }


        function closePopup() {

            popupOverlay.classList.remove(
                'is-visible'
            );

            popupOverlay.setAttribute(
                'aria-hidden',
                'true'
            );

            document.body.style.overflow =
                document.body.dataset.gjPreviousOverflow || '';
            delete document.body.dataset.gjPreviousOverflow;

            if (popupTimer) {

                clearInterval(
                    popupTimer
                );

            }

        }


        buildPopupDots();


        if (popupNext) {

            popupNext.addEventListener(
                'click',
                function () {

                    nextPopup();

                    restartPopup();

                }
            );

        }


        if (popupPrev) {

            popupPrev.addEventListener(
                'click',
                function () {

                    previousPopup();

                    restartPopup();

                }
            );

        }


        if (popupClose) {

            popupClose.addEventListener(
                'click',
                closePopup
            );

        }


        popupOverlay.addEventListener(
            'click',
            function (event) {

                if (
                    event.target ===
                    popupOverlay
                ) {

                    closePopup();

                }

            }
        );


        document.addEventListener(
            'keydown',
            function (event) {

                if (
                    event.key === 'Escape' &&
                    popupOverlay.classList.contains(
                        'is-visible'
                    )
                ) {

                    closePopup();

                }

                if (
                    event.key === 'ArrowRight' &&
                    popupOverlay.classList.contains(
                        'is-visible'
                    )
                ) {

                    nextPopup();

                    restartPopup();

                }

                if (
                    event.key === 'ArrowLeft' &&
                    popupOverlay.classList.contains(
                        'is-visible'
                    )
                ) {

                    previousPopup();

                    restartPopup();

                }

            }
        );


        /*
         * Keep the existing behaviour:
         * popup appears after a short delay.
         *
         * It uses sessionStorage instead of localStorage so
         * closing it does not permanently disable the popup.
         */

        const popupSeen =
            sessionStorage.getItem(
                'gjHomepagePopupSeen'
            );


        if (!popupSeen) {

            window.setTimeout(
                function () {

                    openPopup();

                    sessionStorage.setItem(
                        'gjHomepagePopupSeen',
                        '1'
                    );

                },
                1400
            );

        }

    }


    /* =====================================================
       SMOOTH SCROLL
    ====================================================== */

    document
        .querySelectorAll(
            'a[href^="#"]'
        )
        .forEach(
            function (link) {

                link.addEventListener(
                    'click',
                    function (event) {

                        const targetId =
                            link.getAttribute(
                                'href'
                            );

                        if (
                            !targetId ||
                            targetId === '#'
                        ) {
                            return;
                        }

                        const target =
                            document.querySelector(
                                targetId
                            );

                        if (!target) {
                            return;
                        }

                        event.preventDefault();

                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });

                    }
                );

            }
        );


})();
</script>


