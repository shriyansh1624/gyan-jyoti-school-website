<%- include('partials/header') %>

<!-- =========================================================
     GYAN JYOTI — PREMIUM SCHOOL HOMEPAGE
     Backend-safe EJS:
     - Keeps existing sliders / popups variables
     - Keeps existing internal routes
     - No forms / no CSRF changes
     - No backend dependency added
========================================================= -->

<main class="gj-home">

    <!-- =====================================================
         PREMIUM HERO
    ====================================================== -->

    <section class="gj-hero" id="home">

        <div class="gj-hero-bg"></div>
        <div class="gj-hero-grid"></div>
        <div class="gj-hero-glow gj-glow-one"></div>
        <div class="gj-hero-glow gj-glow-two"></div>

        <div class="gj-hero-slider" id="gjHeroSlider">

            <% if (typeof sliders !== 'undefined' && sliders && sliders.length > 0) { %>

                <% sliders.forEach((slider, index) => { %>

                    <article
                        class="gj-hero-slide <%= index === 0 ? 'is-active' : '' %>"
                        data-slide="<%= index %>"
                        style="background-image:url('<%= slider.image %>');"
                    >

                        <div class="gj-hero-overlay"></div>

                        <div class="gj-hero-content">

                            <div class="gj-eyebrow">
                                <span class="gj-eyebrow-dot"></span>
                                ADMISSIONS OPEN 2026–27
                                <span class="gj-eyebrow-line"></span>
                            </div>

                            <h1>
                                <%= slider.title %>
                            </h1>

                            <div class="gj-title-accent">
                                <span></span>
                                <i class="fas fa-star"></i>
                                <span></span>
                            </div>

                            <p class="gj-hero-subtitle">
                                <%= slider.subtitle %>
                            </p>

                            <div class="gj-hero-actions">

                                <a
                                    href="<%= slider.buttonLink %>"
                                    class="gj-btn gj-btn-gold"
                                >
                                    <span><%= slider.buttonText %></span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>

                                <a
                                    href="/about"
                                    class="gj-btn gj-btn-glass"
                                >
                                    <span>Discover Our School</span>
                                    <i class="fas fa-compass"></i>
                                </a>

                            </div>

                            <div class="gj-hero-features">

                                <span>
                                    <i class="fas fa-circle-check"></i>
                                    CBSE Curriculum
                                </span>

                                <span>
                                    <i class="fas fa-circle-check"></i>
                                    Smart Classrooms
                                </span>

                                <span>
                                    <i class="fas fa-circle-check"></i>
                                    Holistic Development
                                </span>

                            </div>

                        </div>

                        <div class="gj-hero-number">
                            <span>0<%= index + 1 %></span>
                        </div>

                    </article>

                <% }) %>

            <% } else { %>

                <article
                    class="gj-hero-slide is-active"
                    data-slide="0"
                    style="background-image:url('/images/school-bg.jpg');"
                >

                    <div class="gj-hero-overlay"></div>

                    <div class="gj-hero-content">

                        <div class="gj-eyebrow">
                            <span class="gj-eyebrow-dot"></span>
                            ADMISSIONS OPEN 2026–27
                            <span class="gj-eyebrow-line"></span>
                        </div>

                        <h1>
                            Welcome To
                            <strong>Gyan Jyoti</strong>
                        </h1>

                        <div class="gj-title-accent">
                            <span></span>
                            <i class="fas fa-star"></i>
                            <span></span>
                        </div>

                        <p class="gj-hero-subtitle">
                            Excellence in Education, Character & Culture
                        </p>

                        <div class="gj-hero-actions">

                            <a
                                href="/admission/process"
                                class="gj-btn gj-btn-gold"
                            >
                                <span>Start Admission</span>
                                <i class="fas fa-arrow-right"></i>
                            </a>

                            <a
                                href="/about"
                                class="gj-btn gj-btn-glass"
                            >
                                <span>Discover Our School</span>
                                <i class="fas fa-compass"></i>
                            </a>

                        </div>

                        <div class="gj-hero-features">

                            <span>
                                <i class="fas fa-circle-check"></i>
                                CBSE Curriculum
                            </span>

                            <span>
                                <i class="fas fa-circle-check"></i>
                                Smart Classrooms
                            </span>

                            <span>
                                <i class="fas fa-circle-check"></i>
                                Holistic Development
                            </span>

                        </div>

                    </div>

                    <div class="gj-hero-number">
                        <span>01</span>
                    </div>

                </article>

            <% } %>

        </div>


        <!-- Hero Controls -->

        <button
            type="button"
            class="gj-hero-arrow gj-arrow-left"
            id="gjHeroPrev"
            aria-label="Previous slide"
        >
            <i class="fas fa-arrow-left"></i>
        </button>

        <button
            type="button"
            class="gj-hero-arrow gj-arrow-right"
            id="gjHeroNext"
            aria-label="Next slide"
        >
            <i class="fas fa-arrow-right"></i>
        </button>


        <div class="gj-hero-bottom">

            <div class="gj-hero-dots" id="gjHeroDots"></div>

            <div class="gj-hero-progress">
                <span id="gjHeroProgress"></span>
            </div>

            <div class="gj-scroll">
