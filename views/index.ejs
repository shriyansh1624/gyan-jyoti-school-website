        let dragStartX=0, dragStartY=0, baseX=0, baseY=0, dragging=false;

        function applyTransform(){
            lbImg.style.transform='translate3d('+tx+'px,'+ty+'px,0) scale('+scale+')';
        }
        function resetZoom(){
            scale=1; tx=0; ty=0; applyTransform();
        }
        function open(src,alt){
            if(!src) return;
            lbImg.src=src;
            lbImg.alt=alt||'';
            resetZoom();
            lightbox.classList.add('is-open');
            lightbox.setAttribute('aria-hidden','false');
            document.body.dataset.gjMediaOpen='1';
        }
        function close(){
            lightbox.classList.remove('is-open');
            lightbox.setAttribute('aria-hidden','true');
            document.body.removeAttribute('data-gj-media-open');
            window.setTimeout(function(){ if(!lightbox.classList.contains('is-open')) lbImg.removeAttribute('src'); },280);
        }
        function zoomBy(amount,centerX,centerY){
            const old=scale;
            scale=Math.max(1,Math.min(5,scale+amount));
            if(scale===1){tx=0;ty=0;}
            else if(centerX!=null){
                const factor=scale/old;
                tx=centerX-(centerX-tx)*factor;
                ty=centerY-(centerY-ty)*factor;
            }
            applyTransform();
        }

        closeBtn.addEventListener('click',close);
        lightbox.addEventListener('click',function(e){
            if(e.target===lightbox) close();
        });
        lightbox.querySelectorAll('[data-zoom]').forEach(function(btn){
            btn.addEventListener('click',function(){
                zoomBy(Number(btn.dataset.zoom)*.5);
            });
        });
        lightbox.querySelector('[data-reset]').addEventListener('click',resetZoom);

        lightbox.addEventListener('wheel',function(e){
            e.preventDefault();
            const r=lbImg.getBoundingClientRect();
            zoomBy(e.deltaY<0?.35:-.35,e.clientX-r.left,e.clientY-r.top);
        },{passive:false});

        lbImg.addEventListener('pointerdown',function(e){
            if(e.pointerType==='mouse' && e.button!==0) return;
            dragging=true;
            dragStartX=e.clientX;
            dragStartY=e.clientY;
            baseX=tx;
            baseY=ty;
            lbImg.classList.add('is-dragging');
            lbImg.setPointerCapture?.(e.pointerId);
        });
        lbImg.addEventListener('pointermove',function(e){
            if(!dragging || scale<=1) return;
            tx=baseX+(e.clientX-dragStartX);
            ty=baseY+(e.clientY-dragStartY);
            applyTransform();
        });
        ['pointerup','pointercancel','pointerleave'].forEach(function(type){
            lbImg.addEventListener(type,function(){
                dragging=false;
                lbImg.classList.remove('is-dragging');
            });
        });

        /* Touch pinch */
        let touchA=null,touchB=null;
        lbImg.addEventListener('touchstart',function(e){
            if(e.touches.length===2){
                touchA=e.touches[0];
                touchB=e.touches[1];
                pinchStart=Math.hypot(
                    touchB.clientX-touchA.clientX,
                    touchB.clientY-touchA.clientY
                );
                startScale=scale;
            }
        },{passive:true});
        lbImg.addEventListener('touchmove',function(e){
            if(e.touches.length!==2 || !pinchStart) return;
            const a=e.touches[0],b=e.touches[1];
            const dist=Math.hypot(b.clientX-a.clientX,b.clientY-a.clientY);
            scale=Math.max(1,Math.min(5,startScale*(dist/pinchStart)));
            if(scale===1){tx=0;ty=0;}
            applyTransform();
            e.preventDefault();
        },{passive:false});
        lbImg.addEventListener('touchend',function(e){
            if(e.touches.length<2) pinchStart=0;
        },{passive:true});

        document.addEventListener('keydown',function(e){
            if(!lightbox.classList.contains('is-open')) return;
            if(e.key==='Escape') close();
            if(e.key==='+' || e.key==='=') zoomBy(.5);
            if(e.key==='-' || e.key==='_') zoomBy(-.5);
            if(e.key==='0') resetZoom();
        });

        /* ---------- Add zoom controls to real images ---------- */
        const selectors=[
            '.gj-image-frame',
            '.gj-academic-image-main',
            '.gj-academic-small',
            '.gj-gallery-item',
            '.gj-person',
            '.gj-popup-slide'
        ];

        const hosts=[];
        selectors.forEach(function(sel){
            home.querySelectorAll(sel).forEach(function(host){
                if(!host.querySelector('img') || hosts.indexOf(host)!==-1) return;
                hosts.push(host);
            });
        });

        hosts.forEach(function(host){
            host.classList.add('gj-zoom-host');
            const img=host.querySelector('img');
            if(!img) return;
            const button=document.createElement('button');
            button.type='button';
            button.className='gj-zoom-control';
            button.setAttribute('aria-label','Open image zoom');
            button.innerHTML='<i class="fas fa-magnifying-glass-plus" aria-hidden="true"></i>';
            button.addEventListener('click',function(e){
                e.preventDefault();
                e.stopPropagation();
                open(img.currentSrc||img.src,img.alt);
            });
            host.appendChild(button);
        });

        /* ---------- Hero background zoom ---------- */
        const hero=home.querySelector('.gj-hero');
        const heroSlider=home.querySelector('.gj-hero-slider');
        if(hero && heroSlider){
            const heroZoom=document.createElement('button');
            heroZoom.type='button';
            heroZoom.className='gj-hero-zoom';
            heroZoom.setAttribute('aria-label','Zoom current hero image');
            heroZoom.innerHTML='<i class="fas fa-magnifying-glass-plus" aria-hidden="true"></i>';
            hero.appendChild(heroZoom);

            heroZoom.addEventListener('click',function(e){
                e.preventDefault();
                e.stopPropagation();
                const active=hero.querySelector('.gj-hero-slide.is-active');
                if(!active) return;
                const match=active.style.backgroundImage.match(/url\((['"]?)(.*?)\1\)/);
                if(match && match[2]){
                    open(match[2], 'Gyan Jyoti School');
                }
            });
        }

        /* ---------- Keep popup/hero media responsive after viewport changes ---------- */
        let resizeTimer=0;
        window.addEventListener('resize',function(){
            window.clearTimeout(resizeTimer);
            resizeTimer=window.setTimeout(function(){
                if(scale===1){tx=0;ty=0;applyTransform();}
            },120);
        },{passive:true});

        /* ---------- Prevent background page scroll only while lightbox is open ---------- */
        const style=document.createElement('style');
        style.textContent='body[data-gj-media-open="1"]{overflow:hidden!important;touch-action:none;}';
        document.head.appendChild(style);
    }

    if(document.readyState==='loading'){
        document.addEventListener('DOMContentLoaded',init,{once:true});
    }else{
        init();
    }
})();
</script>
