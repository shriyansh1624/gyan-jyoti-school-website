<script id="gj-production-enhancement-script">
/* =========================================================
   GYAN JYOTI — INTERACTION ENHANCEMENT LAYER
   Existing navigation, backend routes and popup logic untouched.
========================================================= */
(function(){
    'use strict';

    const home = document.querySelector('.gj-home');
    if(!home) return;

    /* ---------- Scroll progress + back-to-top ---------- */
    const progressWrap = document.createElement('div');
    progressWrap.className = 'gj-page-progress';
    progressWrap.setAttribute('aria-hidden','true');
    progressWrap.innerHTML = '<span></span>';
    document.body.appendChild(progressWrap);
    const progressBar = progressWrap.querySelector('span');

    const backTop = document.createElement('button');
    backTop.type = 'button';
    backTop.className = 'gj-back-top';
    backTop.setAttribute('aria-label','Back to top');
    backTop.innerHTML = '<i class="fas fa-arrow-up" aria-hidden="true"></i>';
    document.body.appendChild(backTop);

    let scrollTick = false;
    function updateScrollUI(){
        const doc = document.documentElement;
        const max = Math.max(1, doc.scrollHeight - window.innerHeight);
        const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
        progressBar.style.width = pct + '%';
        backTop.classList.toggle('is-visible', window.scrollY > 520);
        scrollTick = false;
    }
    window.addEventListener('scroll',function(){
        if(!scrollTick){
            scrollTick = true;
            requestAnimationFrame(updateScrollUI);
        }
    },{passive:true});
    updateScrollUI();
    backTop.addEventListener('click',function(){
        window.scrollTo({top:0,behavior:'smooth'});
    });

    /* ---------- Scroll reveal stagger ---------- */
    const revealGroups = document.querySelectorAll(
        '.gj-feature-grid .reveal,' +
        '.gj-stats-grid .reveal,' +
        '.gj-discover-grid .reveal,' +
        '.gj-testimonial-grid .reveal,' +
        '.gj-gallery-grid .reveal'
    );
    revealGroups.forEach(function(el,i){
        el.style.transitionDelay = Math.min(i * 70, 420) + 'ms';
    });

    /* ---------- Premium pointer aura on desktop ---------- */
    const finePointer = window.matchMedia('(hover:hover) and (pointer:fine)');
    if(finePointer.matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
        const aura = document.createElement('div');
        aura.className = 'gj-cursor-aura';
        aura.setAttribute('aria-hidden','true');
        document.body.appendChild(aura);

        let mx = -200, my = -200, ax = mx, ay = my, active = false;
        window.addEventListener('pointermove',function(e){
            mx = e.clientX;
            my = e.clientY;
            if(!active){ active = true; aura.classList.add('is-active'); }
        },{passive:true});
        window.addEventListener('pointerleave',function(){
            active = false;
            aura.classList.remove('is-active');
        },{passive:true});
        function moveAura(){
            ax += (mx-ax)*.16;
            ay += (my-ay)*.16;
            aura.style.transform = 'translate3d(' + ax + 'px,' + ay + 'px,0) translate(-50%,-50%)';
            requestAnimationFrame(moveAura);
        }
        requestAnimationFrame(moveAura);
    }

    /* ---------- Subtle 3D card tilt on real pointer devices ---------- */
    if(finePointer.matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
        const tiltCards = document.querySelectorAll(
            '.gj-feature-card,.gj-stat-card,.gj-discover-card,.gj-testimonial'
        );
        tiltCards.forEach(function(card){
            card.addEventListener('pointermove',function(e){
                const r = card.getBoundingClientRect();
                const x = (e.clientX-r.left)/r.width-.5;
                const y = (e.clientY-r.top)/r.height-.5;
                card.style.transform = 'perspective(900px) rotateX(' + (-y*3) + 'deg) rotateY(' + (x*3) + 'deg) translateY(-8px)';
            });
            card.addEventListener('pointerleave',function(){
                card.style.transform = '';
            });
        });
    }

    /* ---------- Ripple feedback; hrefs/actions remain untouched ---------- */
    const rippleTargets = document.querySelectorAll('.gj-btn,.gj-text-btn,.gj-outline-btn,.gj-quick-links a');
    rippleTargets.forEach(function(target){
        target.addEventListener('click',function(e){
            if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const rect = target.getBoundingClientRect();
            const ripple = document.createElement('span');
            ripple.className = 'gj-ripple';
            ripple.style.left = (e.clientX-rect.left) + 'px';
            ripple.style.top = (e.clientY-rect.top) + 'px';
            target.appendChild(ripple);
            window.setTimeout(function(){ ripple.remove(); },700);
        });
    });

    /* ---------- Hero pause when user prefers reduced motion ---------- */
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){
        home.classList.add('gj-reduced-motion');
    }
})();

</script>


