<script>
(function(){
'use strict';
const $=(s,r=document)=>r.querySelector(s);
const $$=(s,r=document)=>Array.from(r.querySelectorAll(s));

/* =========================================================
   PREMIUM HERO — LIGHTWEIGHT + TOUCH SAFE
   Normal backend links are left completely untouched.
========================================================= */
const hero=$('.gj-hero');
const slides=$$('.gj-hero-slide');
const dots=$('#gjHeroDots');
const prev=$('#gjHeroPrev');
const next=$('#gjHeroNext');
const progress=$('#gjHeroProgress');
let index=0, timer=null, startX=0, startY=0, tracking=false;
const DELAY=5600;

function updateHeroUI(){
    slides.forEach((slide,i)=>slide.classList.toggle('is-active',i===index));
    if(dots){
        $$('.gj-hero-dot',dots).forEach((dot,i)=>dot.classList.toggle('is-active',i===index));
    }
    if(progress){
        progress.style.transition='none';
        progress.style.width='0%';
        if(!document.hidden){
            requestAnimationFrame(()=>{
                progress.style.transition=`width ${DELAY}ms linear`;
                progress.style.width='100%';
            });
        }
    }
}

function restartHero(){
    if(timer) clearTimeout(timer);
    timer=null;
    if(slides.length>1 && !document.hidden){
        timer=setTimeout(()=>showHero(index+1),DELAY);
    }
}

function showHero(nextIndex){
    if(!slides.length) return;
    index=(nextIndex+slides.length)%slides.length;
    updateHeroUI();
    restartHero();
}

if(dots && slides.length>1){
    dots.replaceChildren();
    slides.forEach((_,i)=>{
        const button=document.createElement('button');
        button.type='button';
        button.className='gj-hero-dot'+(i===0?' is-active':'');
        button.setAttribute('aria-label','Go to slide '+(i+1));
        button.addEventListener('click',()=>showHero(i));
        dots.appendChild(button);
    });
}

if(slides.length) showHero(0);

if(next) next.addEventListener('click',(event)=>{
    event.preventDefault();
    event.stopPropagation();
    showHero(index+1);
});

if(prev) prev.addEventListener('click',(event)=>{
    event.preventDefault();
    event.stopPropagation();
    showHero(index-1);
});

/* Horizontal swipe changes slides; vertical movement stays page scroll. */
if(hero){
    hero.addEventListener('pointerdown',(event)=>{
        if(event.pointerType==='mouse') return;
        startX=event.clientX;
        startY=event.clientY;
        tracking=true;
    },{passive:true});

    hero.addEventListener('pointerup',(event)=>{
        if(!tracking || event.pointerType==='mouse') return;
        tracking=false;
        const dx=event.clientX-startX;
        const dy=event.clientY-startY;
        if(Math.abs(dx)<55 || Math.abs(dx)<=Math.abs(dy)) return;
        showHero(dx<0 ? index+1 : index-1);
    },{passive:true});

    hero.addEventListener('pointercancel',()=>{tracking=false;},{passive:true});
    hero.addEventListener('mouseenter',()=>{if(timer) clearTimeout(timer);timer=null;});
    hero.addEventListener('mouseleave',restartHero);
}

document.addEventListener('visibilitychange',()=>{
    if(document.hidden){
        if(timer) clearTimeout(timer);
        timer=null;
    }else{
        restartHero();
    }
});

document.addEventListener('keydown',(event)=>{
    if(event.key==='ArrowLeft') showHero(index-1);
    if(event.key==='ArrowRight') showHero(index+1);
});

/* =========================================================
   REVEALS — IntersectionObserver only, no scroll listener.
========================================================= */
const reveals=$$('.reveal,.reveal-left,.reveal-right');
if('IntersectionObserver' in window){
    const observer=new IntersectionObserver((entries,obs)=>{
        entries.forEach(entry=>{
            if(entry.isIntersecting){
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
            }
        });
    },{threshold:.08,rootMargin:'0px 0px -30px'});
    reveals.forEach(el=>observer.observe(el));
}else{
    reveals.forEach(el=>el.classList.add('is-visible'));
}

/* =========================================================
   COUNTERS — only animate when visible.
========================================================= */
const counters=$$('.gj-counter');
function animateCounter(el){
    if(el.dataset.counted==='true') return;
    el.dataset.counted='true';
    const target=Number(el.dataset.target||0);
    const start=performance.now();
    const duration=700;
    function frame(now){
        const progress=Math.min((now-start)/duration,1);
        const eased=1-Math.pow(1-progress,3);
        el.textContent=Math.floor(target*eased);
        if(progress<1) requestAnimationFrame(frame);
        else el.textContent=target;
    }
    requestAnimationFrame(frame);
}
if('IntersectionObserver' in window){
    const counterObserver=new IntersectionObserver((entries,obs)=>{
        entries.forEach(entry=>{
            if(entry.isIntersecting){
                animateCounter(entry.target);
                obs.unobserve(entry.target);
            }
        });
    },{threshold:.35});
    counters.forEach(el=>counterObserver.observe(el));
}else{
    counters.forEach(animateCounter);
}

/* =========================================================
   FLOATING POPUP — never locks page scrolling.
   IMPORTANT: only #gjPopupOverlay is the outer popup container.
========================================================= */
const popup=$('#gjPopupOverlay');
if(popup){
    const popupSlides=$$('.gj-popup-slide',popup);
    const popupDots=$('#gjPopupDots');
    const popupProgress=$('#gjPopupProgress');
    const popupNext=$('#gjPopupNext');
    const popupPrev=$('#gjPopupPrev');
    const popupClose=$('#gjPopupClose');
    let popupIndex=0;
    let popupTimer=null;
    const POPUP_DELAY=5200;

    function updatePopup(){
        popupSlides.forEach((slide,i)=>slide.classList.toggle('is-active',i===popupIndex));
        if(popupDots){
            $$('.gj-popup-dot',popupDots).forEach((dot,i)=>dot.classList.toggle('is-active',i===popupIndex));
        }
        if(popupProgress){
            popupProgress.style.transition='none';
            popupProgress.style.width='0%';
            if(!document.hidden){
                requestAnimationFrame(()=>{
                    popupProgress.style.transition=`width ${POPUP_DELAY}ms linear`;
                    popupProgress.style.width='100%';
                });
            }
        }
    }

    function showPopup(nextIndex){
        if(!popupSlides.length) return;
        popupIndex=(nextIndex+popupSlides.length)%popupSlides.length;
        updatePopup();
    }

    function restartPopup(){
        if(popupTimer) clearTimeout(popupTimer);
        popupTimer=null;
        if(popupSlides.length>1 && popup.classList.contains('is-visible') && !document.hidden){
            popupTimer=setTimeout(()=>{
                showPopup(popupIndex+1);
                restartPopup();
            },POPUP_DELAY);
        }
    }

    function openPopup(){
        popup.classList.add('is-visible');
        popup.setAttribute('aria-hidden','false');
        /* Never modify document/body overflow here. */
        showPopup(0);
        restartPopup();
    }

    function closePopup(){
        popup.classList.remove('is-visible');
        popup.setAttribute('aria-hidden','true');
        if(popupTimer) clearTimeout(popupTimer);
        popupTimer=null;
    }

    if(popupSlides.length<=1){
        if(popupNext) popupNext.hidden=true;
        if(popupPrev) popupPrev.hidden=true;
        if(popupDots) popupDots.hidden=true;
    }

    if(popupDots && popupSlides.length>1){
        popupDots.replaceChildren();
        popupSlides.forEach((_,i)=>{
            const button=document.createElement('button');
            button.type='button';
            button.className='gj-popup-dot'+(i===0?' is-active':'');
            button.setAttribute('aria-label','Popup '+(i+1));
            button.addEventListener('click',(event)=>{
                event.preventDefault();
                event.stopPropagation();
                showPopup(i);
                restartPopup();
            });
            popupDots.appendChild(button);
        });
    }

    if(popupNext) popupNext.addEventListener('click',(event)=>{
        event.preventDefault();
        event.stopPropagation();
        showPopup(popupIndex+1);
        restartPopup();
    });

    if(popupPrev) popupPrev.addEventListener('click',(event)=>{
        event.preventDefault();
        event.stopPropagation();
        showPopup(popupIndex-1);
        restartPopup();
    });

    if(popupClose) popupClose.addEventListener('click',(event)=>{
        event.preventDefault();
        event.stopPropagation();
        closePopup();
    });

    popup.addEventListener('click',(event)=>{
        if(event.target===popup) closePopup();
    });

    document.addEventListener('keydown',(event)=>{
        if(!popup.classList.contains('is-visible')) return;
        if(event.key==='Escape') closePopup();
        if(event.key==='ArrowRight'){
            showPopup(popupIndex+1);
            restartPopup();
        }
        if(event.key==='ArrowLeft'){
            showPopup(popupIndex-1);
            restartPopup();
        }
    });

    if(!sessionStorage.getItem('gjHomepagePopupSeen')){
        window.setTimeout(()=>{
            if(!document.hidden){
                openPopup();
                sessionStorage.setItem('gjHomepagePopupSeen','1');
            }
        },3200);
    }
}

/* Same-page anchors only. Normal backend routes remain native. */
document.addEventListener('click',(event)=>{
    const link=event.target.closest('a[href^="#"]');
    if(!link) return;
    const id=link.getAttribute('href');
    if(!id || id==='#') return;
    const target=document.querySelector(id);
    if(!target) return;
    event.preventDefault();
    target.scrollIntoView({behavior:'smooth',block:'start'});
});
})();
</script>


