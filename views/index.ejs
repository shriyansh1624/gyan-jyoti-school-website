<!-- =========================================================
     PREMIUM POPUP
     Uses existing backend "popups" data only.
========================================================= -->

<%
    const homepagePopups =
        typeof popups !== 'undefined' && Array.isArray(popups)
            ? popups
            : [];
%>

<% if (homepagePopups.length) { %>

    <div
        id="gjPopupOverlay"
        class="gj-popup-overlay"
        aria-hidden="true"
    >

        <div
            class="gj-popup"
            role="dialog"
            aria-modal="true"
            aria-label="School announcement"
        >

            <button
                type="button"
                class="gj-popup-close"
                id="gjPopupClose"
                aria-label="Close"
            >
                <i class="fas fa-xmark"></i>
            </button>


            <button
                type="button"
                class="gj-popup-arrow gj-popup-prev"
                id="gjPopupPrev"
                aria-label="Previous"
            >
                <i class="fas fa-chevron-left"></i>
            </button>


            <button
                type="button"
                class="gj-popup-arrow gj-popup-next"
                id="gjPopupNext"
                aria-label="Next"
            >
                <i class="fas fa-chevron-right"></i>
            </button>


            <div class="gj-popup-slides" id="gjPopupSlides">

                <% homepagePopups.forEach(function(popup, index) { %>

                    <article
                        class="gj-popup-slide <%= index === 0 ? 'is-active' : '' %>"
                        data-popup-slide="<%= index %>"
                    >

                        <img
                            src="<%= popup.image %>"
                            alt="<%= popup.title %>"
                            class="gj-popup-image"
                            draggable="false"
                        >

                        <div class="gj-popup-overlay"></div>

                        <div class="gj-popup-content">

                            <span class="gj-popup-badge">
                                <i class="fas fa-bolt"></i>
                                SCHOOL UPDATE
                            </span>

                            <h2>
                                <%= popup.title %>
                            </h2>

                            <p>
                                <%= popup.subtitle %>
                            </p>

                            <a
                                href="<%= popup.buttonLink %>"
                                class="gj-popup-button"
                            >
                                <span><%= popup.buttonText %></span>
                                <i class="fas fa-arrow-right"></i>
                            </a>

                        </div>

                    </article>

                <% }) %>

            </div>


            <div class="gj-popup-footer">

                <div
                    class="gj-popup-dots"
                    id="gjPopupDots"
                ></div>

                <div class="gj-popup-progress">
                    <span id="gjPopupProgress"></span>
                </div>

            </div>

        </div>

    </div>

<% } %>


