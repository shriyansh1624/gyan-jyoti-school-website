<!-- Instagram URL override: keeps existing header/footer icons and only updates their destination -->
<script>
(function () {
    const instagramUrl = 'https://www.instagram.com/gyanjyoti.nainpur?stkn=b2R2bWR2YnYwZjVn';

    document.querySelectorAll('a').forEach(function (link) {
        const icon = link.querySelector('.fa-instagram');
        const label = (link.getAttribute('aria-label') || '').toLowerCase();

        if (icon || label === 'instagram') {
            link.href = instagramUrl;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
        }
    });
})();
