/* =========================================================
   POPUP
========================================================= */

.gj-popup-overlay {

    position: fixed;

    inset: 0;

    z-index: 99999;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 25px;

    background:
        rgba(0,12,25,.78);

    backdrop-filter: blur(14px);

    opacity: 0;

    visibility: hidden;

    transition: .45s;

}


.gj-popup-overlay.is-visible {

    opacity: 1;

    visibility: visible;

}


.gj-popup {

    position: relative;

    width: min(1100px, 94vw);

    height: min(650px, 82vh);

    overflow: hidden;

    border-radius: 30px;

    background: #061323;

    border: 1px solid rgba(255,255,255,.15);

    box-shadow:
        0 45px 120px rgba(0,0,0,.55);

    transform: translateY(35px) scale(.96);

    transition: .5s;

}


.gj-popup-overlay.is-visible .gj-popup {

    transform: translateY(0) scale(1);

}


.gj-popup::after {

    content: "";

    position: absolute;

    left: 0;

    right: 0;

    bottom: 0;

    height: 4px;

    background:
        linear-gradient(
            90deg,
