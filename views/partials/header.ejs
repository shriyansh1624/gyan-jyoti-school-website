<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#001f3f"
    >

    <title>
        <%= typeof title !== 'undefined'
            ? title
            : 'Gyan Jyoti School' %>
    </title>


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    >


    <!-- =====================================================
         MAIN STYLESHEETS
    ====================================================== -->

    <link
        rel="stylesheet"
        href="/stylesheets/style.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/responsive.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/hero.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/homepage.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/components.css"
    >

    <link
        rel="stylesheet"
        href="/stylesheets/animations.css"
    >

</head>


<body>


<!-- =========================================================
     TOP HEADER
========================================================= -->

<div class="top-header">

    <div class="container top-header-container">


        <!-- =================================================
             CONTACT INFORMATION
        ================================================== -->

        <div class="top-header-left">

            <span>

                <i class="fas fa-envelope"></i>

                <%= typeof schoolInfo !== 'undefined' &&
                    schoolInfo &&
                    schoolInfo.email
                    ? schoolInfo.email
                    : 'info@gyanjyoti.com' %>

            </span>


            <span>

                <i class="fas fa-phone"></i>

                <%= typeof schoolInfo !== 'undefined' &&
                    schoolInfo &&
                    schoolInfo.phone
                    ? schoolInfo.phone
                    : '+91 98765-43210' %>

            </span>

        </div>


        <!-- =================================================
             SOCIAL LINKS
        ================================================== -->

        <div class="top-header-right">

            <% if (
                typeof schoolInfo !== 'undefined' &&
                schoolInfo &&
                schoolInfo.socialLinks
            ) { %>


                <% if (
                    schoolInfo.socialLinks.facebook
                ) { %>

                    <a
                        href="<%= schoolInfo.socialLinks.facebook %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                    >

                        <i class="fab fa-facebook"></i>

                    </a>

                <% } %>


                <% if (
                    schoolInfo.socialLinks.instagram
                ) { %>

                    <a
                        href="<%= schoolInfo.socialLinks.instagram %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                    >

                        <i class="fab fa-instagram"></i>

                    </a>

                <% } %>


                <% if (
                    schoolInfo.socialLinks.youtube
                ) { %>

                    <a
                        href="<%= schoolInfo.socialLinks.youtube %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube"
                    >

                        <i class="fab fa-youtube"></i>

                    </a>

                <% } %>


                <% if (
                    schoolInfo.socialLinks.whatsapp
                ) { %>

                    <a
                        href="<%= schoolInfo.socialLinks.whatsapp %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="WhatsApp"
                    >

                        <i class="fab fa-whatsapp"></i>

                    </a>

                <% } %>


            <% } else { %>


                <a
                    href="#"
                    aria-label="Facebook"
                >

                    <i class="fab fa-facebook"></i>

                </a>


                <a
                    href="#"
                    aria-label="Instagram"
                >

                    <i class="fab fa-instagram"></i>

                </a>


                <a
                    href="#"
                    aria-label="YouTube"
                >

                    <i class="fab fa-youtube"></i>

                </a>


            <% } %>

        </div>

    </div>

</div>


<!-- =========================================================
     MAIN HEADER
========================================================= -->

<header class="main-header">

    <div class="container main-header-container">


        <!-- =================================================
             SCHOOL LOGO / BRAND
        ================================================== -->

        <a
            href="/"
            class="logo-section"
        >

            <img
                src="<%= typeof schoolInfo !== 'undefined' &&
                    schoolInfo &&
                    schoolInfo.logo
                    ? schoolInfo.logo
                    : '/images/logo.png' %>"
                alt="Gyan Jyoti School Logo"
                class="school-logo"
            >


            <div class="school-info">

                <h1>

                    <%= typeof schoolInfo !== 'undefined' &&
                        schoolInfo &&
                        schoolInfo.schoolName
                        ? schoolInfo.schoolName
                        : 'Gyan Jyoti' %>

                </h1>


                <p>

                    <%= typeof schoolInfo !== 'undefined' &&
                        schoolInfo &&
                        schoolInfo.tagline
                        ? schoolInfo.tagline
                        : 'International School' %>

                </p>


                <small>

                    <%= typeof schoolInfo !== 'undefined' &&
                        schoolInfo &&
                        schoolInfo.affiliation
                        ? schoolInfo.affiliation
                        : 'CBSE Affiliation No. 1030842' %>

                </small>

            </div>

        </a>


        <!-- =================================================
             MOBILE HAMBURGER
        ================================================== -->

        <button
            class="hamburger"
            type="button"
            id="hamburgerBtn"
            aria-label="Open navigation menu"
            aria-expanded="false"
        >

            <span></span>
            <span></span>
            <span></span>

        </button>


        <!-- =================================================
             NAVIGATION
        ================================================== -->

        <nav
            class="navbar"
            id="mainNavbar"
        >


            <!-- =============================================
                 MOBILE BRAND
            ============================================== -->

            <div class="mobile-nav-head">

                <div class="mobile-brand">

                    <img
                        src="<%= typeof schoolInfo !== 'undefined' &&
                            schoolInfo &&
                            schoolInfo.logo
                            ? schoolInfo.logo
                            : '/images/logo.png' %>"
                        alt="Gyan Jyoti Logo"
                    >


                    <div>

                        <h3>

                            <%= typeof schoolInfo !== 'undefined' &&
                                schoolInfo &&
                                schoolInfo.schoolName
                                ? schoolInfo.schoolName
                                : 'Gyan Jyoti' %>

                        </h3>


                        <p>

                            <%= typeof schoolInfo !== 'undefined' &&
                                schoolInfo &&
                                schoolInfo.tagline
                                ? schoolInfo.tagline
                                : 'International School' %>

                        </p>

                    </div>

                </div>

            </div>


            <!-- =============================================
                 NAV MENU
            ============================================== -->

            <ul
                class="nav-menu"
                id="navMenu"
            >


                <!-- =================================================
                     HOME
                ================================================== -->

                <li>

                    <a
                        href="/"
                        class="<%= typeof active !== 'undefined' &&
                            active === 'home'
                            ? 'active'
                            : '' %>"
                    >

                        HOME

                    </a>

                </li>


                <!-- =================================================
                     ABOUT US
                ================================================== -->

                <li class="dropdown">

                    <button
                        type="button"
                        class="nav-dropdown-btn <%= typeof active !== 'undefined' &&
                            active === 'about'
                            ? 'active'
                            : '' %>"
                        aria-expanded="false"
                    >

                        ABOUT US

                        <i class="fas fa-chevron-down"></i>

                    </button>


                    <ul class="dropdown-menu">

                        <li>
                            <a href="/about">
                                ABOUT SCHOOL
                            </a>
                        </li>

                        <li>
                            <a href="/about/vision">
                                VISION &amp; MISSION
                            </a>
                        </li>

                        <li>
                            <a href="/about/founder">
                                FOUNDER'S MESSAGE
                            </a>
                        </li>

                        <li>
                            <a href="/about/principal">
                                PRINCIPAL'S MESSAGE
                            </a>
                        </li>

                        <li>
                            <a href="/about/advantages">
                                MIS ADVANTAGES
                            </a>
                        </li>

                        <li>
                            <a href="/about/accolades">
                                DEVELOPER AND MEMBER
                            </a>
                        </li>

                    </ul>

                </li>


                <!-- =================================================
                     ACADEMICS
                ================================================== -->

                <li class="dropdown">

                    <button
                        type="button"
                        class="nav-dropdown-btn <%= typeof active !== 'undefined' &&
                            active === 'academics'
                            ? 'active'
                            : '' %>"
                        aria-expanded="false"
                    >

                        ACADEMICS

                        <i class="fas fa-chevron-down"></i>

                    </button>


                    <ul class="dropdown-menu">

                        <li>
                            <a href="/academics">
                                ACADEMICS OVERVIEW
                            </a>
                        </li>

                        <li>
                            <a href="/academics/sports-records">
                                SPORTS ACADEMIC RECORDS
                            </a>
                        </li>

                    </ul>

                </li>


                <!-- =================================================
                     EVENTS
                ================================================== -->

                <li class="dropdown">

                    <button
                        type="button"
                        class="nav-dropdown-btn <%= typeof active !== 'undefined' &&
                            active === 'events'
                            ? 'active'
                            : '' %>"
                        aria-expanded="false"
                    >

                        EVENTS

                        <i class="fas fa-chevron-down"></i>

                    </button>


                    <ul class="dropdown-menu">


                        <!-- =========================================
                             FUN & FIESTA
                        ========================================== -->

                        <li>

                            <a
                                href="/events/fun-fiesta"
                            >

                                <i
                                    class="fas fa-face-grin-stars event-menu-icon"
                                ></i>

                                FUN &amp; FIESTA

                            </a>

                        </li>


                        <!-- =========================================
                             SPORTS
                        ========================================== -->

                        <li>

                            <a
                                href="/events/sports"
                            >

                                <i
                                    class="fas fa-trophy event-menu-icon"
                                ></i>

                                SPORTS

                            </a>

                        </li>


                        <!-- =========================================
                             NATIONAL CELEBRATIONS
                             Republic + Independence
                        ========================================== -->

                        <li>

                            <a
                                href="/events/national-days"
                            >

                                <i
                                    class="fas fa-flag event-menu-icon"
                                ></i>

                                NATIONAL CELEBRATIONS

                            </a>

                        </li>


                        <!-- =========================================
                             OLD MEMORIES
                        ========================================== -->

                        <li>

                            <a
                                href="/events/old-memories"
                            >

                                <i
                                    class="fas fa-clock-rotate-left event-menu-icon"
                                ></i>

                                OLD MEMORIES

                            </a>

                        </li>


                    </ul>

                </li>


                <!-- =================================================
                     ADMISSION
                ================================================== -->

                <li class="dropdown">

                    <button
                        type="button"
                        class="nav-dropdown-btn <%= typeof active !== 'undefined' &&
                            active === 'admission'
                            ? 'active'
                            : '' %>"
                        aria-expanded="false"
                    >

                        ADMISSION

                        <i class="fas fa-chevron-down"></i>

                    </button>


                    <ul class="dropdown-menu">

                        <li>
                            <a href="/admission/process">
                                ADMISSION PROCESS
                            </a>
                        </li>

                        <li>
                            <a href="/admission/enquiry">
                                ENQUIRY FORM
                            </a>
                        </li>

                        <li>
                            <a href="/admission/registration">
                                REGISTRATION FORM
                            </a>
                        </li>

                        <li>
                            <a href="/admission/guidelines">
                                GUIDELINES &amp; POLICIES
                            </a>
                        </li>

                        <li>
                            <a href="/admission/map">
                                MAP OF SCHOOL
                            </a>
                        </li>

                        <li>
                            <a href="/fees">
                                FEES STRUCTURE
                            </a>
                        </li>

                    </ul>

                </li>


                <!-- =================================================
                     FACULTY
                ================================================== -->

                <li>

                    <a
                        href="/faculty"
                        class="<%= typeof active !== 'undefined' &&
                            active === 'faculty'
                            ? 'active'
                            : '' %>"
                    >

                        FACULTY

                    </a>

                </li>


                <!-- =================================================
                     CONTACT
                ================================================== -->

                <li>

                    <a
                        href="/contact"
                        class="<%= typeof active !== 'undefined' &&
                            active === 'contact'
                            ? 'active'
                            : '' %>"
                    >

                        CONTACT

                    </a>

                </li>

            </ul>

        </nav>

    </div>

</header>


<!-- =========================================================
     HEADER STYLES
========================================================= -->

<style>

    * {
        box-sizing: border-box;
    }


    html,
    body {

        width: 100%;

        overflow-x: hidden;

    }


    body {

        margin: 0;

        font-family:
            'Segoe UI',
            Tahoma,
            Geneva,
            Verdana,
            sans-serif;

        color: #333;

        background: #fff;

    }


    .container {

        width: 86%;

        max-width: 1200px;

        margin: 0 auto;

    }


    /* =========================================================
       TOP HEADER
    ========================================================== */

    .top-header {

        background: #001f3f;

        color: #fff;

        font-size: 13px;

        padding: 10px 0;

    }


    .top-header-container {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

    }


    .top-header-left {

        display: flex;

        align-items: center;

        gap: 28px;

        flex-wrap: wrap;

    }


    .top-header-left span {

        display: inline-flex;

        align-items: center;

        gap: 8px;

    }


    .top-header-left i,
    .top-header-right i {

        color: #ffc300;

    }


    .top-header-right {

        display: flex;

        align-items: center;

        gap: 16px;

    }


    .top-header-right a {

        color: #fff;

        text-decoration: none;

        transition: .3s;

    }


    .top-header-right a:hover {

        color: #ffc300;

        transform:
            translateY(-2px);

    }


    /* =========================================================
       MAIN HEADER
    ========================================================== */

    .main-header {

        position: sticky;

        top: 0;

        z-index: 99999;

        background: #fff;

        box-shadow:
            0 8px 28px
            rgba(0,0,0,.10);

    }


    .main-header-container {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 22px;

        min-height: 95px;

        position: relative;

    }


    /* =========================================================
       LOGO
    ========================================================== */

    .logo-section {

        display: flex;

        align-items: center;

        gap: 14px;

        min-width: 290px;

        text-decoration: none;

    }


    .school-logo {

        width: 78px;

        height: 78px;

        object-fit: contain;

        background: #fff;

        border-radius: 50%;

        padding: 3px;

        filter:
            drop-shadow(
                0 8px 14px
                rgba(0,0,0,.14)
            );

        flex-shrink: 0;

    }


    .school-info h1 {

        margin: 0;

        color: #8b0000;

        font-size: 25px;

        font-weight: 900;

        line-height: 1.1;

    }


    .school-info p {

        margin: 4px 0 0;

        color: #333;

        font-size: 13px;

        font-weight: 700;

    }


    .school-info small {

        display: block;

        margin-top: 2px;

        color: #666;

        font-size: 11px;

    }


    /* =========================================================
       NAVBAR
    ========================================================== */

    .navbar {

        flex: 1;

        display: flex;

        justify-content: flex-end;

    }


    .mobile-nav-head {

        display: none;

    }


    .nav-menu {

        display: flex;

        align-items: center;

        justify-content: flex-end;

        list-style: none;

        gap: 0;

        margin: 0;

        padding: 0;

    }


    .nav-menu > li {

        position: relative;

        list-style: none;

    }


    .nav-menu > li > a,
    .nav-dropdown-btn {

        display: flex;

        align-items: center;

        gap: 7px;

        padding: 15px 13px;

        color: #222;

        background: transparent;

        border: none;

        text-decoration: none;

        font-size: 12px;

        font-weight: 900;

        text-transform: uppercase;

        cursor: pointer;

        white-space: nowrap;

        transition: .3s;

        font-family: inherit;

    }


    .nav-menu > li > a:hover,
    .nav-menu > li > a.active,
    .nav-dropdown-btn:hover,
    .nav-dropdown-btn.active,
    .dropdown:hover > .nav-dropdown-btn {

        background: #ffc300;

        color: #001f3f;

        text-decoration: none;

    }


    /* =========================================================
       DROPDOWN
    ========================================================== */

    .dropdown-menu {

        position: absolute;

        top: 100%;

        left: 0;

        min-width: 280px;

        background: #001f3f;

        list-style: none;

        padding: 0;

        margin: 0;

        display: none;

        border-top:
            4px solid
            #ffc300;

        border-radius:
            0 0 12px 12px;

        overflow: hidden;

        box-shadow:
            0 18px 42px
            rgba(0,0,0,.32);

        z-index: 999999;

    }


    .dropdown:hover > .dropdown-menu {

        display: block;

    }


    .dropdown-menu li a {

        display: flex;

        align-items: center;

        gap: 10px;

        padding: 14px 20px;

        color: #fff;

        background: #001f3f;

        text-decoration: none;

        border-bottom:
            1px solid
            rgba(255,255,255,.12);

        font-size: 12px;

        font-weight: 800;

        text-transform: uppercase;

        white-space: nowrap;

        transition: .3s;

    }


    .dropdown-menu li:last-child a {

        border-bottom: none;

    }


    .dropdown-menu li a:hover {

        background: #ffc300;

        color: #001f3f;

        padding-left: 28px;

    }


    /* =========================================================
       EVENT ICONS
    ========================================================== */

    .event-menu-icon {

        width: 17px;

        text-align: center;

        flex-shrink: 0;

        color: #ffc300;

        transition: .3s;

    }


    .dropdown-menu li a:hover
    .event-menu-icon {

        color: #001f3f;

    }


    /* =========================================================
       HAMBURGER
    ========================================================== */

    .hamburger {

        display: none;

        width: 54px;

        height: 50px;

        border: none;

        background: #001f3f;

        border-radius: 14px;

        align-items: center;

        justify-content: center;

        flex-direction: column;

        gap: 6px;

        cursor: pointer;

        flex-shrink: 0;

        box-shadow:
            0 12px 25px
            rgba(0,31,63,.22);

    }


    .hamburger span {

        width: 27px;

        height: 4px;

        background: #ffc300;

        border-radius: 10px;

        transition: .3s;

    }


    .hamburger.active
    span:nth-child(1) {

        transform:
            translateY(10px)
            rotate(45deg);

    }


    .hamburger.active
    span:nth-child(2) {

        opacity: 0;

    }


    .hamburger.active
    span:nth-child(3) {

        transform:
            translateY(-10px)
            rotate(-45deg);

    }


    /* =========================================================
       TABLET
    ========================================================== */

    @media(max-width:1100px) {

        .main-header-container {

            width: 94%;

        }


        .logo-section {

            min-width: 250px;

        }


        .nav-menu > li > a,
        .nav-dropdown-btn {

            padding:
                14px 9px;

            font-size: 11px;

        }

    }


    /* =========================================================
       MOBILE
    ========================================================== */

    @media(max-width:900px) {

        .top-header {

            display: none;

        }


        .container {

            width: 92%;

        }


        .main-header {

            z-index: 9999999;

        }


        .main-header-container {

            min-height: 88px;

            width: 94%;

        }


        .logo-section {

            min-width: 0;

            flex: 1;

            gap: 10px;

        }


        .school-logo {

            width: 66px;

            height: 66px;

        }


        .school-info h1 {

            font-size: 23px;

        }


        .school-info p {

            font-size: 12px;

        }


        .school-info small {

            display: none;

        }


        .hamburger {

            display: flex;

            position: relative;

            z-index: 10000001;

        }


        /* =====================================================
           MOBILE NAV
        ====================================================== */

        .navbar {

            position: fixed !important;

            inset: 0 !important;

            width: 100vw !important;

            height: 100dvh !important;

            min-height: 100vh !important;

            background: #fff !important;

            display: block !important;

            transform:
                translateX(100%) !important;

            transition:
                transform .35s ease !important;

            z-index: 10000000 !important;

            overflow-y: auto !important;

            padding:
                110px 0 40px !important;

            box-shadow: none !important;

            justify-content:
                flex-start !important;

        }


        .navbar.open {

            transform:
                translateX(0) !important;

        }


        /* =====================================================
           MOBILE BRAND
        ====================================================== */

        .mobile-nav-head {

            display: block;

            position: absolute;

            top: 22px;

            left: 22px;

            right: 92px;

        }


        .mobile-brand {

            display: flex;

            align-items: center;

            gap: 12px;

        }


        .mobile-brand img {

            width: 62px;

            height: 62px;

            object-fit: contain;

            border-radius: 50%;

            filter:
                drop-shadow(
                    0 8px 14px
                    rgba(0,0,0,.15)
                );

        }


        .mobile-brand h3 {

            margin: 0;

            color: #8b0000;

            font-size: 24px;

            line-height: 1.05;

            font-weight: 900;

        }


        .mobile-brand p {

            margin: 5px 0 0;

            color: #333;

            font-size: 13px;

            font-weight: 700;

        }


        /* =====================================================
           MOBILE MENU
        ====================================================== */

        .nav-menu {

            display: block !important;

            width: 100% !important;

            padding: 0 !important;

            margin: 0 !important;

        }


        .nav-menu > li {

            width: 100% !important;

            border-bottom:
                1px solid
                #e8edf3 !important;

        }


        .nav-menu > li > a,
        .nav-dropdown-btn {

            width: 100% !important;

            justify-content:
                space-between !important;

            padding:
                18px 26px !important;

            font-size: 16px !important;

            text-align: left !important;

            background: #fff !important;

            color: #001f3f !important;

            border-radius: 0 !important;

            min-height: 58px !important;

        }


        .nav-menu > li > a.active,
        .nav-dropdown-btn.active,
        .nav-menu > li > a:hover,
        .nav-dropdown-btn:hover {

            background: #ffc300 !important;

            color: #001f3f !important;

        }


        /* =====================================================
           MOBILE DROPDOWN
        ====================================================== */

        .dropdown-menu {

            position: static !important;

            display: none !important;

            width: 100% !important;

            min-width: 100% !important;

            border-top: none !important;

            border-radius: 0 !important;

            box-shadow: none !important;

            background: #001f3f !important;

            overflow: visible !important;

        }


        .dropdown.open >
        .dropdown-menu {

            display: block !important;

        }


        .dropdown:hover >
        .dropdown-menu {

            display: none !important;

        }


        .dropdown.open:hover >
        .dropdown-menu {

            display: block !important;

        }


        .dropdown-menu li a {

            white-space: normal !important;

            font-size: 14px !important;

            padding:
                16px 36px !important;

            color: #fff !important;

            background: #001f3f !important;

            border-bottom:
                1px solid
                rgba(255,255,255,.12) !important;

        }


        .dropdown-menu li a:hover {

            background: #ffc300 !important;

            color: #001f3f !important;

            padding-left:
                42px !important;

        }


        .event-menu-icon {

            color: #ffc300;

        }


        .dropdown-menu li a:hover
        .event-menu-icon {

            color: #001f3f;

