<!-- =========================================================
     GYAN JYOTI — PREMIUM FOOTER
     Backend-safe replacement:
     - Keeps schoolInfo dynamic fields
     - Keeps existing social links
     - Keeps existing contact/map data
     - Keeps existing routes
     - No backend/controller/model changes
========================================================= -->

<section class="gj-footer-cta">
    <div class="gj-footer-orb gj-footer-orb-1"></div>
    <div class="gj-footer-orb gj-footer-orb-2"></div>

    <div class="gj-footer-container gj-footer-cta-inner">

        <div class="gj-footer-cta-copy">
            <span class="gj-footer-eyebrow">
                <i class="fas fa-sparkles"></i>
                BEGIN THE JOURNEY
            </span>

            <h2>
                Give Your Child a
                <span>Brighter Tomorrow.</span>
            </h2>

            <p>
                Discover a learning environment where knowledge,
                character, confidence and creativity grow together.
            </p>
        </div>

        <div class="gj-footer-cta-actions">
            <a href="/admission/process" class="gj-footer-btn gj-footer-btn-gold">
                Start Admission
                <i class="fas fa-arrow-right"></i>
            </a>

            <a href="/contact" class="gj-footer-btn gj-footer-btn-glass">
                Visit Our Campus
                <i class="fas fa-location-dot"></i>
            </a>
        </div>

    </div>
</section>


<footer class="gj-premium-footer">

    <div class="gj-footer-noise"></div>
    <div class="gj-footer-grid-bg"></div>

    <div class="gj-footer-glow gj-footer-glow-1"></div>
    <div class="gj-footer-glow gj-footer-glow-2"></div>

    <div class="gj-footer-container">

        <!-- =====================================================
             TOP BRAND / TRUST BAR
        ====================================================== -->

        <div class="gj-footer-brand-row">

            <div class="gj-footer-brand">

                <div class="gj-footer-logo-wrap">
                    <img
                        src="/images/logo.png"
                        alt="Gyan Jyoti International School"
                        loading="lazy"
                    >
                </div>

                <div class="gj-footer-brand-text">
                    <strong>GYAN JYOTI</strong>
                    <span>INTERNATIONAL SCHOOL</span>
                </div>

            </div>


            <div class="gj-footer-trust">

                <div class="gj-trust-item">
                    <span class="gj-trust-icon">
                        <i class="fas fa-shield-halved"></i>
                    </span>
                    <div>
                        <strong>Safe & Secure</strong>
                        <small>Student-first environment</small>
                    </div>
                </div>

                <div class="gj-trust-item">
                    <span class="gj-trust-icon">
                        <i class="fas fa-award"></i>
                    </span>
                    <div>
                        <strong>Excellence</strong>
                        <small>Learning beyond classrooms</small>
                    </div>
                </div>

                <div class="gj-trust-item">
                    <span class="gj-trust-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </span>
                    <div>
                        <strong>Future Ready</strong>
                        <small>Skills for tomorrow</small>
                    </div>
                </div>

            </div>

        </div>


        <div class="gj-footer-main">

            <!-- =================================================
                 ABOUT
            ================================================== -->

            <div class="gj-footer-column gj-footer-about">

                <span class="gj-footer-kicker">ABOUT OUR SCHOOL</span>

                <h3>
                    Education with
                    <em>Purpose.</em>
                </h3>

                <p>
                    Gyan Jyoti International School is committed to
                    academic excellence, innovation, discipline and
                    holistic development of every child in a safe
                    and inspiring learning environment.
                </p>

                <a href="/about" class="gj-footer-readmore">
                    Discover Our Story
                    <span>
                        <i class="fas fa-arrow-right"></i>
                    </span>
                </a>


                <!-- Socials -->

                <div class="gj-footer-social-label">
                    FOLLOW OUR JOURNEY
                </div>

                <div class="gj-footer-social">

                    <% if(typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.socialLinks && schoolInfo.socialLinks.facebook){ %>
                        <a
                            href="<%= schoolInfo.socialLinks.facebook %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Facebook"
                        >
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    <% } %>

                    <% if(typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.socialLinks && schoolInfo.socialLinks.instagram){ %>
                        <a
                            href="<%= schoolInfo.socialLinks.instagram %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Instagram"
                        >
                            <i class="fab fa-instagram"></i>
                        </a>
                    <% } %>

                    <% if(typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.socialLinks && schoolInfo.socialLinks.youtube){ %>
                        <a
                            href="<%= schoolInfo.socialLinks.youtube %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="YouTube"
                        >
                            <i class="fab fa-youtube"></i>
                        </a>
                    <% } %>

                    <% if(typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.socialLinks && schoolInfo.socialLinks.whatsapp){ %>
                        <a
                            href="<%= schoolInfo.socialLinks.whatsapp %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="WhatsApp"
                        >
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    <% } %>

                </div>

            </div>


            <!-- =================================================
                 EXPLORE
            ================================================== -->

            <div class="gj-footer-column">

                <span class="gj-footer-kicker">EXPLORE</span>

                <h3>Quick Links</h3>

                <ul class="gj-footer-links">

                    <li>
                        <a href="/">
                            <span class="gj-link-number">01</span>
                            <span>Home</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </li>

                    <li>
                        <a href="/about/vision">
                            <span class="gj-link-number">02</span>
                            <span>About Us</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </li>

                    <li>
                        <a href="/academics">
                            <span class="gj-link-number">03</span>
                            <span>Academics</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </li>

                    <li>
                        <a href="/events">
                            <span class="gj-link-number">04</span>
                            <span>Events</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </li>

                    <li>
                        <a href="/gallery">
                            <span class="gj-link-number">05</span>
                            <span>Gallery</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </li>

                    <li>
                        <a href="/contact">
                            <span class="gj-link-number">06</span>
                            <span>Contact</span>
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </li>

                </ul>

            </div>


            <!-- =================================================
                 ADMISSIONS
            ================================================== -->

            <div class="gj-footer-column">

                <span class="gj-footer-kicker">JOIN US</span>

                <h3>Admissions</h3>

                <div class="gj-footer-admission-card">

                    <div class="gj-footer-admission-icon">
                        <i class="fas fa-school"></i>
                    </div>

                    <div>
                        <strong>Admissions Open</strong>
                        <span>2026–27 Academic Session</span>
                    </div>

                </div>


                <div class="gj-footer-admission-links">

                    <a href="/admission/process">
                        <span>
                            <i class="fas fa-file-pen"></i>
                        </span>
                        <div>
                            <strong>Admission Process</strong>
                            <small>Know the complete process</small>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                    </a>

                    <a href="/fees">
                        <span>
                            <i class="fas fa-receipt"></i>
                        </span>
                        <div>
                            <strong>Fee Structure</strong>
                            <small>View available fee details</small>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                    </a>

                    <a href="/contact">
                        <span>
                            <i class="fas fa-calendar-check"></i>
                        </span>
                        <div>
                            <strong>Campus Visit</strong>
                            <small>Plan your visit with us</small>
                        </div>
                        <i class="fas fa-chevron-right"></i>
                    </a>

                </div>

            </div>


            <!-- =================================================
                 CONTACT
            ================================================== -->

            <div class="gj-footer-column gj-footer-contact-column">

                <span class="gj-footer-kicker">GET IN TOUCH</span>

                <h3>Contact Us</h3>

                <% if(typeof schoolInfo !== 'undefined' && schoolInfo){ %>

                    <div class="gj-footer-contact-list">

                        <a
                            href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(schoolInfo.address || '') %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="gj-footer-contact-item"
                        >
                            <span class="gj-contact-icon">
                                <i class="fas fa-location-dot"></i>
                            </span>

                            <span class="gj-contact-copy">
                                <small>VISIT US</small>
                                <strong><%= schoolInfo.address %></strong>
                            </span>
                        </a>


                        <a
                            href="tel:<%= schoolInfo.phone %>"
                            class="gj-footer-contact-item"
                        >
                            <span class="gj-contact-icon">
                                <i class="fas fa-phone"></i>
                            </span>

                            <span class="gj-contact-copy">
                                <small>CALL US</small>
                                <strong><%= schoolInfo.phone %></strong>
                            </span>
                        </a>


                        <a
                            href="mailto:<%= schoolInfo.email %>"
                            class="gj-footer-contact-item"
                        >
                            <span class="gj-contact-icon">
                                <i class="fas fa-envelope"></i>
                            </span>

                            <span class="gj-contact-copy">
                                <small>EMAIL US</small>
                                <strong><%= schoolInfo.email %></strong>
                            </span>
                        </a>

                    </div>

                <% } %>


                <!-- Newsletter is UI-only, exactly like the existing
                     footer: it does not call a backend endpoint. -->

                <div class="gj-footer-newsletter">

                    <span class="gj-newsletter-label">
                        SCHOOL UPDATES
                    </span>

                    <p>
                        Get important announcements and school updates.
                    </p>

                    <form
                        class="gj-newsletter-form"
                        novalidate
                    >
                        <div class="gj-newsletter-input">

                            <i class="fas fa-envelope"></i>

                            <input
                                type="email"
                                name="newsletterEmail"
                                placeholder="Your email address"
                                autocomplete="email"
                                aria-label="Email address"
                                required
                            >

                            <button
                                type="submit"
                                aria-label="Subscribe"
                            >
                                <i class="fas fa-arrow-right"></i>
                            </button>

                        </div>

                        <small class="gj-newsletter-status"></small>

                    </form>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MAP / CAMPUS BAR
        ====================================================== -->

        <% if(typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.mapEmbedUrl){ %>

            <div class="gj-footer-campus">

                <div class="gj-footer-campus-copy">

                    <span class="gj-footer-kicker">
                        FIND US
                    </span>

                    <h3>
                        Come and
                        <em>experience</em>
                        our campus.
                    </h3>

                    <p>
                        A welcoming environment designed to make
                        learning meaningful, engaging and memorable.
                    </p>

                    <a
                        href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(schoolInfo.address || '') %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="gj-footer-map-btn"
                    >
                        Open in Maps
                        <i class="fas fa-arrow-up-right-from-square"></i>
                    </a>

                </div>


                <div class="gj-footer-map">

                    <div class="gj-map-overlay">

                        <span>
                            <i class="fas fa-location-dot"></i>
                        </span>

                        <strong>Gyan Jyoti International School</strong>

                    </div>

                    <iframe
                        src="<%= schoolInfo.mapEmbedUrl %>"
                        loading="lazy"
                        title="Gyan Jyoti International School location"
                        allowfullscreen
                    ></iframe>

                </div>

            </div>

        <% } %>


        <!-- =====================================================
             BOTTOM
        ====================================================== -->

        <div class="gj-footer-bottom">

            <div class="gj-footer-copyright">

                <span class="gj-copyright-symbol">
                    ©
                </span>

                <span>
                    <%= new Date().getFullYear() %>
                    <strong> Gyan Jyoti International School</strong>
                </span>

            </div>


            <div class="gj-footer-legal">

                <a href="/privacy-policy">
                    Privacy
                </a>

                <span></span>

                <a href="/terms">
                    Terms
                </a>

                <span></span>

                <a href="/contact">
                    Support
                </a>

            </div>


            <div class="gj-footer-credit">

                Crafted with
                <i class="fas fa-heart"></i>
                by
                <strong>Gyan Jyoti Web Team</strong>

            </div>

        </div>

    </div>

</footer>


<!-- =========================================================
     FLOATING ACTIONS
========================================================= -->

<% if(typeof schoolInfo !== 'undefined' && schoolInfo && schoolInfo.socialLinks && schoolInfo.socialLinks.whatsapp){ %>

    <a
        href="<%= schoolInfo.socialLinks.whatsapp %>"
        class="gj-whatsapp-float"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat on WhatsApp"
    >
        <span class="gj-whatsapp-ring"></span>
        <i class="fab fa-whatsapp"></i>
        <span class="gj-whatsapp-tooltip">
            Chat with us
        </span>
    </a>

<% } %>


<button
    id="gjTopBtn"
    class="gj-top-btn"
    type="button"
    aria-label="Back to top"
>
    <i class="fas fa-arrow-up"></i>
</button>


<style>

/* =========================================================
   GYAN JYOTI PREMIUM FOOTER — DESIGN SYSTEM
========================================================= */

.gj-footer-cta,
.gj-premium-footer {

    --gj-navy: #001f3f;
    --gj-navy-2: #003d70;
    --gj-blue: #075d98;
    --gj-gold: #ffc300;
    --gj-gold-light: #ffdf70;
    --gj-white: #ffffff;
    --gj-text: rgba(255,255,255,.72);
    --gj-line: rgba(255,255,255,.11);

    font-family: inherit;

}


.gj-footer-container {

    width: min(1180px, 90%);

    margin: 0 auto;

}


/* =========================================================
   CTA
========================================================= */

.gj-footer-cta {

    position: relative;

    overflow: hidden;

    padding: 75px 0;

    background:
        linear-gradient(
            135deg,
            #00162d 0%,
            #00315c 52%,
            #005487 100%
        );

    color: #fff;

}


.gj-footer-cta::before {

    content: "";

    position: absolute;

    inset: 0;

    opacity: .16;

    background-image:
        linear-gradient(
            rgba(255,255,255,.25) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.25) 1px,
            transparent 1px
        );

    background-size: 55px 55px;

    mask-image:
        linear-gradient(
            90deg,
            black,
            transparent 85%
        );

}


.gj-footer-cta-inner {

    position: relative;

    z-index: 3;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 50px;

}


.gj-footer-eyebrow,
.gj-footer-kicker {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    color: var(--gj-gold);

    font-size: 12px;

    font-weight: 950;

    letter-spacing: 2px;

}


.gj-footer-eyebrow i {

    font-size: 12px;

}


.gj-footer-cta-copy h2 {

    max-width: 760px;

    margin: 14px 0 12px;

    color: #fff;

    font-size: clamp(38px, 5vw, 63px);

    line-height: 1.02;

    letter-spacing: -2.5px;

    font-weight: 950;

}


.gj-footer-cta-copy h2 span {

    display: block;

    color: var(--gj-gold);

}


.gj-footer-cta-copy p {

    max-width: 670px;

    margin: 0;

    color: rgba(255,255,255,.67);

    font-size: 14px;

    line-height: 1.8;

}


.gj-footer-cta-actions {

    display: flex;

    flex-direction: column;

    gap: 10px;

    min-width: 210px;

}


.gj-footer-btn {

    min-height: 51px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 11px;

    padding: 13px 20px;

    border-radius: 999px;

    text-decoration: none;

    font-size: 13px;

    font-weight: 950;

    transition: .3s ease;

}


.gj-footer-btn:hover {

    transform: translateY(-4px);

    text-decoration: none;

}


.gj-footer-btn-gold {

    color: var(--gj-navy);

    background:
        linear-gradient(
            135deg,
            var(--gj-gold),
            var(--gj-gold-light)
        );

    box-shadow:
        0 18px 40px rgba(255,195,0,.2);

}


.gj-footer-btn-gold:hover {

    color: var(--gj-navy);

    box-shadow:
        0 22px 48px rgba(255,195,0,.35);

}


.gj-footer-btn-glass {

    color: #fff;

    border: 1px solid rgba(255,255,255,.2);

    background: rgba(255,255,255,.06);

    backdrop-filter: blur(12px);

}


.gj-footer-btn-glass:hover {

    color: var(--gj-navy);

    background: #fff;

}


/* Orbs */

.gj-footer-orb {

    position: absolute;

    border-radius: 50%;

    pointer-events: none;

}


.gj-footer-orb-1 {

    width: 300px;

    height: 300px;

    right: 5%;

    top: -210px;

    border: 1px solid rgba(255,195,0,.22);

    box-shadow:
        0 0 0 55px rgba(255,195,0,.025),
        0 0 0 110px rgba(255,195,0,.015);

}


.gj-footer-orb-2 {

    width: 180px;

    height: 180px;

    left: 38%;

    bottom: -145px;

    border: 1px solid rgba(255,255,255,.11);

}


/* =========================================================
   MAIN FOOTER
========================================================= */

.gj-premium-footer {

    position: relative;

    overflow: hidden;

    padding: 0 0 28px;

    background:
        linear-gradient(
            145deg,
            #001426 0%,
            #001e39 48%,
            #00345f 100%
        );

    color: #fff;

}


.gj-footer-noise {

    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: .035;

    background-image:
        url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");

}


.gj-footer-grid-bg {

    position: absolute;

    inset: 0;

    pointer-events: none;

    opacity: .045;

    background-image:
        linear-gradient(
            rgba(255,255,255,.35) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(255,255,255,.35) 1px,
            transparent 1px
        );

    background-size: 80px 80px;

    mask-image:
        radial-gradient(
            circle at 50% 0%,
            black,
            transparent 72%
        );

}


.gj-footer-glow {

    position: absolute;

    border-radius: 50%;

    filter: blur(80px);

    pointer-events: none;

}


.gj-footer-glow-1 {

    width: 360px;

    height: 360px;

    left: -170px;

    top: 90px;

    background: rgba(255,195,0,.13);

}


.gj-footer-glow-2 {

    width: 450px;

    height: 450px;

    right: -220px;

    bottom: -180px;

    background: rgba(0,132,204,.16);

}


/* =========================================================
   BRAND ROW
========================================================= */

.gj-footer-brand-row {

    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 35px;

    padding: 42px 0;

    border-bottom: 1px solid var(--gj-line);

}


.gj-footer-brand {

    display: flex;

    align-items: center;

    gap: 15px;

}


.gj-footer-logo-wrap {

    width: 66px;

    height: 66px;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;

    border-radius: 19px;

    background: #fff;

    border: 1px solid rgba(255,255,255,.25);

    box-shadow:
        0 15px 35px rgba(0,0,0,.25);

    overflow: hidden;

}


.gj-footer-logo-wrap img {

    width: 52px;

    height: 52px;

    object-fit: contain;

}


.gj-footer-brand-text strong {

    display: block;

    color: #fff;

    font-size: 23px;

    font-weight: 950;

    letter-spacing: .5px;

    line-height: 1;

}


.gj-footer-brand-text span {

    display: block;

    margin-top: 6px;

    color: var(--gj-gold);

    font-size: 11px;

    font-weight: 900;

    letter-spacing: 2.2px;

}


.gj-footer-trust {

    display: flex;

    align-items: center;

    gap: 8px;

}


.gj-trust-item {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 13px;

    border: 1px solid rgba(255,255,255,.08);

    border-radius: 14px;

    background: rgba(255,255,255,.045);

    backdrop-filter: blur(10px);

}


.gj-trust-icon {

    width: 35px;

    height: 35px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 11px;

    background: rgba(255,195,0,.1);

    color: var(--gj-gold);

    font-size: 13px;

}


.gj-trust-item strong {

    display: block;

    color: #fff;

    font-size: 11px;

}


.gj-trust-item small {

    display: block;

    margin-top: 3px;

    color: rgba(255,255,255,.42);

    font-size: 9px;

}


/* =========================================================
   MAIN GRID
========================================================= */

.gj-footer-main {

    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns:
        1.35fr
        .82fr
        .95fr
        1.18fr;

    gap: 50px;

    padding: 70px 0 65px;

}


.gj-footer-column {

    min-width: 0;

}


.gj-footer-column h3 {

    margin: 10px 0 25px;

    color: #fff;

    font-size: 22px;

    line-height: 1.1;

    font-weight: 900;

}


.gj-footer-column h3::after {

    content: "";

    display: block;

    width: 34px;

    height: 3px;

    margin-top: 11px;

    border-radius: 10px;

    background: var(--gj-gold);

}


.gj-footer-about h3 em {

    color: var(--gj-gold);

    font-style: normal;

}


.gj-footer-about p {

    max-width: 360px;

    margin: 0;

    color: rgba(255,255,255,.58);

