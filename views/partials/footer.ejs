<script>

/* =========================================================
   GYAN JYOTI PREMIUM FOOTER JS
   No backend calls. No route manipulation.
========================================================= */

(function () {

    'use strict';


    function initFooter() {

        /* =====================================================
           BACK TO TOP
        ====================================================== */

        const topBtn =
            document.getElementById('gjTopBtn');


        if (topBtn) {

            const updateTopButton =
                function () {

                    topBtn.classList.toggle(
                        'is-visible',
                        window.scrollY > 450
                    );

                };


            window.addEventListener(
                'scroll',
                updateTopButton,
                { passive: true }
            );


            updateTopButton();


            topBtn.addEventListener(
                'click',
                function () {

                    window.scrollTo({
                        top: 0,
                        behavior: 'smooth'
                    });

                }
            );

        }


        /* =====================================================
           NEWSLETTER — FRONTEND ONLY
           The existing footer did not submit this to a backend.
           Keep it UI-only to avoid changing backend/CSRF behavior.
        ====================================================== */

        const newsletter =
            document.querySelector(
                '.gj-newsletter-form'
            );


        if (newsletter) {

            newsletter.addEventListener(
                'submit',
                function (event) {

                    event.preventDefault();


                    const input =
                        newsletter.querySelector(
                            'input[type="email"]'
                        );

                    const button =
                        newsletter.querySelector(
                            'button'
                        );

                    const status =
                        newsletter.querySelector(
                            '.gj-newsletter-status'
                        );


                    if (!input || !button) {
                        return;
                    }


                    const email =
                        input.value.trim();


                    const valid =
                        /^[^\s@]+@[^\s@]+\.[^\s@]+$/
                        .test(email);


                    if (!valid) {

                        input.focus();

                        input.animate(
                            [
                                {
                                    transform:
                                        'translateX(-6px)'
                                },
                                {
                                    transform:
                                        'translateX(6px)'
                                },
                                {
                                    transform:
                                        'translateX(-4px)'
                                },
                                {
                                    transform:
                                        'translateX(0)'
                                }
                            ],
                            {
                                duration: 260
                            }
                        );


                        if (status) {

                            status.textContent =
                                'Please enter a valid email address.';

                            status.style.color =
                                '#ffb4b4';

                        }

                        return;

                    }


                    button.disabled = true;

                    button.innerHTML =
                        '<i class="fas fa-check"></i>';


                    if (status) {

                        status.textContent =
                            'You are subscribed for school updates.';

                        status.style.color =
                            '#ffc300';

                    }


                    input.value = '';


                    window.setTimeout(
                        function () {

                            button.disabled = false;

                            button.innerHTML =
                                '<i class="fas fa-arrow-right"></i>';

                            if (status) {
                                status.textContent = '';
                            }

                        },
                        3200
                    );

                }
            );

        }


        /* =====================================================
           FOOTER MICRO-REVEAL
        ====================================================== */

        const columns =
            document.querySelectorAll(
                '.gj-footer-column'
            );


        if (
            'IntersectionObserver' in window &&
            columns.length
        ) {

            const observer =
                new IntersectionObserver(
                    function (entries, obs) {

                        entries.forEach(
                            function (entry) {

                                if (
                                    entry.isIntersecting
                                ) {

                                    entry.target.style.opacity =
                                        '1';

                                    entry.target.style.transform =
                                        'translateY(0)';

                                    obs.unobserve(
                                        entry.target
                                    );

                                }

                            }
                        );

                    },
                    {
                        threshold: .12
                    }
                );


            columns.forEach(
                function (column, index) {

                    column.style.opacity = '0';

                    column.style.transform =
                        'translateY(24px)';

                    column.style.transition =
                        'opacity .7s ease ' +
                        (index * .08) +
                        's, transform .7s ease ' +
                        (index * .08) +
                        's';

                    observer.observe(column);

                }
            );

        }


        /* =====================================================
           NEWSLETTER FOCUS POLISH
        ====================================================== */

        document
            .querySelectorAll(
                '.gj-newsletter-input input'
            )
            .forEach(
                function (input) {

                    input.addEventListener(
                        'focus',
                        function () {

                            const wrapper =
                                input.closest(
                                    '.gj-newsletter-input'
                                );

                            if (wrapper) {

                                wrapper.style.transform =
                                    'translateY(-2px)';

                            }

                        }
                    );


                    input.addEventListener(
                        'blur',
                        function () {

                            const wrapper =
                                input.closest(
                                    '.gj-newsletter-input'
                                );

                            if (wrapper) {

                                wrapper.style.transform =
                                    '';

                            }

                        }
                    );

                }
            );


        /* =====================================================
           CONTACT ICON TILT — LIGHTWEIGHT
        ====================================================== */

        document
            .querySelectorAll(
                '.gj-footer-contact-item'
            )
            .forEach(
                function (item) {

                    item.addEventListener(
                        'mouseenter',
                        function () {

                            const icon =
                                item.querySelector(
                                    '.gj-contact-icon'
                                );

                            if (icon) {

                                icon.style.transform =
                                    'translateY(-2px) scale(1.05)';

                            }

                        }
                    );


                    item.addEventListener(
                        'mouseleave',
                        function () {

                            const icon =
                                item.querySelector(
                                    '.gj-contact-icon'
                                );

                            if (icon) {

                                icon.style.transform =
                                    '';

                            }

                        }
                    );

                }
            );

    }


    if (
        document.readyState === 'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            initFooter
        );

    } else {

        initFooter();

    }

})();

</script>
