.legal-bottom-note i{margin-top:2px;}

.legal-reveal{
    opacity:0;
    transform:translateY(24px);
    transition:opacity .8s ease,transform .8s ease;
}

.legal-reveal.is-visible{
    opacity:1;
    transform:none;
}

@keyframes legalFloat{
    0%,100%{transform:translateY(0) rotate(0);}
    50%{transform:translateY(-20px) rotate(2deg);}
}

@keyframes legalCardFloat{
    0%,100%{transform:translateY(0) rotate(2deg);}
    50%{transform:translateY(-13px) rotate(-1deg);}
}

@keyframes legalPulse{
    0%,100%{transform:scale(1);opacity:1;}
    50%{transform:scale(.88);opacity:.7;}
}

@keyframes legalSpin{
    from{transform:rotate(0);}
    to{transform:rotate(360deg);}
}

@media(max-width:900px){
    .legal-hero .legal-shell{
        grid-template-columns:1fr;
        gap:35px;
    }

    .legal-hero-visual{
        min-height:300px;
    }

    .legal-body-grid{
        grid-template-columns:1fr;
        gap:30px;
    }

    .legal-sidebar{
        position:relative;
        top:auto;
    }

    .legal-sidebar-inner{
        display:flex;
        gap:4px;
        overflow-x:auto;
        padding:12px;
    }

    .legal-side-label{
        display:none;
    }

    .legal-nav-link{
        white-space:nowrap;
    }

    .legal-info-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:620px){
    .legal-shell{
        width:92%;
    }

    .legal-hero{
        min-height:650px;
    }

    .legal-hero .legal-shell{
        padding:70px 0 95px;
    }

    .legal-hero h1{
        font-size:49px;
        letter-spacing:-2.2px;
    }

    .legal-lead{
        font-size:13px;
    }

    .legal-meta-row{
        gap:7px;
    }

    .legal-meta-row span{
        font-size:8px;
    }

    .legal-glass-card{
        padding:25px;
    }

    .legal-body{
        padding:65px 0 80px;
    }

    .legal-section{
        grid-template-columns:1fr;
        gap:14px;
        padding-bottom:48px;
        margin-bottom:48px;
    }

    .legal-section-number{
        width:34px;
        height:34px;
    }

    .legal-section h2{
        font-size:31px;
    }

    .legal-section p{
        font-size:12px;
    }

    .legal-contact-card{
        grid-template-columns:1fr;
    }

    .legal-contact-card > div{
        padding:0;
    }

    .legal-primary-btn{
        width:100%;
    }

    .legal-orbit{
        width:280px;
        height:280px;
    }
}

@media(prefers-reduced-motion:reduce){
    .legal-page *,
    .legal-page *::before,
    .legal-page *::after{
        animation-duration:.01ms!important;
        animation-iteration-count:1!important;
        scroll-behavior:auto!important;
        transition-duration:.01ms!important;
    }

    .legal-reveal{
        opacity:1;
        transform:none;
    }
}
</style>

<script>
(function(){
    'use strict';

    const revealItems =
        document.querySelectorAll('.legal-reveal');

    if ('IntersectionObserver' in window) {

        const observer =
            new IntersectionObserver(
                function(entries, obs){

                    entries.forEach(function(entry){

                        if(entry.isIntersecting){

                            entry.target.classList.add(
                                'is-visible'
                            );

                            obs.unobserve(
                                entry.target
                            );

                        }

                    });

                },
                {
                    threshold:.12,
                    rootMargin:'0px 0px -45px 0px'
                }
            );

        revealItems.forEach(function(item){
            observer.observe(item);
        });

    } else {

        revealItems.forEach(function(item){
            item.classList.add('is-visible');
        });

    }


    const navLinks =
        Array.from(
            document.querySelectorAll('.legal-nav-link')
        );

    const sections =
        navLinks
            .map(function(link){
                return document.querySelector(
                    link.getAttribute('href')
                );
            })
            .filter(Boolean);


    if ('IntersectionObserver' in window){

        const sectionObserver =
            new IntersectionObserver(
                function(entries){

                    entries.forEach(function(entry){

                        if(entry.isIntersecting){

                            navLinks.forEach(function(link){
                                link.classList.toggle(
                                    'is-active',
                                    link.getAttribute('href') ===
                                    '#' + entry.target.id
                                );
                            });

                        }

                    });

                },
                {
                    rootMargin:'-20% 0px -65% 0px',
                    threshold:0
                }
            );

        sections.forEach(function(section){
            sectionObserver.observe(section);
        });

    }


    navLinks.forEach(function(link){

        link.addEventListener(
            'click',
            function(event){

                const target =
                    document.querySelector(
                        link.getAttribute('href')
                    );

                if(!target){
                    return;
                }

                event.preventDefault();

                target.scrollIntoView({
                    behavior:'smooth',
                    block:'start'
                });

            }
        );

    });

})();
</script>

