<style>
/* =========================================================
   GYAN JYOTI — PREMIUM PRIVACY / TERMS DESIGN SYSTEM
   Frontend only. Uses existing header/footer and routes.
========================================================= */

.legal-page{
    --lp-navy:#001f3f;
    --lp-navy-2:#003b69;
    --lp-blue:#0877b9;
    --lp-gold:#ffc300;
    --lp-gold-2:#ffe071;
    --lp-ink:#102a43;
    --lp-muted:#6e8092;
    --lp-border:#dfe8f0;
    --lp-bg:#f5f8fc;
    --lp-white:#fff;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 8% 8%,rgba(255,195,0,.09),transparent 24%),
        radial-gradient(circle at 92% 20%,rgba(0,91,150,.08),transparent 28%),
        var(--lp-bg);
    color:var(--lp-ink);
}

.legal-grid{
    position:absolute;
    inset:0;
    opacity:.22;
    pointer-events:none;
    background-image:
        linear-gradient(rgba(0,31,63,.05) 1px,transparent 1px),
        linear-gradient(90deg,rgba(0,31,63,.05) 1px,transparent 1px);
    background-size:70px 70px;
    mask-image:linear-gradient(to bottom,#000,transparent 72%);
}

.legal-ambient{
    position:absolute;
    width:430px;
    height:430px;
    border:1px solid rgba(255,195,0,.22);
    border-radius:50%;
    pointer-events:none;
    animation:legalFloat 9s ease-in-out infinite;
}

.legal-ambient-one{left:-250px;top:170px;}
.legal-ambient-two{right:-260px;top:520px;border-color:rgba(0,91,150,.16);animation-delay:-4s;}

.legal-shell{
    width:min(1180px,90%);
    margin:0 auto;
    position:relative;
    z-index:2;
}

.legal-hero{
    min-height:610px;
    display:flex;
    align-items:center;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 70% 30%,rgba(255,195,0,.12),transparent 24%),
        linear-gradient(135deg,#00172f,#003b69 65%,#00223e);
    color:#fff;
}

.legal-hero:after{
    content:"";
    position:absolute;
    left:0;
    right:0;
    bottom:-1px;
    height:110px;
    background:linear-gradient(to top,var(--lp-bg),transparent);
    pointer-events:none;
}

.legal-hero .legal-shell{
    display:grid;
    grid-template-columns:1.08fr .92fr;
    align-items:center;
    gap:70px;
    padding:85px 0 115px;
}

.legal-kicker{
    display:inline-flex;
    align-items:center;
    gap:12px;
    color:var(--lp-gold);
    font-size:10px;
    font-weight:950;
    letter-spacing:2.2px;
}

.legal-kicker-line{
    width:34px;
    height:2px;
    border-radius:20px;
    background:var(--lp-gold);
}

.legal-icon{
    width:66px;
    height:66px;
    margin:28px 0 22px;
